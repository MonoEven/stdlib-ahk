AhkStdlibPillowFloatBoxBlurLineChannel(line, floatRadius)
{
    radius := Floor(floatRadius)
    fixedOne := 1 << 24
    denominator := AhkStdlibPillowFloat32(floatRadius * 2 + 1)
    wholeWeight := Floor(AhkStdlibPillowFloat32(fixedOne / denominator))
    farWeight := Floor((fixedOne - (radius * 2 + 1) * wholeWeight) / 2)

    count := line.Length
    last := count - 1
    edgeA := Min(radius + 1, count)
    edgeB := Max(count - radius - 1, 0)
    acc := line[1] * (radius + 1)
    x := 0
    while x < edgeA - 1 {
        acc += line[x + 1]
        x += 1
    }
    acc += line[last + 1] * (radius - edgeA + 1)

    output := []
    if edgeA <= edgeB {
        x := 0
        while x < edgeA {
            acc += line[x + radius + 1] - line[1]
            output.Push(AhkStdlibPillowFloatBoxBlurSave(acc, wholeWeight, farWeight, line[1], line[x + radius + 2]))
            x += 1
        }
        while x < edgeB {
            acc += line[x + radius + 1] - line[x - radius]
            output.Push(AhkStdlibPillowFloatBoxBlurSave(acc, wholeWeight, farWeight, line[x - radius], line[x + radius + 2]))
            x += 1
        }
        while x <= last {
            acc += line[last + 1] - line[x - radius]
            output.Push(AhkStdlibPillowFloatBoxBlurSave(acc, wholeWeight, farWeight, line[x - radius], line[last + 1]))
            x += 1
        }
    } else {
        x := 0
        while x < edgeB {
            acc += line[x + radius + 1] - line[1]
            output.Push(AhkStdlibPillowFloatBoxBlurSave(acc, wholeWeight, farWeight, line[1], line[x + radius + 2]))
            x += 1
        }
        while x < edgeA {
            acc += line[last + 1] - line[1]
            output.Push(AhkStdlibPillowFloatBoxBlurSave(acc, wholeWeight, farWeight, line[1], line[last + 1]))
            x += 1
        }
        while x <= last {
            acc += line[last + 1] - line[x - radius]
            output.Push(AhkStdlibPillowFloatBoxBlurSave(acc, wholeWeight, farWeight, line[x - radius], line[last + 1]))
            x += 1
        }
    }
    return output
}

AhkStdlibPillowFloat32(value)
{
