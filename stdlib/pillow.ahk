    if RegExMatch(color, "^rgb\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)$", &match)
        return [Integer(match[1]), Integer(match[2]), Integer(match[3])]
    if RegExMatch(color, "^rgb\(\s*(\d+)%\s*,\s*(\d+)%\s*,\s*(\d+)%\s*\)$", &match)
        return [
            Integer(Integer(match[1]) * 255 / 100.0 + 0.5),
            Integer(Integer(match[2]) * 255 / 100.0 + 0.5),
            Integer(Integer(match[3]) * 255 / 100.0 + 0.5),
        ]
    if RegExMatch(color, "^rgba\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)$", &match)
        return [Integer(match[1]), Integer(match[2]), Integer(match[3]), Integer(match[4])]
    if RegExMatch(color, "^hsl\(\s*(\d+\.?\d*)\s*,\s*(\d+\.?\d*)%\s*,\s*(\d+\.?\d*)%\s*\)$", &match)
        return AhkStdlibPillowHlsToRgb(Float(match[1]) / 360.0, Float(match[3]) / 100.0, Float(match[2]) / 100.0)
    if RegExMatch(color, "^hs[bv]\(\s*(\d+\.?\d*)\s*,\s*(\d+\.?\d*)%\s*,\s*(\d+\.?\d*)%\s*\)$", &match)
        return AhkStdlibPillowHsvToRgb(Float(match[1]) / 360.0, Float(match[2]) / 100.0, Float(match[3]) / 100.0)

    throw ValueError("unknown color specifier: '" StrLower(original) "'", -1)
}

AhkStdlibPillowImageColorGetColor(color, mode)
{
    rgb := AhkStdlibPillowImageColorGetRgb(color)
    alpha := 255
    if rgb.Length = 4 {
        alpha := rgb[4]
        rgb := [rgb[1], rgb[2], rgb[3]]
    }

    if mode = "HSV" {
        hsv := AhkStdlibPillowRgbToHsv(rgb[1] / 255.0, rgb[2] / 255.0, rgb[3] / 255.0)
        return [Integer(hsv[1] * 255), Integer(hsv[2] * 255), Integer(hsv[3] * 255)]
    }

    if !AhkStdlibPillowModeIsSupported(mode)
        throw KeyError("'" mode "'", -1)

    if mode = "1" || mode = "L" || mode = "LA" {
        gray := (rgb[1] * 19595 + rgb[2] * 38470 + rgb[3] * 7471 + 0x8000) >> 16
        if mode = "1"
            return AhkStdlibPillowBoolColorValue(gray)
        return mode = "LA" ? [gray, alpha] : gray
    }
    if mode = "RGBA"
        return [rgb[1], rgb[2], rgb[3], alpha]
    return rgb
}

