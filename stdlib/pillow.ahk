            b := bIndex / (size3 - 1)
            loop size2 {
                gIndex := A_Index - 1
                g := gIndex / (size2 - 1)
                loop size1 {
                    rIndex := A_Index - 1
                    r := rIndex / (size1 - 1)
                    values := AhkStdlibPillowSequenceToArray(callback.Call(r, g, b))
                    loop channels
                        table.Push(values[A_Index])
                }
