        return super.getpixel(xy)
    }

    getdata(band := unset)
    {
        this.load()
        return super.getdata(band?)
    }

    copy()
    {
        this.load()
        return super.copy()
    }
}

AhkStdlibPillowIcoOpen(source)
{
    if !(AhkStdlibPillowIsOpenFileLike(source))
        source := AhkStdlibPillowOpenFile(source)
    ico := AhkStdlibPillowIcoFile(source)
    header := ico.entry[1]
    image := ico.frame(0)
    return AhkStdlibPillowIcoImage(image, ico, header.dim)
}

AhkStdlibPillowIcoDibImage(dib)
{
    patched := dib.Clone()
    headerSize := AhkStdlibPillowBmpI32(patched)
    if headerSize = 12 && patched.Length >= 10 {
        originalHeight := AhkStdlibPillowBmpI16(patched, 9)
        height := originalHeight // 2
        patched[9] := height & 0xFF
        patched[10] := (height >> 8) & 0xFF
    } else if patched.Length >= 12 {
        originalHeight := AhkStdlibPillowBmpI32(patched, 9)
        height := originalHeight // 2
        heightBytes := AhkStdlibPillowBmpO32(height)
        loop 4
            patched[8 + A_Index] := heightBytes[A_Index]
    }
    return stdlib.pillow.BmpImagePlugin.DibImageFile(stdlib.io.BytesIO(patched))
}

AhkStdlibPillowIcoSaveImage(image, fp, filename)
{
    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    sizes := info.Has("sizes") ? AhkStdlibPillowIcoNormalizeSizes(info["sizes"]) : AhkStdlibPillowIcoDefaultSizes()
    bitmapFormat := info.Has("bitmap_format") ? StrLower(info["bitmap_format"]) : "png"
    appendImages := info.Has("append_images") ? AhkStdlibPillowSequenceToArray(info["append_images"]) : []
    provided := AhkStdlibPillowIcoProvidedImages(image, appendImages)

    frames := []
    for size in sizes {
        source := AhkStdlibPillowIcoSourceForSize(image, provided, size)
        owned := !(source == image) && !AhkStdlibPillowIcoImageInList(source, appendImages)
        try {
            payload := bitmapFormat = "bmp" ? AhkStdlibPillowIcoImageToDibBytes(source) : AhkStdlibPillowIcoImageToPngBytes(source)
            frames.Push({ Size: size, Payload: payload, Bpp: AhkStdlibPillowIcoBitsPerPixel(source.mode), Colors: AhkStdlibPillowIcoColorCount(source.mode) })
        } finally {
            if owned && IsObject(source) && HasMethod(source, "close")
                source.close()
        }
    }

    bytes := AhkStdlibPillowIcoImagePluginModule._MAGIC.Clone()
    for byte in AhkStdlibPillowIcoO16(frames.Length)
        bytes.Push(byte)
    offset := 6 + frames.Length * 16
    for frame in frames {
        width := frame.Size[1] >= 256 ? 0 : frame.Size[1]
        height := frame.Size[2] >= 256 ? 0 : frame.Size[2]
        bytes.Push(width)
        bytes.Push(height)
        bytes.Push(frame.Colors)
        bytes.Push(0)
        for byte in AhkStdlibPillowIcoO16(0)
            bytes.Push(byte)
        for byte in AhkStdlibPillowIcoO16(frame.Bpp)
            bytes.Push(byte)
        for byte in AhkStdlibPillowIcoO32(frame.Payload.Length)
            bytes.Push(byte)
        for byte in AhkStdlibPillowIcoO32(offset)
            bytes.Push(byte)
        offset += frame.Payload.Length
    }
    for frame in frames {
        for byte in frame.Payload
            bytes.Push(byte)
    }
    fp.write(bytes)
    if HasMethod(fp, "flush")
        fp.flush()
    return stdlib.None
}

AhkStdlibPillowIcoDefaultSizes()
{
    return [[16, 16], [24, 24], [32, 32], [48, 48], [64, 64], [128, 128], [256, 256]]
}

AhkStdlibPillowIcoNormalizeSizes(sizes)
{
    result := []
    for size in AhkStdlibPillowSequenceToArray(sizes)
        result.Push(AhkStdlibPillowIcoNormalizeSize(size))
    return result
}

AhkStdlibPillowIcoNormalizeSize(size)
{
    values := AhkStdlibPillowSequenceToArray(size)
    if values.Length != 2
        throw ValueError("Size must be a sequence of length 2", -1)
    return [Integer(values[1]), Integer(values[2])]
}

AhkStdlibPillowIcoProvidedImages(image, appendImages)
{
    provided := Map(AhkStdlibPillowIcoSizeKey(image.size), image)
    for appended in appendImages
        provided[AhkStdlibPillowIcoSizeKey(appended.size)] := appended
    return provided
}

AhkStdlibPillowIcoSourceForSize(image, provided, size)
{
    key := AhkStdlibPillowIcoSizeKey(size)
    if provided.Has(key)
        return provided[key]
    return image.resize(size)
}

AhkStdlibPillowIcoImageInList(image, images)
{
    for candidate in images
        if IsObject(candidate) && ObjPtr(candidate) = ObjPtr(image)
            return true
    return false
}

AhkStdlibPillowIcoImageToPngBytes(image)
{
    buffer := stdlib.io.BytesIO()
    image.save(buffer, "PNG")
    return buffer.getvalue()
}

AhkStdlibPillowIcoImageToDibBytes(image)
{
    buffer := stdlib.io.BytesIO()
    image.save(buffer, "BMP")
    bmpBytes := buffer.getvalue()
    dib := AhkStdlibPillowArraySlice(bmpBytes, 15, bmpBytes.Length)
    headerSize := AhkStdlibPillowBmpI32(dib)
    if headerSize = 12 && dib.Length >= 10 {
        height := AhkStdlibPillowBmpI16(dib, 9)
        doubled := height * 2
        dib[9] := doubled & 0xFF
        dib[10] := (doubled >> 8) & 0xFF
    } else if dib.Length >= 12 {
        height := AhkStdlibPillowBmpI32(dib, 9)
        doubled := height * 2
        heightBytes := AhkStdlibPillowBmpO32(doubled)
        loop 4
            dib[8 + A_Index] := heightBytes[A_Index]
    }
    return dib
}

AhkStdlibPillowIcoBitsPerPixel(mode)
{
    switch mode {
        case "1":
            return 1
        case "P", "L":
            return 8
        case "RGB":
            return 24
        default:
            return 32
    }
}

AhkStdlibPillowIcoColorCount(mode)
{
    switch mode {
        case "1":
            return 2
        case "P", "L":
            return 0
        default:
            return 0
    }
}

AhkStdlibPillowIcoSortEntries(entries)
{
    count := entries.Length
    loop count {
        i := A_Index
        j := i + 1
        while j <= count {
            if AhkStdlibPillowIcoEntryLess(entries[j], entries[i]) {
                tmp := entries[i]
                entries[i] := entries[j]
                entries[j] := tmp
            }
            j += 1
        }
    }
    return entries
}

AhkStdlibPillowIcoEntryLess(left, right)
{
    if left.square != right.square
        return left.square > right.square
    return left.color_depth < right.color_depth
}

AhkStdlibPillowIcoSortSizes(sizes)
{
    count := sizes.Length
    loop count {
        i := A_Index
        j := i + 1
        while j <= count {
            if sizes[j][1] < sizes[i][1] || (sizes[j][1] = sizes[i][1] && sizes[j][2] < sizes[i][2]) {
                tmp := sizes[i]
                sizes[i] := sizes[j]
                sizes[j] := tmp
            }
            j += 1
        }
    }
    return sizes
}

AhkStdlibPillowIcoSizeKey(size)
{
    return size[1] "," size[2]
}

AhkStdlibPillowIcoSizesEqual(left, right)
{
    return left.Length = right.Length && left[1] = right[1] && left[2] = right[2]
}

AhkStdlibPillowIcoStartsWith(bytes, prefix)
{
    if bytes.Length < prefix.Length
        return false
    loop prefix.Length {
        if bytes[A_Index] != prefix[A_Index]
            return false
    }
    return true
}

AhkStdlibPillowIcoRequireLength(bytes, length)
{
    if bytes.Length < length
        throw OSError("Truncated ICO file", -1)
}

AhkStdlibPillowIcoI16(bytes, offset)
{
    if bytes.Length < offset + 1
        return 0
    return bytes[offset] | (bytes[offset + 1] << 8)
}

AhkStdlibPillowIcoI32(bytes, offset)
{
    if bytes.Length < offset + 3
        return 0
    return bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)
}

AhkStdlibPillowIcoO16(value)
{
    value := Integer(value)
    return [value & 0xFF, (value >> 8) & 0xFF]
}

AhkStdlibPillowIcoO32(value)
{
    value := Integer(value)
    return [value & 0xFF, (value >> 8) & 0xFF, (value >> 16) & 0xFF, (value >> 24) & 0xFF]
}

