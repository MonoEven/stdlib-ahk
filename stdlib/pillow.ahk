    palette := []
    loop count {
        index := A_Index
        palette.Push(
            AhkStdlibPillowSunByteAt(bytes, index),
            AhkStdlibPillowSunByteAt(bytes, count + index),
            AhkStdlibPillowSunByteAt(bytes, count * 2 + index)
        )
    }
    return palette
}

AhkStdlibPillowSunStride(width, depth)
{
