class AhkStdlibPillowMpegBitStream
{
    __New(fp)
    {
        this.fp := fp
        this.bits := 0
        this.bitbuffer := 0
    }

    next()
    {
        bytes := AhkStdlibPillowByteSequence(this.fp.read(1))
        if bytes.Length < 1
            throw IndexError("index out of range", -1)
        return bytes[1]
    }

    peek(bits)
    {
        bits := Integer(bits)
        while this.bits < bits {
            this.bitbuffer := (this.bitbuffer << 8) + this.next()
            this.bits += 8
        }
        return (this.bitbuffer >> (this.bits - bits)) & ((1 << bits) - 1)
    }

    skip(bits)
    {
        bits := Integer(bits)
        while this.bits < bits {
            this.bitbuffer := (this.bitbuffer << 8) + this.next()
            this.bits += 8
        }
        this.bits -= bits
        return stdlib.None
    }

    read(bits)
    {
        value := this.peek(bits)
        this.bits -= Integer(bits)
        return value
    }
}

