        if IsSet(paletteBytes) {
            this.AhkStdlibPaletteMode := "RGB"
            this.AhkStdlibPalette := paletteBytes.Clone()
        }
    }

    layers
    {
        get => this.AhkStdlibPsdLayers
    }

    n_frames
    {
        get => this.AhkStdlibPsdLayers.Length
    }

    is_animated
    {
        get => this.AhkStdlibPsdLayers.Length > 1
    }

    seek(args*)
    {
        if args.Length = 0
            throw TypeError("Image.seek() missing 1 required positional argument: 'frame'", -1)
        if args.Length > 1
            throw TypeError("Image.seek() takes 2 positional arguments but " (args.Length + 1) " were given", -1)
        layer := Integer(args[1])
        if layer = this.frame
            return stdlib.None
        if layer < 1 || layer > this.AhkStdlibPsdLayers.Length
            throw IndexError("list index out of range", -1)
        layerInfo := this.AhkStdlibPsdLayers[layer]
        this.AhkStdlibMode := layerInfo[2]
        this.tile := layerInfo[4]
        this.frame := layer
        this.AhkStdlibMemoryPixels := AhkStdlibPillowPsdBlankRows(this.AhkStdlibMode, this.width, this.height)
        return stdlib.None
    }

    tell(args*)
    {
        if args.Length > 0
            throw TypeError("Image.tell() takes 1 positional argument but " (args.Length + 1) " were given", -1)
        return this.frame
    }
}

