class AhkStdlibPillowImAccept
{
    static Call(prefix)
    {
        bytes := AhkStdlibPillowByteSequence(prefix)
        if bytes.Length = 0
            return false
        text := AhkStdlibPillowAsciiFromBytes(bytes)
        return RegExMatch(text, "^[A-Za-z][^:]*:") ? true : false
    }
}

class AhkStdlibPillowImImage extends AhkStdlibPillowImage
{
    __New(mode, size, rawmode, source, dataOffset, frameSize, frames, info, paletteBytes := unset)
    {
        super.__New(0, mode, size[1], size[2], "IM", 1)
        this.rawmode := rawmode
        this.fp := source
        this.AhkStdlibImDataOffset := dataOffset
        this.AhkStdlibImFrameSize := frameSize
        this.AhkStdlibImFrames := frames
        this.AhkStdlibImLoadedFrame := -1
        this.frame := 0
        this.info := AhkStdlibPillowCloneMap(info)
        if IsSet(paletteBytes) {
            this.AhkStdlibPaletteMode := "RGB"
            this.AhkStdlibPalette := paletteBytes.Clone()
        }
        this.AhkStdlibMemoryPixels := AhkStdlibPillowImBlankRows(mode, size[1], size[2])
    }

    n_frames
    {
        get => this.AhkStdlibImFrames
    }

    is_animated
    {
        get => this.AhkStdlibImFrames > 1
    }

    seek(args*)
    {
        if args.Length = 0
            throw TypeError("Image.seek() missing 1 required positional argument: 'frame'", -1)
        if args.Length > 1
            throw TypeError("Image.seek() takes 2 positional arguments but " (args.Length + 1) " were given", -1)
        frame := Integer(args[1])
        if frame < 0 || frame >= this.AhkStdlibImFrames
            throw EOFError("attempt to seek outside sequence", -1)
        this.frame := frame
        this.AhkStdlibImLoadedFrame := -1
        return stdlib.None
    }

    tell(args*)
    {
        if args.Length > 0
            throw TypeError("Image.tell() takes 1 positional argument but " (args.Length + 1) " were given", -1)
        return this.frame
    }

    load()
    {
        if this.AhkStdlibImLoadedFrame = this.frame
            return stdlib.None
        this.fp.seek(this.AhkStdlibImDataOffset + this.frame * this.AhkStdlibImFrameSize)
        bytes := AhkStdlibPillowByteSequence(this.fp.read(this.AhkStdlibImFrameSize))
        AhkStdlibPillowImDecodeInto(this, bytes)
        this.AhkStdlibImLoadedFrame := this.frame
        return stdlib.None
    }

    getpixel(xy)
    {
        this.load()
        return super.getpixel(xy)
    }

    getdata(band := unset)
    {
        this.load()
        return super.getdata(band?)
    }

    copy()
    {
        this.load()
        return super.copy()
    }
}

