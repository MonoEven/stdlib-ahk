AhkStdlibPillowGimpPaletteParseByte(text)
{
    clean := Trim(text)
    if !RegExMatch(clean, "^[+-]?\d+$")
        throw ValueError("invalid literal for int() with base 10: " AhkStdlibPillowGimpGradientBytesRepr(AhkStdlibPillowAsciiBytes(clean)), -1)
    value := Integer(clean)
    if value < 0 || value > 255
