        result.Push(paletteBytes[index])
        result.Push(index + 1 <= paletteBytes.Length ? paletteBytes[index + 1] : 0)
        result.Push(index + 2 <= paletteBytes.Length ? paletteBytes[index + 2] : 0)
        index += 4
    }
    return result
}

