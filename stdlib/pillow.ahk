        "gdiplus\GdipCreateBitmapFromScan0",
        "Int", backingWidth,
        "Int", backingHeight,
        "Int", 0,
        "Int", AhkStdlibPillowPixelFormat(mode),
        "Ptr", 0,
        "Ptr*", &handle
    ), "GdipCreateBitmapFromScan0")
    return handle
}

