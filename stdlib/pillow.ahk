}

AhkStdlibPillowWebPSaveAll(image, fp, filename := "")
{
    background := Map()
    if image.HasOwnProp("encoderinfo") && image.encoderinfo.Has("background")
        background := image.encoderinfo["background"]
    else if image.info.Has("background")
        background := image.info["background"]
    else
        background := [0, 0, 0, 0]

    values := AhkStdlibPillowSequenceToArray(background)
    if values.Length != 4
        throw OSError("Background color is not an RGBA tuple clamped to (0-255): " AhkStdlibPillowWebPValueRepr(background), -1)
    for value in values {
        if !(value is Number) || value < 0 || value >= 256
            throw OSError("Background color is not an RGBA tuple clamped to (0-255): " AhkStdlibPillowWebPValueRepr(background), -1)
    }
    throw OSError("cannot write file as WebP (encoder returned None)", -1)
}

AhkStdlibPillowWebPValueRepr(value)
{
    if AhkStdlibIsNone(value)
        return "None"
    if value is String
        return "'" value "'"
    if value is Number
        return String(value)
    if IsObject(value) && HasMethod(value, "__Enum") {
        parts := []
        for item in value
            parts.Push(AhkStdlibPillowWebPValueRepr(item))
        return "(" AhkStdlibPillowJoin(parts, ", ") (parts.Length = 1 ? "," : "") ")"
    }
    return "<" Type(value) " object>"
}

