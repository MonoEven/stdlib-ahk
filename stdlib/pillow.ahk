AhkStdlibPillowImageTkKwMap(kw := unset)
{
    if !IsSet(kw) || AhkStdlibIsNone(kw)
        return Map()
    if kw is Map
        return kw
    if IsObject(kw) {
        mapped := Map()
        for key, value in kw.OwnProps()
            mapped[key] := value
