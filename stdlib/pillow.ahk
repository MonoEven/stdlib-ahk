class AhkStdlibPillowJpeg2KBoxReader
{
    __New(fp, length := -1)
    {
        this.fp := fp
        this.has_length := length >= 0
        this.length := length
        this.remaining_in_box := -1
    }

    _can_read(numBytes)
    {
        if this.has_length && this.fp.tell() + numBytes > this.length
            return false
        if this.remaining_in_box >= 0
            return numBytes <= this.remaining_in_box
        return true
    }

    _read_bytes(numBytes)
    {
        if !this._can_read(numBytes)
            throw SyntaxError("Not enough data in header", -1)
        data := AhkStdlibPillowByteSequence(this.fp.read(numBytes))
        if data.Length < numBytes
            throw OSError("Expected to read " numBytes " bytes but only got " data.Length ".", -1)
        if this.remaining_in_box > 0
            this.remaining_in_box -= numBytes
        return data
    }

    read_fields(format)
    {
        data := this._read_bytes(AhkStdlibPillowJpeg2KStructSize(format))
        return AhkStdlibPillowJpeg2KUnpack(format, data)
    }

    read_boxes()
    {
        size := this.remaining_in_box
        data := this._read_bytes(size)
        return AhkStdlibPillowJpeg2KBoxReader(stdlib.io.BytesIO(data), size)
    }

    has_next_box()
    {
        if this.has_length
            return this.fp.tell() + this.remaining_in_box < this.length
        return true
    }

    next_box_type()
    {
        if this.remaining_in_box > 0
            this.fp.seek(this.remaining_in_box, stdlib.io.SEEK_CUR)
        this.remaining_in_box := -1

        fields := this.read_fields(">I4s")
        lbox := fields[1]
        tbox := fields[2]
        hlen := 8
        if lbox = 1 {
            lbox := this.read_fields(">Q")[1]
            hlen := 16
        }
        if lbox < hlen || !this._can_read(lbox - hlen)
            throw SyntaxError("Invalid header length", -1)
        this.remaining_in_box := lbox - hlen
        return tbox
    }
}

