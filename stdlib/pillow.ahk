        yy := y - radius
        while yy <= y + radius {
            sourceY := AhkStdlibPillowClampCoordinate(yy, height)
            total += AhkStdlibPillowPixelChannel(sourceRows[sourceY + 1][sourceX + 1], mode, channelIndex)
            count += 1
            yy += 1
