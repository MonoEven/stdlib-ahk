AhkStdlibPillowFpxOpenSubimage(ole, fp, index, subimage, mode, rawmode, imageSize, jpeg, jpegKeys)
{
    stream := [
        Format("Data Object Store {:06d}", index),
        Format("Resolution {:04d}", subimage),
        "Subimage 0000 Header",
    ]
    headerFp := ole.openstream(stream)
    headerFp.read(28)
    header := AhkStdlibPillowByteSequence(headerFp.read(36))

    size := [AhkStdlibPillowFpxI32(header, 5), AhkStdlibPillowFpxI32(header, 9)]
    tileCount := AhkStdlibPillowFpxI32(header, 13)
    tileSize := [AhkStdlibPillowFpxI32(header, 17), AhkStdlibPillowFpxI32(header, 21)]
    offset := AhkStdlibPillowFpxI32(header, 29)
    length := AhkStdlibPillowFpxI32(header, 33)

    if size[1] != imageSize[1] || size[2] != imageSize[2]
        throw OSError("subimage mismatch", -1)

    headerFp.seek(28 + offset)
    descriptors := AhkStdlibPillowByteSequence(headerFp.read(tileCount * length))
    tile := []
    tilePrefix := []
    x := 0
    y := 0
    xsize := size[1]
    ysize := size[2]
    xtile := tileSize[1]
    ytile := tileSize[2]
    descriptorOffset := 1

    loop tileCount {
        if descriptorOffset > descriptors.Length
            break
        x1 := Min(xsize, x + xtile)
        y1 := Min(ysize, y + ytile)
        compression := AhkStdlibPillowFpxI32(descriptors, descriptorOffset + 8)
        dataOffset := AhkStdlibPillowFpxI32(descriptors, descriptorOffset) + 28

        if compression = 0 {
            tile.Push(["raw", [x, y, x1, y1], dataOffset, rawmode])
        } else if compression = 1 {
            fillBytes := AhkStdlibPillowArraySlice(descriptors, descriptorOffset + 12, descriptorOffset + 15)
            tile.Push(["fill", [x, y, x1, y1], dataOffset, [rawmode, fillBytes]])
        } else if compression = 2 {
            internalColorConversion := descriptorOffset + 14 <= descriptors.Length ? descriptors[descriptorOffset + 14] : 0
            jpegTable := descriptorOffset + 15 <= descriptors.Length ? descriptors[descriptorOffset + 15] : 0
            tileRawmode := rawmode
            if internalColorConversion {
                if rawmode = "RGBA" {
                    jpegmode := "YCbCrK"
                    tileRawmode := "CMYK"
                } else {
                    jpegmode := stdlib.None
                }
            } else {
                jpegmode := rawmode
            }
            tile.Push(["jpeg", [x, y, x1, y1], dataOffset, [tileRawmode, jpegmode]])
            if jpegTable && jpeg.Has(jpegTable)
                tilePrefix := jpeg[jpegTable].Clone()
        } else {
            throw OSError("unknown/invalid compression", -1)
        }

        x += xtile
        if x >= xsize {
            x := 0
            y += ytile
            if y >= ysize
                break
        }
        descriptorOffset += length
    }

    return AhkStdlibPillowFpxImage(mode, size, rawmode, ole, stream, tile, tilePrefix, jpegKeys)
}

