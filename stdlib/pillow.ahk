}

AhkStdlibPillowQoiHash(pixel)
{
    return Mod(pixel[1] * 3 + pixel[2] * 5 + pixel[3] * 7 + pixel[4] * 11, 64)
}

AhkStdlibPillowQoiPixelsEqual(left, right)
{
    return left[1] = right[1] && left[2] = right[2] && left[3] = right[3] && left[4] = right[4]
}

AhkStdlibPillowQoiDelta(left, right)
{
    result := (Integer(left) - Integer(right)) & 255
    if result >= 128
        result -= 256
    return result
}

AhkStdlibPillowQoiReadU32(bytes, offset)
{
    return ((bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]) & 0xFFFFFFFF
}

AhkStdlibPillowQoiO32(value)
{
    value := Integer(value) & 0xFFFFFFFF
    return [(value >> 24) & 0xFF, (value >> 16) & 0xFF, (value >> 8) & 0xFF, value & 0xFF]
}

AhkStdlibPillowQoiAppendBytes(target, more)
{
    for byte in more
        target.Push(AhkStdlibPillowRequireByte(byte))
    return target
}

