class AhkStdlibPillowPcfBytesPerRow
{
    __New(index)
    {
        this.index := index
    }

    Call(bits)
    {
        bits := Integer(bits)
        switch this.index {
            case 0:
                return (bits + 7) >> 3
            case 1:
                return ((bits + 15) >> 3) & ~1
            case 2:
                return ((bits + 31) >> 3) & ~3
            default:
                return ((bits + 63) >> 3) & ~7
        }
    }
}

class AhkStdlibPillowPcfFontFile extends AhkStdlibPillowFontFile
{
    AhkStdlibTypeName := "PcfFontFile"
    name := "name"

    __New(fp, charsetEncoding := "iso8859-1")
    {
        this.charset_encoding := charsetEncoding
        magic := AhkStdlibPillowPcfReadLe32(AhkStdlibPillowByteSequence(fp.read(4)), 1)
        if magic != AhkStdlibPillowPcfFontFileModule.PCF_MAGIC
            throw SyntaxError("not a PCF file", -1)

        super.__New()
        count := AhkStdlibPillowPcfReadLe32(AhkStdlibPillowByteSequence(fp.read(4)), 1)
        this.toc := Map()
        loop count {
            tableType := AhkStdlibPillowPcfReadLe32(AhkStdlibPillowByteSequence(fp.read(4)), 1)
            tableFormat := AhkStdlibPillowPcfReadLe32(AhkStdlibPillowByteSequence(fp.read(4)), 1)
            tableSize := AhkStdlibPillowPcfReadLe32(AhkStdlibPillowByteSequence(fp.read(4)), 1)
            tableOffset := AhkStdlibPillowPcfReadLe32(AhkStdlibPillowByteSequence(fp.read(4)), 1)
            this.toc[tableType] := [tableFormat, tableSize, tableOffset]
        }
        this.fp := fp

        this.info := this._load_properties()
        metrics := this._load_metrics()
        bitmaps := this._load_bitmaps(metrics)
        encoding := this._load_encoding()

        for ch, ix in encoding {
            if AhkStdlibIsNone(ix)
                continue
            metric := metrics[ix + 1]
            xsize := metric[1]
            ysize := metric[2]
            left := metric[3]
            width := metric[5]
            descent := metric[7]
            this.glyph[ch] := [
                [width, 0],
                [left, descent - ysize, xsize + left, descent],
                [0, 0, xsize, ysize],
                bitmaps[ix + 1],
            ]
        }
    }

    _getformat(tag)
    {
        table := this.toc[tag]
        this.fp.seek(table[3])
        formatValue := AhkStdlibPillowPcfReadLe32(AhkStdlibPillowByteSequence(this.fp.read(4)), 1)
        bigEndian := !!(formatValue & 4)
        return { Fp: this.fp, Format: formatValue, BigEndian: bigEndian }
    }

    _load_properties()
    {
        state := this._getformat(AhkStdlibPillowPcfFontFileModule.PCF_PROPERTIES)
        fp := state.Fp
        nprops := AhkStdlibPillowPcfReadI32(fp, state)
        records := []
        loop nprops {
            nameOffset := AhkStdlibPillowPcfReadI32(fp, state)
            isString := AhkStdlibPillowPcfReadU8(fp)
            value := AhkStdlibPillowPcfReadI32(fp, state)
            records.Push([nameOffset, isString, value])
        }
        if nprops & 3
            fp.seek(4 - (nprops & 3), 1)
        data := AhkStdlibPillowByteSequence(fp.read(AhkStdlibPillowPcfReadI32(fp, state)))
        properties := Map()
        for record in records {
            key := AhkStdlibPillowAsciiFromBytes(AhkStdlibPillowPcfSz(data, record[1]))
            value := record[2] ? AhkStdlibPillowPcfSz(data, record[3]) : record[3]
            properties[key] := value
        }
        return properties
    }

    _load_metrics()
    {
        state := this._getformat(AhkStdlibPillowPcfFontFileModule.PCF_METRICS)
        fp := state.Fp
        metrics := []
        if (state.Format & 0xFF00) = 0x100 {
            count := AhkStdlibPillowPcfReadI16(fp, state)
            loop count {
                left := AhkStdlibPillowPcfReadU8(fp) - 128
                right := AhkStdlibPillowPcfReadU8(fp) - 128
                width := AhkStdlibPillowPcfReadU8(fp) - 128
                ascent := AhkStdlibPillowPcfReadU8(fp) - 128
                descent := AhkStdlibPillowPcfReadU8(fp) - 128
                metrics.Push([right - left, ascent + descent, left, right, width, ascent, descent, 0])
            }
            return metrics
        }

        count := AhkStdlibPillowPcfReadI32(fp, state)
        loop count {
            left := AhkStdlibPillowPcfReadI16(fp, state)
            right := AhkStdlibPillowPcfReadI16(fp, state)
            width := AhkStdlibPillowPcfReadI16(fp, state)
            ascent := AhkStdlibPillowPcfReadI16(fp, state)
            descent := AhkStdlibPillowPcfReadI16(fp, state)
            attributes := AhkStdlibPillowPcfReadI16(fp, state)
            metrics.Push([right - left, ascent + descent, left, right, width, ascent, descent, attributes])
        }
        return metrics
    }

    _load_bitmaps(metrics)
    {
        state := this._getformat(AhkStdlibPillowPcfFontFileModule.PCF_BITMAPS)
        fp := state.Fp
        nbitmaps := AhkStdlibPillowPcfReadI32(fp, state)
        if nbitmaps != metrics.Length
            throw OSError("Wrong number of bitmaps", -1)

        offsets := []
        loop nbitmaps
            offsets.Push(AhkStdlibPillowPcfReadI32(fp, state))
        bitmapSizes := []
        loop 4
            bitmapSizes.Push(AhkStdlibPillowPcfReadI32(fp, state))

        bitorder := state.Format & 8
        padindex := state.Format & 3
        bitmapsize := bitmapSizes[padindex + 1]
        offsets.Push(bitmapsize)
        data := AhkStdlibPillowByteSequence(fp.read(bitmapsize))
        bitmaps := []
        loop nbitmaps {
            metric := metrics[A_Index]
            b := offsets[A_Index]
            e := offsets[A_Index + 1]
            chunk := AhkStdlibPillowArraySlice(data, b + 1, e)
            bitmaps.Push(AhkStdlibPillowPcfBitmap(metric[1], metric[2], chunk, padindex, bitorder))
        }
        return bitmaps
    }

    _load_encoding()
    {
        state := this._getformat(AhkStdlibPillowPcfFontFileModule.PCF_BDF_ENCODINGS)
        fp := state.Fp
        firstCol := AhkStdlibPillowPcfReadI16(fp, state)
        lastCol := AhkStdlibPillowPcfReadI16(fp, state)
        firstRow := AhkStdlibPillowPcfReadI16(fp, state)
        lastRow := AhkStdlibPillowPcfReadI16(fp, state)
        AhkStdlibPillowPcfReadI16(fp, state)

        nencoding := (lastCol - firstCol + 1) * (lastRow - firstRow + 1)
        encoding := []
        loop Min(256, nencoding)
            encoding.Push(stdlib.None)
        encodingOffsets := []
        loop nencoding
            encodingOffsets.Push(AhkStdlibPillowPcfReadI16(fp, state))

        i := firstCol
        while i < encoding.Length {
            try {
                lookup := AhkStdlibPillowPcfCharsetOrdinal(i, this.charset_encoding)
                encodingOffset := encodingOffsets[lookup + 1]
                if encodingOffset != 0xFFFF
                    encoding[i + 1] := encodingOffset
            } catch Error {
            }
            i += 1
        }
        return encoding
    }
}

AhkStdlibPillowPcfSz(data, offset)
{
    bytes := AhkStdlibPillowByteSequence(data)
    start := Integer(offset) + 1
    index := start
    while index <= bytes.Length {
        if bytes[index] = 0
            return AhkStdlibPillowArraySlice(bytes, start, index - 1)
        index += 1
    }
    throw ValueError("subsection not found", -1)
}

AhkStdlibPillowPcfReadU8(fp)
{
    bytes := AhkStdlibPillowByteSequence(fp.read(1))
    if bytes.Length < 1
        throw OSError("Truncated File Read", -1)
    return bytes[1]
}

AhkStdlibPillowPcfReadI16(fp, state)
{
    bytes := AhkStdlibPillowByteSequence(fp.read(2))
    if bytes.Length < 2
        throw OSError("Truncated File Read", -1)
    return state.BigEndian ? AhkStdlibPillowPcfReadBe16(bytes, 1) : AhkStdlibPillowPcfReadLe16(bytes, 1)
}

AhkStdlibPillowPcfReadI32(fp, state)
{
    bytes := AhkStdlibPillowByteSequence(fp.read(4))
    if bytes.Length < 4
        throw OSError("Truncated File Read", -1)
    return state.BigEndian ? AhkStdlibPillowPcfReadBe32(bytes, 1) : AhkStdlibPillowPcfReadLe32(bytes, 1)
}

AhkStdlibPillowPcfReadLe16(bytes, offset)
{
    if offset < 1 || offset + 1 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return bytes[offset] | (bytes[offset + 1] << 8)
}

AhkStdlibPillowPcfReadBe16(bytes, offset)
{
    if offset < 1 || offset + 1 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return (bytes[offset] << 8) | bytes[offset + 1]
}

AhkStdlibPillowPcfReadLe32(bytes, offset)
{
    if offset < 1 || offset + 3 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)
}

AhkStdlibPillowPcfReadBe32(bytes, offset)
{
    if offset < 1 || offset + 3 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return (bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]
}

AhkStdlibPillowPcfBitmap(width, height, data, padindex, bitorder)
{
    image := stdlib.pillow.Image.new("1", [width, height])
    if width = 0 || height = 0
        return image
    stride := AhkStdlibPillowPcfFontFileModule.BYTES_PER_ROW[padindex + 1](width)
    loop height {
        y := A_Index - 1
        rowStart := y * stride + 1
        loop width {
            x := A_Index - 1
            byteIndex := rowStart + (x // 8)
            byteValue := byteIndex <= data.Length ? data[byteIndex] : 0
            bit := bitorder ? 7 - Mod(x, 8) : Mod(x, 8)
            image.putpixel([x, y], ((byteValue >> bit) & 1) ? 255 : 0)
        }
    }
    return image
}

AhkStdlibPillowPcfCharsetOrdinal(byteValue, encoding)
{
    encoding := String(encoding)
    if encoding = "iso8859-1" || encoding = "latin1" || encoding = "latin-1"
        return byteValue
    if encoding = "ascii" {
        if byteValue > 127
            throw ValueError("ordinal not in range(128)", -1)
        return byteValue
    }
    return byteValue
}

AhkStdlibPillowBdfReadChar(fp)
{
    while true {
        line := fp.readline()
        if line.Length = 0
            return stdlib.None
        if AhkStdlibPillowBytesStartsWithAscii(line, "STARTCHAR")
            break
    }
    id := Trim(AhkStdlibPillowAsciiFromBytes(AhkStdlibPillowArraySlice(line, 10, line.Length)), " `t`r`n")

    props := Map()
    while true {
        line := fp.readline()
        if line.Length = 0 || AhkStdlibPillowBytesStartsWithAscii(line, "BITMAP")
            break
        split := AhkStdlibPillowBytesFindByte(line, 32)
        key := AhkStdlibPillowAsciiFromBytes(AhkStdlibPillowArraySlice(line, 1, split - 1))
        value := AhkStdlibPillowAsciiLineText(AhkStdlibPillowArraySlice(line, split + 1, line.Length))
        props[key] := value
    }

    bitmapHex := ""
    while true {
        line := fp.readline()
        if line.Length = 0 || AhkStdlibPillowBytesStartsWithAscii(line, "ENDCHAR")
            break
        bitmapHex .= AhkStdlibPillowAsciiLineText(line)
    }

    bbx := AhkStdlibPillowSplitWhitespace(props["BBX"])
    width := Integer(bbx[1])
    height := Integer(bbx[2])
    xDisp := Integer(bbx[3])
    yDisp := Integer(bbx[4])

    dwidth := AhkStdlibPillowSplitWhitespace(props["DWIDTH"])
    dwx := Integer(dwidth[1])
    dwy := Integer(dwidth[2])

    bbox := [
        [dwx, dwy],
        [xDisp, -yDisp - height, width + xDisp, -yDisp],
        [0, 0, width, height],
    ]
    image := AhkStdlibPillowBdfHexImage(width, height, bitmapHex)
    return [id, Integer(props["ENCODING"]), bbox, image]
}

AhkStdlibPillowBdfHexImage(width, height, bitmapHex)
{
    image := stdlib.pillow.Image.new("1", [width, height])
    if width = 0 || height = 0
        return image

    cleanHex := RegExReplace(bitmapHex, "\s")
    bytesPerRow := Ceil(width / 8)
    offset := 1
    loop height {
        y := A_Index - 1
        rowHex := SubStr(cleanHex, offset, bytesPerRow * 2)
        offset += bytesPerRow * 2
        loop width {
            x := A_Index - 1
            byteHex := SubStr(rowHex, Floor(x / 8) * 2 + 1, 2)
            byteValue := byteHex = "" ? 0 : AhkStdlibPillowHexByte(byteHex)
            bit := 7 - Mod(x, 8)
            image.putpixel([x, y], ((byteValue >> bit) & 1) ? 255 : 0)
        }
    }
    return image
}

AhkStdlibPillowBytesStartsWithAscii(bytes, prefix)
{
    if bytes.Length < StrLen(prefix)
        return false
    index := 1
    loop parse prefix {
        if bytes[index] != Ord(A_LoopField)
            return false
        index += 1
    }
    return true
}

AhkStdlibPillowBytesContainsAscii(bytes, needle)
{
    needleLength := StrLen(needle)
    if needleLength = 0
        return true
    if bytes.Length < needleLength
        return false
    stop := bytes.Length - needleLength + 1
    loop stop {
        start := A_Index
        matched := true
        loop parse needle {
            if bytes[start + A_Index - 1] != Ord(A_LoopField) {
                matched := false
                break
            }
        }
        if matched
            return true
    }
    return false
}

AhkStdlibPillowBytesFindByte(bytes, needle)
{
    for index, byteValue in bytes
        if byteValue = needle
            return index
    return 0
}

AhkStdlibPillowAsciiFromBytes(bytes)
{
    text := ""
    for byteValue in bytes
        text .= Chr(byteValue)
    return text
}

AhkStdlibPillowAsciiLineText(bytes)
{
    text := AhkStdlibPillowAsciiFromBytes(bytes)
    return Trim(text, "`r`n")
}

AhkStdlibPillowSplitWhitespace(text)
{
    parts := []
    for part in StrSplit(Trim(text), " ")
        if part != ""
            parts.Push(part)
    return parts
}

AhkStdlibPillowFontFilePuti16Bytes(values)
{
    bytes := []
    for value in AhkStdlibPillowSequenceToArray(values) {
        intValue := Integer(value)
        if intValue < 0
            intValue += 65536
        bytes.Push((intValue >> 8) & 0xFF)
        bytes.Push(intValue & 0xFF)
    }
    return bytes
}

AhkStdlibPillowFontMetricValues(metric)
{
    values := []
    for part in metric
        for value in part
            values.Push(value)
    return values
}

AhkStdlibPillowWriteFileBytes(path, bytes)
{
    file := FileOpen(path, "w")
    try {
        byteBuffer := Buffer(bytes.Length, 0)
        for index, byteValue in bytes
            NumPut("UChar", byteValue, byteBuffer, index - 1)
        file.RawWrite(byteBuffer, byteBuffer.Size)
    } finally {
        file.Close()
    }
    return stdlib.None
}

AhkStdlibPillowSplitExtRoot(path)
{
    root := RegExReplace(path, "\.[^.\\/:]*$")
    return root = "" ? path : root
}

class AhkStdlibPillowAvifImagePluginModule
{
    static SUPPORTED := true
    static DECODE_CODEC_CHOICE := "auto"
    static DEFAULT_MAX_THREADS := 0

    static AvifImageFile
    {
        get {
            AhkStdlibPillowAvifEnsureRegistered()
            static factory := AhkStdlibPillowAvifImageFileFactory()
            return factory
        }
    }

    static get_codec_version(codecName)
    {
        switch codecName {
            case "aom":
                return "v3.12.1"
            case "dav1d":
                return "1.5.1-0-g42b2b24"
            default:
                return stdlib.None
        }
    }

    static _accept(prefix)
    {
        bytes := AhkStdlibPillowByteSequence(prefix)
        if bytes.Length < 12
            return false
        if !(bytes[5] = 102 && bytes[6] = 116 && bytes[7] = 121 && bytes[8] = 112)
            return false
        brand := Chr(bytes[9]) Chr(bytes[10]) Chr(bytes[11]) Chr(bytes[12])
        if !(brand = "avif" || brand = "avis" || brand = "mif1" || brand = "msf1")
            return false
        if !this.SUPPORTED
            return "image file could not be identified because AVIF support not installed"
        return true
    }

    static _get_default_max_threads()
    {
        if this.DEFAULT_MAX_THREADS
            return this.DEFAULT_MAX_THREADS
        processors := EnvGet("NUMBER_OF_PROCESSORS")
        return processors != "" ? Integer(processors) : 1
    }
}

