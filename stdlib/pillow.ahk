class AhkStdlibPillowFontFile
{
    AhkStdlibTypeName := "FontFile"

    __New(args*)
    {
        if args.Length > 0
            throw TypeError("FontFile.__init__() takes 1 positional argument but " (args.Length + 1) " were given", -1)
        this.info := Map()
        this.glyph := []
        loop 256
            this.glyph.Push(stdlib.None)
        this.bitmap := stdlib.None
    }

    __Item[index]
    {
        get => this.glyph[index + 1]
    }

    compile(args*)
    {
        if args.Length > 0
            throw TypeError("compile() takes 1 positional argument but " (args.Length + 1) " were given", -1)
        if !AhkStdlibIsNone(this.bitmap)
            return stdlib.None

        h := 0
        w := 0
        maxwidth := 0
        lines := 1
        for glyph in this.glyph {
            if AhkStdlibIsNone(glyph)
                continue
            src := glyph[3]
            glyphWidth := src[3] - src[1]
            h := Max(h, src[4] - src[2])
            w += glyphWidth
            if w > AhkStdlibPillowFontFileModule.WIDTH {
                lines += 1
                w := glyphWidth
            }
            maxwidth := Max(maxwidth, w)
        }

        xsize := maxwidth
        ysize := lines * h
        if xsize = 0 && ysize = 0
            return stdlib.None

        this.ysize := h
        this.bitmap := stdlib.pillow.Image.new("1", [xsize, ysize])
        this.metrics := []
        loop 256
            this.metrics.Push(stdlib.None)

        x := 0
        y := 0
        loop 256 {
            glyph := this.glyph[A_Index]
            if AhkStdlibIsNone(glyph)
                continue
            d := glyph[1]
            dst := glyph[2]
            src := glyph[3]
            im := glyph[4]
            xx := src[3] - src[1]
            x0 := x
            y0 := y
            x += xx
            if x > AhkStdlibPillowFontFileModule.WIDTH {
                x := 0
                y += h
                x0 := x
                y0 := y
                x := xx
            }
            s := [src[1] + x0, src[2] + y0, src[3] + x0, src[4] + y0]
            if s[3] > s[1] && s[4] > s[2] {
                cropped := im.crop(src)
                try {
                    this.bitmap.paste(cropped, s)
                } finally {
                    cropped.close()
                }
            }
            this.metrics[A_Index] := [d, dst, s]
        }
        return stdlib.None
    }

    save(args*)
    {
        if args.Length < 1
            throw TypeError("save() missing 1 required positional argument: 'filename'", -1)
        if args.Length > 1
            throw TypeError("save() takes 2 positional arguments but " (args.Length + 1) " were given", -1)

        filename := String(args[1])
        this.compile()
        if AhkStdlibIsNone(this.bitmap)
            throw ValueError("No bitmap created", -1)

        root := AhkStdlibPillowSplitExtRoot(filename)
        this.bitmap.save(root ".pbm", "PNG")

        bytes := AhkStdlibPillowAsciiBytes("PILfont`n;;;;;;" this.ysize ";`nDATA`n")
        loop 256 {
            metric := this.metrics[A_Index]
            if AhkStdlibIsNone(metric) {
                loop 20
                    bytes.Push(0)
            } else {
                for byteValue in AhkStdlibPillowFontFilePuti16Bytes(AhkStdlibPillowFontMetricValues(metric))
                    bytes.Push(byteValue)
            }
        }
        AhkStdlibPillowWriteFileBytes(root ".pil", bytes)
        return stdlib.None
    }
}

