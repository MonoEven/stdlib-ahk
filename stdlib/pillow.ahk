AhkStdlibPillowImageTkLooksLikeKw(value)
{
    if value is Map
        return value.Has("file") || value.Has("data")
    return IsObject(value) && (HasProp(value, "file") || HasProp(value, "data"))
}

AhkStdlibPillowImageTkGetImageFromKw(kw)
{
    if !(kw is Map)
        kw := AhkStdlibPillowImageTkKwMap(kw)
    if kw.Has("file") {
        source := kw["file"]
        kw.Delete("file")
    } else if kw.Has("data") {
        source := stdlib.io.BytesIO(kw["data"])
        kw.Delete("data")
    } else {
        return stdlib.None
    }
    if !source
        return stdlib.None
    try {
        decoded := AhkStdlibPillowWicDecodeToBgra(source)
    } catch Error as err {
        if AhkStdlibPillowIsOpenFileLike(source)
            throw OSError("cannot identify image file " AhkStdlibPillowFileLikeRepr(source), -1)
        throw err
    }
    return AhkStdlibPillowImageFromWicDecoded(decoded)
}

