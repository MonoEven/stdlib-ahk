AhkStdlibPillowJpeg2KLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowJpeg2KAcceptPrefix(prefix)
{
    bytes := AhkStdlibPillowByteSequence(prefix)
    return AhkStdlibPillowJpeg2KStartsWith(bytes, [0xFF, 0x4F, 0xFF, 0x51])
        || AhkStdlibPillowJpeg2KStartsWith(bytes, [0, 0, 0, 12, 0x6A, 0x50, 0x20, 0x20, 13, 10, 135, 10])
}

AhkStdlibPillowJpeg2KOpen(source)
{
    if !(AhkStdlibPillowIsOpenFileLike(source))
        source := AhkStdlibPillowOpenFile(source)

    first := AhkStdlibPillowByteSequence(source.read(4))
    info := Map()
    customMimetype := stdlib.None
    if AhkStdlibPillowJpeg2KBytesEqual(first, [0xFF, 0x4F, 0xFF, 0x51]) {
        codec := "j2k"
        parsed := AhkStdlibPillowJpeg2KParseCodestream(source)
        size := parsed.Size
        mode := parsed.Mode
        AhkStdlibPillowJpeg2KParseComment(source, info)
    } else {
        rest := AhkStdlibPillowByteSequence(source.read(8))
        sig := first.Clone()
        for byte in rest
            sig.Push(byte)
        if !AhkStdlibPillowJpeg2KBytesEqual(sig, [0, 0, 0, 12, 0x6A, 0x50, 0x20, 0x20, 13, 10, 135, 10])
            throw SyntaxError("not a JPEG 2000 file", -1)
        codec := "jp2"
        header := AhkStdlibPillowJpeg2KParseJp2Header(source)
        size := header.Size
        mode := header.Mode
        customMimetype := header.CustomMimetype
        if !AhkStdlibIsNone(header.Dpi)
            info["dpi"] := header.Dpi
    }

    length := AhkStdlibPillowJpeg2KStreamLength(source)
    return AhkStdlibPillowJpeg2KImage(mode, size, codec, source, info, length, customMimetype)
}

AhkStdlibPillowJpeg2KStartsWith(bytes, prefix)
{
    if bytes.Length < prefix.Length
        return false
    loop prefix.Length
        if bytes[A_Index] != prefix[A_Index]
            return false
    return true
}

AhkStdlibPillowJpeg2KBytesEqual(left, right)
{
    if left.Length != right.Length
        return false
    loop left.Length
        if left[A_Index] != right[A_Index]
            return false
    return true
}

AhkStdlibPillowJpeg2KParseCodestream(source)
{
    hdr := AhkStdlibPillowByteSequence(source.read(2))
    lsiz := AhkStdlibPillowJpeg2KReadBe16(hdr, 1)
    rest := AhkStdlibPillowByteSequence(source.read(lsiz - 2))
    siz := hdr.Clone()
    for byte in rest
        siz.Push(byte)
    if siz.Length < 38
        throw OSError("Expected to read " lsiz " bytes but only got " siz.Length ".", -1)
    xsiz := AhkStdlibPillowJpeg2KReadBe32(siz, 5)
    ysiz := AhkStdlibPillowJpeg2KReadBe32(siz, 9)
    xosiz := AhkStdlibPillowJpeg2KReadBe32(siz, 13)
    yosiz := AhkStdlibPillowJpeg2KReadBe32(siz, 17)
    csiz := AhkStdlibPillowJpeg2KReadBe16(siz, 37)
    size := [xsiz - xosiz, ysiz - yosiz]
    if csiz = 1 {
        ssiz := siz[39]
        mode := ((ssiz & 0x7F) + 1) > 8 ? "I;16" : "L"
    } else if csiz = 2 {
        mode := "LA"
    } else if csiz = 3 {
        mode := "RGB"
    } else if csiz = 4 {
        mode := "RGBA"
    } else {
        throw SyntaxError("unable to determine J2K image mode", -1)
    }
    return { Size: size, Mode: mode }
}

AhkStdlibPillowJpeg2KParseComment(source, info)
{
    loop {
        marker := AhkStdlibPillowByteSequence(source.read(2))
        if marker.Length = 0
            break
        typ := marker.Length >= 2 ? marker[2] : 0
        if typ = 0x90 || typ = 0xD9
            break
        hdr := AhkStdlibPillowByteSequence(source.read(2))
        length := AhkStdlibPillowJpeg2KReadBe16(hdr, 1)
        if typ = 0x64 {
            data := AhkStdlibPillowByteSequence(source.read(length - 2))
            info["comment"] := AhkStdlibPillowArraySlice(data, 3, data.Length)
            break
        }
        source.seek(length - 2, stdlib.io.SEEK_CUR)
    }
    return stdlib.None
}

AhkStdlibPillowJpeg2KParseJp2Header(source)
{
    reader := AhkStdlibPillowJpeg2KBoxReader(source)
    header := unset
    customMimetype := stdlib.None
    loop {
        tbox := reader.next_box_type()
        name := AhkStdlibPillowAsciiFromBytes(tbox)
        if name = "jp2h" {
            header := reader.read_boxes()
            break
        }
        if name = "ftyp" {
            brand := reader.read_fields(">4s")[1]
            if AhkStdlibPillowAsciiFromBytes(brand) = "jpx "
                customMimetype := "image/jpx"
        }
    }
    if !IsSet(header)
        throw SyntaxError("Malformed JP2 header", -1)

    size := unset
    mode := unset
    components := 0
    dpi := stdlib.None
    while header.has_next_box() {
        tbox := header.next_box_type()
        name := AhkStdlibPillowAsciiFromBytes(tbox)
        if name = "ihdr" {
            fields := header.read_fields(">IIHB")
            height := fields[1]
            width := fields[2]
            components := fields[3]
            bpc := fields[4]
            size := [width, height]
            if components = 1 && (bpc & 0x7F) > 8
                mode := "I;16"
            else if components = 1
                mode := "L"
            else if components = 2
                mode := "LA"
            else if components = 3
                mode := "RGB"
            else if components = 4
                mode := "RGBA"
        } else if name = "colr" && components = 4 {
            fields := header.read_fields(">BBBI")
            if fields[1] = 1 && fields[4] = 12
                mode := "CMYK"
        } else if name = "res " {
            res := header.read_boxes()
            while res.has_next_box() {
                tres := res.next_box_type()
                if AhkStdlibPillowAsciiFromBytes(tres) = "resc" {
                    fields := res.read_fields(">HHHHBB")
                    hres := AhkStdlibPillowJpeg2KResToDpi(fields[3], fields[4], fields[6])
                    vres := AhkStdlibPillowJpeg2KResToDpi(fields[1], fields[2], fields[5])
                    if !AhkStdlibIsNone(hres) && !AhkStdlibIsNone(vres)
                        dpi := [hres, vres]
                    break
                }
            }
        }
    }
    if !IsSet(size) || !IsSet(mode)
        throw SyntaxError("Malformed JP2 header", -1)
    return { Size: size, Mode: mode, CustomMimetype: customMimetype, Dpi: dpi }
}

AhkStdlibPillowJpeg2KResToDpi(num, denom, exp)
{
    if denom = 0
        return stdlib.None
    return (254 * num * (10 ** exp)) / (10000 * denom)
}

