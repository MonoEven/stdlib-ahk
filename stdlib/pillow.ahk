AhkStdlibPillowPsdLayerInfo(bytes, pos, ctBytes)
{
    layers := []
    layerCount := AhkStdlibPillowPsdReadS16(bytes, pos)
    pos += 2
    if ctBytes < Abs(layerCount) * 20
        throw SyntaxError("Layer block too short for number of layers requested", -1)

    records := []
    loop Abs(layerCount) {
        y0 := AhkStdlibPillowPsdReadS32(bytes, pos)
        pos += 4
        x0 := AhkStdlibPillowPsdReadS32(bytes, pos)
        pos += 4
        y1 := AhkStdlibPillowPsdReadS32(bytes, pos)
        pos += 4
        x1 := AhkStdlibPillowPsdReadS32(bytes, pos)
        pos += 4
        channelCount := AhkStdlibPillowPsdReadU16(bytes, pos)
        pos += 2
        channelTypes := []
        if channelCount > 4 {
            pos += channelCount * 6 + 12
            extraSize := AhkStdlibPillowPsdReadU32(bytes, pos)
            pos += 4 + extraSize
            continue
        }
        loop channelCount {
            channelType := AhkStdlibPillowPsdReadU16(bytes, pos)
            pos += 2
            channelTypes.Push(channelType)
            pos += 4
        }
        mode := AhkStdlibPillowPsdModeFromChannelTypes(channelTypes)
        pos += 12
        name := ""
        extraSize := AhkStdlibPillowPsdReadU32(bytes, pos)
        pos += 4
        dataEnd := pos + extraSize
        if extraSize {
            length := AhkStdlibPillowPsdReadU32(bytes, pos)
            pos += 4
            if length
                pos += length - 16
            length := AhkStdlibPillowPsdReadU32(bytes, pos)
            pos += 4
            if length
                pos += length
            length := bytes[pos]
            pos += 1
            if length {
                name := AhkStdlibPillowAsciiFromBytes(AhkStdlibPillowArraySlice(bytes, pos, pos + length - 1))
                pos += length
            }
            pos := dataEnd
        }
        records.Push([name, mode, [x0, y0, x1, y1]])
    }

    for record in records {
        tile := []
        mode := record[2]
        loop parse mode {
            tileResult := AhkStdlibPillowPsdMakeTile(bytes, &pos, A_LoopField, record[3], 1)
            for item in tileResult[1]
                tile.Push(item)
        }
        layers.Push([record[1], mode, record[3], tile])
    }
    return layers
}

AhkStdlibPillowPsdModeFromChannelTypes(channelTypes)
{
    hasA := false, hasB := false, hasG := false, hasR := false
    for channelType in channelTypes {
        if channelType = 65535 {
            hasA := true
        } else if channelType = 0 {
            hasR := true
        } else if channelType = 1 {
            hasG := true
        } else if channelType = 2 {
            hasB := true
        }
    }
    if hasR && !hasG && !hasB && !hasA
        return "L"
    if hasR && hasG && hasB && !hasA
        return "RGB"
    if hasR && hasG && hasB && hasA
        return "RGBA"
    return ""
}

AhkStdlibPillowPsdMakeTile(bytes, &pos, mode, bbox, channels)
{
    tiles := []
    compression := AhkStdlibPillowPsdReadU16(bytes, pos)
    pos += 2
    xsize := bbox[3] - bbox[1]
    ysize := bbox[4] - bbox[2]
    offset := pos - 1
    if compression = 0 {
        loop channels {
            layer := SubStr(mode, A_Index, 1)
            if mode = "CMYK"
                layer .= ";I"
            tiles.Push(["raw", bbox.Clone(), offset, layer])
            offset += xsize * ysize
        }
    } else if compression = 1 {
        bytecount := AhkStdlibPillowArraySlice(bytes, pos, pos + channels * ysize * 2 - 1)
        pos += channels * ysize * 2
        offset := pos - 1
        i := 1
        loop channels {
            layer := SubStr(mode, A_Index, 1)
            if mode = "CMYK"
                layer .= ";I"
            tiles.Push(["packbits", bbox.Clone(), offset, layer])
            loop ysize {
                offset += AhkStdlibPillowPsdReadU16(bytecount, i)
                i += 2
            }
        }
    }
    pos := offset + 1
    if Mod(offset, 2)
        pos += 1
    return [tiles, pos]
}

AhkStdlibPillowPsdDecodeRows(bytes, width, height, mode, tile)
{
    if mode = "1"
        return AhkStdlibPillowPsdDecodePackedBitmapRows(bytes, width, height, tile)
    if mode = "L" || mode = "P"
        return AhkStdlibPillowPsdDecodeSingleRows(bytes, width, height, tile)
    return AhkStdlibPillowPsdDecodeMultiRows(bytes, width, height, mode, tile)
}

AhkStdlibPillowPsdDecodeSingleRows(bytes, width, height, tile)
{
    rows := []
    offset := tile.Length ? tile[1][3] + 1 : 1
    loop height {
        row := []
        loop width {
            index := offset + (A_Index - 1) + (A_Index ? 0 : 0)
            row.Push(index <= bytes.Length ? bytes[index] : 0)
        }
        offset += width
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowPsdDecodePackedBitmapRows(bytes, width, height, tile)
{
    rows := []
    offset := tile.Length ? tile[1][3] + 1 : 1
    rowBytes := Ceil(width / 8)
    loop height {
        row := []
        loop rowBytes {
            if offset > bytes.Length
                break
            byteValue := bytes[offset]
            offset += 1
            bitIndex := 0
            while bitIndex < 8 && row.Length < width {
                row.Push(((byteValue >> (7 - bitIndex)) & 1) ? 255 : 0)
                bitIndex += 1
            }
        }
        while row.Length < width
            row.Push(0)
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowPsdDecodeMultiRows(bytes, width, height, mode, tile)
{
    rows := []
    channels := StrLen(mode)
    total := width * height
    planes := []
    loop channels {
        plane := []
        if A_Index <= tile.Length {
            offset := tile[A_Index][3] + 1
            invert := InStr(tile[A_Index][4], ";I", true) ? true : false
            loop total {
                value := offset + A_Index - 1 <= bytes.Length ? bytes[offset + A_Index - 1] : 0
                plane.Push(invert ? 255 - value : value)
            }
        }
        planes.Push(plane)
    }
    index := 1
    loop height {
        row := []
        loop width {
            pixel := []
            loop channels {
                plane := planes[A_Index]
                pixel.Push(index <= plane.Length ? plane[index] : 0)
            }
            row.Push(pixel)
            index += 1
        }
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowPsdBlankRows(mode, width, height)
{
    rows := []
    loop height {
        row := []
        loop width
            row.Push(AhkStdlibPillowPsdBlankPixel(mode))
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowPsdBlankPixel(mode)
{
    switch mode {
        case "RGB", "LAB":
            return [0, 0, 0]
        case "RGBA", "CMYK":
            return [0, 0, 0, 0]
        default:
            return 0
    }
}

AhkStdlibPillowPsdPaletteFromColorData(colorData)
{
    palette := []
    loop 256 {
        index := A_Index
        palette.Push(colorData[index], colorData[256 + index], colorData[512 + index])
    }
    return palette
}

AhkStdlibPillowPsdReadU16(bytes, offset)
{
    return (bytes[offset] << 8) | bytes[offset + 1]
}

AhkStdlibPillowPsdReadU32(bytes, offset)
{
    return (bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]
}

AhkStdlibPillowPsdReadS16(bytes, offset)
{
    value := AhkStdlibPillowPsdReadU16(bytes, offset)
    return value >= 0x8000 ? value - 0x10000 : value
}

AhkStdlibPillowPsdReadS32(bytes, offset)
{
    value := AhkStdlibPillowPsdReadU32(bytes, offset)
    return value >= 0x80000000 ? value - 0x100000000 : value
}

