AhkStdlibPillowFloatBoxBlurSave(acc, wholeWeight, farWeight, farLeft, farRight)
{
    bulk := acc * wholeWeight + (farLeft + farRight) * farWeight
    return (bulk + (1 << 23)) >> 24
}

AhkStdlibPillowColor3DLUTCheckSize(size)
{
    if size is Array {
        if size.Length != 3
            throw ValueError("Size should be either an integer or a tuple of three integers.", -1)
        result := [Integer(size[1]), Integer(size[2]), Integer(size[3])]
    } else {
        result := [Integer(size), Integer(size), Integer(size)]
    }
    for size1d in result {
        if size1d < 2 || size1d > 65
            throw ValueError("Size should be in [2, 65] range.", -1)
    }
    return result
}

AhkStdlibPillowColor3DLUTNormalizeTable(table, size, channels)
{
    values := AhkStdlibPillowSequenceToArray(table)
    flat := []
    if values.Length && values[1] is Array {
        for pixel in values {
            if pixel.Length != channels
                throw ValueError("The elements of the table should have a length of " channels ".", -1)
            for value in pixel
                flat.Push(value)
        }
    } else {
        flat := values
    }
    expected := channels * size[1] * size[2] * size[3]
    if flat.Length != expected {
        actualItems := flat.Length
        throw ValueError(
            "The table should have either channels * size**3 float items or size**3 items of channels-sized tuples with floats. "
            "Table should be: " channels "x" size[1] "x" size[2] "x" size[3] ". "
            "Actual length: " actualItems,
            -1
        )
    }
    return flat.Clone()
}

AhkStdlibPillowColor3DLUTPixel(pixel, sourceMode, filter, targetMode)
{
    r := AhkStdlibPillowPixelChannel(pixel, sourceMode, 1) / 255
    g := AhkStdlibPillowPixelChannel(pixel, sourceMode, 2) / 255
    b := AhkStdlibPillowPixelChannel(pixel, sourceMode, 3) / 255
    values := []
    loop filter.channels
        values.Push(AhkStdlibPillowColor3DLUTSample(filter, r, g, b, A_Index))

    if targetMode = "RGB"
        return [
            AhkStdlibPillowColor3DLUTChannelToByte(values[1]),
            AhkStdlibPillowColor3DLUTChannelToByte(values[2]),
            AhkStdlibPillowColor3DLUTChannelToByte(values[3]),
        ]

    alpha := filter.channels >= 4 ? AhkStdlibPillowColor3DLUTChannelToByte(values[4])
        : (sourceMode = "RGBA" ? AhkStdlibPillowPixelChannel(pixel, sourceMode, 4) : 255)
    return [
        AhkStdlibPillowColor3DLUTChannelToByte(values[1]),
        AhkStdlibPillowColor3DLUTChannelToByte(values[2]),
        AhkStdlibPillowColor3DLUTChannelToByte(values[3]),
        alpha,
    ]
}

AhkStdlibPillowColor3DLUTSample(filter, r, g, b, channelIndex)
{
    size1 := filter.size[1]
    size2 := filter.size[2]
    size3 := filter.size[3]
    x := r * (size1 - 1)
    y := g * (size2 - 1)
    z := b * (size3 - 1)
    x0 := Floor(x)
    y0 := Floor(y)
    z0 := Floor(z)
    x1 := Min(x0 + 1, size1 - 1)
    y1 := Min(y0 + 1, size2 - 1)
    z1 := Min(z0 + 1, size3 - 1)
    fx := x - x0
    fy := y - y0
    fz := z - z0

    c000 := AhkStdlibPillowColor3DLUTValue(filter, x0, y0, z0, channelIndex)
    c100 := AhkStdlibPillowColor3DLUTValue(filter, x1, y0, z0, channelIndex)
    c010 := AhkStdlibPillowColor3DLUTValue(filter, x0, y1, z0, channelIndex)
    c110 := AhkStdlibPillowColor3DLUTValue(filter, x1, y1, z0, channelIndex)
    c001 := AhkStdlibPillowColor3DLUTValue(filter, x0, y0, z1, channelIndex)
    c101 := AhkStdlibPillowColor3DLUTValue(filter, x1, y0, z1, channelIndex)
    c011 := AhkStdlibPillowColor3DLUTValue(filter, x0, y1, z1, channelIndex)
    c111 := AhkStdlibPillowColor3DLUTValue(filter, x1, y1, z1, channelIndex)

    c00 := c000 * (1 - fx) + c100 * fx
    c10 := c010 * (1 - fx) + c110 * fx
    c01 := c001 * (1 - fx) + c101 * fx
    c11 := c011 * (1 - fx) + c111 * fx
    c0 := c00 * (1 - fy) + c10 * fy
    c1 := c01 * (1 - fy) + c11 * fy
    return c0 * (1 - fz) + c1 * fz
}

AhkStdlibPillowColor3DLUTValue(filter, x, y, z, channelIndex)
{
    index := (((z * filter.size[2] + y) * filter.size[1] + x) * filter.channels) + channelIndex
    return filter.table[index]
}

AhkStdlibPillowColor3DLUTChannelToByte(value)
{
    if value <= 0
        return 0
    if value >= 1
        return 255
    return Floor(value * 255 + 0.5)
}

