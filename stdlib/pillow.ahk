AhkStdlibPillowQoiDecodePayload(bytes, mode, width, height)
{
    rows := AhkStdlibPillowQoiDecodeRows(bytes, mode, width, height)
    raw := []
    channels := StrLen(AhkStdlibPillowChannels(mode))
    for row in rows {
        for pixel in row {
            loop channels
                raw.Push(AhkStdlibPillowPixelChannel(pixel, mode, A_Index))
