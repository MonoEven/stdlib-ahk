        return stdlib.None
    for id in formats {
        upper := StrUpper(id)
        if AhkStdlibPillowBuiltinOpenFormatIds().Has(upper) || AhkStdlibPillowRegistryMap("OPEN").Has(upper)
            continue
        throw KeyError("'" upper "'", -1)
    }
    return stdlib.None
}

AhkStdlibPillowBuiltinOpenFormatIds()
{
    static ids := Map("PNG", true, "BMP", true, "JPEG", true, "JPG", true, "TIFF", true, "TIF", true, "WEBP", true)
    return ids
}

AhkStdlibPillowImageOpenRegistered(path, formats := unset)
{
    openMap := AhkStdlibPillowRegistryMap("OPEN")
    if openMap.Count = 0
        return stdlib.None
    if !AhkStdlibPillowIsOpenFileLike(path) && !FileExist(path)
        throw OSError("No such file or directory: '" path "'", -1)

    ids := AhkStdlibPillowOpenFormatIds(formats?)
    if ids.Length = 0
        return stdlib.None

    openedInput := AhkStdlibPillowOpenInputFile(path)
    fp := openedInput.Fp
    hadRegisteredFormat := false
    try {
        fp.seek(0)
        prefix := fp.read(16)
        for id in ids {
            upper := StrUpper(id)
            if !openMap.Has(upper)
                continue
            hadRegisteredFormat := true
            entry := openMap[upper]
            accept := entry[2]
            accepted := true
            if !AhkStdlibIsNone(accept) {
                result := accept(prefix.Clone())
                accepted := !(result = false || AhkStdlibIsNone(result) || result is String)
            }
            if !accepted
                continue
            fp.seek(0)
            try {
                image := entry[1](fp, openedInput.Filename)
            } catch SyntaxError as err {
                continue
            }
            if !(IsObject(image) && image.HasOwnProp("AhkStdlibHandle"))
                throw TypeError("registered open factory must return an image", -1)
            if !image.HasOwnProp("AhkStdlibFormat") || AhkStdlibIsNone(image.AhkStdlibFormat)
                image.AhkStdlibFormat := upper
            return image
        }
    } finally {
        if openedInput.ShouldClose
            fp.close()
    }

    if IsSet(formats) && !AhkStdlibIsNone(formats) && hadRegisteredFormat
        throw OSError("cannot identify image file " AhkStdlibPillowOpenSourceRepr(path), -1)
    return stdlib.None
}

AhkStdlibPillowOpenInputFile(source)
{
