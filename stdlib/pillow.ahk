AhkStdlibPillowFitsNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowFitsLooksLikeSource(actual[1]) && AhkStdlibPillowFitsLooksLikeSource(actual[2]) {
