class AhkStdlibPillowSpiderImage extends AhkStdlibPillowImage
{
    __New(bytes, parsed)
    {
        super.__New(0, "F", parsed.Width, parsed.Height, "SPIDER", 1)
        this.AhkStdlibSpiderBytes := bytes
        this.AhkStdlibSpiderHdrLen := parsed.HdrLen
        this.AhkStdlibSpiderImgBytes := parsed.Width * parsed.Height * 4
        this.rawmode := parsed.RawMode
        this.bigendian := parsed.BigEndian
        this.istack := parsed.IStack
        this.imgnumber := parsed.ImgNumber
        this.n_frames := parsed.NFrames
        this.is_animated := parsed.NFrames > 1
        this.tile := []
        this.AhkStdlibMemoryPixels := AhkStdlibPillowSpiderReadRows(bytes, parsed.DataOffset, parsed.Width, parsed.Height, parsed.BigEndian = 0)
    }

    tell(args*)
    {
        if args.Length > 0
            throw TypeError("Image.tell() takes 1 positional argument but " args.Length + 1 " were given", -1)
        return this.imgnumber < 1 ? 0 : this.imgnumber - 1
    }

    seek(args*)
    {
        if args.Length = 0
            throw TypeError("Image.seek() missing 1 required positional argument: 'frame'", -1)
        if args.Length > 1
            throw TypeError("Image.seek() takes 2 positional arguments but " args.Length + 1 " were given", -1)
        frame := args[1]
        if this.istack = 0
            throw EOFError("attempt to seek in a non-stack file", -1)
        if !(frame is Integer) || frame < 0 || frame >= this.n_frames
            throw EOFError("attempt to seek outside sequence", -1)
        if frame = this.tell()
            return stdlib.None

        stackOffset := this.AhkStdlibSpiderHdrLen + frame * (this.AhkStdlibSpiderHdrLen + this.AhkStdlibSpiderImgBytes)
        parsed := AhkStdlibPillowSpiderParse(this.AhkStdlibSpiderBytes, stackOffset, stackOffset, this.n_frames)
        this.AhkStdlibWidth := parsed.Width
        this.AhkStdlibHeight := parsed.Height
        this.rawmode := parsed.RawMode
        this.bigendian := parsed.BigEndian
        this.istack := parsed.IStack
        this.imgnumber := parsed.ImgNumber
        this.AhkStdlibMemoryPixels := AhkStdlibPillowSpiderReadRows(this.AhkStdlibSpiderBytes, parsed.DataOffset, parsed.Width, parsed.Height, parsed.BigEndian = 0)
        return stdlib.None
    }

    load()
    {
        return stdlib.None
    }

    convert2byte(depth := 255)
    {
        extrema := this.getextrema()
        minimum := extrema[1]
        maximum := extrema[2]
        multiplier := maximum != minimum ? depth / (maximum - minimum) : 1
        offset := -multiplier * minimum
        image := AhkStdlibPillowImageNew("L", this.size, 0)
        try {
            loop this.height {
                y := A_Index - 1
                loop this.width {
                    x := A_Index - 1
                    image.putpixel([x, y], AhkStdlibPillowClampByte(this.getpixel([x, y]) * multiplier + offset))
                }
            }
        } catch Error as err {
            image.close()
            throw err
        }
        return image
    }

    tkPhotoImage()
    {
        return AhkStdlibPillowImageTkModule.PhotoImage(this.convert2byte(), { palette: 256 })
    }
}

