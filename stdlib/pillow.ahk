    loop channels
        result.Push(AhkStdlibPillowUnsharpMaskChannel(
            AhkStdlibPillowPixelChannel(sourcePixel, mode, A_Index),
            AhkStdlibPillowPixelChannel(blurredPixel, mode, A_Index),
