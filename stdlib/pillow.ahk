AhkStdlibPillowFpxOpenIndex(ole, fp, index := 1)
{
    prop := ole.getproperties([Format("Data Object Store {:06d}", index), Chr(5) "Image Contents"])
    size := [prop[0x1000002], prop[0x1000003]]
    maxSize := Max(size[1], size[2])
    i := 1
    while maxSize > 64 {
        maxSize := maxSize // 2
        i += 1
    }
    maxid := i - 1

    modeBlob := AhkStdlibPillowByteSequence(prop[0x2000002 | (maxid << 16)])
    if modeBlob.Length < 8
        throw OSError("Invalid number of bands", -1)
    bands := AhkStdlibPillowFpxI32(modeBlob, 5)
    if bands > 4
        throw OSError("Invalid number of bands", -1)

    colors := []
    loop bands
        colors.Push(AhkStdlibPillowFpxI32(modeBlob, 9 + (A_Index - 1) * 4) & 0x7FFFFFFF)
    colorKey := AhkStdlibPillowFpxTupleKey(colors)
    if !AhkStdlibPillowFpxImagePluginModule.MODES.Has(colorKey)
        throw SyntaxError(colorKey, -1)
    modePair := AhkStdlibPillowFpxImagePluginModule.MODES[colorKey]
    mode := modePair[1]
    rawmode := modePair[2]

    jpeg := Map()
    jpegKeys := []
    loop 256 {
        jpegIndex := A_Index - 1
        propId := 0x3000001 | (jpegIndex << 16)
        if prop.Has(propId) {
            jpeg[jpegIndex] := AhkStdlibPillowByteSequence(prop[propId])
            jpegKeys.Push(jpegIndex)
        }
