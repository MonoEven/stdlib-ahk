    height := AhkStdlibPillowSunU32(bytes, 9)
    depth := AhkStdlibPillowSunU32(bytes, 13)
    fileType := AhkStdlibPillowSunU32(bytes, 21)
    paletteType := AhkStdlibPillowSunU32(bytes, 25)
    paletteLength := AhkStdlibPillowSunU32(bytes, 29)
    offset := 32

