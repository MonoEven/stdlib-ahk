AhkStdlibPillowHlsToRgb(h, l, s)
{
    if s = 0 {
        value := AhkStdlibPillowColorFloatToByte(l)
        return [value, value, value]
    }
    if l <= 0.5
        m2 := l * (1.0 + s)
    else
        m2 := l + s - (l * s)
    m1 := 2.0 * l - m2
    return [
        AhkStdlibPillowColorFloatToByte(AhkStdlibPillowHueToRgb(m1, m2, h + 1.0 / 3.0)),
        AhkStdlibPillowColorFloatToByte(AhkStdlibPillowHueToRgb(m1, m2, h)),
        AhkStdlibPillowColorFloatToByte(AhkStdlibPillowHueToRgb(m1, m2, h - 1.0 / 3.0)),
    ]
}

AhkStdlibPillowHueToRgb(m1, m2, h)
{
    h := Mod(h, 1.0)
    if h < 0
        h += 1.0
    if h < 1.0 / 6.0
        return m1 + (m2 - m1) * h * 6.0
    if h < 0.5
        return m2
    if h < 2.0 / 3.0
        return m1 + (m2 - m1) * (2.0 / 3.0 - h) * 6.0
    return m1
}

AhkStdlibPillowHsvToRgb(h, s, v)
{
    if s = 0 {
        value := AhkStdlibPillowColorFloatToByte(v)
        return [value, value, value]
    }
    h := Mod(h, 1.0) * 6.0
    i := Floor(h)
    f := h - i
    p := v * (1.0 - s)
    q := v * (1.0 - s * f)
    t := v * (1.0 - s * (1.0 - f))
    switch Mod(i, 6) {
        case 0:
            return AhkStdlibPillowRgbFloatTriplet(v, t, p)
        case 1:
            return AhkStdlibPillowRgbFloatTriplet(q, v, p)
        case 2:
            return AhkStdlibPillowRgbFloatTriplet(p, v, t)
        case 3:
            return AhkStdlibPillowRgbFloatTriplet(p, q, v)
        case 4:
            return AhkStdlibPillowRgbFloatTriplet(t, p, v)
        default:
            return AhkStdlibPillowRgbFloatTriplet(v, p, q)
    }
}

AhkStdlibPillowRgbToHsv(r, g, b)
{
    maxc := Max(r, g, b)
    minc := Min(r, g, b)
    v := maxc
    if minc = maxc
        return [0.0, 0.0, v]
    s := (maxc - minc) / maxc
    rc := (maxc - r) / (maxc - minc)
    gc := (maxc - g) / (maxc - minc)
    bc := (maxc - b) / (maxc - minc)
    if r = maxc
        h := bc - gc
    else if g = maxc
        h := 2.0 + rc - bc
    else
        h := 4.0 + gc - rc
    h := Mod(h / 6.0, 1.0)
    if h < 0
        h += 1.0
    return [h, s, v]
}

AhkStdlibPillowConvertImagePixel(image, x, y, targetMode)
{
    pixel := image.getpixel([x, y])
    if image.mode = "P" && (targetMode = "RGB" || targetMode = "RGBA")
        return AhkStdlibPillowPaletteLookup(image, pixel, targetMode)
    return AhkStdlibPillowConvertColor(pixel, image.mode, targetMode)
}

