    if RegExMatch(color, "^#([a-f0-9]{6})$", &match)
        return [
            AhkStdlibPillowHexByte(SubStr(match[1], 1, 2)),
            AhkStdlibPillowHexByte(SubStr(match[1], 3, 2)),
            AhkStdlibPillowHexByte(SubStr(match[1], 5, 2)),
        ]
    if RegExMatch(color, "^#([a-f0-9]{8})$", &match)
        return [
            AhkStdlibPillowHexByte(SubStr(match[1], 1, 2)),
            AhkStdlibPillowHexByte(SubStr(match[1], 3, 2)),
            AhkStdlibPillowHexByte(SubStr(match[1], 5, 2)),
            AhkStdlibPillowHexByte(SubStr(match[1], 7, 2)),
