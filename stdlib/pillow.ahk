    } else {
        pixelFlags := AhkStdlibPillowDdsImagePluginModule.DDPF_RGB
        if mode = "RGBA"
            pixelFlags |= AhkStdlibPillowDdsImagePluginModule.DDPF_ALPHAPIXELS
        masks := mode = "RGBA" ? [0x00FF0000, 0x0000FF00, 0x000000FF, 0xFF000000] : [0x00FF0000, 0x0000FF00, 0x000000FF, 0]
    }

