{
    AhkStdlibPillowRegisterOpen("IPTC", AhkStdlibPillowIptcImageFileFactory(), AhkStdlibPillowIptcAccept)
    AhkStdlibPillowRegisterExtension("IPTC", ".iim")
    return stdlib.None
}

AhkStdlibPillowIptcCompressionMap()
{
    static compression := Map(1, "raw", 5, "jpeg")
    return compression
}

AhkStdlibPillowIptcNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowIptcLooksLikeSource(actual[1]) && AhkStdlibPillowIptcLooksLikeSource(actual[2]) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length = 1 && !AhkStdlibPillowIptcLooksLikeSource(actual[1]) {
        actual := []
    }
    return actual
}

AhkStdlibPillowIptcLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowIptcOpen(source)
{
    if !(AhkStdlibPillowIsOpenFileLike(source))
        source := AhkStdlibPillowOpenFile(source)

    info := Map()
    tag := stdlib.None
    size := 0
    offset := 0
    loop {
        offset := source.tell()
        field := AhkStdlibPillowIptcReadField(source)
        tag := field[1]
        size := field[2]
        if AhkStdlibIsNone(tag) || AhkStdlibPillowIptcKey(tag) = "8,10"
            break
        tagdata := size ? AhkStdlibPillowByteSequence(source.read(size)) : stdlib.None
        AhkStdlibPillowIptcStoreInfo(info, tag, tagdata)
    }

    layerInfo := info["3,60"]
    layers := layerInfo[1]
    component := layerInfo[2]
    id := info.Has("3,65") ? info["3,65"][1] - 1 : 0
    if layers = 1 && !component {
        mode := "L"
    } else if layers = 3 && component {
        mode := SubStr("RGB", id + 1, 1)
    } else if layers = 4 && component {
        mode := SubStr("CMYK", id + 1, 1)
    } else {
        mode := "L"
    }

    imageSize := [AhkStdlibPillowIptcInfoInt(info, "3,20"), AhkStdlibPillowIptcInfoInt(info, "3,30")]
    compressionKey := AhkStdlibPillowIptcInfoInt(info, "3,120")
    compression := AhkStdlibPillowIptcCompressionMap()
    if !compression.Has(compressionKey)
        throw OSError("Unknown IPTC image compression", -1)

    tile := []
    if !AhkStdlibIsNone(tag) && AhkStdlibPillowIptcKey(tag) = "8,10"
        tile := [["iptc", [0, 0, imageSize[1], imageSize[2]], offset, compression[compressionKey]]]
    return AhkStdlibPillowIptcImage(mode, imageSize, source, tile, info)
}

AhkStdlibPillowIptcReadField(source)
{
    s := AhkStdlibPillowByteSequence(source.read(5))
    if AhkStdlibPillowIptcBlankField(s)
        return [stdlib.None, 0]

    if s.Length < 5 || s[1] != 0x1C || !AhkStdlibPillowArrayContains([1, 2, 3, 4, 5, 6, 7, 8, 9, 240], s[2])
        throw SyntaxError("invalid IPTC/NAA file", -1)

    tag := [s[2], s[3]]
    size := s[4]
    if size > 132 {
        throw OSError("illegal field length in IPTC/NAA file", -1)
    } else if size = 128 {
        size := 0
    } else if size > 128 {
        size := AhkStdlibPillowIptcI(source.read(size - 128))
    } else {
        size := (s[4] << 8) | s[5]
    }
    return [tag, size]
}

AhkStdlibPillowIptcBlankField(bytes)
{
    if bytes.Length = 0
        return true
    for byte in bytes
        if byte != 0
            return false
    return true
}

AhkStdlibPillowIptcStoreInfo(info, tag, tagdata)
{
    key := AhkStdlibPillowIptcKey(tag)
    if info.Has(key) {
        existing := info[key]
        if existing is Array && (existing.Length = 0 || !(existing[1] is Integer)) {
            existing.Push(tagdata)
        } else {
            info[key] := [existing, tagdata]
        }
    } else {
        info[key] := tagdata
    }
    return stdlib.None
}

AhkStdlibPillowIptcInfoInt(info, key)
{
    return AhkStdlibPillowIptcI(info[key])
}

AhkStdlibPillowIptcKey(key)
{
    values := AhkStdlibPillowSequenceToArray(key)
    return values[1] "," values[2]
}

AhkStdlibPillowIptcI(c)
{
    bytes := AhkStdlibPillowByteSequence(c)
    value := 0
    start := Max(1, bytes.Length - 3)
    index := start
    while index <= bytes.Length {
        value := (value << 8) | bytes[index]
        index += 1
    }
    return value
}

AhkStdlibPillowIptcI8(c)
{
    if c is Integer
        return c
    bytes := AhkStdlibPillowByteSequence(c)
    return bytes[1]
}

AhkStdlibPillowIptcI16(c)
{
    bytes := AhkStdlibPillowByteSequence(c)
    if bytes.Length < 2
        throw ValueError("not enough values to unpack", -1)
    return (bytes[1] << 8) | bytes[2]
}

AhkStdlibPillowIptcI32(c)
{
    bytes := AhkStdlibPillowByteSequence(c)
    if bytes.Length < 4
        throw ValueError("not enough values to unpack", -1)
    return (bytes[1] << 24) | (bytes[2] << 16) | (bytes[3] << 8) | bytes[4]
}

AhkStdlibPillowIptcGetInfo(im)
{
    if im is AhkStdlibPillowIptcImage {
        info := Map()
        for key, value in im.info {
            if InStr(key, ",")
                info[key] := AhkStdlibPillowIptcCloneInfoValue(value)
        }
        return info
    }
