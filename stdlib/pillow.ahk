AhkStdlibPillowReadFileBytes(path)
{
    try {
        file := FileOpen(path, "r")
    } catch Error {
        throw OSError("No such file or directory: '" path "'", -1)
    }
    try {
        bytesBuffer := Buffer(file.Length, 0)
        readCount := file.RawRead(bytesBuffer, bytesBuffer.Size)
    } finally {
        file.Close()
    }
    return AhkStdlibPillowBufferToBytes(bytesBuffer, readCount)
}

AhkStdlibPillowParsePilFont(path, bytes)
{
    cursor := 1
    header := AhkStdlibPillowReadAsciiLine(bytes, &cursor)
    if header != "PILfont`n"
        throw OSError("Not a PILfont file", -1)

    metricsHeader := AhkStdlibPillowReadAsciiLine(bytes, &cursor)
    ysize := AhkStdlibPillowPilFontYSize(metricsHeader)

    info := []
    loop {
        line := AhkStdlibPillowReadAsciiLine(bytes, &cursor)
        if line = "" || line = "DATA`n"
            break
        info.Push(line)
    }

    needed := 256 * 20
    if bytes.Length - cursor + 1 < needed
        throw OSError("invalid PILfont file", -1)

    metrics := []
    loop 256 {
        values := []
        loop 10 {
            value := AhkStdlibPillowReadI16be(bytes, cursor)
            values.Push(value)
            cursor += 2
        }
        if AhkStdlibPillowPilFontMetricIsEmpty(values)
            metrics.Push(stdlib.None)
        else
            metrics.Push({
                AdvanceX: values[1],
                AdvanceY: values[2],
                Dst: [values[3], values[4], values[5], values[6]],
                Src: [values[7], values[8], values[9], values[10]],
            })
    }

    glyphFile := AhkStdlibPillowPilFontGlyphFile(path)
    if !FileExist(glyphFile)
        throw OSError("cannot find glyph data file " RegExReplace(path, "\.pil$") ".{gif|pbm|png}", -1)

    return { File: glyphFile, Info: info, YSize: ysize, Metrics: metrics }
}

AhkStdlibPillowReadAsciiLine(bytes, &cursor)
{
    if cursor > bytes.Length
        return ""
    chars := []
    while cursor <= bytes.Length {
        byte := bytes[cursor]
        cursor += 1
        chars.Push(Chr(byte))
        if byte = 10
            break
    }
    text := ""
    for char in chars
        text .= char
    return text
}

AhkStdlibPillowPilFontYSize(line)
{
    parts := StrSplit(Trim(line, "`r`n"), ";")
    for part in parts {
        if RegExMatch(part, "^-?\d+$")
            return Integer(part)
    }
    return 0
}

AhkStdlibPillowReadI16be(bytes, cursor)
{
    value := (bytes[cursor] << 8) | bytes[cursor + 1]
    return value >= 0x8000 ? value - 0x10000 : value
}

AhkStdlibPillowPilFontMetricIsEmpty(values)
{
    for value in values
        if value != 0
            return false
    return true
}

AhkStdlibPillowPilFontGlyphFile(path)
{
    root := RegExReplace(path, "\.[^.\\/:]*$")
    for ext in [".png", ".gif", ".pbm"] {
        candidate := root ext
        if FileExist(candidate)
            return candidate
    }
    return root ".pbm"
}

AhkStdlibPillowIsAbsolutePath(path)
{
    return RegExMatch(path, "i)^[a-z]:[\\/]") || SubStr(path, 1, 1) = "\"
}

AhkStdlibPillowIsPath(value)
{
    if value is String
        return true
    if !IsObject(value)
        return false
    return Type(value) = "AhkStdlibPathlibPath" || HasMethod(value, "__fspath")
}

