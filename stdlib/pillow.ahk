    redMask := AhkStdlibPillowDdsU32(bytes, 93)
    greenMask := AhkStdlibPillowDdsU32(bytes, 97)
    blueMask := AhkStdlibPillowDdsU32(bytes, 101)
    alphaMask := AhkStdlibPillowDdsU32(bytes, 105)
