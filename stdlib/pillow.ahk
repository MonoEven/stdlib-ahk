        copied := frame.copy()
        if IsSet(func) && !AhkStdlibIsNone(func) {
            try {
                transformed := func.Call(copied)
            } catch Error as err {
                copied.close()
                throw err
            }
            if IsObject(transformed) && HasMethod(transformed, "close") && transformed != copied
                copied.close()
            copied := transformed
        }
        frames.Push(copied)
    }
}

