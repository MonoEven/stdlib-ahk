AhkStdlibPillowGifOpen(source)
{
    bytes := AhkStdlibPillowGifSourceBytes(source)
    if !AhkStdlibPillowGifImagePluginModule._accept(bytes)
        throw SyntaxError("not a GIF file", -1)

    pos := 7
    width := AhkStdlibPillowGifReadU16(bytes, pos)
    height := AhkStdlibPillowGifReadU16(bytes, pos + 2)
    flags := AhkStdlibPillowGifByte(bytes, pos + 4)
    background := AhkStdlibPillowGifByte(bytes, pos + 5)
    pos += 7

    info := Map("version", AhkStdlibPillowArraySlice(bytes, 1, 6))
    paletteBytes := []
    if flags & 0x80 {
        info["background"] := background
        bits := (flags & 7) + 1
        paletteLength := 3 << bits
        paletteBytes := AhkStdlibPillowGifReadBytes(bytes, &pos, paletteLength)
    }

    frames := []
    frameInfo := AhkStdlibPillowCloneMap(info)
    pendingGce := stdlib.None

    loop {
        blockType := AhkStdlibPillowGifByte(bytes, pos)
        pos += 1
        if blockType = 0x3B
            break
        if blockType = 0x21 {
            label := AhkStdlibPillowGifByte(bytes, pos)
            pos += 1
            if label = 0xF9 {
                block := AhkStdlibPillowGifReadSubBlock(bytes, &pos)
                if block.Length >= 4 {
                    pendingGce := block
                    frameInfo := AhkStdlibPillowCloneMap(info)
                    if block[1] & 1
                        frameInfo["transparency"] := block[4]
                    frameInfo["duration"] := AhkStdlibPillowGifU16FromBytes(block, 2) * 10
                }
                AhkStdlibPillowGifSkipSubBlocks(bytes, &pos)
            } else if label = 0xFE {
                comment := AhkStdlibPillowGifReadSubBlocks(bytes, &pos)
                if comment.Length {
                    info["comment"] := comment
                    frameInfo["comment"] := comment
                }
            } else if label = 0xFF {
                appStart := pos
                app := AhkStdlibPillowGifReadSubBlock(bytes, &pos)
                info["extension"] := [app, pos - 1]
                frameInfo["extension"] := [app, pos - 1]
                if AhkStdlibPillowGifBytesStartWithAscii(app, "NETSCAPE2.0") {
                    loopBlock := AhkStdlibPillowGifReadSubBlock(bytes, &pos)
                    if loopBlock.Length >= 3 && loopBlock[1] = 1 {
                        info["loop"] := AhkStdlibPillowGifU16FromBytes(loopBlock, 2)
                        frameInfo["loop"] := info["loop"]
                    }
                    AhkStdlibPillowGifSkipSubBlocks(bytes, &pos)
                } else {
                    AhkStdlibPillowGifSkipSubBlocks(bytes, &pos)
                }
            } else {
                AhkStdlibPillowGifSkipSubBlocks(bytes, &pos)
            }
            continue
        }
        if blockType = 0x2C {
            imageLeft := AhkStdlibPillowGifReadU16(bytes, pos)
            imageTop := AhkStdlibPillowGifReadU16(bytes, pos + 2)
            imageWidth := AhkStdlibPillowGifReadU16(bytes, pos + 4)
            imageHeight := AhkStdlibPillowGifReadU16(bytes, pos + 6)
            descriptorFlags := AhkStdlibPillowGifByte(bytes, pos + 8)
            pos += 9
            interlace := !!(descriptorFlags & 0x40)
            if descriptorFlags & 0x80 {
                bits := (descriptorFlags & 7) + 1
                paletteBytes := AhkStdlibPillowGifReadBytes(bytes, &pos, 3 << bits)
            }
            lzwMinCodeSize := AhkStdlibPillowGifByte(bytes, pos)
            pos += 1
            tileOffset := pos - 1
            imageData := AhkStdlibPillowGifReadSubBlocks(bytes, &pos)
            if imageData.Length = 0
                throw EOFError("image not found in GIF frame", -1)
            frames.Push({
                Width: imageWidth,
                Height: imageHeight,
                Left: imageLeft,
                Top: imageTop,
                LzwMinCodeSize: lzwMinCodeSize,
                Interlace: interlace,
                TileOffset: tileOffset,
                Data: imageData,
                Info: AhkStdlibPillowCloneMap(frameInfo),
                Palette: paletteBytes.Clone(),
            })
            frameInfo := AhkStdlibPillowCloneMap(info)
            pendingGce := stdlib.None
            continue
        }
        throw SyntaxError("not a GIF file", -1)
    }

    if frames.Length = 0
        throw EOFError("image not found in GIF frame", -1)

    image := AhkStdlibPillowGifImage(width, height, frames)
    return image
}

AhkStdlibPillowGifReadBytes(bytes, &pos, count)
{
    if bytes.Length < pos + count - 1
        throw EOFError("image not found in GIF frame", -1)
    chunk := AhkStdlibPillowArraySlice(bytes, pos, pos + count - 1)
    pos += count
    return chunk
}

AhkStdlibPillowGifByte(bytes, pos)
{
    if pos < 1 || pos > bytes.Length
        throw EOFError("image not found in GIF frame", -1)
