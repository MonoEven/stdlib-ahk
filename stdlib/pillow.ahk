AhkStdlibPillowPsdOpen(source)
{
    bytes := AhkStdlibPillowPsdSourceBytes(source)
    if bytes.Length < 26 || !AhkStdlibPillowPsdAcceptPrefix(AhkStdlibPillowArraySlice(bytes, 1, Min(bytes.Length, 26))) || AhkStdlibPillowPsdReadU16(bytes, 5) != 1
        throw SyntaxError("not a PSD file", -1)

    psdChannels := AhkStdlibPillowPsdReadU16(bytes, 13)
    height := AhkStdlibPillowPsdReadU32(bytes, 15)
    width := AhkStdlibPillowPsdReadU32(bytes, 19)
    bits := AhkStdlibPillowPsdReadU16(bytes, 23)
    psdMode := AhkStdlibPillowPsdReadU16(bytes, 25)
    key := psdMode "," bits
    modes := AhkStdlibPillowPsdModesMap()
    if !modes.Has(key)
        throw SyntaxError("(" psdMode ", " bits ")", -1)
    modeInfo := modes[key]
    mode := modeInfo[1]
    channels := modeInfo[2]
    if channels > psdChannels
        throw OSError("not enough channels", -1)
    if mode = "RGB" && psdChannels = 4 {
        mode := "RGBA"
        channels := 4
    }

    pos := 27
    colorSize := AhkStdlibPillowPsdReadU32(bytes, pos)
    pos += 4
    palette := unset
    if colorSize {
        colorData := AhkStdlibPillowArraySlice(bytes, pos, pos + colorSize - 1)
        if mode = "P" && colorSize = 768
            palette := AhkStdlibPillowPsdPaletteFromColorData(colorData)
        pos += colorSize
    }

    info := Map()
    resources := []
    resourceSize := AhkStdlibPillowPsdReadU32(bytes, pos)
    pos += 4
    if resourceSize {
        endPos := pos + resourceSize
        while pos < endPos {
            pos += 4
            resourceId := AhkStdlibPillowPsdReadU16(bytes, pos)
            pos += 2
            nameLength := bytes[pos]
            pos += 1
            name := AhkStdlibPillowArraySlice(bytes, pos, pos + nameLength - 1)
            pos += nameLength
            if !Mod(name.Length, 2)
                pos += 1
            dataLength := AhkStdlibPillowPsdReadU32(bytes, pos)
            pos += 4
            data := AhkStdlibPillowArraySlice(bytes, pos, pos + dataLength - 1)
            pos += dataLength
            if Mod(dataLength, 2)
                pos += 1
            resources.Push([resourceId, name, data])
            if resourceId = 1039
                info["icc_profile"] := data
        }
    }

    layers := []
    layerMaskSize := AhkStdlibPillowPsdReadU32(bytes, pos)
    pos += 4
    if layerMaskSize {
        endPos := pos + layerMaskSize
        layerInfoSize := AhkStdlibPillowPsdReadU32(bytes, pos)
        pos += 4
        if layerInfoSize {
            layerData := AhkStdlibPillowArraySlice(bytes, pos, pos + layerInfoSize - 1)
            layers := AhkStdlibPillowPsdLayerInfo(layerData, 1, layerInfoSize)
        }
        pos := endPos
    }

    tileResult := AhkStdlibPillowPsdMakeTile(bytes, &pos, mode, [0, 0, width, height], channels)
    tile := tileResult[1]
    rows := AhkStdlibPillowPsdDecodeRows(bytes, width, height, mode, tile)
    image := AhkStdlibPillowPsdImage(mode, width, height, tile, rows, resources, layers, info, palette?)
    return image
}

