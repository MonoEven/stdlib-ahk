AhkStdlibPillowMicOpen(source)
{
    shouldClose := false
    if AhkStdlibPillowIsOpenFileLike(source) {
        fp := source
    } else {
        fp := AhkStdlibPillowOpenFile(source)
        shouldClose := true
    }

    ole := unset
    tiffImage := unset
    try {
        try {
            ole := AhkStdlibPillowMicImagePluginModule.olefile.OleFileIO(fp)
        } catch OSError as err {
            throw SyntaxError("not an MIC file; invalid OLE file", -1)
        }

        images := []
        for path in ole.listdir() {
            if AhkStdlibPillowMicIsImagePath(path)
                images.Push(path.Clone())
        }
        if images.Length = 0
            throw SyntaxError("not an MIC file; no image entries", -1)

        stream := ole.openstream(images[1])
        tiffImage := stdlib.pillow.Image.open(stream, "r", ["TIFF"])
        return AhkStdlibPillowMicImage(tiffImage, ole, fp, shouldClose, images)
    } catch Error as err {
        if IsSet(tiffImage) && IsObject(tiffImage) && HasMethod(tiffImage, "close")
            tiffImage.close()
        if IsSet(ole) && IsObject(ole) && HasMethod(ole, "close")
            ole.close()
        if shouldClose && IsObject(fp) && HasMethod(fp, "close")
            fp.close()
        throw err
    }
}

