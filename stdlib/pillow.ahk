    if !AhkStdlibPillowRegistryMap("OPEN").Has("TIFF")
        AhkStdlibPillowRegisterOpen("TIFF", AhkStdlibPillowTiffImageFileFactory(), AhkStdlibPillowTiffAccept)
    AhkStdlibPillowRegisterSave("TIFF", AhkStdlibPillowTiffSave)
    AhkStdlibPillowRegisterSaveAll("TIFF", AhkStdlibPillowTiffSave)
    AhkStdlibPillowRegisterExtensions("TIFF", [".tif", ".tiff"])
    AhkStdlibPillowRegisterMime("TIFF", "image/tiff")
