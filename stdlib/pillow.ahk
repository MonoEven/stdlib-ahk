AhkStdlibPillowModeFilterChannel(sourceRows, mode, width, height, x, y, radius, channelIndex)
{
    histogram := Map()
    yy := y - radius
    while yy <= y + radius {
        if yy >= 0 && yy < height {
            xx := x - radius
            while xx <= x + radius {
                if xx >= 0 && xx < width {
                    value := AhkStdlibPillowPixelChannel(sourceRows[yy + 1][xx + 1], mode, channelIndex)
                    histogram[value] := histogram.Has(value) ? histogram[value] + 1 : 1
                }
                xx += 1
            }
        }
        yy += 1
    }

    maxPixel := 0
    maxCount := histogram.Has(0) ? histogram[0] : 0
    value := 1
    while value < 256 {
        count := histogram.Has(value) ? histogram[value] : 0
        if count > maxCount {
            maxCount := count
            maxPixel := value
        }
        value += 1
    }
    if maxCount > 2
        return maxPixel
    return AhkStdlibPillowPixelChannel(sourceRows[y + 1][x + 1], mode, channelIndex)
}

AhkStdlibPillowClampCoordinate(value, size)
{
    if value < 0
        return 0
    if value >= size
        return size - 1
    return value
}

AhkStdlibPillowKernelPixel(sourceRows, mode, x, y, filter)
{
