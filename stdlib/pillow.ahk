AhkStdlibPillowImOpenMap()
{
    static open := unset
    if IsSet(open)
        return open
    open := Map(
        "0 1 image", ["1", "1"],
        "L 1 image", ["1", "1"],
        "Greyscale image", ["L", "L"],
        "Grayscale image", ["L", "L"],
        "RGB image", ["RGB", "RGB;L"],
        "RLB image", ["RGB", "RLB"],
        "RYB image", ["RGB", "RLB"],
        "B1 image", ["1", "1"],
        "B2 image", ["P", "P;2"],
        "B4 image", ["P", "P;4"],
        "X 24 image", ["RGB", "RGB"],
        "L 32 S image", ["I", "I;32"],
        "L 32 F image", ["F", "F;32"],
        "RGB3 image", ["RGB", "RGB;T"],
        "RYB3 image", ["RGB", "RYB;T"],
        "LA image", ["LA", "LA;L"],
        "PA image", ["LA", "PA;L"],
