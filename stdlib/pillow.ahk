AhkStdlibPillowImageQtPackBits(image)
{
    bytes := []
    bitIndex := 0
    current := 0
    for pixel in image.getdata() {
        if pixel
            current |= 1 << (7 - bitIndex)
        bitIndex += 1
        if bitIndex = 8 {
            bytes.Push(current)
            current := 0
            bitIndex := 0
        }
    }
    if bitIndex
        bytes.Push(current)
    return bytes
}

AhkStdlibPillowImageQtPixelInteger(pixel, mode, colortable)
{
    if mode = "RGBA"
        return AhkStdlibPillowImageQtRgb(pixel[1], pixel[2], pixel[3], pixel[4])
    if mode = "RGB"
        return AhkStdlibPillowImageQtRgb(pixel[1], pixel[2], pixel[3])
    if mode = "L" || mode = "I;16" {
        value := mode = "I;16" ? Floor(pixel / 256) : pixel
        return AhkStdlibPillowImageQtRgb(value, value, value)
    }
    if mode = "P" {
        index := pixel + 1
        if index >= 1 && index <= colortable.Length
            return colortable[index]
        return AhkStdlibPillowImageQtRgb(0, 0, 0)
    }
    if mode = "1"
        return pixel ? AhkStdlibPillowImageQtRgb(255, 255, 255) : AhkStdlibPillowImageQtRgb(0, 0, 0)
    return 0
}

