class AhkStdlibPillowPaletteFile
{
    AhkStdlibTypeName := "PaletteFile"
    rawmode := "RGB"

    __New(fp)
    {
        palette := []
        loop 256 {
            value := A_Index - 1
            palette.Push(value)
            palette.Push(value)
            palette.Push(value)
        }

        loop {
            line := AhkStdlibPillowByteSequence(fp.readline())
            if line.Length = 0
                break
            if line[1] = Ord("#")
                continue
            if line.Length > 100
                throw SyntaxError("bad palette file", -1)

            values := AhkStdlibPillowPaletteFileParseValues(line)
            try {
                if values.Length = 4 {
                    i := values[1], r := values[2], g := values[3], b := values[4]
                } else {
                    if values.Length < 2
                        throw ValueError("not enough values to unpack (expected 2, got " values.Length ")", -1)
                    if values.Length > 2
                        throw ValueError("too many values to unpack (expected 2)", -1)
                    i := values[1], r := values[2], g := r, b := r
                }
            } catch ValueError as err {
                throw err
            }

            if i >= 0 && i <= 255 {
                offset := i * 3 + 1
                palette[offset] := r & 0xFF
                palette[offset + 1] := g & 0xFF
                palette[offset + 2] := b & 0xFF
            }
        }
        this.palette := palette
    }

    getpalette(args*)
    {
        if args.Length > 0
            throw TypeError("PaletteFile.getpalette() takes 1 positional argument but " (args.Length + 1) " were given", -1)
        return [this.palette, this.rawmode]
    }
}

AhkStdlibPillowPaletteFileLooksLikeSource(value)
{
    return AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowPaletteFileParseValues(line)
{
    parts := AhkStdlibPillowPaletteFileSplitBytes(line)
    values := []
    for part in parts {
        clean := Trim(part)
        if !RegExMatch(clean, "^[+-]?\d+$")
            throw ValueError("invalid literal for int() with base 10: " AhkStdlibPillowGimpGradientBytesRepr(AhkStdlibPillowAsciiBytes(clean)), -1)
        values.Push(Integer(clean))
    }
    return values
}

AhkStdlibPillowPaletteFileSplitBytes(line)
{
    text := AhkStdlibPillowAsciiLineText(line)
    parts := []
    loop parse text, " `t`r`n" {
        if A_LoopField != ""
            parts.Push(A_LoopField)
    }
    return parts
}

