AhkStdlibPillowMpoValidateMpInfo(mpinfo)
{
    if !IsObject(mpinfo) || !mpinfo.Has(0xB002)
        return stdlib.None
    for entry in mpinfo[0xB002] {
        if entry.Has("Attribute") {
            attribute := entry["Attribute"]
            if Type(attribute) = "Map" && attribute.Has("ImageDataFormat") && attribute["ImageDataFormat"] != "JPEG"
                throw SyntaxError("unsupported picture format in MPO", -1)
        }
    }
    return stdlib.None
}

