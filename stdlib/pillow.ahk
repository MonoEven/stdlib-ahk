        rowStride := AhkStdlibPillowSunPackedStride(width, depth)
        image := AhkStdlibPillowSunDecodeRle(bytes, offset + 1, width, height, mode, rawmode, depth, rowStride)
    } else {
        throw SyntaxError("Unsupported Sun Raster file type", -1)
    }

    try {
        image.AhkStdlibFormat := "SUN"
        image.AhkStdlibReadonly := 1
        image.tile := tile
        if IsSet(palette)
            image.putpalette(palette)
        return image
    } catch Error as err {
        image.close()
        throw err
    }
}

AhkStdlibPillowSunDecodeRaw(bytes, dataIndex, width, height, mode, rawmode, depth, stride)
{
