AhkStdlibPillowJpegOpen(source, filename := unset, mpoFallbackToJpeg := true)
{
    bytes := AhkStdlibPillowJpegSourceBytes(source)
    metadata := AhkStdlibPillowJpegParse(bytes)
    sourceFp := AhkStdlibPillowIsOpenFileLike(source) ? source : stdlib.io.BytesIO(bytes)

    image := unset
    try {
        if !metadata.HasScanData
            throw ValueError("metadata-only JPEG stream", -1)
        decoded := AhkStdlibPillowWicDecodeToBgra(stdlib.io.BytesIO(bytes))
        image := AhkStdlibPillowImageFromWicDecoded(decoded)
    } catch Error {
        image := AhkStdlibPillowJpegImage(0, metadata.Mode, metadata.Size[1], metadata.Size[2], "JPEG", 1)
    }
    AhkStdlibPillowJpegAttachMetadata(image, metadata)
    image.AhkStdlibJpegBytes := bytes
    image.fp := sourceFp
    if IsObject(image.fp) && HasMethod(image.fp, "seek")
        image.fp.seek(0)
    if metadata.Info.Has("mp") {
        if mpoFallbackToJpeg && AhkStdlibPillowJpegHasUltraHdrApp1(metadata.AppList)
            return image
        try {
            return AhkStdlibPillowMpoAdopt(image, metadata.Info["mp"])
        } catch SyntaxError as err {
            if !mpoFallbackToJpeg
                throw err
            stdlib.warnings.warn("Image appears to be a malformed MPO file, it will be interpreted as a base JPEG file", stdlib.warnings.UserWarning, 2)
        }
    }
    return image
}

