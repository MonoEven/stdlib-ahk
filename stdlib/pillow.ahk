AhkStdlibPillowGifReadBits(data, &bitPos, codeSize)
{
    totalBits := data.Length * 8
    if bitPos + codeSize > totalBits
        return stdlib.None
    value := 0
    loop codeSize {
        absoluteBit := bitPos + A_Index - 1
        byteIndex := Floor(absoluteBit / 8) + 1
        bitIndex := Mod(absoluteBit, 8)
        if data[byteIndex] & (1 << bitIndex)
            value |= 1 << (A_Index - 1)
    }
    bitPos += codeSize
    return value
}

AhkStdlibPillowGifSaveImage(image, fp, filename)
{
    bytes := AhkStdlibPillowGifEncodeImage(image)
    fp.write(bytes)
    return stdlib.None
}

AhkStdlibPillowGifSaveAllImage(image, fp, filename)
{
