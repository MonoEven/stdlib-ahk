AhkStdlibPillowFitsLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowFitsSourceBytes(source)
{
    if AhkStdlibPillowIsOpenFileLike(source)
        return AhkStdlibPillowReadAllFileLikeBytes(source)
    fp := AhkStdlibPillowOpenFile(source)
    try {
        return AhkStdlibPillowByteSequence(fp.read())
    } finally {
        fp.close()
    }
}

AhkStdlibPillowFitsOpen(source)
{
    bytes := AhkStdlibPillowFitsSourceBytes(source)
    headers := Map()
    headerInProgress := false
    decoderName := ""
    imageMode := ""
    imageSize := unset
    offset := 0
    args := []
    pos := 1

    while true {
        if pos + 79 > bytes.Length
            throw OSError("Truncated FITS file", -1)

        header := AhkStdlibPillowFitsReadCard(bytes, pos)
        keyword := Trim(SubStr(header, 1, 8), " `t")
        if keyword = "SIMPLE" || keyword = "XTENSION" {
            headerInProgress := true
        } else if headers.Count && !headerInProgress {
            break
        } else if keyword = "END" {
            nextBlock := Ceil((pos + 79) / 2880) * 2880 + 1
            pos := nextBlock
            if decoderName = "" {
                parsed := AhkStdlibPillowFitsParseHeaders(headers)
                decoderName := parsed.DecoderName
                offset := parsed.Offset
                args := parsed.Args
                if parsed.HasProp("Mode")
                    imageMode := parsed.Mode
                if parsed.HasProp("Size")
                    imageSize := parsed.Size
            }
            headerInProgress := false
            continue
        }

        if decoderName != "" {
            pos += 80
            continue
        }

        value := AhkStdlibPillowFitsHeaderValue(header)
        if !headers.Count && (!AhkStdlibPillowFitsImagePluginModule._accept(AhkStdlibPillowAsciiBytes(keyword)) || value != "T")
            throw SyntaxError("Not a FITS file", -1)
        headers[keyword] := value
        pos += 80
    }

    if decoderName = ""
        throw ValueError("No image data", -1)

    tileOffset := offset + pos - 1
    return AhkStdlibPillowFitsImage(imageMode, imageSize, [["" decoderName, [0, 0, imageSize[1], imageSize[2]], tileOffset, args]])
}

AhkStdlibPillowFitsReadCard(bytes, pos)
{
    text := ""
    loop 80
        text .= Chr(bytes[pos + A_Index - 1])
    return text
}

AhkStdlibPillowFitsHeaderValue(header)
{
    value := SubStr(header, 9)
    slash := InStr(value, "/", true)
    if slash
        value := SubStr(value, 1, slash - 1)
    value := Trim(value, " `t")
    if SubStr(value, 1, 1) = "="
        value := Trim(SubStr(value, 2), " `t")
    return value
}

AhkStdlibPillowFitsParseHeaders(headers)
{
    prefix := ""
    decoderName := "raw"
    offset := 0
    if AhkStdlibPillowFitsHeaderGet(headers, "XTENSION", stdlib.None) = "'BINTABLE'"
        && AhkStdlibPillowFitsHeaderGet(headers, "ZIMAGE", stdlib.None) = "T"
        && AhkStdlibPillowFitsHeaderGet(headers, "ZCMPTYPE", stdlib.None) = "'GZIP_1  '" {
        noPrefixSize := AhkStdlibPillowFitsGetSize(headers, prefix)
        if AhkStdlibIsNone(noPrefixSize)
            noPrefixSize := [0, 0]
        numberOfBits := Integer(AhkStdlibPillowFitsHeaderGet(headers, "BITPIX"))
        offset := noPrefixSize[1] * noPrefixSize[2] * (numberOfBits // 8)
        prefix := "Z"
        decoderName := "fits_gzip"
    }

    size := AhkStdlibPillowFitsGetSize(headers, prefix)
    if AhkStdlibIsNone(size)
        return { DecoderName: "", Offset: 0, Args: [] }

    numberOfBits := Integer(AhkStdlibPillowFitsHeaderGet(headers, prefix "BITPIX"))
    if numberOfBits = 8
        mode := "L"
    else if numberOfBits = 16
        mode := "I;16"
    else if numberOfBits = 32
        mode := "I"
    else if numberOfBits = -32 || numberOfBits = -64
        mode := "F"
    else
        mode := ""

    if decoderName = "raw"
        args := [mode, 0, -1]
    else
        args := [numberOfBits]
    return { DecoderName: decoderName, Offset: offset, Args: args, Mode: mode, Size: size }
}

AhkStdlibPillowFitsGetSize(headers, prefix)
{
    naxis := Integer(AhkStdlibPillowFitsHeaderGet(headers, prefix "NAXIS"))
    if naxis = 0
        return stdlib.None
    if naxis = 1
        return [1, Integer(AhkStdlibPillowFitsHeaderGet(headers, prefix "NAXIS1"))]
    return [
        Integer(AhkStdlibPillowFitsHeaderGet(headers, prefix "NAXIS1")),
        Integer(AhkStdlibPillowFitsHeaderGet(headers, prefix "NAXIS2")),
    ]
}

AhkStdlibPillowFitsHeaderGet(headers, key, default := unset)
{
    if headers.Has(key)
        return headers[key]
    if IsSet(default)
        return default
    throw KeyError("'" key "'")
}

