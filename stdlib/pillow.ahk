AhkStdlibPillowConvertMemoryAwareImage(image, mode)
{
    converted := AhkStdlibPillowImageNew(mode, image.size, AhkStdlibPillowDefaultColor(mode))
    try {
        loop image.height {
            y := A_Index - 1
            loop image.width {
                x := A_Index - 1
                pixel := image.getpixel([x, y])
                if mode = "I"
                    value := Integer(pixel)
                else if mode = "F"
                    value := pixel + 0.0
                else
