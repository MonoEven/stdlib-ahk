AhkStdlibPillowJpegAttachMetadata(image, metadata)
{
    image.AhkStdlibFormat := "JPEG"
    image.AhkStdlibJpegImage := true
    image.bits := metadata.Bits
    image.layers := metadata.Layers
    image.layer := metadata.Layer
    image.quantization := metadata.Quantization
    image.app := metadata.App
    image.applist := metadata.AppList
    image.tile := [["jpeg", [0, 0, metadata.Size[1], metadata.Size[2]], 0, [metadata.Mode, ""]]]
    image.info := metadata.Info
    return image
}

AhkStdlibPillowJpegParse(bytes)
{
    if !AhkStdlibPillowJpegAcceptPrefix(bytes)
        throw SyntaxError("not a JPEG file", -1)

    info := Map()
    app := Map()
    appList := []
    quantization := Map()
    layer := []
    size := stdlib.None
    mode := stdlib.None
    bits := stdlib.None
    layers := 0
    pos := 3
    while pos <= bytes.Length {
        while pos <= bytes.Length && bytes[pos] != 0xFF
            pos += 1
        while pos <= bytes.Length && bytes[pos] = 0xFF
            pos += 1
        if pos > bytes.Length
            break

        markerCode := bytes[pos]
        marker := 0xFF00 | markerCode
        pos += 1
        if markerCode = 0xD9 || markerCode = 0xDA
            break
        if !AhkStdlibPillowJpegMarkerHasLength(markerCode)
            continue
        if pos + 1 > bytes.Length
            break
        length := AhkStdlibPillowJpegReadBe16(bytes, pos)
        if length < 2
            throw SyntaxError("broken JPEG marker", -1)
        dataStart := pos + 2
        payloadLength := length - 2
        dataEnd := dataStart + payloadLength - 1
        if dataEnd > bytes.Length
            throw OSError("Truncated File Read", -1)
        payload := AhkStdlibPillowArraySlice(bytes, dataStart, dataEnd)
        pos := dataEnd + 1

        if markerCode >= 0xE0 && markerCode <= 0xEF
            AhkStdlibPillowJpegParseApp(marker, payload, info, app, appList, dataStart)
        else if markerCode = 0xFE
            AhkStdlibPillowJpegParseComment(payload, info, app, appList)
        else if markerCode = 0xDB
            AhkStdlibPillowJpegParseDqt(payload, quantization)
        else if AhkStdlibPillowJpegIsSofMarker(markerCode) {
            sof := AhkStdlibPillowJpegParseSof(marker, payload, info)
            size := sof.Size
            mode := sof.Mode
            bits := sof.Bits
            layers := sof.Layers
            layer := sof.Layer
        }
    }

    if AhkStdlibIsNone(size)
        throw SyntaxError("cannot identify image file", -1)
    return { Size: size, Mode: mode, Bits: bits, Layers: layers, Layer: layer, Info: info, App: app, AppList: appList, Quantization: quantization, HasScanData: AhkStdlibPillowJpegHasScanData(bytes) }
}

AhkStdlibPillowJpegMarkerHasLength(markerCode)
{
    return !(markerCode = 0x01 || (markerCode >= 0xD0 && markerCode <= 0xD9))
}

AhkStdlibPillowJpegIsSofMarker(markerCode)
{
    return markerCode >= 0xC0 && markerCode <= 0xCF && markerCode != 0xC4 && markerCode != 0xC8 && markerCode != 0xCC
}

AhkStdlibPillowJpegHasScanData(bytes)
{
    pos := 3
    while pos <= bytes.Length {
        while pos <= bytes.Length && bytes[pos] != 0xFF
            pos += 1
        while pos <= bytes.Length && bytes[pos] = 0xFF
            pos += 1
        if pos > bytes.Length
            break
        markerCode := bytes[pos]
        pos += 1
        if markerCode = 0xDA {
            if pos + 1 > bytes.Length
                return false
            length := AhkStdlibPillowJpegReadBe16(bytes, pos)
            dataStart := pos + length
            return dataStart <= bytes.Length && !(dataStart + 1 <= bytes.Length && bytes[dataStart] = 0xFF && bytes[dataStart + 1] = 0xD9)
        }
        if markerCode = 0xD9
            return false
        if !AhkStdlibPillowJpegMarkerHasLength(markerCode)
            continue
        if pos + 1 > bytes.Length
            return false
        length := AhkStdlibPillowJpegReadBe16(bytes, pos)
        if length < 2
            return false
        pos += length
    }
    return false
}

AhkStdlibPillowJpegParseApp(marker, payload, info, app, appList, dataStart)
{
    appName := "APP" (marker & 15)
    app[appName] := payload
    appList.Push([appName, payload])
    if marker = 0xFFE0 && AhkStdlibPillowBytesStartsWithAscii(payload, "JFIF") {
        version := AhkStdlibPillowJpegReadBe16(payload, 6)
        info["jfif"] := version
        info["jfif_version"] := [version >> 8, version & 0xFF]
        if payload.Length >= 12 {
            unit := payload[8]
            density := [AhkStdlibPillowJpegReadBe16(payload, 9), AhkStdlibPillowJpegReadBe16(payload, 11)]
            if unit = 1
                info["dpi"] := density.Clone()
            else if unit = 2
                info["dpi"] := [density[1] * 2.54, density[2] * 2.54]
            info["jfif_unit"] := unit
            info["jfif_density"] := density
        }
    } else if marker = 0xFFE1 && AhkStdlibPillowBytesStartsWithAscii(payload, "Exif") {
        info["exif"] := payload
    } else if marker = 0xFFE2 && AhkStdlibPillowBytesStartsWithAscii(payload, "MPF") && payload.Length >= 12 && payload[4] = 0 {
        info["mp"] := AhkStdlibPillowMpoParseMpf(payload)
        info["mpoffset"] := dataStart - 1 + 4
    }
    return stdlib.None
}

AhkStdlibPillowJpegParseComment(payload, info, app, appList)
{
    info["comment"] := payload
    app["COM"] := payload
    appList.Push(["COM", payload])
    return stdlib.None
}

AhkStdlibPillowJpegParseDqt(payload, quantization)
{
    pos := 1
    zigzag := AhkStdlibPillowJpegZigzagIndex()
    while pos <= payload.Length {
        value := payload[pos]
        pos += 1
        precision := (value // 16 = 0) ? 1 : 2
        data := []
        loop 64 {
            if precision = 1 {
                if pos > payload.Length
                    throw SyntaxError("bad quantization table marker", -1)
                data.Push(payload[pos])
                pos += 1
            } else {
                if pos + 1 > payload.Length
                    throw SyntaxError("bad quantization table marker", -1)
                data.Push(AhkStdlibPillowJpegReadBe16(payload, pos))
                pos += 2
            }
        }
        table := []
        for order in zigzag
            table.Push(data[order + 1])
        quantization[value & 15] := table
    }
    return stdlib.None
}

AhkStdlibPillowJpegParseSof(marker, payload, info)
{
    if payload.Length < 6
        throw OSError("Truncated File Read", -1)
    bits := payload[1]
    if bits != 8
        throw SyntaxError("cannot handle " bits "-bit layers", -1)
    height := AhkStdlibPillowJpegReadBe16(payload, 2)
    width := AhkStdlibPillowJpegReadBe16(payload, 4)
    layers := payload[6]
    if layers = 1
        mode := "L"
    else if layers = 3
        mode := "RGB"
    else if layers = 4
        mode := "CMYK"
    else
        throw SyntaxError("cannot handle " layers "-layer images", -1)
    if marker = 0xFFC2 || marker = 0xFFC6 || marker = 0xFFCA || marker = 0xFFCE {
        info["progressive"] := 1
        info["progression"] := 1
    }
    layer := []
    pos := 7
    loop layers {
        if pos + 2 > payload.Length
            throw OSError("Truncated File Read", -1)
        sampling := payload[pos + 1]
        layer.Push([payload[pos], sampling // 16, sampling & 15, payload[pos + 2]])
        pos += 3
    }
    return { Size: [width, height], Mode: mode, Bits: bits, Layers: layers, Layer: layer }
}

AhkStdlibPillowJpegReadBe16(bytes, offset)
{
    if offset < 1 || offset + 1 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return (bytes[offset] << 8) | bytes[offset + 1]
}

AhkStdlibPillowJpegReadBe32(bytes, offset)
{
    if offset < 1 || offset + 3 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return (bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]
}

AhkStdlibPillowJpegI16(c, offset := 0)
{
    bytes := AhkStdlibPillowByteSequence(c)
    return AhkStdlibPillowJpegReadBe16(bytes, Integer(offset) + 1)
}

AhkStdlibPillowJpegI32(c, offset := 0)
{
    bytes := AhkStdlibPillowByteSequence(c)
    return AhkStdlibPillowJpegReadBe32(bytes, Integer(offset) + 1)
}

AhkStdlibPillowJpegO8(i)
{
    return [Integer(i) & 0xFF]
}

AhkStdlibPillowJpegO16(i)
{
    value := Integer(i)
    return [(value >> 8) & 0xFF, value & 0xFF]
}

