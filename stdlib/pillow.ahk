    secondValues := AhkStdlibPillowSequenceToArray(second)
    total := 0
    loop secondValues.Length {
        a := firstValues[A_Index]
        b := secondValues[A_Index]
        if a is String
            throw TypeError("unsupported operand type(s) for -: 'str' and 'int'", -1)
