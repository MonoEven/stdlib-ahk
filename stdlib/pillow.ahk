            return 0
    }
    iform := Integer(header[5])
    if !AhkStdlibPillowArrayContains(AhkStdlibPillowSpiderImagePluginModule.iforms, iform)
        return 0
    labrec := Integer(header[13])
    labbyt := Integer(header[22])
    lenbyt := Integer(header[23])
    if labbyt != labrec * lenbyt
        return 0
    return labbyt
}

AhkStdlibPillowSpiderIsImage(filename)
{
    bytes := AhkStdlibPillowReadFileBytes(filename)
    if bytes.Length < 92
        throw Error("unpack requires a buffer of 92 bytes", -1)
    values := AhkStdlibPillowSpiderReadHeaderFloats(bytes, 1, false, 23)
    hdrLen := AhkStdlibPillowSpiderIsHeader(values)
    if hdrLen = 0 {
        values := AhkStdlibPillowSpiderReadHeaderFloats(bytes, 1, true, 23)
        hdrLen := AhkStdlibPillowSpiderIsHeader(values)
    }
    return hdrLen
}

AhkStdlibPillowSpiderMakeHeader(image)
{
    width := image.width
    height := image.height
    lenbyt := width * 4
    labrec := 1024 // lenbyt
    if Mod(1024, lenbyt) != 0
        labrec += 1
    labbyt := labrec * lenbyt
    nvalues := labbyt // 4
    if nvalues < 23
        return []

    values := []
    loop nvalues
        values.Push(0.0)
    values[1] := 1.0
    values[2] := height + 0.0
    values[3] := height + 0.0
    values[5] := 1.0
    values[12] := width + 0.0
    values[13] := labrec + 0.0
    values[22] := labbyt + 0.0
    values[23] := lenbyt + 0.0

    parts := []
    for value in values
        parts.Push(AhkStdlibPillowSpiderFloat32Bytes(value, true))
    return parts
}

AhkStdlibPillowSpiderSaveImage(image, fp, filename)
{
    source := image.mode = "F" ? image : image.convert("F")
    closeSource := source != image
    try {
        header := AhkStdlibPillowSpiderMakeHeader(source)
        if header.Length < 256
            throw OSError("Error creating Spider header", -1)
        bytes := []
        for part in header
            for byte in part
                bytes.Push(byte)
        loop source.height {
            y := A_Index - 1
            loop source.width {
                for byte in AhkStdlibPillowSpiderFloat32Bytes(source.getpixel([A_Index - 1, y]), true)
                    bytes.Push(byte)
            }
        }
        fp.write(bytes)
    } finally {
        if closeSource
            source.close()
    }
    return stdlib.None
}

