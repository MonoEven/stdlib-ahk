    rawmode := AhkStdlibPillowTgaModesMap().Has(key) ? AhkStdlibPillowTgaModesMap()[key] : mode
    if compressed {
        tile := [["tga_rle", [0, 0, width, height], offset, [rawmode, orientation, depth]]]
        image := AhkStdlibPillowTgaDecodeRle(bytes, offset + 1, width, height, mode, rawmode, depth, orientation, flipHorizontally)
    } else {
        tile := [["raw", [0, 0, width, height], offset, [rawmode, 0, orientation]]]
        image := AhkStdlibPillowTgaDecodeRaw(bytes, offset + 1, width, height, mode, rawmode, depth, orientation, flipHorizontally)
    }

    try {
        image.AhkStdlibFormat := "TGA"
        image.AhkStdlibReadonly := 1
        image.info := info
        image.tile := tile
        if IsSet(palette)
            image.putpalette(palette)
        return image
    } catch Error as err {
        image.close()
        throw err
    }
}

AhkStdlibPillowTgaDecodeRaw(bytes, dataIndex, width, height, mode, rawmode, depth, orientation, flipHorizontally)
{
    image := AhkStdlibPillowImageNew(mode, [width, height], AhkStdlibPillowDefaultColor(mode))
    unit := AhkStdlibPillowTgaPixelUnit(depth)
    try {
        if depth = 1 {
            stride := (width + 7) // 8
            loop height {
                fileY := A_Index - 1
                y := orientation = -1 ? height - 1 - fileY : fileY
                loop width {
                    fileX := A_Index - 1
                    x := flipHorizontally ? width - 1 - fileX : fileX
                    byte := AhkStdlibPillowTgaByteAt(bytes, dataIndex + fileY * stride + (fileX // 8))
                    bit := 7 - Mod(fileX, 8)
                    image.putpixel([x, y], ((byte >> bit) & 1) ? 255 : 0)
                }
            }
            return image
        }
        index := dataIndex
        loop height {
            fileY := A_Index - 1
            y := orientation = -1 ? height - 1 - fileY : fileY
            loop width {
                fileX := A_Index - 1
                x := flipHorizontally ? width - 1 - fileX : fileX
                pixel := AhkStdlibPillowTgaReadPixel(bytes, index, mode, rawmode, depth)
                image.putpixel([x, y], pixel)
                index += unit
            }
        }
        return image
    } catch Error as err {
        image.close()
        throw err
    }
}

AhkStdlibPillowTgaDecodeRle(bytes, dataIndex, width, height, mode, rawmode, depth, orientation, flipHorizontally)
{
    image := AhkStdlibPillowImageNew(mode, [width, height], AhkStdlibPillowDefaultColor(mode))
    unit := AhkStdlibPillowTgaPixelUnit(depth)
    index := dataIndex
    written := 0
    total := width * height
    try {
        while written < total {
            control := AhkStdlibPillowTgaByteAt(bytes, index)
            index += 1
            count := (control & 0x7F) + 1
            if control & 0x80 {
                pixel := AhkStdlibPillowTgaReadPixel(bytes, index, mode, rawmode, depth)
                index += unit
                loop count {
                    AhkStdlibPillowTgaPutLinearPixel(image, written, width, height, orientation, flipHorizontally, pixel)
                    written += 1
                    if written >= total
                        break
                }
            } else {
                loop count {
                    pixel := AhkStdlibPillowTgaReadPixel(bytes, index, mode, rawmode, depth)
                    index += unit
                    AhkStdlibPillowTgaPutLinearPixel(image, written, width, height, orientation, flipHorizontally, pixel)
                    written += 1
                    if written >= total
                        break
                }
            }
        }
        return image
    } catch Error as err {
        image.close()
        throw err
    }
}

AhkStdlibPillowTgaPutLinearPixel(image, position, width, height, orientation, flipHorizontally, pixel)
{
    fileY := position // width
    fileX := Mod(position, width)
    y := orientation = -1 ? height - 1 - fileY : fileY
    x := flipHorizontally ? width - 1 - fileX : fileX
    image.putpixel([x, y], pixel)
    return stdlib.None
}

AhkStdlibPillowTgaReadPixel(bytes, index, mode, rawmode, depth)
{
    if rawmode = "1" {
        byte := AhkStdlibPillowTgaByteAt(bytes, index)
        return byte & 0x80 ? 255 : 0
    }
    if rawmode = "L" || rawmode = "P"
        return AhkStdlibPillowTgaByteAt(bytes, index)
    if rawmode = "LA"
        return [AhkStdlibPillowTgaByteAt(bytes, index), AhkStdlibPillowTgaByteAt(bytes, index + 1)]
    if rawmode = "BGR"
        return [AhkStdlibPillowTgaByteAt(bytes, index + 2), AhkStdlibPillowTgaByteAt(bytes, index + 1), AhkStdlibPillowTgaByteAt(bytes, index)]
    if rawmode = "BGRA"
        return [AhkStdlibPillowTgaByteAt(bytes, index + 2), AhkStdlibPillowTgaByteAt(bytes, index + 1), AhkStdlibPillowTgaByteAt(bytes, index), AhkStdlibPillowTgaByteAt(bytes, index + 3)]
    if rawmode = "BGRA;15Z"
        return AhkStdlibPillowTgaReadBgra15(bytes, index)
    return AhkStdlibPillowDefaultColor(mode)
}

AhkStdlibPillowTgaReadBgra15(bytes, index)
{
    value := AhkStdlibPillowTgaU16(bytes, index)
    b := Round((value & 0x1F) * 255 / 31)
    g := Round(((value >> 5) & 0x1F) * 255 / 31)
    r := Round(((value >> 10) & 0x1F) * 255 / 31)
    a := (value & 0x8000) ? 255 : 0
    return [r, g, b, a]
}

AhkStdlibPillowTgaPixelUnit(depth)
{
    if depth = 1 || depth = 8
        return 1
    if depth = 16
        return 2
    if depth = 24
        return 3
    return 4
}

AhkStdlibPillowTgaPaletteBgr(start, bytes, unit)
{
    palette := []
    loop start {
        palette.Push(0, 0, 0)
    }
    index := 1
    while index <= bytes.Length {
        b := AhkStdlibPillowTgaByteAt(bytes, index)
        g := AhkStdlibPillowTgaByteAt(bytes, index + 1)
        r := AhkStdlibPillowTgaByteAt(bytes, index + 2)
        palette.Push(r, g, b)
        index += unit
    }
    return palette
}

AhkStdlibPillowTgaPaletteBgra15(start, bytes)
{
    palette := []
    loop start {
        palette.Push(0, 0, 0)
    }
    index := 1
    while index <= bytes.Length {
        color := AhkStdlibPillowTgaReadBgra15(bytes, index)
        palette.Push(color[1], color[2], color[3])
        index += 2
    }
    return palette
}

AhkStdlibPillowTgaSaveImage(image, fp, filename)
{
    saveMap := AhkStdlibPillowTgaSaveMap()
    if !saveMap.Has(image.mode)
        throw OSError("cannot write mode " image.mode " as TGA", -1)

    spec := saveMap[image.mode]
    rawmode := spec[1]
    bits := spec[2]
    colormapType := spec[3]
    imageType := spec[4]
    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    rle := false
    if info.Has("rle") {
        rle := !!info["rle"]
    } else {
        compression := info.Has("compression") ? info["compression"] : (image.info.Has("compression") ? image.info["compression"] : stdlib.None)
        rle := compression = "tga_rle"
    }
    if rle
        imageType += 8

    idSection := AhkStdlibPillowTgaIdSection(info.Has("id_section") ? info["id_section"] : (image.info.Has("id_section") ? image.info["id_section"] : ""))
    if idSection.Length > 255
        idSection := AhkStdlibPillowArraySlice(idSection, 1, 255)

    palette := []
    colormapLength := 0
    colormapEntry := 0
    if colormapType {
        palette := AhkStdlibPillowTgaSavePalette(image)
        colormapLength := palette.Length // 3
        colormapEntry := 24
    }

    flags := (image.mode = "LA" || image.mode = "RGBA") ? 8 : 0
    orientation := info.Has("orientation") ? info["orientation"] : (image.info.Has("orientation") ? image.info["orientation"] : -1)
    if orientation > 0
        flags |= 0x20

    header := []
    header.Push(idSection.Length, colormapType, imageType)
    AhkStdlibPillowTgaPushU16(header, 0)
    AhkStdlibPillowTgaPushU16(header, colormapLength)
    header.Push(colormapEntry)
    AhkStdlibPillowTgaPushU16(header, 0)
    AhkStdlibPillowTgaPushU16(header, 0)
    AhkStdlibPillowTgaPushU16(header, image.width)
    AhkStdlibPillowTgaPushU16(header, image.height)
    header.Push(bits, flags)
    fp.write(header)
    if idSection.Length
        fp.write(idSection)
    if palette.Length
        fp.write(palette)

    if rle
        data := AhkStdlibPillowTgaEncodeRle(image, rawmode, bits, orientation)
    else
        data := AhkStdlibPillowTgaEncodeRaw(image, rawmode, bits, orientation)
    fp.write(data)
    fp.write(AhkStdlibPillowTgaFooter())
    return stdlib.None
}

AhkStdlibPillowTgaEncodeRaw(image, rawmode, bits, orientation)
{
    data := []
    rows := AhkStdlibPillowTgaFileRows(image.height, orientation)
    for y in rows {
        if rawmode = "1" {
            byte := 0
            bit := 7
            loop image.width {
                pixel := image.getpixel([A_Index - 1, y])
                if pixel
                    byte |= 1 << bit
                bit -= 1
                if bit < 0 {
                    data.Push(byte)
                    byte := 0
                    bit := 7
                }
            }
            if bit != 7
                data.Push(byte)
        } else {
            loop image.width {
                for byte in AhkStdlibPillowTgaEncodePixel(image.getpixel([A_Index - 1, y]), rawmode)
                    data.Push(byte)
            }
        }
    }
    return data
}

AhkStdlibPillowTgaEncodeRle(image, rawmode, bits, orientation)
{
    units := []
    rows := AhkStdlibPillowTgaFileRows(image.height, orientation)
    for y in rows {
        loop image.width
            units.Push(AhkStdlibPillowTgaEncodePixel(image.getpixel([A_Index - 1, y]), rawmode))
    }
    data := []
    index := 1
    while index <= units.Length {
        run := 1
        while index + run <= units.Length && run < 128 && AhkStdlibPillowArrayEquals(units[index], units[index + run])
            run += 1
        if run >= 2 {
            data.Push(0x80 | (run - 1))
            for byte in units[index]
                data.Push(byte)
            index += run
            continue
        }
        rawStart := index
        index += 1
        while index <= units.Length && (index - rawStart) < 128 {
            nextRun := 1
            while index + nextRun <= units.Length && nextRun < 128 && AhkStdlibPillowArrayEquals(units[index], units[index + nextRun])
                nextRun += 1
            if nextRun >= 2
                break
            index += 1
        }
        count := index - rawStart
        data.Push(count - 1)
        loop count {
            for byte in units[rawStart + A_Index - 1]
                data.Push(byte)
        }
    }
    return data
}

AhkStdlibPillowTgaEncodePixel(pixel, rawmode)
{
    if rawmode = "L" || rawmode = "P"
        return [AhkStdlibPillowRequireByte(pixel)]
    if rawmode = "LA" {
        values := AhkStdlibPillowSequenceToArray(pixel)
        return [AhkStdlibPillowRequireByte(values[1]), AhkStdlibPillowRequireByte(values[2])]
    }
    if rawmode = "BGR" {
        values := AhkStdlibPillowSequenceToArray(pixel)
        return [AhkStdlibPillowRequireByte(values[3]), AhkStdlibPillowRequireByte(values[2]), AhkStdlibPillowRequireByte(values[1])]
    }
    if rawmode = "BGRA" {
        values := AhkStdlibPillowSequenceToArray(pixel)
        return [AhkStdlibPillowRequireByte(values[3]), AhkStdlibPillowRequireByte(values[2]), AhkStdlibPillowRequireByte(values[1]), AhkStdlibPillowRequireByte(values[4])]
    }
    if rawmode = "1"
        return [pixel ? 0x80 : 0]
    return [0]
}

AhkStdlibPillowTgaFileRows(height, orientation)
{
    rows := []
    if orientation > 0 {
        loop height
            rows.Push(A_Index - 1)
    } else {
        y := height - 1
        while y >= 0 {
            rows.Push(y)
            y -= 1
        }
    }
    return rows
}

AhkStdlibPillowTgaSavePalette(image)
{
    rgb := image.getpalette("RGB")
    bgr := []
    index := 1
    while index <= rgb.Length {
        r := AhkStdlibPillowTgaByteAt(rgb, index)
        g := AhkStdlibPillowTgaByteAt(rgb, index + 1)
        b := AhkStdlibPillowTgaByteAt(rgb, index + 2)
        bgr.Push(b, g, r)
        index += 3
    }
    return bgr
}

AhkStdlibPillowTgaIdSection(value)
{
    if value is String
        return AhkStdlibPillowAsciiBytes(value)
    return AhkStdlibPillowByteSequence(value)
}

AhkStdlibPillowTgaFooter()
{
    footer := []
    loop 8
        footer.Push(0)
    for byte in AhkStdlibPillowAsciiBytes("TRUEVISION-XFILE.")
        footer.Push(byte)
    footer.Push(0)
    return footer
}

AhkStdlibPillowTgaU16(bytes, offset)
{
    if bytes.Length < offset + 1
        return 0
    return bytes[offset] | (bytes[offset + 1] << 8)
}

AhkStdlibPillowTgaPushU16(bytes, value)
{
    value := Integer(value)
    bytes.Push(value & 0xFF, (value >> 8) & 0xFF)
    return stdlib.None
}

AhkStdlibPillowTgaByteAt(bytes, index)
{
    return index >= 1 && index <= bytes.Length ? bytes[index] : 0
}

