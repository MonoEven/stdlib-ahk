AhkStdlibPillowCreateIStreamFromBytes(bytes)
{
    size := bytes.Length
    flags := 0x0002 | 0x0040 ; GMEM_MOVEABLE | GMEM_ZEROINIT
    hglobal := DllCall("kernel32\GlobalAlloc", "UInt", flags, "UPtr", Max(size, 1), "Ptr")
    if !hglobal
