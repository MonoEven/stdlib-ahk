    bytecount := bitcount // 8
    channelCount := mode = "RGBA" ? 4 : 3
    try {
        index := dataOffset
        loop height {
            y := A_Index - 1
            loop width {
                x := A_Index - 1
                AhkStdlibPillowDdsRequireLength(bytes, index + bytecount - 1)
                value := 0
                loop bytecount
                    value |= bytes[index + A_Index - 1] << (8 * (A_Index - 1))
                channels := []
                loop channelCount
                    channels.Push(AhkStdlibPillowDdsMaskChannel(value, masks[A_Index]))
                image.putpixel([x, y], channels)
                index += bytecount
            }
        }
    } catch Error as err {
        image.close()
        throw err
    }
    return image
}

AhkStdlibPillowDdsMaskChannel(value, mask)
{
    if !mask
        return 0
    offset := 0
    while ((mask >> (offset + 1)) << (offset + 1)) = mask
        offset += 1
    total := mask >> offset
    if !total
        return 0
    return Floor((((value & mask) >> offset) / total) * 255)
}

AhkStdlibPillowDdsSaveImage(image, fp)
