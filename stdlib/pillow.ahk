class AhkStdlibPillowBdfFontFile extends AhkStdlibPillowFontFile
{
    AhkStdlibTypeName := "BdfFontFile"

    __New(fp)
    {
        super.__New()
        line := fp.readline()
        if !AhkStdlibPillowBytesStartsWithAscii(line, "STARTFONT 2.1")
            throw SyntaxError("not a valid BDF file", -1)

        while true {
            line := fp.readline()
            if line.Length = 0 || AhkStdlibPillowBytesStartsWithAscii(line, "ENDPROPERTIES")
                break
        }

        while true {
            charRecord := AhkStdlibPillowBdfReadChar(fp)
            if AhkStdlibIsNone(charRecord)
                break
            code := charRecord[2]
            if code >= 0 && code < this.glyph.Length
                this.glyph[code + 1] := [charRecord[3][1], charRecord[3][2], charRecord[3][3], charRecord[4]]
        }
    }
}

