}

AhkStdlibPillowGifReadU16(bytes, pos)
{
    return AhkStdlibPillowGifByte(bytes, pos) | (AhkStdlibPillowGifByte(bytes, pos + 1) << 8)
}

AhkStdlibPillowGifU16FromBytes(bytes, pos)
{
    if bytes.Length < pos + 1
        return 0
    return bytes[pos] | (bytes[pos + 1] << 8)
}

AhkStdlibPillowGifReadSubBlock(bytes, &pos)
{
    size := AhkStdlibPillowGifByte(bytes, pos)
    pos += 1
    if size = 0
        return []
    return AhkStdlibPillowGifReadBytes(bytes, &pos, size)
}

AhkStdlibPillowGifReadSubBlocks(bytes, &pos)
{
    result := []
    loop {
        block := AhkStdlibPillowGifReadSubBlock(bytes, &pos)
        if block.Length = 0
            break
        for byte in block
            result.Push(byte)
    }
    return result
}

AhkStdlibPillowGifSkipSubBlocks(bytes, &pos)
{
    loop {
        size := AhkStdlibPillowGifByte(bytes, pos)
        pos += 1
        if size = 0
            break
        pos += size
    }
    return stdlib.None
}

AhkStdlibPillowGifBytesStartWithAscii(bytes, text)
{
    prefix := AhkStdlibPillowAsciiBytes(text)
    if bytes.Length < prefix.Length
        return false
    loop prefix.Length
        if bytes[A_Index] != prefix[A_Index]
            return false
    return true
}

class AhkStdlibPillowGifImage extends AhkStdlibPillowImage
{
    __New(screenWidth, screenHeight, frames)
    {
        handle := AhkStdlibPillowCreateBitmap(screenWidth, screenHeight, "P")
        super.__New(handle, "P", screenWidth, screenHeight, "GIF", 1)
        this.AhkStdlibGifFrames := frames
        this.AhkStdlibGifFrame := 0
        this.n_frames := frames.Length
        this.is_animated := frames.Length > 1
        this.AhkStdlibGifApplyFrame(0)
    }

    load()
    {
        if this.HasOwnProp("AhkStdlibGifData") && this.tile.Length {
            pixels := AhkStdlibPillowGifDecodeLzw(this.AhkStdlibGifData, this.AhkStdlibGifLzwMinCodeSize, this.AhkStdlibGifImageWidth * this.AhkStdlibGifImageHeight)
            index := 1
            loop this.AhkStdlibGifImageHeight {
                y := this.AhkStdlibGifTop + A_Index - 1
                loop this.AhkStdlibGifImageWidth {
                    x := this.AhkStdlibGifLeft + A_Index - 1
                    if index <= pixels.Length {
                        pixel := pixels[index]
                        if this.AhkStdlibMode = "RGB"
                            pixel := AhkStdlibPillowGifPaletteRgb(this.AhkStdlibPalette, pixel)
                        this.putpixel([x, y], pixel)
                    }
                    index += 1
                }
            }
            this.tile := []
        }
        return stdlib.None
    }

    seek(args*)
    {
        if args.Length = 0
            throw TypeError("Image.seek() missing 1 required positional argument: 'frame'", -1)
        if args.Length > 1
            throw TypeError("Image.seek() takes 2 positional arguments but " args.Length + 1 " were given", -1)
        frame := Integer(args[1])
        if frame < 0 || frame >= this.n_frames
            throw EOFError("attempt to seek outside sequence", -1)
        if frame = this.AhkStdlibGifFrame
            return stdlib.None
        this.AhkStdlibGifApplyFrame(frame)
        return stdlib.None
    }

    tell(args*)
    {
        if args.Length > 0
            throw TypeError("Image.tell() takes 1 positional argument but " args.Length + 1 " were given", -1)
        return this.AhkStdlibGifFrame
    }

    AhkStdlibGifApplyFrame(frame)
    {
        spec := this.AhkStdlibGifFrames[frame + 1]
        targetMode := frame = 0 ? "P" : "RGB"
        if this.AhkStdlibHandle
            DllCall("gdiplus\GdipDisposeImage", "Ptr", this.AhkStdlibHandle)
        this.AhkStdlibHandle := AhkStdlibPillowCreateBitmap(this.AhkStdlibWidth, this.AhkStdlibHeight, targetMode)
        this.AhkStdlibMode := targetMode
        this.info := AhkStdlibPillowCloneMap(spec.Info)
        this.AhkStdlibPaletteMode := "RGB"
        this.AhkStdlibPalette := spec.Palette.Clone()
        this.palette := AhkStdlibPillowImagePaletteModule.raw("RGB", spec.Palette)
        this.tile := [["gif", [spec.Left, spec.Top, spec.Left + spec.Width, spec.Top + spec.Height], spec.TileOffset, [spec.LzwMinCodeSize, spec.Interlace, -1]]]
        this.AhkStdlibGifImageWidth := spec.Width
        this.AhkStdlibGifImageHeight := spec.Height
        this.AhkStdlibGifLeft := spec.Left
        this.AhkStdlibGifTop := spec.Top
        this.AhkStdlibGifLzwMinCodeSize := spec.LzwMinCodeSize
        this.AhkStdlibGifInterlace := spec.Interlace
        this.AhkStdlibGifData := spec.Data
        this.AhkStdlibGifFrame := frame
        return stdlib.None
    }

    getpixel(xy)
    {
        this.load()
        return super.getpixel(xy)
    }

    getdata(band := unset)
    {
        this.load()
        return super.getdata(band?)
    }
}

