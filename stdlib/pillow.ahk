AhkStdlibPillowMpoAdopt(jpegInstance, mpheader := unset)
{
    if !IsObject(jpegInstance) || !jpegInstance.HasOwnProp("AhkStdlibHandle")
        throw TypeError("jpeg_instance must be a JpegImageFile", -1)
    if !IsSet(mpheader) || AhkStdlibIsNone(mpheader) {
        if !jpegInstance.info.Has("mp")
            throw ValueError("Image appears to be a malformed MPO file", -1)
        mpheader := jpegInstance.info["mp"]
    }
    if !IsObject(mpheader) || !mpheader.Has(0xB001) || !mpheader.Has(0xB002)
        throw ValueError("Image appears to be a malformed MPO file", -1)
    AhkStdlibPillowMpoValidateMpInfo(mpheader)

    mpOffset := jpegInstance.info.Has("mpoffset") ? jpegInstance.info["mpoffset"] : 0
    entries := mpheader[0xB002]
    offsets := []
    for entry in entries
        offsets.Push((entry.Has("DataOffset") ? entry["DataOffset"] : 0) + mpOffset)
    if offsets.Length < 1
        throw ValueError("Image appears to be a malformed MPO file", -1)
    offsets[1] := 0

    jpegInstance.AhkStdlibFormat := "MPO"
    jpegInstance.mpinfo := mpheader
    jpegInstance.n_frames := mpheader[0xB001]
    jpegInstance.is_animated := jpegInstance.n_frames > 1
    jpegInstance.AhkStdlibMpoOffsets := offsets
    jpegInstance.AhkStdlibMpoFrame := 0
    jpegInstance.offset := 0
    jpegInstance.readonly := 1
    if jpegInstance.info.Has("mpoffset")
        jpegInstance.info.Delete("mpoffset")
    jpegInstance.info["mp"] := AhkStdlibPillowMpoCloneMpInfo(mpheader)
    jpegInstance.DefineProp("seek", { Call: AhkStdlibPillowMpoImageSeek })
    jpegInstance.DefineProp("tell", { Call: AhkStdlibPillowMpoImageTell })
    jpegInstance.DefineProp("load_seek", { Call: AhkStdlibPillowMpoImageLoadSeek })
    return jpegInstance
}

AhkStdlibPillowJpegGetMp(image)
{
    if image.HasOwnProp("info") && image.info.Has("mp")
        return AhkStdlibPillowMpoGetInfoValue(image.info["mp"])
    if image.HasOwnProp("mpinfo")
        return AhkStdlibPillowMpoCloneMpInfo(image.mpinfo)
    return stdlib.None
}

AhkStdlibPillowMpoGetInfoValue(value)
{
    if Type(value) = "Map"
        return AhkStdlibPillowMpoValidatedCloneMpInfo(value)

    bytes := AhkStdlibPillowByteSequence(value)
    if bytes.Length >= 4 && AhkStdlibPillowBytesStartsWithAscii(bytes, "MPF") && bytes[4] = 0
        return AhkStdlibPillowMpoValidatedCloneMpInfo(AhkStdlibPillowMpoParseMpf(bytes))

    result := AhkStdlibPillowMpoParseMpfTiff(bytes)
    if !result.Has(0xB001)
        throw SyntaxError("malformed MP Index (no number of images)", -1)
    AhkStdlibPillowMpoValidateMpInfo(result)
    return result
}

