    {
        get {
            AhkStdlibPillowPixarEnsureRegistered()
            static factory := AhkStdlibPillowPixarImageFileFactory()
            return factory
        }
    }

    static _accept(prefix)
    {
        bytes := AhkStdlibPillowByteSequence(prefix)
        return bytes.Length >= 4 && bytes[1] = 0x80 && bytes[2] = 0xE8 && bytes[3] = 0 && bytes[4] = 0
    }

    static i16(bytes, offset := 0)
    {
        return AhkStdlibPillowPixarI16(AhkStdlibPillowByteSequence(bytes), Integer(offset) + 1)
    }
}

class AhkStdlibPillowPixarImageFileFactory
{
    format := "PIXAR"
    format_description := "PIXAR raster image"

    Call(args*)
    {
        actual := AhkStdlibPillowPixarNormalizeFactoryArgs(this, args)
        if actual.Length < 1
            throw TypeError("ImageFile.__init__() missing 1 required positional argument: 'fp'", -1)
        if actual.Length > 2
            throw TypeError("ImageFile.__init__() takes from 2 to 3 positional arguments but " (actual.Length + 1) " were given", -1)
        return AhkStdlibPillowPixarOpen(actual[1])
    }
}

class AhkStdlibPillowPixarAccept
{
    static Call(prefix)
    {
        return AhkStdlibPillowPixarImagePluginModule._accept(prefix)
    }
}

AhkStdlibPillowPixarEnsureRegistered()
{
    if !AhkStdlibPillowRegistryMap("OPEN").Has("PIXAR")
        AhkStdlibPillowRegisterOpen("PIXAR", AhkStdlibPillowPixarImageFileFactory(), AhkStdlibPillowPixarAccept)
    AhkStdlibPillowRegisterExtension("PIXAR", ".pxr")
    return stdlib.None
}

AhkStdlibPillowPixarNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowPixarLooksLikeSource(actual[1]) && AhkStdlibPillowPixarLooksLikeSource(actual[2]) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length = 1 && !AhkStdlibPillowPixarLooksLikeSource(actual[1]) {
        actual := []
    }
    return actual
}

AhkStdlibPillowPixarLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowPixarOpen(source)
{
    bytes := AhkStdlibPillowPixarSourceBytes(source)
    if !AhkStdlibPillowPixarImagePluginModule._accept(AhkStdlibPillowArraySlice(bytes, 1, 4))
        throw SyntaxError("not a PIXAR file", -1)

    width := AhkStdlibPillowPixarI16(bytes, 419)
    height := AhkStdlibPillowPixarI16(bytes, 417)
    channelDesc := AhkStdlibPillowPixarI16(bytes, 425)
    depthDesc := AhkStdlibPillowPixarI16(bytes, 427)
    if channelDesc != 14 || depthDesc != 2
        throw SyntaxError("not identified by this driver", -1)

    handle := AhkStdlibPillowCreateBitmap(width, height, "RGB")
    image := AhkStdlibPillowImage(handle, "RGB", width, height, "PIXAR", 1)
    image.tile := [["raw", [0, 0, width, height], 1024, "RGB"]]
    payload := bytes.Length >= 1025 ? AhkStdlibPillowArraySlice(bytes, 1025, bytes.Length) : []
    AhkStdlibPillowImageFromBytes(image, payload, "raw")
    return image
}

AhkStdlibPillowPixarSourceBytes(source)
{
    if AhkStdlibPillowIsOpenFileLike(source)
        return AhkStdlibPillowReadAllFileLikeBytes(source)
    fp := AhkStdlibPillowOpenFile(source)
    try {
        return AhkStdlibPillowByteSequence(fp.read())
    } finally {
        fp.close()
    }
}

AhkStdlibPillowPixarI16(bytes, offset)
{
    if bytes.Length < offset + 1
        return 0
    return bytes[offset] | (bytes[offset + 1] << 8)
}

