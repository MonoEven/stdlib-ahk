AhkStdlibPillowAutocontrastLut(histogram, cutoffPair)
{
    h := histogram.Clone()
    if cutoffPair[1] || cutoffPair[2] {
        total := 0
        for count in h
            total += count
        cut := Floor(total * cutoffPair[1] // 100)
        loop 256 {
            if cut > h[A_Index] {
                cut -= h[A_Index]
                h[A_Index] := 0
            } else {
                h[A_Index] -= cut
                cut := 0
            }
            if cut <= 0
                break
        }
        cut := Floor(total * cutoffPair[2] // 100)
        loop 256 {
            index := 257 - A_Index
            if cut > h[index] {
                cut -= h[index]
                h[index] := 0
            } else {
                h[index] -= cut
                cut := 0
            }
            if cut <= 0
                break
        }
    }

    lo := 0
    loop 256 {
        if h[A_Index] {
            lo := A_Index - 1
            break
        }
    }
    hi := 255
    loop 256 {
        index := 257 - A_Index
        if h[index] {
            hi := index - 1
            break
        }
    }
    lut := []
    if hi <= lo {
        loop 256
            lut.Push(A_Index - 1)
        return lut
    }
    scale := 255.0 / (hi - lo)
    offset := -lo * scale
    loop 256 {
        value := Floor((A_Index - 1) * scale + offset)
        if value < 0
            value := 0
        else if value > 255
            value := 255
        lut.Push(value)
    }
    return lut
}

