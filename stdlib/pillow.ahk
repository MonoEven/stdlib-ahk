    if axis = "x" {
        yy := y
        xx := x - radius
        while xx <= x + radius {
            sourceX := AhkStdlibPillowClampCoordinate(xx, width)
            total += AhkStdlibPillowPixelChannel(sourceRows[yy + 1][sourceX + 1], mode, channelIndex)
            count += 1
            xx += 1
