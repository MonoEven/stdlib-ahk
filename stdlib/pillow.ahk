        super.__New(handle, mode, size[1], size[2], "EPS", 1)
        this.info := info
        this.tile := tile
    }

    load(scale := 1, transparency := false)
    {
        if this.HasOwnProp("tile") && this.tile
            throw OSError("Unable to locate Ghostscript on paths", -1)
        return stdlib.None
    }
}

AhkStdlibPillowEpsCheckRequired(info)
{
    if !info.Has("PS-Adobe")
        throw SyntaxError('EPS header missing "%!PS-Adobe" comment', -1)
    if !info.Has("BoundingBox")
        throw SyntaxError('EPS header missing "%%BoundingBox" comment', -1)
    return stdlib.None
}

AhkStdlibPillowEpsReadComment(line, info, &boundingBox, &readingTrailer, trailerReached, preferTrailer)
{
    if RegExMatch(line, "^%%([^:]*):[ \t]*(.*?)[ \t]*$", &match) {
        key := match[1]
        value := match[2]
        info[key] := value
        if key = "BoundingBox" {
            if value = "(atend)" {
                readingTrailer := true
            } else if AhkStdlibIsNone(boundingBox) || (trailerReached && readingTrailer) {
                parsed := AhkStdlibPillowEpsParseBoundingBox(value)
                if !AhkStdlibIsNone(parsed)
                    boundingBox := parsed
            }
        }
        return true
    }
    if RegExMatch(line, "^%[%!\w]([^:]*)[ \t]*$", &fieldMatch) {
        key := fieldMatch[1]
        if SubStr(key, 1, 8) = "PS-Adobe"
            info["PS-Adobe"] := SubStr(key, 8 + 1 + 1)
        else
            info[key] := ""
        return true
    }
    if SubStr(line, 1, 1) = "%"
        return false
    throw OSError("bad EPS header", -1)
}

AhkStdlibPillowEpsParseBoundingBox(value)
{
    if !RegExMatch(Trim(value), "^([-+]?\d+(?:\.\d+)?)\s+([-+]?\d+(?:\.\d+)?)\s+([-+]?\d+(?:\.\d+)?)\s+([-+]?\d+(?:\.\d+)?)", &match)
        return stdlib.None
    try {
        return [
            Integer(match[1] + 0.0),
            Integer(match[2] + 0.0),
            Integer(match[3] + 0.0),
            Integer(match[4] + 0.0),
        ]
    }
    return stdlib.None
}

AhkStdlibPillowEpsLines(bytes, startIndex, endIndex)
{
    lines := []
    current := ""
    index := startIndex
    while index <= endIndex {
        byte := bytes[index]
        if byte = 10 || byte = 13 {
            lines.Push(current)
            current := ""
            if byte = 13 && index < endIndex && bytes[index + 1] = 10
                index += 1
        } else {
            current .= Chr(byte)
        }
        index += 1
    }
    if current != ""
        lines.Push(current)
    return lines
}

AhkStdlibPillowEpsSaveImage(image, fp)
{
    if image.mode = "L" {
        bitDepth := 8
        channels := 1
        operator := "image"
    } else if image.mode = "RGB" {
        bitDepth := 8
        channels := 3
        operator := "false 3 colorimage"
    } else if image.mode = "CMYK" {
        bitDepth := 8
        channels := 4
        operator := "false 4 colorimage"
    } else {
        throw ValueError("image mode is not supported", -1)
    }

    text := "%!PS-Adobe-3.0 EPSF-3.0`n"
        . "%%Creator: PIL 0.1 EpsEncode`n"
        . "%%BoundingBox: 0 0 " image.width " " image.height "`n"
        . "%%Pages: 1`n"
        . "%%EndComments`n"
        . "%%Page: 1 1`n"
        . "%ImageData: " image.width " " image.height " " bitDepth " " channels " 0 1 1 `"" operator "`"`n"
        . "gsave`n"
        . "10 dict begin`n"
        . "/buf " (image.width * channels) " string def`n"
        . image.width " " image.height " scale`n"
        . image.width " " image.height " 8`n"
        . "[" image.width " 0 0 -" image.height " 0 " image.height "]`n"
        . "{ currentfile buf readhexstring pop } bind`n"
        . operator "`n"
    bytes := AhkStdlibPillowAsciiBytes(text)
    AhkStdlibPillowEpsAppendHexPixels(bytes, image, channels)
    for byte in AhkStdlibPillowAsciiBytes("%%%%EndBinary`ngrestore end`n")
        bytes.Push(byte)
    fp.write(bytes)
    return stdlib.None
}

AhkStdlibPillowEpsAppendHexPixels(bytes, image, channels)
{
    pixelBytes := image.tobytes()
    line := ""
    for byte in pixelBytes {
        line .= Format("{:02x}", byte)
        if StrLen(line) >= 78 {
            for outByte in AhkStdlibPillowAsciiBytes(line "`n")
                bytes.Push(outByte)
            line := ""
        }
    }
    if line != "" {
        for outByte in AhkStdlibPillowAsciiBytes(line "`n")
            bytes.Push(outByte)
    }
    return stdlib.None
}

AhkStdlibPillowEpsU32(bytes, offset)
{
    if bytes.Length < offset + 3
        return 0
    return bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)
}

