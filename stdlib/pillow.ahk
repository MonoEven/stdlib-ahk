    if AhkStdlibIsNone(animation) {
        image := AhkStdlibPillowWebPDecodeImage(bytes)
        loopCount := 1
        background := [255, 255, 255, 255]
        frameCount := 1
        isAnimated := false
        timestamp := 0
        duration := 0
    } else {
        image := AhkStdlibPillowWebPDecodeImage(animation.Frames[1].Bytes)
        if animation.HasAlpha && image.mode != "RGBA"
            image := AhkStdlibPillowWebPReplaceWithConverted(image, "RGBA")
        loopCount := animation.Loop
        background := animation.Background
        frameCount := animation.Frames.Length
        isAnimated := frameCount > 1
        timestamp := animation.Frames[1].Timestamp
        duration := animation.Frames[1].Duration
        image.AhkStdlibWebPFrames := animation.Frames
        image.AhkStdlibWebPHasAlpha := animation.HasAlpha
    }

    image.AhkStdlibFormat := "WEBP"
    image.AhkStdlibReadonly := 1
    image.rawmode := image.mode = "RGB" ? "RGB" : "RGBA"
    image.n_frames := frameCount
    image.is_animated := isAnimated
    image.AhkStdlibWebPFrame := 0
    image.info["loop"] := loopCount
    image.info["background"] := background
    image.info["timestamp"] := timestamp
    image.info["duration"] := duration
    image.DefineProp("seek", { Call: AhkStdlibPillowWebPImageSeek })
    image.DefineProp("tell", { Call: AhkStdlibPillowWebPImageTell })
    image.DefineProp("load_seek", { Call: AhkStdlibPillowWebPImageLoadSeek })
    return image
}

