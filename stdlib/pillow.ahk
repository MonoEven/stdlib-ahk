AhkStdlibPillowSpiderLoadImageSeries(filelist := unset)
{
    if !IsSet(filelist) || AhkStdlibIsNone(filelist)
        return stdlib.None
    files := AhkStdlibPillowSequenceToArray(filelist)
    if files.Length < 1
        return stdlib.None
    images := []
    for path in files {
        if !FileExist(path)
            continue
        image := unset
        try {
            image := AhkStdlibPillowImageModule.open(path)
            byteImage := image.convert2byte()
        } catch Error {
            if !AhkStdlibPillowSpiderIsImage(path)
                continue
