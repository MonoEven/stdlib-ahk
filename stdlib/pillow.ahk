        return bytes.Length >= 1 && bytes[1] = 42
            || SubStr(text, 1, 5) = "width"
            || SubStr(text, 1, 6) = "height"
            || SubStr(text, 1, 5) = "pixel"
    }
}

class AhkStdlibPillowImtImage extends AhkStdlibPillowImage
{
    __New(width, height, source, dataOffset)
    {
        handle := AhkStdlibPillowCreateBitmap(width, height, "L")
        super.__New(handle, "L", width, height, "IMT", 1)
        this.AhkStdlibImtSource := source
        this.AhkStdlibImtDataOffset := dataOffset
        this.AhkStdlibImtLoaded := false
        this.tile := [["raw", [0, 0, width, height], dataOffset, "L"]]
    }

    load()
    {
        if this.AhkStdlibImtLoaded
            return stdlib.None

        expected := this.width * this.height
        this.AhkStdlibImtSource.seek(this.AhkStdlibImtDataOffset)
        bytes := AhkStdlibPillowByteSequence(this.AhkStdlibImtSource.read(expected))
        if bytes.Length < expected
            throw OSError("image file is truncated (" (expected - bytes.Length) " bytes not processed)", -1)

        this.frombytes(AhkStdlibPillowArraySlice(bytes, 1, expected))
        this.AhkStdlibImtLoaded := true
        return stdlib.None
    }

    getpixel(xy)
    {
        this.load()
        return super.getpixel(xy)
    }

    getdata(band := unset)
    {
        this.load()
        return super.getdata(band?)
    }

    copy()
    {
        this.load()
        return super.copy()
    }
}

AhkStdlibPillowImtEnsureRegistered()
{
    AhkStdlibPillowRegisterOpen("IMT", AhkStdlibPillowImtImageFileFactory(), AhkStdlibPillowImtAccept)
    return stdlib.None
}

AhkStdlibPillowImtNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowImtLooksLikeSource(actual[1]) && AhkStdlibPillowImtLooksLikeSource(actual[2]) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length = 1 && !AhkStdlibPillowImtLooksLikeSource(actual[1]) {
        actual := []
    }
    return actual
}

AhkStdlibPillowImtLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowImtOpen(source)
{
    if !(AhkStdlibPillowIsOpenFileLike(source))
        source := AhkStdlibPillowOpenFile(source)

    first := AhkStdlibPillowByteSequence(source.read(100))
    if !AhkStdlibPillowArrayContains(first, 10)
        throw SyntaxError("not an IM file", -1)
    source.seek(0)

    width := 0
    height := 0
    mode := ""
    dataOffset := 0

    loop {
        lineStart := source.tell()
        line := AhkStdlibPillowImtReadLine(source)
        if line.Length = 0
            break

        formFeed := AhkStdlibPillowImtFindByte(line, 0x0C)
        if formFeed {
            dataOffset := lineStart + formFeed
            break
        }

        while line.Length && (line[line.Length] = 10 || line[line.Length] = 13)
            line.Pop()
        if line.Length = 0
            continue
        if line[1] = 42
            continue

        text := AhkStdlibPillowAsciiFromBytes(line)
        if !RegExMatch(text, "^([a-z]*) ([^ \r\n]*)", &match)
            break
        key := match[1]
        value := match[2]
        if key = "width"
            width := Integer(value)
        else if key = "height"
            height := Integer(value)
        else if key = "pixel" && value = "n8"
            mode := "L"
    }

    if dataOffset = 0 || mode != "L" || width <= 0 || height <= 0
        throw SyntaxError("not identified by this driver", -1)

    return AhkStdlibPillowImtImage(width, height, source, dataOffset)
}

AhkStdlibPillowImtReadLine(source)
{
    bytes := []
    loop {
        next := AhkStdlibPillowByteSequence(source.read(1))
        if next.Length = 0
            break
        bytes.Push(next[1])
        if next[1] = 10
            break
    }
    return bytes
}

AhkStdlibPillowImtFindByte(bytes, byte)
{
    for index, value in bytes {
        if value = byte
            return index
    }
    return 0
}

