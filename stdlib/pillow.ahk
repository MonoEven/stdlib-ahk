    pos := dataOffset + 1
    loop height {
        row := []
        loop width {
            if pos + 3 <= bytes.Length
                row.Push(AhkStdlibPillowSpiderReadFloat32(bytes, pos, little))
            else
                row.Push(0.0)
            pos += 4
        }
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowSpiderReadFloat32(bytes, pos, little)
{
    buf := Buffer(4, 0)
    if little {
        NumPut("UChar", bytes[pos], buf, 0)
        NumPut("UChar", bytes[pos + 1], buf, 1)
        NumPut("UChar", bytes[pos + 2], buf, 2)
        NumPut("UChar", bytes[pos + 3], buf, 3)
    } else {
        NumPut("UChar", bytes[pos + 3], buf, 0)
        NumPut("UChar", bytes[pos + 2], buf, 1)
        NumPut("UChar", bytes[pos + 1], buf, 2)
        NumPut("UChar", bytes[pos], buf, 3)
    }
    return NumGet(buf, 0, "Float")
}

AhkStdlibPillowSpiderFloat32Bytes(value, little := true)
{
    buf := Buffer(4, 0)
    NumPut("Float", value + 0.0, buf, 0)
    if little
        return [NumGet(buf, 0, "UChar"), NumGet(buf, 1, "UChar"), NumGet(buf, 2, "UChar"), NumGet(buf, 3, "UChar")]
    return [NumGet(buf, 3, "UChar"), NumGet(buf, 2, "UChar"), NumGet(buf, 1, "UChar"), NumGet(buf, 0, "UChar")]
}

