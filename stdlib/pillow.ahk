class AhkStdlibPillowImageMorphLutBuilder
{
    __New(patterns := unset, op_name := unset)
    {
        this.patterns := IsSet(patterns) && !AhkStdlibIsNone(patterns)
            ? AhkStdlibPillowSequenceToArray(patterns)
            : []
        this.lut := stdlib.None
        if IsSet(op_name) && !AhkStdlibIsNone(op_name)
            this.patterns := AhkStdlibPillowImageMorphKnownPatterns(op_name)
    }

    add_patterns(patterns)
    {
        for pattern in AhkStdlibPillowSequenceToArray(patterns)
            this.patterns.Push(pattern)
        return stdlib.None
    }

    build_default_lut()
    {
        lut := []
        m := 1 << 4
        loop AhkStdlibPillowImageMorphModule.LUT_SIZE {
            i := A_Index - 1
            lut.Push((i & m) > 0 ? 1 : 0)
        }
        this.lut := lut
        return stdlib.None
    }

    get_lut()
    {
        return this.lut
    }

    _string_permute(pattern, permutation)
    {
        permutation := AhkStdlibPillowSequenceToArray(permutation)
        if permutation.Length != 9
            throw AssertionError("", -1)
        result := ""
        for index in permutation
            result .= SubStr(pattern, index + 1, 1)
        return result
    }

    _pattern_permute(basic_pattern, options, basic_result)
    {
        patterns := [[basic_pattern, Integer(basic_result)]]
        if InStr(options, "4") {
            res := patterns[patterns.Length][2]
            loop 4
                patterns.Push([this._string_permute(patterns[patterns.Length][1], AhkStdlibPillowImageMorphModule.ROTATION_MATRIX), res])
        }
        if InStr(options, "M") {
            count := patterns.Length
            loop count
                patterns.Push([this._string_permute(patterns[A_Index][1], AhkStdlibPillowImageMorphModule.MIRROR_MATRIX), patterns[A_Index][2]])
        }
        if InStr(options, "N") {
            count := patterns.Length
            loop count
                patterns.Push([AhkStdlibPillowImageMorphNegatePattern(patterns[A_Index][1]), 1 - Integer(patterns[A_Index][2])])
        }
        return patterns
    }

    build_lut()
    {
        this.build_default_lut()
        allPatterns := []
        for rawPattern in this.patterns {
            parsed := AhkStdlibPillowImageMorphParsePattern(rawPattern)
            for pattern in this._pattern_permute(parsed.Pattern, parsed.Options, parsed.Result)
                allPatterns.Push(pattern)
        }

        loop AhkStdlibPillowImageMorphModule.LUT_SIZE {
            value := A_Index - 1
            bitpattern := AhkStdlibPillowImageMorphBitPattern(value)
            for pattern in allPatterns {
                if AhkStdlibPillowImageMorphPatternMatches(pattern[1], bitpattern)
                    this.lut[value + 1] := pattern[2] ? 1 : 0
            }
        }
        return this.lut
    }
}

class AhkStdlibPillowImageMorphOp
{
    __New(lut := unset, op_name := unset, patterns := unset)
    {
        this.lut := IsSet(lut) && !AhkStdlibIsNone(lut)
            ? (lut is Array ? lut : AhkStdlibPillowSequenceToArray(lut))
            : stdlib.None
        if IsSet(op_name) && !AhkStdlibIsNone(op_name)
            this.lut := AhkStdlibPillowImageMorphLutBuilder(, op_name).build_lut()
        else if IsSet(patterns) && !AhkStdlibIsNone(patterns)
            this.lut := AhkStdlibPillowImageMorphLutBuilder(patterns).build_lut()
    }

    apply(image)
    {
        AhkStdlibPillowImageMorphRequireLut(this)
        AhkStdlibPillowImageMorphRequireLImage(image)
        result := stdlib.pillow.Image.new("L", image.size, 0)
        changed := 0
        if image.width < 3 || image.height < 3
            return [0, result]
        y := 1
        while y < image.height - 1 {
            x := 1
            while x < image.width - 1 {
                oldValue := image.getpixel([x, y]) ? 255 : 0
                newValue := this.lut[AhkStdlibPillowImageMorphNeighborhoodIndex(image, x, y) + 1] ? 255 : 0
                result.putpixel([x, y], newValue)
                if newValue != oldValue
                    changed += 1
                x += 1
            }
            y += 1
        }
        return [changed, result]
    }

    match(image)
    {
        AhkStdlibPillowImageMorphRequireLut(this)
        AhkStdlibPillowImageMorphRequireLImage(image)
        matches := []
        if image.width < 3 || image.height < 3
            return matches
        y := 1
        while y < image.height - 1 {
            x := 1
            while x < image.width - 1 {
                if this.lut[AhkStdlibPillowImageMorphNeighborhoodIndex(image, x, y) + 1]
                    matches.Push([x, y])
                x += 1
            }
            y += 1
        }
        return matches
    }

    get_on_pixels(image)
    {
        AhkStdlibPillowImageMorphRequireLImage(image)
        pixels := []
        loop image.height {
            y := A_Index - 1
            loop image.width {
                x := A_Index - 1
                if image.getpixel([x, y])
                    pixels.Push([x, y])
            }
        }
        return pixels
    }

    load_lut(filename)
    {
        lut := AhkStdlibPillowReadFileBytes(filename)
        if lut.Length != AhkStdlibPillowImageMorphModule.LUT_SIZE {
            this.lut := stdlib.None
            throw Error("Wrong size operator file!", -1)
        }
        this.lut := lut
        return stdlib.None
    }

    save_lut(filename)
    {
        AhkStdlibPillowImageMorphRequireLut(this)
        AhkStdlibPillowWriteFileBytes(filename, this.lut)
        return stdlib.None
    }

    set_lut(lut)
    {
        this.lut := AhkStdlibIsNone(lut) ? stdlib.None : (lut is Array ? lut : AhkStdlibPillowSequenceToArray(lut))
        return stdlib.None
    }
}

