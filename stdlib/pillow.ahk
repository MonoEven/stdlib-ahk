    height := AhkStdlibPillowGbrReadI32(bytes, &pos)
    colorDepth := AhkStdlibPillowGbrReadI32(bytes, &pos)
    if width <= 0 || height <= 0
        throw SyntaxError("not a GIMP brush", -1)
    if colorDepth != 1 && colorDepth != 4
        throw SyntaxError("Unsupported GIMP brush color depth: " colorDepth, -1)

    info := Map()
    if version = 1 {
        commentLength := headerSize - 20
    } else {
        commentLength := headerSize - 28
        magic := AhkStdlibPillowGbrReadBytes(bytes, &pos, 4)
        if AhkStdlibPillowAsciiFromBytes(magic) != "GIMP"
            throw SyntaxError("not a GIMP brush, bad magic number", -1)
        info["spacing"] := AhkStdlibPillowGbrReadI32(bytes, &pos)
    }

    commentBytes := AhkStdlibPillowGbrReadBytes(bytes, &pos, commentLength)
    if commentBytes.Length
        commentBytes.RemoveAt(commentBytes.Length)
    info["comment"] := commentBytes
    dataSize := width * height * colorDepth
    data := AhkStdlibPillowGbrReadBytes(bytes, &pos, dataSize)
    mode := colorDepth = 1 ? "L" : "RGBA"
