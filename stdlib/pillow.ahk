AhkStdlibPillowEpsNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowEpsLooksLikeSource(actual[1]) && AhkStdlibPillowEpsLooksLikeSource(actual[2]) {
        actual := actual.Clone()
