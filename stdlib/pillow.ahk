AhkStdlibPillowRankChannel(sourceRows, mode, width, height, x, y, radius, rank, channelIndex)
{
    values := []
    yy := y - radius
    while yy <= y + radius {
        sourceY := AhkStdlibPillowClampCoordinate(yy, height)
        xx := x - radius
        while xx <= x + radius {
            sourceX := AhkStdlibPillowClampCoordinate(xx, width)
            values.Push(AhkStdlibPillowPixelChannel(sourceRows[sourceY + 1][sourceX + 1], mode, channelIndex))
            xx += 1
        }
        yy += 1
    }
    AhkStdlibPillowSortNumbers(values)
    return values[rank + 1]
}

