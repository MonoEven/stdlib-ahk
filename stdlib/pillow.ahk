AhkStdlibPillowEqualizeLut(histogram)
{
    nonzero := []
    for count in histogram {
        if count
            nonzero.Push(count)
    }
    lut := []
    if nonzero.Length <= 1 {
        loop 256
            lut.Push(A_Index - 1)
        return lut
