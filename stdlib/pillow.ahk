class AhkStdlibPillowImageShowViewer
{
    __New(args*)
    {
        this.format := stdlib.None
        this.options := Map()
    }

    show(args*)
    {
        if args.Length < 1
            throw TypeError("Viewer.show() missing 1 required positional argument: 'image'", -1)
        image := args[1]
        options := args.Length >= 2 && IsObject(args[2]) ? AhkStdlibPillowImageShowOptionsToMap(args[2]) : Map()
        if !((image.mode = "1") || (image.mode = "RGBA") || (this.format = "PNG" && (image.mode = "I;16" || image.mode = "LA"))) {
            base := AhkStdlibPillowModeInfo(image.mode).ModeBase
            if image.mode != base
                image := image.convert(base)
        }
        return this.show_image(image, options)
    }

    get_format(image)
    {
        return this.format
    }

    get_command(file, options*)
    {
        throw NotImplementedError("unavailable in base viewer", -1)
    }

    save_image(image)
    {
        path := AhkStdlibPillowImageShowTempFile(this.get_format(image))
        image.save(path, this.get_format(image))
        return path
    }

    show_image(image, options*)
    {
        return this.show_file(this.save_image(image), options*)
    }

    show_file(path, options*)
    {
        if !FileExist(path)
            throw OSError("", -1)
        this.AhkStdlibLastCommand := this.get_command(path, options*)
        return 1
    }
}

