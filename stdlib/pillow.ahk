    AhkStdlibPillowDdsPushU32(bytes, AhkStdlibPillowDdsImagePluginModule.DDS_MAGIC)
    AhkStdlibPillowDdsPushU32(bytes, 124)
    AhkStdlibPillowDdsPushU32(bytes, flags)
    AhkStdlibPillowDdsPushU32(bytes, image.height)
    AhkStdlibPillowDdsPushU32(bytes, image.width)
    AhkStdlibPillowDdsPushU32(bytes, pitch)
    AhkStdlibPillowDdsPushU32(bytes, 0)
    AhkStdlibPillowDdsPushU32(bytes, 0)
    loop 11
        AhkStdlibPillowDdsPushU32(bytes, 0)
    AhkStdlibPillowDdsPushU32(bytes, 32)
    AhkStdlibPillowDdsPushU32(bytes, pixelFlags)
    AhkStdlibPillowDdsPushU32(bytes, 0)
    AhkStdlibPillowDdsPushU32(bytes, bitcount)
    for mask in masks
        AhkStdlibPillowDdsPushU32(bytes, mask)
    AhkStdlibPillowDdsPushU32(bytes, AhkStdlibPillowDdsImagePluginModule.DDSCAPS_TEXTURE)
    loop 4
        AhkStdlibPillowDdsPushU32(bytes, 0)
    AhkStdlibPillowDdsAppendPixels(bytes, image)
