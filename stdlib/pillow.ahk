AhkStdlibPillowImNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowImLooksLikeSource(actual[1]) && AhkStdlibPillowImLooksLikeSource(actual[2]) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length = 1 && !AhkStdlibPillowImLooksLikeSource(actual[1]) {
        actual := []
    }
    return actual
}

AhkStdlibPillowImLooksLikeSource(value)
