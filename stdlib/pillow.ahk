}

AhkStdlibPillowPpmNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowPpmLooksLikeSource(actual[1]) && AhkStdlibPillowPpmLooksLikeSource(actual[2]) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length = 1 && !AhkStdlibPillowPpmLooksLikeSource(actual[1]) {
        actual := []
    }
    return actual
}

AhkStdlibPillowPpmLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowPpmOpen(source)
{
    bytes := AhkStdlibPillowPpmSourceBytes(source)
    pos := 1
    magic := AhkStdlibPillowPpmReadMagic(bytes, &pos)
    modes := AhkStdlibPillowPpmModesMap()
    if !modes.Has(magic)
        throw SyntaxError("not a PPM file", -1)

    mode := modes[magic]
    customMimetype := stdlib.None
    if magic = "P1" || magic = "P4"
        customMimetype := "image/x-portable-bitmap"
    else if magic = "P2" || magic = "P5"
        customMimetype := "image/x-portable-graymap"
    else if magic = "P3" || magic = "P6"
        customMimetype := "image/x-portable-pixmap"

    width := Integer(AhkStdlibPillowPpmReadToken(bytes, &pos))
    height := Integer(AhkStdlibPillowPpmReadToken(bytes, &pos))

    decoderName := "raw"
    if magic = "P1" || magic = "P2" || magic = "P3"
        decoderName := "ppm_plain"

    args := unset
    maxval := unset
    scale := unset
    rawmode := mode
    if mode = "1" {
        args := "1;I"
    } else if mode = "F" {
        scale := Float(AhkStdlibPillowPpmReadToken(bytes, &pos))
        if scale = 0.0
            throw ValueError("scale must be finite and non-zero", -1)
        rawmode := scale < 0 ? "F;32F" : "F;32BF"
        args := [rawmode, 0, -1]
    } else {
        maxval := Integer(AhkStdlibPillowPpmReadToken(bytes, &pos))
        if !(maxval > 0 && maxval < 65536)
            throw ValueError("maxval must be greater than 0 and less than 65536", -1)
        if maxval > 255 && mode = "L"
            mode := "I"
        rawmode := mode
        if decoderName != "ppm_plain" {
            if maxval = 65535 && mode = "I"
                rawmode := "I;16B"
            else if maxval != 255
                decoderName := "ppm"
        }
        args := decoderName = "raw" ? rawmode : [rawmode, maxval]
    }

    dataOffset := pos - 1
    rows := AhkStdlibPillowPpmDecodeRows(bytes, pos, width, height, mode, magic, decoderName, maxval?, scale?)
    image := AhkStdlibPillowImage(0, mode, width, height, "PPM", 1)
    image.AhkStdlibMemoryPixels := rows
    image.tile := [[decoderName, [0, 0, width, height], dataOffset, args]]
    if mode = "F"
        image.info["scale"] := Abs(scale)
    if !AhkStdlibIsNone(customMimetype)
        image.custom_mimetype := customMimetype
    return image
}

AhkStdlibPillowPpmSourceBytes(source)
{
    if AhkStdlibPillowIsOpenFileLike(source) {
        source.seek(0)
        return AhkStdlibPillowByteSequence(source.read())
    }
    return AhkStdlibPillowReadFileBytes(source)
}

AhkStdlibPillowPpmReadMagic(bytes, &pos)
{
    magic := []
    loop 6 {
        if pos > bytes.Length
            break
        c := bytes[pos]
        pos += 1
        if AhkStdlibPillowPpmIsWhitespace(c)
            break
        magic.Push(c)
    }
    return AhkStdlibPillowAsciiFromBytes(magic)
}

AhkStdlibPillowPpmReadToken(bytes, &pos)
{
    token := []
    while token.Length <= 10 {
        if pos > bytes.Length
            break
        c := bytes[pos]
        pos += 1
        if AhkStdlibPillowPpmIsWhitespace(c) {
            if token.Length = 0
                continue
            break
        }
        if c = 35 {
            while pos <= bytes.Length {
                c := bytes[pos]
                pos += 1
                if c = 10 || c = 13
                    break
            }
            continue
        }
        token.Push(c)
    }
    if token.Length = 0
        throw ValueError("Reached EOF while reading header", -1)
    if token.Length > 10
        throw ValueError("b'Token too long in file header: " AhkStdlibPillowAsciiFromBytes(token) "'", -1)
    return AhkStdlibPillowAsciiFromBytes(token)
}

AhkStdlibPillowPpmDecodeRows(bytes, dataPos, width, height, mode, magic, decoderName, maxval := unset, scale := unset)
{
    if mode = "F"
        return AhkStdlibPillowPpmDecodeFloatRows(bytes, dataPos, width, height, scale)
    if decoderName = "ppm_plain"
        return AhkStdlibPillowPpmDecodePlainRows(bytes, dataPos, width, height, mode, maxval?)
    if mode = "1"
        return AhkStdlibPillowPpmDecodePackedBitmapRows(bytes, dataPos, width, height)
    return AhkStdlibPillowPpmDecodeRawRows(bytes, dataPos, width, height, mode, maxval)
}

AhkStdlibPillowPpmDecodePlainRows(bytes, dataPos, width, height, mode, maxval := unset)
{
    total := width * height
    channels := AhkStdlibPillowPpmModeBands(mode)
    values := []
    if mode = "1" {
        data := AhkStdlibPillowPpmDataWithoutComments(bytes, dataPos)
        for c in data {
            if AhkStdlibPillowPpmIsWhitespace(c)
                continue
            if c != 48 && c != 49
                throw ValueError("b'Invalid token for this mode: " Chr(c) "'", -1)
            values.Push(c = 48 ? 255 : 0)
            if values.Length = total
                break
        }
        return AhkStdlibPillowPpmRowsFromFlat(values, width, height, 1)
    }

    tokens := AhkStdlibPillowPpmDataTokens(bytes, dataPos)
    outMax := mode = "I" ? 65535 : 255
    needed := total * channels
    for token in tokens {
        if StrLen(token) > 10
            throw ValueError("b'Token too long found in data: " SubStr(token, 1, 11) "'", -1)
        value := Integer(token)
        if value < 0
            throw ValueError("Channel value is negative: " value, -1)
        if value > maxval
            throw ValueError("Channel value too large for this mode: " value, -1)
        values.Push(Round(value / maxval * outMax))
        if values.Length = needed
            break
    }
    return AhkStdlibPillowPpmRowsFromFlat(values, width, height, channels)
}

AhkStdlibPillowPpmDecodePackedBitmapRows(bytes, dataPos, width, height)
{
    rows := []
    rowBytes := Ceil(width / 8)
    pos := dataPos
    loop height {
        row := []
        loop rowBytes {
            if pos > bytes.Length
                break
            byteValue := bytes[pos]
            pos += 1
            bitIndex := 0
            while bitIndex < 8 {
                if row.Length >= width
                    break
                bit := (byteValue >> (7 - bitIndex)) & 1
                row.Push(bit ? 0 : 255)
                bitIndex += 1
            }
        }
        while row.Length < width
            row.Push(0)
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowPpmDecodeRawRows(bytes, dataPos, width, height, mode, maxval)
{
    channels := AhkStdlibPillowPpmModeBands(mode)
    inByteCount := maxval < 256 ? 1 : 2
    outMax := mode = "I" ? 65535 : 255
    values := []
    pos := dataPos
    needed := width * height * channels
    while values.Length < needed && pos <= bytes.Length {
        loop channels {
            if pos > bytes.Length
                break 2
            if inByteCount = 1 {
                value := bytes[pos]
                pos += 1
            } else {
                if pos + 1 > bytes.Length
                    break 2
                value := (bytes[pos] << 8) | bytes[pos + 1]
                pos += 2
            }
            if maxval = outMax
                values.Push(value)
            else
                values.Push(Min(outMax, Round(value / maxval * outMax)))
            if values.Length = needed
                break
        }
    }
    return AhkStdlibPillowPpmRowsFromFlat(values, width, height, channels)
}

AhkStdlibPillowPpmDecodeFloatRows(bytes, dataPos, width, height, scale)
{
    little := scale < 0
    rows := []
    flatRows := []
    pos := dataPos
    loop height {
        row := []
        loop width {
            if pos + 3 > bytes.Length {
                row.Push(0.0)
                continue
            }
            row.Push(AhkStdlibPillowPpmReadFloat32(bytes, pos, little))
            pos += 4
        }
        flatRows.Push(row)
    }
    index := flatRows.Length
    while index >= 1 {
        rows.Push(flatRows[index])
        index -= 1
    }
    return rows
}

AhkStdlibPillowPpmRowsFromFlat(values, width, height, channels)
{
    rows := []
    index := 1
    loop height {
        row := []
        loop width {
            if channels = 1 {
                value := index <= values.Length ? values[index] : 0
                row.Push(value)
                index += 1
            } else {
                pixel := []
                loop channels {
                    value := index <= values.Length ? values[index] : 0
                    pixel.Push(value)
                    index += 1
                }
                row.Push(pixel)
            }
        }
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowPpmDataWithoutComments(bytes, dataPos)
{
    data := []
    pos := dataPos
    inComment := false
    while pos <= bytes.Length {
        c := bytes[pos]
        pos += 1
        if inComment {
            if c = 10 || c = 13
                inComment := false
            continue
        }
        if c = 35 {
            inComment := true
            continue
        }
        data.Push(c)
    }
    return data
}

AhkStdlibPillowPpmDataTokens(bytes, dataPos)
{
    tokens := []
    token := []
    pos := dataPos
    inComment := false
    while pos <= bytes.Length {
        c := bytes[pos]
        pos += 1
        if inComment {
            if c = 10 || c = 13
                inComment := false
            continue
        }
        if c = 35 {
            if token.Length {
                tokens.Push(AhkStdlibPillowAsciiFromBytes(token))
                token := []
            }
            inComment := true
            continue
        }
        if AhkStdlibPillowPpmIsWhitespace(c) {
            if token.Length {
                tokens.Push(AhkStdlibPillowAsciiFromBytes(token))
                token := []
            }
            continue
        }
        token.Push(c)
        if token.Length > 10
            throw ValueError("b'Token too long found in data: " AhkStdlibPillowAsciiFromBytes(token) "'", -1)
    }
    if token.Length
        tokens.Push(AhkStdlibPillowAsciiFromBytes(token))
    return tokens
}

AhkStdlibPillowPpmSaveImage(image, fp, filename)
{
    mode := image.mode
    bytes := []
    switch mode {
        case "1":
            AhkStdlibPillowPpmAppendAscii(bytes, "P4`n" image.width " " image.height "`n")
            AhkStdlibPillowPpmAppendBytes(bytes, AhkStdlibPillowPpmPackBitmap(image))
        case "L":
            AhkStdlibPillowPpmAppendAscii(bytes, "P5`n" image.width " " image.height "`n255`n")
            loop image.height {
                y := A_Index - 1
                loop image.width
                    bytes.Push(AhkStdlibPillowClampByte(image.getpixel([A_Index - 1, y])))
            }
        case "I", "I;16":
            AhkStdlibPillowPpmAppendAscii(bytes, "P5`n" image.width " " image.height "`n65535`n")
            loop image.height {
                y := A_Index - 1
                loop image.width {
                    value := AhkStdlibPillowPpmClampU16(image.getpixel([A_Index - 1, y]))
                    bytes.Push((value >> 8) & 0xFF, value & 0xFF)
                }
            }
        case "RGB", "RGBA":
            AhkStdlibPillowPpmAppendAscii(bytes, "P6`n" image.width " " image.height "`n255`n")
            loop image.height {
                y := A_Index - 1
                loop image.width {
                    pixel := AhkStdlibPillowSequenceToArray(image.getpixel([A_Index - 1, y]))
                    bytes.Push(AhkStdlibPillowClampByte(pixel[1]), AhkStdlibPillowClampByte(pixel[2]), AhkStdlibPillowClampByte(pixel[3]))
                }
            }
        case "F":
            AhkStdlibPillowPpmAppendAscii(bytes, "Pf`n" image.width " " image.height "`n-1.0`n")
            y := image.height - 1
            while y >= 0 {
                loop image.width
                    AhkStdlibPillowPpmAppendBytes(bytes, AhkStdlibPillowPpmFloat32Bytes(image.getpixel([A_Index - 1, y]), true))
                y -= 1
            }
        default:
            throw OSError("cannot write mode " mode " as PPM", -1)
    }
    fp.write(bytes)
    return stdlib.None
}

AhkStdlibPillowPpmPackBitmap(image)
{
    bytes := []
    loop image.height {
        y := A_Index - 1
        current := 0
        bit := 7
        loop image.width {
            value := image.getpixel([A_Index - 1, y]) ? 0 : 1
            current |= value << bit
            bit -= 1
            if bit < 0 {
                bytes.Push(current)
                current := 0
                bit := 7
            }
        }
        if bit != 7
            bytes.Push(current)
    }
    return bytes
}

AhkStdlibPillowPpmModeBands(mode)
{
    switch mode {
        case "RGB":
            return 3
        case "RGBA", "CMYK":
            return 4
        default:
            return 1
    }
}

AhkStdlibPillowPpmIsWhitespace(byte)
{
    return byte = 32 || byte = 9 || byte = 10 || byte = 11 || byte = 12 || byte = 13
}

AhkStdlibPillowPpmAppendAscii(target, text)
{
