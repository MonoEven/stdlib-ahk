    for suffix in ["8", "8S", "16", "16S", "32", "32F"] {
        open["L " suffix " image"] := ["F", "F;" suffix]
        open["L*" suffix " image"] := ["F", "F;" suffix]
    }
    for suffix in ["16", "16L", "16B"] {
