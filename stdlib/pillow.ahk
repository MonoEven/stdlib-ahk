        if x > xmax {
            y := y * xmax / x
            x := xmax
        }
        if y > ymax {
            x := x * ymax / y
            y := ymax
        }
        dx := (xmax - x) / 2 + box[1]
        dy := (ymax - y) / 2 + box[2]
        this.fp.write(AhkStdlibPillowAsciiBytes(Format("gsave`n{:.6f} {:.6f} translate`n", dx, dy)))
        if x != im.size[1] || y != im.size[2]
            this.fp.write(AhkStdlibPillowAsciiBytes(Format("{:.6f} {:.6f} scale`n", x / im.size[1], y / im.size[2])))
        AhkStdlibPillowEpsSaveImage(im, this.fp)
        this.fp.write(AhkStdlibPillowAsciiBytes("`ngrestore`n"))
        return stdlib.None
    }
}

