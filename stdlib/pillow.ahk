        loop size3 {
            bIndex := A_Index - 1
            b := bIndex / (size3 - 1)
            loop size2 {
                gIndex := A_Index - 1
                g := gIndex / (size2 - 1)
                loop size1 {
                    rIndex := A_Index - 1
                    r := rIndex / (size1 - 1)
