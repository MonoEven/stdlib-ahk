AhkStdlibPillowMpegOpen(source)
{
    shouldClose := false
    if AhkStdlibPillowIsOpenFileLike(source) {
        fp := source
    } else {
        fp := AhkStdlibPillowOpenFile(source)
        shouldClose := true
    }

    try {
        stream := AhkStdlibPillowMpegBitStream(fp)
        try {
            if stream.read(32) != 0x1B3
                throw SyntaxError("not an MPEG file", -1)
            width := stream.read(12)
            height := stream.read(12)
        } catch IndexError as err {
            throw SyntaxError(err.Message, -1)
        }
        return AhkStdlibPillowMpegImage(width, height)
    } finally {
        if shouldClose && IsObject(fp) && HasMethod(fp, "close")
            fp.close()
    }
}

