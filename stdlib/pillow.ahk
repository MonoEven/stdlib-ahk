        throw TypeError("formats must be a list or tuple", -1)
    AhkStdlibPillowValidateOpenFormats(formats?)

    registered := AhkStdlibPillowImageOpenRegistered(path, formats?)
    if !AhkStdlibIsNone(registered)
        return registered

    try {
        decoded := AhkStdlibPillowWicDecodeToBgra(path)
    } catch Error as err {
        if AhkStdlibPillowIsOpenFileLike(path)
            throw OSError("cannot identify image file " AhkStdlibPillowFileLikeRepr(path), -1)
        throw err
    }
    if IsSet(formats) && !AhkStdlibIsNone(formats) && !AhkStdlibPillowOpenFormatAllowed(decoded.Format, formats)
        throw OSError("cannot identify image file " AhkStdlibPillowOpenSourceRepr(path), -1)
    return AhkStdlibPillowImageFromWicDecoded(decoded)
}

AhkStdlibPillowImageFromWicDecoded(decoded)
{
    mode := decoded.Mode
    handle := AhkStdlibPillowCreateBitmap(decoded.Width, decoded.Height, mode)
    try {
        offset := 0
        loop decoded.Height {
            y := A_Index - 1
            loop decoded.Width {
                x := A_Index - 1
                b := NumGet(decoded.Pixels, offset, "UChar")
                g := NumGet(decoded.Pixels, offset + 1, "UChar")
                r := NumGet(decoded.Pixels, offset + 2, "UChar")
                a := NumGet(decoded.Pixels, offset + 3, "UChar")
                argb := (a << 24) | (r << 16) | (g << 8) | b
                AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipBitmapSetPixel", "Ptr", handle, "Int", x, "Int", y, "UInt", argb), "GdipBitmapSetPixel")
                offset += 4
            }
        }
    } catch Error as err {
        if handle
            DllCall("gdiplus\GdipDisposeImage", "Ptr", handle)
        throw err
    }

    return AhkStdlibPillowImage(handle, mode, decoded.Width, decoded.Height, decoded.Format, 1)
}

AhkStdlibPillowValidateOpenFormats(formats := unset)
{
