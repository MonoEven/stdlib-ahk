        throw TypeError("object of type 'NoneType' has no len()", -1)
    if !(color is String)
        throw TypeError("object of type '" AhkStdlibPythonTypeName(color) "' has no len()", -1)
    if StrLen(color) > 100
        throw ValueError("color specifier is too long", -1)

    original := color
    color := StrLower(color)
    colormap := AhkStdlibPillowImageColorMap()
    if colormap.Has(color)
        return AhkStdlibPillowImageColorGetRgb(colormap[color])

    if RegExMatch(color, "^#([a-f0-9]{3})$", &match)
        return [
            AhkStdlibPillowHexByte(SubStr(match[1], 1, 1) SubStr(match[1], 1, 1)),
            AhkStdlibPillowHexByte(SubStr(match[1], 2, 1) SubStr(match[1], 2, 1)),
            AhkStdlibPillowHexByte(SubStr(match[1], 3, 1) SubStr(match[1], 3, 1)),
