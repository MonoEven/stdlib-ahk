        mode := "1", rawmode := "1;I"
    } else if depth = 4 {
        mode := "L", rawmode := "L;4"
    } else if depth = 8 {
        mode := "L", rawmode := "L"
    } else if depth = 24 {
        mode := "RGB", rawmode := fileType = 3 ? "RGB" : "BGR"
    } else if depth = 32 {
        mode := "RGB", rawmode := fileType = 3 ? "RGBX" : "BGRX"
    } else {
        throw SyntaxError("Unsupported Mode/Bit Depth", -1)
    }

    palette := unset
    if paletteLength {
        if paletteLength > 1024
            throw SyntaxError("Unsupported Color Palette Length", -1)
        if paletteType != 1
            throw SyntaxError("Unsupported Palette Type", -1)
        paletteStart := offset + 1
        palette := AhkStdlibPillowSunRgbLPalette(AhkStdlibPillowArraySlice(bytes, paletteStart, paletteStart + paletteLength - 1))
        offset += paletteLength
        if mode = "L" {
            mode := "P"
            rawmode := rawmode = "L" ? "P" : (rawmode = "L;4" ? "P;4" : rawmode)
        }
    }

    stride := AhkStdlibPillowSunStride(width, depth)
