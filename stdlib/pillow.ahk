        palette.Push(AhkStdlibPillowGimpGradientO8(Integer(255 * ((rgb1[1] - rgb0[1]) * scale + rgb0[1]) + 0.5)))
        palette.Push(AhkStdlibPillowGimpGradientO8(Integer(255 * ((rgb1[2] - rgb0[2]) * scale + rgb0[2]) + 0.5)))
        palette.Push(AhkStdlibPillowGimpGradientO8(Integer(255 * ((rgb1[3] - rgb0[3]) * scale + rgb0[3]) + 0.5)))
        palette.Push(AhkStdlibPillowGimpGradientO8(Integer(255 * ((rgb1[4] - rgb0[4]) * scale + rgb0[4]) + 0.5)))
