    return stdlib.None
}

AhkStdlibPillowQoiEncodeImage(image, mode)
{
    if mode != "RGB" && mode != "RGBA"
        throw ValueError("Unsupported QOI image mode", -1)
    seen := Map()
    seen[0] := [0, 0, 0, 0]
    previous := [0, 0, 0, 255]
    run := 0
    data := []
    bands := StrLen(AhkStdlibPillowChannels(mode))
    loop image.height {
        y := A_Index - 1
        loop image.width {
            pixel := image.getpixel([A_Index - 1, y])
            pixel := AhkStdlibPillowQoiRgbaPixel(pixel, mode)
            if AhkStdlibPillowQoiPixelsEqual(pixel, previous) {
                run += 1
                if run = 62
                    AhkStdlibPillowQoiWriteRun(data, &run)
            } else {
                if run
                    AhkStdlibPillowQoiWriteRun(data, &run)
                hashValue := AhkStdlibPillowQoiHash(pixel)
                if seen.Has(hashValue) && AhkStdlibPillowQoiPixelsEqual(seen[hashValue], pixel) {
                    data.Push(hashValue)
                } else {
                    seen[hashValue] := pixel.Clone()
                    if previous[4] = pixel[4] {
                        deltaR := AhkStdlibPillowQoiDelta(pixel[1], previous[1])
                        deltaG := AhkStdlibPillowQoiDelta(pixel[2], previous[2])
                        deltaB := AhkStdlibPillowQoiDelta(pixel[3], previous[3])
                        if deltaR >= -2 && deltaR < 2 && deltaG >= -2 && deltaG < 2 && deltaB >= -2 && deltaB < 2 {
                            data.Push(0x40 | ((deltaR + 2) << 4) | ((deltaG + 2) << 2) | (deltaB + 2))
                        } else {
                            deltaGR := AhkStdlibPillowQoiDelta(deltaR, deltaG)
                            deltaGB := AhkStdlibPillowQoiDelta(deltaB, deltaG)
                            if deltaGR >= -8 && deltaGR < 8 && deltaG >= -32 && deltaG < 32 && deltaGB >= -8 && deltaGB < 8 {
                                data.Push(0x80 | (deltaG + 32))
                                data.Push(((deltaGR + 8) << 4) | (deltaGB + 8))
                            } else {
                                data.Push(0xFE, pixel[1], pixel[2], pixel[3])
                            }
                        }
                    } else {
                        data.Push(0xFF, pixel[1], pixel[2], pixel[3], pixel[4])
                    }
                }
            }
            previous := pixel.Clone()
        }
    }
    if run
        AhkStdlibPillowQoiWriteRun(data, &run)
    data.Push(0, 0, 0, 0, 0, 0, 0, 1)
    return data
}

AhkStdlibPillowQoiRgbaPixel(pixel, mode)
{
    if mode = "RGB"
        return [AhkStdlibPillowPixelChannel(pixel, mode, 1), AhkStdlibPillowPixelChannel(pixel, mode, 2), AhkStdlibPillowPixelChannel(pixel, mode, 3), 255]
    return [AhkStdlibPillowPixelChannel(pixel, mode, 1), AhkStdlibPillowPixelChannel(pixel, mode, 2), AhkStdlibPillowPixelChannel(pixel, mode, 3), AhkStdlibPillowPixelChannel(pixel, mode, 4)]
}

AhkStdlibPillowQoiWriteRun(data, &run)
{
    data.Push((0xC0 | (run - 1)) & 0xFF)
    run := 0
    return stdlib.None
}

AhkStdlibPillowQoiRememberPixel(seen, pixel)
{
    seen[AhkStdlibPillowQoiHash(pixel)] := pixel.Clone()
