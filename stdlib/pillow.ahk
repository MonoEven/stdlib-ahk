}

AhkStdlibPillowJpeg2KStructSize(format)
{
    switch format {
        case ">I4s":
            return 8
        case ">Q":
            return 8
        case ">4s":
            return 4
        case ">2s":
            return 2
        case ">IIHB":
            return 11
        case ">BBBI":
            return 7
        case ">HHHHBB":
            return 10
    }
    throw ValueError("unsupported struct format", -1)
}

AhkStdlibPillowJpeg2KUnpack(format, data)
{
    switch format {
        case ">I4s":
            return [AhkStdlibPillowJpeg2KReadBe32(data, 1), AhkStdlibPillowArraySlice(data, 5, 8)]
        case ">Q":
            return [AhkStdlibPillowJpeg2KReadBe64(data, 1)]
        case ">4s":
            return [AhkStdlibPillowArraySlice(data, 1, 4)]
        case ">2s":
            return [AhkStdlibPillowArraySlice(data, 1, 2)]
        case ">IIHB":
            return [
                AhkStdlibPillowJpeg2KReadBe32(data, 1),
                AhkStdlibPillowJpeg2KReadBe32(data, 5),
                AhkStdlibPillowJpeg2KReadBe16(data, 9),
                data[11],
            ]
        case ">BBBI":
            return [data[1], data[2], data[3], AhkStdlibPillowJpeg2KReadBe32(data, 4)]
        case ">HHHHBB":
            return [
                AhkStdlibPillowJpeg2KReadBe16(data, 1),
                AhkStdlibPillowJpeg2KReadBe16(data, 3),
                AhkStdlibPillowJpeg2KReadBe16(data, 5),
                AhkStdlibPillowJpeg2KReadBe16(data, 7),
                data[9],
                data[10],
            ]
    }
    throw ValueError("unsupported struct format", -1)
}

AhkStdlibPillowJpeg2KReadBe16(bytes, offset)
{
    return (bytes[offset] << 8) | bytes[offset + 1]
}

AhkStdlibPillowJpeg2KReadBe32(bytes, offset)
{
    return (bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]
}

AhkStdlibPillowJpeg2KReadBe64(bytes, offset)
{
    high := AhkStdlibPillowJpeg2KReadBe32(bytes, offset)
    low := AhkStdlibPillowJpeg2KReadBe32(bytes, offset + 4)
    return high * 0x100000000 + low
}

AhkStdlibPillowJpeg2KStreamLength(source)
{
    try {
        pos := source.tell()
        source.seek(0, stdlib.io.SEEK_END)
        length := source.tell()
        source.seek(pos)
        return length
    } catch Error {
        return -1
    }
}

