AhkStdlibPillowConvertColor(value, sourceMode, targetMode)
{
    if sourceMode = targetMode {
        if value is Array
            return value.Clone()
        return value
    }

    if sourceMode = "L" {
        gray := AhkStdlibPillowRequireByte(value)
        switch targetMode {
            case "1":
                return AhkStdlibPillowBoolColorValue(gray)
            case "RGB":
                return [gray, gray, gray]
            case "RGBA":
                return [gray, gray, gray, 255]
            case "LA":
                return [gray, 255]
        }
        return gray
    }

    if sourceMode = "1" {
        gray := AhkStdlibPillowBoolColorValue(value)
        switch targetMode {
            case "L":
                return gray
            case "RGB":
                return [gray, gray, gray]
            case "RGBA":
                return [gray, gray, gray, 255]
            case "LA":
                return [gray, 255]
        }
        return gray
    }

    values := AhkStdlibPillowSequenceToArray(value)
    if sourceMode = "LA" {
        gray := values[1], a := values[2]
        switch targetMode {
            case "L":
                return gray
            case "RGB":
                return [gray, gray, gray]
            case "RGBA":
                return [gray, gray, gray, a]
        }
    }

    if sourceMode = "RGB" {
        r := values[1], g := values[2], b := values[3]
        switch targetMode {
            case "L":
                return AhkStdlibPillowRgbToLuma(r, g, b)
            case "1":
                return AhkStdlibPillowBoolColorValue(AhkStdlibPillowRgbToLuma(r, g, b))
            case "RGBA":
                return [r, g, b, 255]
            case "LA":
                return [AhkStdlibPillowRgbToLuma(r, g, b), 255]
        }
    }

    if sourceMode = "RGBA" {
        r := values[1], g := values[2], b := values[3], a := values[4]
        switch targetMode {
            case "RGB":
                return [r, g, b]
            case "L":
                return AhkStdlibPillowRgbToLuma(r, g, b)
            case "1":
                return AhkStdlibPillowBoolColorValue(AhkStdlibPillowRgbToLuma(r, g, b))
            case "LA":
                return [AhkStdlibPillowRgbToLuma(r, g, b), a]
        }
    }

    throw ValueError("conversion from " sourceMode " to " targetMode " not supported", -1)
}

AhkStdlibPillowRgbToLuma(r, g, b)
{
    return Floor((r * 299 + g * 587 + b * 114) / 1000)
}

