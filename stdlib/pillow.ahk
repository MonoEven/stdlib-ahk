AhkStdlibPillowHasBuiltinEncoder(format)
{
    upper := StrUpper(format)
    return upper = "BMP" || upper = "JPEG" || upper = "GIF" || upper = "TIFF" || upper = "PNG"
}

AhkStdlibPillowEncoderClsid(format)
{
    static encoders := Map(
        "BMP", "{557CF400-1A04-11D3-9A73-0000F81EF32E}",
        "JPEG", "{557CF401-1A04-11D3-9A73-0000F81EF32E}",
        "GIF", "{557CF402-1A04-11D3-9A73-0000F81EF32E}",
        "TIFF", "{557CF405-1A04-11D3-9A73-0000F81EF32E}",
        "PNG", "{557CF406-1A04-11D3-9A73-0000F81EF32E}"
    )
    if !encoders.Has(format)
        throw ValueError("unknown file extension: " format, -1)
    clsid := Buffer(16, 0)
    if DllCall("ole32\CLSIDFromString", "WStr", encoders[format], "Ptr", clsid, "Int") != 0
        throw OSError("CLSIDFromString failed", -1)
    return clsid
}

AhkStdlibPillowCheckStatus(status, api)
{
    if status = 0
        return
    throw OSError(api " failed: " status, -1)
}

AhkStdlibPillowCheckHresult(hr, api)
{
    if hr >= 0
        return
    throw OSError(api " failed: 0x" Format("{:08X}", hr & 0xFFFFFFFF), -1)
}
