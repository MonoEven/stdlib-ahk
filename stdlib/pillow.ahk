AhkStdlibPillowImageWinBlankPixels(mode, size)
{
    rows := []
    pixel := mode = "RGB" ? [0, 0, 0] : 0
    loop size[2] {
        row := []
        loop size[1]
            row.Push(pixel is Array ? pixel.Clone() : pixel)
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowImageWinHandleToInteger(handle)
{
    if handle is Integer
        return handle
    if handle is AhkStdlibPillowImageWinHdc
        return handle.dc
    if handle is AhkStdlibPillowImageWinHwnd
        return handle.wnd
    try {
        return Integer(handle)
    } catch Error {
        throw ValueError("invalid literal for int() with base 10: '" String(handle) "'", -1)
    }
}

AhkStdlibPillowImageWinPixelForMode(pixel, mode)
{
    if mode = "RGB" {
        values := AhkStdlibPillowSequenceToArray(pixel)
        return [values[1], values[2], values[3]]
    }
    if mode = "1"
        return pixel ? 255 : 0
    return AhkStdlibPillowRequireByte(pixel)
}

AhkStdlibPillowImageWinStride(mode, width)
{
    bytesPerPixel := mode = "RGB" ? 3 : 1
    rowBytes := width * bytesPerPixel
    padding := Mod(4 - Mod(rowBytes, 4), 4)
    if padding = 4
        padding := 0
    return rowBytes + padding
}

AhkStdlibPillowImageWinPixelsToBytes(mode, size, pixels)
{
    width := size[1], height := size[2]
    bytes := []
    stride := AhkStdlibPillowImageWinStride(mode, width)
    rowBytes := mode = "RGB" ? width * 3 : width
    loop height {
        y := A_Index - 1
        row := pixels[y + 1]
        loop width {
            pixel := row[A_Index]
            if mode = "RGB" {
                values := AhkStdlibPillowSequenceToArray(pixel)
                bytes.Push(values[3])
                bytes.Push(values[2])
                bytes.Push(values[1])
            } else {
                bytes.Push(AhkStdlibPillowRequireByte(pixel))
            }
        }
        loop stride - rowBytes
            bytes.Push(0)
    }
    return bytes
}

AhkStdlibPillowImageWinPixelsFromBytes(mode, size, bytes)
{
    width := size[1], height := size[2]
    stride := AhkStdlibPillowImageWinStride(mode, width)
    rows := []
    loop height {
        y := A_Index - 1
        row := []
        rowStart := y * stride + 1
        loop width {
            offset := rowStart + (A_Index - 1) * (mode = "RGB" ? 3 : 1)
            if mode = "RGB"
                row.Push([bytes[offset + 2], bytes[offset + 1], bytes[offset]])
            else
                row.Push(bytes[offset])
        }
        rows.Push(row)
    }
    return rows
}

