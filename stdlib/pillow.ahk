    return stdlib.None
}

AhkStdlibPillowWebPSetFrame(self, frame)
{
    frameInfo := self.AhkStdlibWebPFrames[frame + 1]
    decoded := AhkStdlibPillowWebPDecodeImage(frameInfo.Bytes)
    if self.HasOwnProp("AhkStdlibWebPHasAlpha") && self.AhkStdlibWebPHasAlpha && decoded.mode != "RGBA"
        decoded := AhkStdlibPillowWebPReplaceWithConverted(decoded, "RGBA")
    oldHandle := self.AhkStdlibHandle
    self.AhkStdlibHandle := decoded.AhkStdlibHandle
    decoded.AhkStdlibHandle := 0
    if oldHandle
        DllCall("gdiplus\GdipDisposeImage", "Ptr", oldHandle)
    self.AhkStdlibMode := decoded.mode
    self.AhkStdlibWidth := decoded.width
    self.AhkStdlibHeight := decoded.height
    self.rawmode := decoded.mode = "RGB" ? "RGB" : "RGBA"
    self.info["timestamp"] := frameInfo.Timestamp
    self.info["duration"] := frameInfo.Duration
    return stdlib.None
}

