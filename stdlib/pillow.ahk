AhkStdlibPillowTiffSaveImage(image, fp)
{
    if image.mode = "L"
        return AhkStdlibPillowImageSaveBaselineTiff(image, fp)
    encoder := AhkStdlibPillowEncoderClsid("TIFF")
    if AhkStdlibPillowIsFileLikeSaveTarget(fp)
        return AhkStdlibPillowImageSaveBuiltinFileLike(image, fp, encoder)
    AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipSaveImageToFile", "Ptr", image.AhkStdlibHandle, "WStr", fp, "Ptr", encoder, "Ptr", 0), "GdipSaveImageToFile")
    return stdlib.None
}

AhkStdlibPillowTiffNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowTiffLooksLikeSource(actual[1]) && AhkStdlibPillowTiffLooksLikeSource(actual[2]) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length = 1 && !AhkStdlibPillowTiffLooksLikeSource(actual[1]) {
        actual := []
    }
    return actual
}

AhkStdlibPillowTiffLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowTiffSourceBytes(source)
{
    if AhkStdlibPillowIsOpenFileLike(source)
        return AhkStdlibPillowReadAllFileLikeBytes(source)
    fp := AhkStdlibPillowOpenFile(source)
    try {
        return AhkStdlibPillowByteSequence(fp.read())
    } finally {
        fp.close()
    }
}

AhkStdlibPillowTiffOpen(source)
{
    bytes := AhkStdlibPillowTiffSourceBytes(source)
    if !AhkStdlibPillowTiffAcceptPrefix(bytes)
        throw SyntaxError("not a TIFF file (header " AhkStdlibPillowTiffHeaderRepr(bytes) " not valid)", -1)
    try {
        decoded := AhkStdlibPillowWicDecodeToBgra(stdlib.io.BytesIO(bytes))
        image := AhkStdlibPillowImageFromWicDecoded(decoded)
        image.AhkStdlibFormat := "TIFF"
        image.info["compression"] := "raw"
        return image
    } catch Error as err {
        if err is SyntaxError
            throw err
        throw OSError("cannot identify image file " AhkStdlibPillowOpenSourceRepr(source), -1)
    }
}

AhkStdlibPillowTiffAcceptPrefix(prefix)
{
    bytes := AhkStdlibPillowByteSequence(prefix)
    if bytes.Length < 4
        return false
    for candidate in AhkStdlibPillowTiffImagePluginModule.PREFIXES {
        if bytes[1] = candidate[1] && bytes[2] = candidate[2] && bytes[3] = candidate[3] && bytes[4] = candidate[4]
            return true
    }
    return false
}

AhkStdlibPillowTiffHeaderRepr(bytes)
{
    header := AhkStdlibPillowArraySlice(bytes, 1, Min(4, bytes.Length))
    text := "b'"
    for byte in header {
        if byte >= 32 && byte <= 126 && byte != 39 && byte != 92
            text .= Chr(byte)
        else
            text .= Format("\x{:02x}", byte)
    }
    return text "'"
}

