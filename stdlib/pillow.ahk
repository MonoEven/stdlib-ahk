AhkStdlibPillowFeaturesModulesMap()
{
    static modules := Map(
        "pil", ["PIL._imaging", "PILLOW_VERSION"],
        "tkinter", ["PIL._tkinter_finder", "tk_version"],
        "freetype2", ["PIL._imagingft", "freetype2_version"],
        "littlecms2", ["PIL._imagingcms", "littlecms_version"],
        "webp", ["PIL._webp", "webpdecoder_version"],
        "avif", ["PIL._avif", "libavif_version"]
    )
    return modules
}

AhkStdlibPillowFeaturesCodecsMap()
{
    static codecs := Map(
        "jpg", ["jpeg", "jpeglib"],
        "jpg_2000", ["jpeg2k", "jp2klib"],
        "zlib", ["zip", "zlib"],
        "libtiff", ["libtiff", "libtiff"]
    )
    return codecs
}

AhkStdlibPillowFeaturesFeaturesMap()
{
    static features := Map(
        "webp_anim", ["PIL._webp", true, stdlib.None],
        "webp_mux", ["PIL._webp", true, stdlib.None],
        "transp_webp", ["PIL._webp", true, stdlib.None],
        "raqm", ["PIL._imagingft", "HAVE_RAQM", "raqm_version"],
        "fribidi", ["PIL._imagingft", "HAVE_FRIBIDI", "fribidi_version"],
        "harfbuzz", ["PIL._imagingft", "HAVE_HARFBUZZ", "harfbuzz_version"],
        "libjpeg_turbo", ["PIL._imaging", "HAVE_LIBJPEGTURBO", "libjpeg_turbo_version"],
        "mozjpeg", ["PIL._imaging", "HAVE_MOZJPEG", "libjpeg_turbo_version"],
        "zlib_ng", ["PIL._imaging", "HAVE_ZLIBNG", "zlib_ng_version"],
        "libimagequant", ["PIL._imaging", "HAVE_LIBIMAGEQUANT", "imagequant_version"],
        "xcb", ["PIL._imaging", "HAVE_XCB", stdlib.None]
    )
    return features
}

AhkStdlibPillowFeaturesCheck(args*)
{
    AhkStdlibPillowFeaturesRequireArity("check", args.Length, 1)
    name := String(args[1])
    if AhkStdlibPillowFeaturesModulesMap().Has(name)
        return AhkStdlibPillowFeaturesCheckKnown("module", name)
    if AhkStdlibPillowFeaturesFeaturesMap().Has(name)
        return AhkStdlibPillowFeaturesCheckKnown("feature", name)
    if AhkStdlibPillowFeaturesCodecsMap().Has(name)
        return AhkStdlibPillowFeaturesCheckKnown("codec", name)
    stdlib.warnings.warn("Unknown feature '" name "'.", stdlib.warnings.UserWarning, 2)
    return false
}

AhkStdlibPillowFeaturesCheckKind(kind, args*)
{
    functionName := "check_" kind
    AhkStdlibPillowFeaturesRequireArity(functionName, args.Length, 1)
    name := String(args[1])
    AhkStdlibPillowFeaturesRequireKnown(kind, name)
    return AhkStdlibPillowFeaturesCheckKnown(kind, name)
}

AhkStdlibPillowFeaturesCheckKnown(kind, name)
{
    if kind = "feature"
        AhkStdlibPillowFeaturesWarnDeprecated(name)
    support := AhkStdlibPillowFeaturesSupportMap(kind)
    return support.Has(name) && support[name]
}

AhkStdlibPillowFeaturesVersion(args*)
{
    AhkStdlibPillowFeaturesRequireArity("version", args.Length, 1)
    name := String(args[1])
    if AhkStdlibPillowFeaturesModulesMap().Has(name)
        return AhkStdlibPillowFeaturesVersionKnown("module", name)
    if AhkStdlibPillowFeaturesFeaturesMap().Has(name)
        return AhkStdlibPillowFeaturesVersionKnown("feature", name)
    if AhkStdlibPillowFeaturesCodecsMap().Has(name)
        return AhkStdlibPillowFeaturesVersionKnown("codec", name)
    return stdlib.None
}

AhkStdlibPillowFeaturesVersionKind(kind, args*)
{
    functionName := "version_" kind
    AhkStdlibPillowFeaturesRequireArity(functionName, args.Length, 1)
    name := String(args[1])
    AhkStdlibPillowFeaturesRequireKnown(kind, name)
    return AhkStdlibPillowFeaturesVersionKnown(kind, name)
}

AhkStdlibPillowFeaturesVersionKnown(kind, name)
{
    if kind = "feature"
        AhkStdlibPillowFeaturesWarnDeprecated(name)
    versions := AhkStdlibPillowFeaturesVersionMap(kind)
    return versions.Has(name) ? versions[name] : stdlib.None
}

AhkStdlibPillowFeaturesGetSupported(kind, args*)
{
    functionName := kind = "all" ? "get_supported" : "get_supported_" kind "s"
    AhkStdlibPillowFeaturesRequireArity(functionName, args.Length, 0)
    if kind = "all" {
        supported := []
        for name in AhkStdlibPillowFeaturesGetSupported("module")
            supported.Push(name)
        for name in AhkStdlibPillowFeaturesGetSupported("feature")
            supported.Push(name)
        for name in AhkStdlibPillowFeaturesGetSupported("codec")
            supported.Push(name)
        return supported
    }

    names := AhkStdlibPillowFeaturesNames(kind)
    support := AhkStdlibPillowFeaturesSupportMap(kind)
    supported := []
    for name in names {
        if support.Has(name) && support[name]
            supported.Push(name)
    }
    return supported
}

AhkStdlibPillowFeaturesPilinfo(args*)
{
    if args.Length > 2
        throw TypeError("pilinfo() takes from 0 to 2 positional arguments but " args.Length " were given", -1)
    out := args.Length >= 1 ? args[1] : stdlib.None
    supportedFormats := args.Length >= 2 ? args[2] : true
    text := "--------------------------------------------------------------------`n"
        . "Pillow 11.3.0`n"
        . "Python 3.10.11`n"
        . "--------------------------------------------------------------------`n"
        . "Python Pillow modules loaded from PIL`n"
        . "--------------------------------------------------------------------`n"
        . "--- PIL CORE support ok, compiled for 11.3.0`n"
        . "--- TKINTER support ok, loaded 8.6`n"
        . "--- JPEG support ok, compiled for libjpeg-turbo 3.1.1`n"
        . "Supported modules: " AhkStdlibPillowJoin(AhkStdlibPillowFeaturesGetSupported("module"), ", ") "`n"
        . "Supported codecs: " AhkStdlibPillowJoin(AhkStdlibPillowFeaturesGetSupported("codec"), ", ") "`n"
        . "Supported features: " AhkStdlibPillowJoin(AhkStdlibPillowFeaturesGetSupported("feature"), ", ") "`n"
    if supportedFormats
        text .= AhkStdlibPillowFeaturesPilinfoFormats()
    if IsObject(out) && HasMethod(out, "write")
        out.write(text)
    return stdlib.None
}

AhkStdlibPillowFeaturesPilinfoFormats()
{
    return "--------------------------------------------------------------------`n"
        . "JPEG image/jpeg`n"
        . "Extensions: .jfif, .jpe, .jpeg, .jpg`n"
        . "Features: open, save`n"
        . "--------------------------------------------------------------------`n"
        . "PNG image/png`n"
        . "Extensions: .apng, .png`n"
        . "Features: open, save, save_all`n"
        . "--------------------------------------------------------------------`n"
        . "TIFF image/tiff`n"
        . "Extensions: .tif, .tiff`n"
        . "Features: open, save, save_all`n"
}

AhkStdlibPillowFeaturesNames(kind)
{
    switch kind {
        case "module":
            return ["pil", "tkinter", "freetype2", "littlecms2", "webp", "avif"]
        case "codec":
            return ["jpg", "jpg_2000", "zlib", "libtiff"]
        case "feature":
            return ["webp_anim", "webp_mux", "transp_webp", "raqm", "fribidi", "harfbuzz", "libjpeg_turbo", "mozjpeg", "zlib_ng", "libimagequant", "xcb"]
    }
    throw ValueError("unknown features table", -1)
}

AhkStdlibPillowFeaturesSupportMap(kind)
{
    static modules := Map("pil", true, "tkinter", true, "freetype2", true, "littlecms2", true, "webp", true, "avif", true)
    static codecs := Map("jpg", true, "jpg_2000", true, "zlib", true, "libtiff", true)
    static features := Map(
        "webp_anim", true,
        "webp_mux", true,
        "transp_webp", true,
        "raqm", true,
        "fribidi", true,
        "harfbuzz", true,
        "libjpeg_turbo", true,
        "mozjpeg", false,
        "zlib_ng", true,
        "libimagequant", false,
        "xcb", false
    )
    switch kind {
        case "module":
            return modules
        case "codec":
            return codecs
        case "feature":
            return features
    }
    throw ValueError("unknown features table", -1)
}

AhkStdlibPillowFeaturesVersionMap(kind)
{
    static modules := Map(
        "pil", "11.3.0",
        "tkinter", "8.6",
        "freetype2", "2.13.3",
        "littlecms2", "2.17",
        "webp", "1.5.0",
        "avif", "1.3.0"
    )
    static codecs := Map(
        "jpg", "8.0",
        "jpg_2000", "2.5.3",
        "zlib", "1.3.1.zlib-ng",
        "libtiff", "4.7.0"
    )
    static features := Map(
        "webp_anim", stdlib.None,
        "webp_mux", stdlib.None,
        "transp_webp", stdlib.None,
        "raqm", "0.10.1",
        "fribidi", "1.0.5",
        "harfbuzz", "11.2.1",
        "libjpeg_turbo", "3.1.1",
        "mozjpeg", stdlib.None,
        "zlib_ng", "2.2.4",
        "libimagequant", stdlib.None,
        "xcb", stdlib.None
    )
    switch kind {
        case "module":
            return modules
        case "codec":
            return codecs
        case "feature":
            return features
    }
    throw ValueError("unknown features table", -1)
}

AhkStdlibPillowFeaturesRequireKnown(kind, name)
{
    if kind = "module" && AhkStdlibPillowFeaturesModulesMap().Has(name)
        return
    if kind = "codec" && AhkStdlibPillowFeaturesCodecsMap().Has(name)
        return
    if kind = "feature" && AhkStdlibPillowFeaturesFeaturesMap().Has(name)
        return
    throw ValueError("Unknown " kind " " name, -1)
}

AhkStdlibPillowFeaturesWarnDeprecated(name)
{
    if name = "transp_webp" || name = "webp_anim" || name = "webp_mux"
        stdlib.warnings.warn('check_feature("' name '") is deprecated and will be removed in Pillow 12 (2025-10-15)', stdlib.warnings.DeprecationWarning, 3)
}

AhkStdlibPillowFeaturesRequireArity(functionName, actual, expected)
{
    if actual = expected
        return
    if actual < expected
        throw TypeError(functionName "() missing " (expected - actual) " required positional argument" (expected - actual = 1 ? "" : "s") ": 'feature'", -1)
    throw TypeError(functionName "() takes " expected " positional argument" (expected = 1 ? "" : "s") " but " actual " " (actual = 1 ? "was" : "were") " given", -1)
}

