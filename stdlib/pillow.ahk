            return stdlib.None
        current := this.AhkStdlibDcxFrames[this.AhkStdlibDcxFrame + 1]
        current.AhkStdlibHandle := this.AhkStdlibHandle
        next := this.AhkStdlibDcxFrames[frame + 1]
        this.AhkStdlibHandle := next.AhkStdlibHandle
        next.AhkStdlibHandle := 0
        this.AhkStdlibMode := next.mode
        this.AhkStdlibWidth := next.width
        this.AhkStdlibHeight := next.height
        this.info := next.info
        this.AhkStdlibPaletteMode := next.AhkStdlibPaletteMode
        this.AhkStdlibPalette := next.AhkStdlibPalette
        this.AhkStdlibDcxFrame := frame
        return stdlib.None
    }

