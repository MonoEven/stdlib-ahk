AhkStdlibPillowAlphaCompositeColor(baseColor, overlayColor)
{
    dst := AhkStdlibPillowSequenceToArray(baseColor)
    src := AhkStdlibPillowSequenceToArray(overlayColor)
    srcA := src[4]
    dstA := dst[4]

    if srcA = 0
        return dst.Clone()
    if srcA = 255
        return src.Clone()

    outA := srcA + Floor((dstA * (255 - srcA) + 127) / 255)
    if outA = 0
        return [0, 0, 0, 0]

    out := []
    loop 3 {
        srcC := src[A_Index]
        dstC := dst[A_Index]
        value := Floor((srcC * srcA * 255 + dstC * dstA * (255 - srcA) + Floor(outA / 2)) / (outA * 255))
        if value < 0
            value := 0
        else if value > 255
            value := 255
        out.Push(value)
    }
    out.Push(outA)
    return out
}

