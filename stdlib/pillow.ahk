AhkStdlibPillowPointLut(sourceMode, targetMode, lut, targetModeProvided)
{
    if IsObject(lut) && HasMethod(lut, "Call") {
        if targetModeProvided && targetMode != sourceMode
            throw ValueError("wrong number of lut entries", -1)
        values := []
        loop 256
            values.Push(AhkStdlibPillowClampByte(lut.Call(A_Index - 1)))
        return { Values: values, Shared: true }
    }

    values := AhkStdlibPillowPointIterableToArray(lut)
    expected := AhkStdlibPillowPointExpectedLutLength(sourceMode, targetMode)
    if values.Length != expected
        throw ValueError("wrong number of lut entries", -1)
    if targetMode != sourceMode && !(sourceMode = "L" && (targetMode = "RGB" || targetMode = "RGBA"))
        throw ValueError("point operation not supported for this mode", -1)

    normalized := []
    for value in values
        normalized.Push(AhkStdlibPillowClampByte(value))
    return { Values: normalized, Shared: false }
}

AhkStdlibPillowPointIterableToArray(value)
{
    if AhkStdlibIsNone(value)
        throw TypeError("'NoneType' object is not iterable", -1)
    if value is Array
        return value.Clone()
    if IsObject(value) && HasMethod(value, "__Enum") {
        values := []
        for item in value
            values.Push(item)
        return values
    }
    throw TypeError("'" AhkStdlibPythonTypeName(value) "' object is not iterable", -1)
}

AhkStdlibPillowPointExpectedLutLength(sourceMode, targetMode)
{
    targetBands := StrLen(AhkStdlibPillowChannels(targetMode))
    if targetMode != sourceMode
        return targetBands * 256
    return Max(1, StrLen(AhkStdlibPillowChannels(sourceMode))) * 256
}

AhkStdlibPillowPointPixel(pixel, sourceMode, targetMode, lutData)
{
    values := lutData.Values
    if targetMode = sourceMode {
        if sourceMode = "L"
            return values[pixel + 1]
        channels := AhkStdlibPillowSequenceToArray(pixel)
        mapped := []
        for index, channelValue in channels {
            offset := lutData.Shared ? 0 : (index - 1) * 256
            mapped.Push(values[offset + channelValue + 1])
        }
        return mapped
    }

    gray := AhkStdlibPillowRequireByte(pixel)
    mapped := []
    loop StrLen(AhkStdlibPillowChannels(targetMode)) {
        offset := (A_Index - 1) * 256
        mapped.Push(values[offset + gray + 1])
    }
    return mapped
}

AhkStdlibPillowClampByte(value)
{
    if !(value is Number)
        throw TypeError("type " AhkStdlibPythonTypeName(value) " doesn't define __round__ method", -1)
    rounded := Round(value)
    if rounded < 0
        return 0
    if rounded > 255
        return 255
    return rounded
}

AhkStdlibPillowPasteRegion(target, source, box := unset)
{
    sourceIsImage := IsObject(source) && source.HasOwnProp("AhkStdlibHandle")
    if IsSet(box) {
        values := AhkStdlibPillowSequenceToArray(box)
        if values.Length = 2 {
            left := AhkStdlibPillowRequireInteger(values[1], "left")
            top := AhkStdlibPillowRequireInteger(values[2], "top")
            width := sourceIsImage ? source.width : target.width - left
            height := sourceIsImage ? source.height : target.height - top
        } else if values.Length = 4 {
            left := AhkStdlibPillowRequireInteger(values[1], "left")
            top := AhkStdlibPillowRequireInteger(values[2], "top")
            right := AhkStdlibPillowRequireInteger(values[3], "right")
            bottom := AhkStdlibPillowRequireInteger(values[4], "bottom")
            width := right - left
            height := bottom - top
        } else {
            throw TypeError("argument 2 must be sequence of length 4, not " values.Length, -1)
        }
    } else {
        left := 0
        top := 0
        width := sourceIsImage ? source.width : target.width
        height := sourceIsImage ? source.height : target.height
    }

    if width < 0 || height < 0
        throw ValueError("images do not match", -1)

    color := stdlib.None
    if !sourceIsImage
        color := AhkStdlibPillowConvertColor(AhkStdlibPillowColorToModeValue(source, target.mode), target.mode, target.mode)

    return { Left: left, Top: top, Width: width, Height: height, SourceIsImage: sourceIsImage, Color: color }
}

