        throw Error("unpack_from requires a buffer of at least " (offset + 4) " bytes for unpacking 4 bytes at offset " offset " (actual buffer size is " bytes.Length ")", -1)

    index := offset + 1
    return bytes[index]
        | (bytes[index + 1] << 8)
        | (bytes[index + 2] << 16)
        | (bytes[index + 3] << 24)
}

