AhkStdlibPillowImageOpsFit(image, size, method := unset, bleed := 0.0, centering := unset)
{
    if AhkStdlibIsNone(image)
        throw AttributeError("'NoneType' object has no attribute 'size'", -1)
    if IsSet(centering) && AhkStdlibIsNone(centering)
        throw TypeError("cannot unpack non-iterable NoneType object", -1)

    imageSize := image.size
    values := AhkStdlibPillowSequenceToArray(size)
    if values.Length < 2
        throw IndexError("tuple index out of range", -1)
    targetWidth := values[1]
    targetHeight := values[2]
    if targetHeight = 0
        throw ZeroDivisionError("division by zero", -1)
    outputRatio := targetWidth / targetHeight

    center := IsSet(centering) ? AhkStdlibPillowImageOpsCentering(centering) : [0.5, 0.5]
    centeringX := center[1]
    centeringY := center[2]
    if centeringX < 0.0 || centeringX > 1.0
        centeringX := 0.5
    if centeringY < 0.0 || centeringY > 1.0
        centeringY := 0.5
    if bleed < 0.0 || bleed >= 0.5
        bleed := 0.0

    bleedX := bleed * imageSize[1]
    bleedY := bleed * imageSize[2]
    liveWidth := imageSize[1] - bleedX * 2
    liveHeight := imageSize[2] - bleedY * 2
    liveRatio := liveWidth / liveHeight

    if liveRatio = outputRatio {
        cropWidth := liveWidth
        cropHeight := liveHeight
    } else if liveRatio >= outputRatio {
        cropWidth := outputRatio * liveHeight
        cropHeight := liveHeight
    } else {
        cropWidth := liveWidth
        cropHeight := liveWidth / outputRatio
    }

    left := Round(bleedX + (liveWidth - cropWidth) * centeringX)
    top := Round(bleedY + (liveHeight - cropHeight) * centeringY)
    right := Round(left + cropWidth)
    bottom := Round(top + cropHeight)
    if left = 0 && top = 0 && right = image.width && bottom = image.height && targetWidth = image.width && targetHeight = image.height
        return image.copy()

    cropped := image.crop([left, top, right, bottom])
    try {
        if targetWidth = cropped.width && targetHeight = cropped.height
            return cropped.copy()
        return cropped.resize([targetWidth, targetHeight])
    } finally {
        cropped.close()
    }
}

