        return defaultValue
    value := info[key]
    if value is Array {
        if frameIndex >= 1 && frameIndex <= value.Length
            return Integer(value[frameIndex])
        return defaultValue
    }
    return Integer(value)
}

AhkStdlibPillowGifPaletteRgb(palette, index)
{
