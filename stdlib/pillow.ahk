        open["L*" suffix " image"] := ["I;" suffix, "I;" suffix]
    }
    open["L 32S image"] := ["I", "I;32S"]
    open["L*32S image"] := ["I", "I;32S"]
    loop 31 {
        suffix := A_Index + 1
        open["L*" suffix " image"] := ["F", "F;" suffix]
    }
    return open
}

