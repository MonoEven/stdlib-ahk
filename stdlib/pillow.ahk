        langBytes := AhkStdlibPillowPngUtf8OrBytes(lang)
        tkeyBytes := AhkStdlibPillowPngUtf8OrBytes(tkey)
        payload := keyBytes.Clone()
        AhkStdlibPillowPngAppendBytes(payload, [0, zip ? 1 : 0, 0])
        AhkStdlibPillowPngAppendBytes(payload, langBytes)
        payload.Push(0)
        AhkStdlibPillowPngAppendBytes(payload, tkeyBytes)
        payload.Push(0)
        AhkStdlibPillowPngAppendBytes(payload, zip ? AhkStdlibPillowPngZlibStoreCompress(valueBytes) : valueBytes)
