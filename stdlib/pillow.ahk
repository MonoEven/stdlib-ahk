    values := AhkStdlibPillowRequireSize(size)
    width := values[1]
    height := values[2]
    handle := AhkStdlibPillowCreateBitmap(width, height, mode)
    image := AhkStdlibPillowImage(handle, mode, width, height, stdlib.None)

    fill := IsSet(color) ? AhkStdlibPillowNormalizeColor(color, mode) : AhkStdlibPillowDefaultColor(mode)
    argb := AhkStdlibPillowColorToArgb(fill, mode)
    loop height {
        y := A_Index - 1
        loop width {
            x := A_Index - 1
            AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipBitmapSetPixel", "Ptr", handle, "Int", x, "Int", y, "UInt", argb), "GdipBitmapSetPixel")
