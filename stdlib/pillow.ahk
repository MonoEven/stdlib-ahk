    bands := [
        AhkStdlibPillowImagePaletteLinearLut(0, rgb[1]),
        AhkStdlibPillowImagePaletteLinearLut(0, rgb[2]),
        AhkStdlibPillowImagePaletteLinearLut(0, rgb[3]),
    ]
    bytes := []
    loop 256 {
        i := A_Index
        bytes.Push(bands[1][i])
        bytes.Push(bands[2][i])
        bytes.Push(bands[3][i])
    }
    return bytes
}

AhkStdlibPillowImagePaletteLinearLut(black, white)
{
    if black != 0
        throw NotImplementedError("unavailable when black is non-zero", -1)
    lut := []
    loop 256
        lut.Push(Integer(Floor(white * (A_Index - 1) / 255)))
    return lut
}

AhkStdlibPillowImagePaletteGammaLut(exp)
{
    lut := []
    loop 256
        lut.Push(Integer(((A_Index - 1) / 255.0) ** exp * 255.0 + 0.5))
    return lut
}

AhkStdlibPillowImagePaletteSlice(values, startIndex, endIndex)
{
    result := []
    index := startIndex
    while index <= endIndex && index <= values.Length {
        if index >= 1
            result.Push(values[index])
        index += 1
    }
    return result
}

AhkStdlibPillowImageEntropy(image, mask := unset, extrema := unset)
{
    if IsSet(mask) && !AhkStdlibIsNone(mask) {
        if !IsObject(mask) || !mask.HasOwnProp("AhkStdlibHandle")
            throw AttributeError("'" AhkStdlibPythonTypeName(mask) "' object has no attribute 'load'", -1)
        if !AhkStdlibPillowImagesSameSize(image, mask)
            throw ValueError("images do not match", -1)
        if !(mask.mode = "L" || mask.mode = "1")
            throw ValueError("bad transparency mask", -1)
    }

    histogram := AhkStdlibPillowImageHistogram(image, mask?, extrema?)
    total := 0
    for count in histogram
        total += count
    if total = 0
        return 0.0

    entropy := 0.0
    log2 := Ln(2)
    for count in histogram {
        if count = 0
            continue
        probability := count / total
        entropy -= probability * (Ln(probability) / log2)
    }
    return entropy
}

AhkStdlibPillowImageReduce(image, factor, box := unset)
{
    if image.mode = "1" || image.mode = "P"
        throw ValueError("image has wrong mode", -1)

    factors := AhkStdlibPillowReduceFactor(factor)
    factorX := factors[1]
    factorY := factors[2]
    if factorX <= 0 || factorY <= 0
        throw ValueError("scale must be > 0", -1)

    if IsSet(box) && !AhkStdlibIsNone(box) {
        bounds := AhkStdlibPillowReduceBox(image, box)
    } else {
        bounds := [0, 0, image.width, image.height]
    }

    if factorX = 1 && factorY = 1 && bounds[1] = 0 && bounds[2] = 0 && bounds[3] = image.width && bounds[4] = image.height
        return image.copy()

    sourceWidth := bounds[3] - bounds[1]
    sourceHeight := bounds[4] - bounds[2]
    targetWidth := Ceil(sourceWidth / factorX)
    targetHeight := Ceil(sourceHeight / factorY)
    result := AhkStdlibPillowImageNew(image.mode, [targetWidth, targetHeight], AhkStdlibPillowDefaultColor(image.mode))
    try {
        loop targetHeight {
            targetY := A_Index - 1
            top := bounds[2] + targetY * factorY
            bottom := Min(bounds[4], top + factorY)
            loop targetWidth {
                targetX := A_Index - 1
                left := bounds[1] + targetX * factorX
                right := Min(bounds[3], left + factorX)
                result.putpixel([targetX, targetY], AhkStdlibPillowReduceAveragePixel(image, left, top, right, bottom))
            }
        }
    } catch Error as err {
        result.close()
        throw err
    }
    AhkStdlibPillowCopyExif(image, result)
    return result
}

AhkStdlibPillowReduceFactor(factor)
{
    if factor is Array {
        if factor.Length != 2
            throw TypeError("argument 1 must be sequence of length 2, not " factor.Length, -1)
        return [AhkStdlibPillowRequireInteger(factor[1], "factor"), AhkStdlibPillowRequireInteger(factor[2], "factor")]
    }
    if IsObject(factor) && HasMethod(factor, "__Enum") {
        values := AhkStdlibPillowSequenceToArray(factor)
        if values.Length != 2
            throw TypeError("argument 1 must be sequence of length 2, not " values.Length, -1)
        return [AhkStdlibPillowRequireInteger(values[1], "factor"), AhkStdlibPillowRequireInteger(values[2], "factor")]
    }
    value := AhkStdlibPillowRequireInteger(factor, "factor")
    return [value, value]
}

AhkStdlibPillowReduceBox(image, box)
{
    values := AhkStdlibPillowSequenceToArray(box)
    if values.Length != 4
        throw TypeError("argument 2 must be sequence of length 4, not " values.Length, -1)
    left := AhkStdlibPillowRequireInteger(values[1], "left")
    top := AhkStdlibPillowRequireInteger(values[2], "top")
    right := AhkStdlibPillowRequireInteger(values[3], "right")
    bottom := AhkStdlibPillowRequireInteger(values[4], "bottom")
    if left < 0 || top < 0
        throw ValueError("box offset can't be negative", -1)
    if right > image.width || bottom > image.height
        throw ValueError("box can't exceed original image size", -1)
    if right <= left || bottom <= top
        throw ValueError("box can't be empty", -1)
    return [left, top, right, bottom]
}

AhkStdlibPillowReduceAveragePixel(image, left, top, right, bottom)
{
    mode := image.mode
    channels := StrLen(AhkStdlibPillowChannels(mode))
    sums := []
    loop channels
        sums.Push(0)
    count := 0

    y := top
    while y < bottom {
        x := left
        while x < right {
            pixel := image.getpixel([x, y])
            loop channels
                sums[A_Index] += AhkStdlibPillowPixelChannel(pixel, mode, A_Index)
            count += 1
            x += 1
        }
        y += 1
    }

    if mode = "L"
        return Round(sums[1] / count)

    averaged := []
    loop channels
        averaged.Push(Round(sums[A_Index] / count))
    return averaged
}

AhkStdlibPillowImageEffectSpread(image, distance)
{
    dist := AhkStdlibPillowRequireInteger(distance, "distance")
    if dist <= 0
        return image.copy()

    result := AhkStdlibPillowImageNew(image.mode, image.size, AhkStdlibPillowDefaultColor(image.mode))
    try {
        loop image.height {
            y := A_Index - 1
            loop image.width {
                x := A_Index - 1
                xx := x + Random(0, dist - 1) - dist // 2
                yy := y + Random(0, dist - 1) - dist // 2
                if xx >= 0 && xx < image.width && yy >= 0 && yy < image.height {
                    result.putpixel([xx, yy], image.getpixel([x, y]))
                    result.putpixel([x, y], image.getpixel([xx, yy]))
                } else {
                    result.putpixel([x, y], image.getpixel([x, y]))
                }
            }
        }
    } catch Error as err {
        result.close()
        throw err
    }
    AhkStdlibPillowCopyExif(image, result)
    return result
}

AhkStdlibPillowImageThumbnail(image, size, resample := unset, reducingGap := 2.0)
{
    values := AhkStdlibPillowThumbnailSize(size)
    targetWidth := values[1]
    targetHeight := values[2]
    if targetWidth = 0 || targetHeight = 0
        throw ZeroDivisionError("division by zero", -1)
    if IsSet(reducingGap) && !AhkStdlibIsNone(reducingGap) && !(reducingGap is Number)
        throw ValueError("invalid literal for int() with base 10: '" reducingGap reducingGap reducingGap "'", -1)

    finalSize := AhkStdlibPillowThumbnailPreserveAspect(image.width, image.height, targetWidth, targetHeight)
    if AhkStdlibIsNone(finalSize)
        return stdlib.None

    if image.width = finalSize[1] && image.height = finalSize[2]
        return stdlib.None

    resized := AhkStdlibPillowImageThumbnailResize(image, finalSize)
    AhkStdlibPillowReplaceImage(image, resized)
    return stdlib.None
}

AhkStdlibPillowThumbnailSize(size)
{
    if AhkStdlibIsNone(size)
        throw TypeError("'NoneType' object is not iterable", -1)
    if size is String {
        if StrLen(size) < 2
            throw ValueError("not enough values to unpack (expected 2, got " StrLen(size) ")", -1)
        if !IsNumber(SubStr(size, 1, 1)) || !IsNumber(SubStr(size, 2, 1))
            throw TypeError("must be real number, not str", -1)
    }

    values := AhkStdlibPillowSequenceToArray(size)
    if values.Length < 2
        throw ValueError("not enough values to unpack (expected 2, got " values.Length ")", -1)
    if !(values[1] is Number)
        throw TypeError("must be real number, not " AhkStdlibPythonTypeName(values[1]), -1)
    if !(values[2] is Number)
        throw TypeError("must be real number, not " AhkStdlibPythonTypeName(values[2]), -1)
    return [Floor(values[1]), Floor(values[2])]
}

AhkStdlibPillowThumbnailPreserveAspect(width, height, targetWidth, targetHeight)
{
    if targetWidth >= width && targetHeight >= height
        return stdlib.None

    aspect := width / height
    if targetWidth / targetHeight >= aspect {
        targetWidth := AhkStdlibPillowThumbnailRoundAspect(targetHeight * aspect, (value) => Abs(aspect - value / targetHeight))
    } else {
        targetHeight := AhkStdlibPillowThumbnailRoundAspect(targetWidth / aspect, (value) => value = 0 ? 0 : Abs(aspect - targetWidth / value))
    }
    return [targetWidth, targetHeight]
}

AhkStdlibPillowThumbnailRoundAspect(number, key)
{
    floorValue := Floor(number)
    ceilValue := Ceil(number)
    if key.Call(floorValue) <= key.Call(ceilValue)
        return Max(floorValue, 1)
    return Max(ceilValue, 1)
}

AhkStdlibPillowImageThumbnailResize(image, size)
{
    targetWidth := size[1]
    targetHeight := size[2]
    horizontal := AhkStdlibPillowImageThumbnailResizeHorizontal(image, targetWidth)
    try {
        return AhkStdlibPillowImageThumbnailResizeVertical(horizontal, targetHeight)
    } finally {
        horizontal.close()
    }
}

AhkStdlibPillowImageThumbnailResizeHorizontal(image, targetWidth)
{
    result := AhkStdlibPillowImageNew(image.mode, [targetWidth, image.height], AhkStdlibPillowDefaultColor(image.mode))
    try {
        loop image.height {
            y := A_Index - 1
            loop targetWidth {
                x := A_Index - 1
                result.putpixel([x, y], AhkStdlibPillowThumbnailResampleHorizontalPixel(image, x, y, targetWidth))
            }
        }
    } catch Error as err {
        result.close()
        throw err
    }
    AhkStdlibPillowCopyExif(image, result)
    return result
}

AhkStdlibPillowImageThumbnailResizeVertical(image, targetHeight)
{
    targetWidth := image.width
    result := AhkStdlibPillowImageNew(image.mode, [targetWidth, targetHeight], AhkStdlibPillowDefaultColor(image.mode))
    try {
        loop targetHeight {
            y := A_Index - 1
            loop targetWidth {
                x := A_Index - 1
                result.putpixel([x, y], AhkStdlibPillowThumbnailResampleVerticalPixel(image, x, y, targetHeight))
            }
        }
    } catch Error as err {
        result.close()
        throw err
    }
    AhkStdlibPillowCopyExif(image, result)
    return result
}

AhkStdlibPillowThumbnailResampleHorizontalPixel(image, targetX, y, targetWidth)
{
    mode := image.mode
    channels := StrLen(AhkStdlibPillowChannels(mode))
    scaleX := image.width / targetWidth
    centerX := (targetX + 0.5) * scaleX
    filterScaleX := Max(1, scaleX)
    supportX := 2 * filterScaleX
    left := Floor(centerX - supportX + 0.5)
    right := Floor(centerX + supportX + 0.5)

    sums := []
    loop channels
        sums.Push(0.0)
    totalWeight := 0.0

    x := left
    while x < right {
        if x >= 0 && x < image.width {
            weight := AhkStdlibPillowThumbnailCubic(((x + 0.5) - centerX) / filterScaleX)
            if weight != 0 {
                pixel := image.getpixel([x, y])
                loop channels
                    sums[A_Index] += AhkStdlibPillowPixelChannel(pixel, mode, A_Index) * weight
                totalWeight += weight
            }
        }
        x += 1
    }

    if totalWeight = 0
        return image.getpixel([Min(image.width - 1, Floor(centerX)), y])

    if mode = "L"
        return AhkStdlibPillowClampByte(Floor(sums[1] / totalWeight + 0.5))

    values := []
    loop channels
        values.Push(AhkStdlibPillowClampByte(Floor(sums[A_Index] / totalWeight + 0.5)))
    return values
}

AhkStdlibPillowThumbnailResampleVerticalPixel(image, x, targetY, targetHeight)
{
    mode := image.mode
    channels := StrLen(AhkStdlibPillowChannels(mode))
    scaleY := image.height / targetHeight
    centerY := (targetY + 0.5) * scaleY
    filterScaleY := Max(1, scaleY)
    supportY := 2 * filterScaleY
    top := Floor(centerY - supportY + 0.5)
    bottom := Floor(centerY + supportY + 0.5)

    sums := []
    loop channels
        sums.Push(0.0)
    totalWeight := 0.0

    y := top
    while y < bottom {
        if y >= 0 && y < image.height {
            weight := AhkStdlibPillowThumbnailCubic(((y + 0.5) - centerY) / filterScaleY)
            if weight != 0 {
                pixel := image.getpixel([x, y])
                loop channels
                    sums[A_Index] += AhkStdlibPillowPixelChannel(pixel, mode, A_Index) * weight
                totalWeight += weight
            }
        }
        y += 1
    }

    if totalWeight = 0
        return image.getpixel([x, Min(image.height - 1, Floor(centerY))])

    if mode = "L"
        return AhkStdlibPillowClampByte(Floor(sums[1] / totalWeight + 0.5))

    values := []
    loop channels
        values.Push(AhkStdlibPillowClampByte(Floor(sums[A_Index] / totalWeight + 0.5)))
    return values
}

AhkStdlibPillowThumbnailCubic(value)
{
    x := Abs(value)
    a := -0.5
    if x < 1
        return 1 + x * x * ((a + 2) * x - (a + 3))
    if x < 2
        return x * (x * (a * x - 5 * a) + 8 * a) - 4 * a
    return 0
}

AhkStdlibPillowImageGetProjection(image)
{
    xProjection := []
    yProjection := []
    loop image.width
        xProjection.Push(0)
    loop image.height
        yProjection.Push(0)

    loop image.height {
        y := A_Index - 1
        loop image.width {
            x := A_Index - 1
            pixel := image.getpixel([x, y])
            channels := StrLen(AhkStdlibPillowChannels(image.mode))
            loop channels {
                if AhkStdlibPillowPixelChannel(pixel, image.mode, A_Index) != 0 {
                    xProjection[x + 1] := 1
                    yProjection[y + 1] := 1
                    break
                }
            }
        }
    }
    return [xProjection, yProjection]
}

AhkStdlibPillowImageGetData(image, band := unset)
{
    if IsSet(band) && !AhkStdlibIsNone(band)
        bandIndex := AhkStdlibPillowChannelIndex(image.mode, band) + 1
    else
        bandIndex := 0

    data := []
    loop image.height {
        y := A_Index - 1
        loop image.width {
            pixel := image.getpixel([A_Index - 1, y])
            if bandIndex
                data.Push(AhkStdlibPillowPixelChannel(pixel, image.mode, bandIndex))
            else if IsObject(pixel) && pixel is Array
                data.Push(pixel.Clone())
            else
                data.Push(pixel)
        }
    }
    return data
}

AhkStdlibPillowImageToBytes(image, encoderName := "raw", args*)
{
    if encoderName != "raw"
        return AhkStdlibPillowImageToRegisteredBytes(image, encoderName, args*)

    if image.mode = "1"
        return AhkStdlibPillowImageToPackedBits(image)

    bytes := []
    channels := StrLen(AhkStdlibPillowChannels(image.mode))
    loop image.height {
        y := A_Index - 1
        loop image.width {
            pixel := image.getpixel([A_Index - 1, y])
            loop channels
                bytes.Push(AhkStdlibPillowPixelChannel(pixel, image.mode, A_Index))
        }
    }
    return bytes
}

AhkStdlibPillowImageToBitmap(image, name := "image")
{
    if image.mode != "1"
        throw ValueError("not a bitmap", -1)

    if AhkStdlibIsNone(name)
        name := "image"
    name := String(name)
    packedBytes := AhkStdlibPillowImageToXbmBytes(image)
    text := "#define " name "_width " image.width "`n"
        . "#define " name "_height " image.height "`n"
        . "static char " name "_bits[] = {`n"
        . AhkStdlibPillowXbmByteLines(packedBytes)
        . "`n};"
    return AhkStdlibPillowAsciiBytes(text)
}

AhkStdlibPillowImageToXbmBytes(image)
{
    bytes := []
    current := 0
    bit := 0
    loop image.height {
        y := A_Index - 1
        loop image.width {
            value := image.getpixel([A_Index - 1, y]) ? 1 : 0
            current |= value << bit
            bit += 1
            if bit = 8 {
                bytes.Push(current)
                current := 0
                bit := 0
            }
        }
        if bit != 0 {
            bytes.Push(current)
            current := 0
            bit := 0
        }
    }
    return bytes
}

AhkStdlibPillowXbmByteLines(bytes)
{
    parts := []
    for value in bytes
        parts.Push(Format("0x{:02x}", value))
    return AhkStdlibPillowJoin(parts, ", ")
}

AhkStdlibPillowAsciiBytes(text)
{
    bytes := []
    loop parse text
        bytes.Push(Ord(A_LoopField))
    return bytes
}

AhkStdlibPillowImageFromBytes(image, data, decoderName := "raw", args*)
{
    if decoderName != "raw"
        return AhkStdlibPillowImageFromRegisteredBytes(image, data, decoderName, args*)

    bytes := AhkStdlibPillowByteSequence(data)
    required := image.mode = "1" ? Ceil(image.width / 8) * image.height : image.width * image.height * StrLen(AhkStdlibPillowChannels(image.mode))
    if bytes.Length < required
        throw ValueError("not enough image data", -1)

    if image.mode = "1" {
        AhkStdlibPillowImageFromPackedBits(image, bytes)
        return stdlib.None
    }

    channels := StrLen(AhkStdlibPillowChannels(image.mode))
    offset := 1
    loop image.height {
        y := A_Index - 1
        loop image.width {
            x := A_Index - 1
            if channels = 1 {
                image.putpixel([x, y], bytes[offset])
                offset += 1
            } else {
                pixel := []
                loop channels {
                    pixel.Push(bytes[offset])
                    offset += 1
                }
                image.putpixel([x, y], pixel)
            }
        }
    }
    return stdlib.None
}

AhkStdlibPillowImageFromRegisteredBytes(image, data, decoderName, args*)
{
    decoderMap := AhkStdlibPillowRegistryMap("DECODERS")
    if !decoderMap.Has(decoderName)
        throw OSError("decoder " decoderName " not available", -1)

    decoder := AhkStdlibPillowCreateCodec(decoderMap[decoderName], image.mode, args*)
    if !IsObject(decoder) || !HasMethod(decoder, "decode")
        throw TypeError("decoder must define decode", -1)
    if HasMethod(decoder, "setimage")
        decoder.setimage(image)

    bytes := AhkStdlibPillowByteSequence(data)
    result := AhkStdlibPillowSequenceToArray(decoder.decode(bytes))
    if result.Length < 2
        throw ValueError("cannot decode image data", -1)
    if result[1] >= 0
        throw ValueError("not enough image data", -1)
    if result[2] != 0
        throw ValueError("cannot decode image data", -1)
    if result.Length >= 3
        AhkStdlibPillowImageFromBytes(image, result[3], "raw")
    return stdlib.None
}

AhkStdlibPillowImageToRegisteredBytes(image, encoderName, args*)
{
    encoderMap := AhkStdlibPillowRegistryMap("ENCODERS")
    if !encoderMap.Has(encoderName)
        throw OSError("encoder " encoderName " not available", -1)

    encoder := AhkStdlibPillowCreateCodec(encoderMap[encoderName], image.mode, args*)
    if !IsObject(encoder) || !HasMethod(encoder, "encode")
        throw TypeError("encoder must define encode", -1)
    if HasMethod(encoder, "setimage")
        encoder.setimage(image)

    output := []
    bufsize := Max(65536, image.width * 4)
    loop {
        result := AhkStdlibPillowSequenceToArray(encoder.encode(bufsize))
        if result.Length < 3
            throw RuntimeError("encoder error -1 in tobytes", -1)
        for byte in AhkStdlibPillowByteSequence(result[3])
            output.Push(byte)
        if result[2] {
            if result[2] < 0
                throw RuntimeError("encoder error " result[2] " in tobytes", -1)
            break
        }
    }
    return output
}

AhkStdlibPillowCreateCodec(factory, mode, args*)
{
    if args.Length = 1 && IsObject(args[1]) && HasMethod(args[1], "__Enum")
        args := AhkStdlibPillowSequenceToArray(args[1])
    if IsObject(factory) && HasMethod(factory, "Call")
        return factory(mode, args*)
    throw TypeError("codec factory must be callable", -1)
}

AhkStdlibPillowResolveSaveFormat(path, format := unset)
{
    if IsSet(format) && !AhkStdlibIsNone(format)
        return StrUpper(format)
    if AhkStdlibPillowIsFileLikeSaveTarget(path)
        return AhkStdlibPillowFormatFromPath("", true)
    return AhkStdlibPillowFormatFromPath(path, true)
}

AhkStdlibPillowHasCustomSaveHandler(format, params := unset)
{
    upper := StrUpper(format)
    if AhkStdlibPillowShouldUseSaveAll(upper, params?)
        return AhkStdlibPillowRegistryMap("SAVE_ALL").Has(upper)
    return AhkStdlibPillowRegistryMap("SAVE").Has(upper)
}

AhkStdlibPillowShouldUseSaveAll(format, params := unset)
{
    if !IsSet(params) || AhkStdlibIsNone(params) || !IsObject(params)
        return false
    if HasProp(params, "save_all") && params.save_all
        return true
    if HasProp(params, "append_images") && AhkStdlibPillowRegistryMap("SAVE_ALL").Has(format)
        return true
    return false
}

AhkStdlibPillowImageSaveRegistered(image, path, format, params := unset)
{
    upper := StrUpper(format)
    useSaveAll := AhkStdlibPillowShouldUseSaveAll(upper, params?)
    saveMap := useSaveAll ? AhkStdlibPillowRegistryMap("SAVE_ALL") : AhkStdlibPillowRegistryMap("SAVE")
    if !saveMap.Has(upper)
        throw KeyError(upper, -1)

    info := AhkStdlibPillowSaveParamsToMap(params?)
    previousEncoderInfoWasSet := image.HasOwnProp("encoderinfo")
    previousEncoderInfo := previousEncoderInfoWasSet ? image.encoderinfo : unset
    previousDefaultWasSet := image.HasOwnProp("_default_encoderinfo")
    previousDefault := previousDefaultWasSet ? image._default_encoderinfo : unset
    fileLike := AhkStdlibPillowIsFileLikeSaveTarget(path)
    filename := fileLike ? "" : path
    created := !fileLike && !FileExist(path)
    fp := unset
    closeFp := false
    try {
        image._default_encoderinfo := AhkStdlibPillowCloneMap(info)
        image.encoderinfo := AhkStdlibPillowCloneMap(info)
        if fileLike {
            fp := path
        } else {
            fp := AhkStdlibPillowSaveFile(path)
            closeFp := true
        }
        saveMap[upper](image, fp, filename)
    } catch Error as err {
        if closeFp && IsSet(fp)
            fp.close()
        if created && FileExist(path)
            FileDelete path
        throw err
    } finally {
        if closeFp && IsSet(fp)
            fp.close()
        if previousEncoderInfoWasSet
            image.encoderinfo := previousEncoderInfo
        else if image.HasOwnProp("encoderinfo")
            image.DeleteProp("encoderinfo")
        if previousDefaultWasSet
            image._default_encoderinfo := previousDefault
        else if image.HasOwnProp("_default_encoderinfo")
            image.DeleteProp("_default_encoderinfo")
    }
    return stdlib.None
}

AhkStdlibPillowIsFileLikeSaveTarget(target)
{
    return IsObject(target) && HasMethod(target, "write")
}

AhkStdlibPillowImageSaveBuiltinFileLike(image, target, encoder)
{
    stream := 0
    hglobal := 0
    locked := 0
    try {
        AhkStdlibPillowCheckHresult(DllCall("ole32\CreateStreamOnHGlobal", "Ptr", 0, "Int", true, "Ptr*", &stream, "Int"), "CreateStreamOnHGlobal")
        AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipSaveImageToStream", "Ptr", image.AhkStdlibHandle, "Ptr", stream, "Ptr", encoder, "Ptr", 0), "GdipSaveImageToStream")
        AhkStdlibPillowCheckHresult(DllCall("ole32\GetHGlobalFromStream", "Ptr", stream, "Ptr*", &hglobal, "Int"), "GetHGlobalFromStream")
        size := DllCall("kernel32\GlobalSize", "Ptr", hglobal, "UPtr")
        locked := DllCall("kernel32\GlobalLock", "Ptr", hglobal, "Ptr")
        if !locked && size > 0
            throw OSError("GlobalLock failed", -1)
        bytes := []
        loop size
            bytes.Push(NumGet(locked, A_Index - 1, "UChar"))
        target.write(bytes)
    } finally {
        if locked
            DllCall("kernel32\GlobalUnlock", "Ptr", hglobal, "Int")
        if stream
            ObjRelease(stream)
    }
    return stdlib.None
}

AhkStdlibPillowImageSaveBaselineTiff(image, target)
{
    bytes := AhkStdlibPillowImageToBaselineTiffBytes(image)
    if AhkStdlibPillowIsFileLikeSaveTarget(target) {
        target.write(bytes)
        return stdlib.None
    }

    fp := AhkStdlibPillowSaveFile(target)
    try {
        fp.write(bytes)
    } finally {
        fp.close()
    }
    return stdlib.None
}

AhkStdlibPillowImageToBaselineTiffBytes(image)
{
    if image.mode != "L"
        throw ValueError("baseline TIFF encoder only supports L mode", -1)

    pixelBytes := image.tobytes()
    entryCount := 9
    ifdOffset := 8
    dataOffset := ifdOffset + 2 + entryCount * 12 + 4
    bytes := [73, 73, 42, 0]
    AhkStdlibPillowTiffPushU32(bytes, ifdOffset)
    AhkStdlibPillowTiffPushU16(bytes, entryCount)
    AhkStdlibPillowTiffPushEntry(bytes, 256, 4, 1, image.width)
    AhkStdlibPillowTiffPushEntry(bytes, 257, 4, 1, image.height)
    AhkStdlibPillowTiffPushEntry(bytes, 258, 3, 1, 8)
    AhkStdlibPillowTiffPushEntry(bytes, 259, 3, 1, 1)
    AhkStdlibPillowTiffPushEntry(bytes, 262, 3, 1, 1)
    AhkStdlibPillowTiffPushEntry(bytes, 273, 4, 1, dataOffset)
    AhkStdlibPillowTiffPushEntry(bytes, 278, 4, 1, Max(image.height, 1))
    AhkStdlibPillowTiffPushEntry(bytes, 279, 4, 1, pixelBytes.Length)
    AhkStdlibPillowTiffPushEntry(bytes, 284, 3, 1, 1)
    AhkStdlibPillowTiffPushU32(bytes, 0)
    for byte in pixelBytes
        bytes.Push(AhkStdlibPillowRequireByte(byte))
    return bytes
}

AhkStdlibPillowTiffPushEntry(bytes, tag, typeValue, count, value)
{
    AhkStdlibPillowTiffPushU16(bytes, tag)
    AhkStdlibPillowTiffPushU16(bytes, typeValue)
    AhkStdlibPillowTiffPushU32(bytes, count)
    if (typeValue = 3 || typeValue = 8) && count = 1 {
        AhkStdlibPillowTiffPushU16(bytes, value)
        AhkStdlibPillowTiffPushU16(bytes, 0)
    } else {
        AhkStdlibPillowTiffPushU32(bytes, value)
    }
    return stdlib.None
}

AhkStdlibPillowTiffPushU16(bytes, value)
{
    bytes.Push(value & 0xFF)
    bytes.Push((value >> 8) & 0xFF)
    return stdlib.None
}

AhkStdlibPillowTiffPushU32(bytes, value)
{
    bytes.Push(value & 0xFF)
    bytes.Push((value >> 8) & 0xFF)
    bytes.Push((value >> 16) & 0xFF)
    bytes.Push((value >> 24) & 0xFF)
    return stdlib.None
}

AhkStdlibPillowSaveParamsToMap(params := unset)
{
    result := Map()
    if !IsSet(params) || AhkStdlibIsNone(params)
        return result
    if params is Map {
        for key, value in params
            if key != "save_all"
                result[key] := value
        return result
    }
    if IsObject(params) {
        for name in params.OwnProps()
            if name != "save_all"
                result[name] := params.%name%
        return result
    }
    throw TypeError("save parameters must be an object", -1)
}

class AhkStdlibPillowSaveFile
{
    __New(path)
    {
        this.path := path
        this.file := FileOpen(path, "w")
        this.closed := false
    }

    write(data)
    {
        bytes := AhkStdlibPillowByteSequence(data)
        if bytes.Length = 0
            return 0
        bytesBuffer := Buffer(bytes.Length, 0)
        for index, byte in bytes
            NumPut("UChar", AhkStdlibPillowRequireByte(byte), bytesBuffer, index - 1)
        this.file.RawWrite(bytesBuffer, bytesBuffer.Size)
        return bytes.Length
    }

    close()
    {
        if !this.closed {
            this.file.Close()
            this.closed := true
            this.file := stdlib.None
        }
        return stdlib.None
    }

    name
    {
        get => this.path
    }
}

class AhkStdlibPillowOpenFile
{
    __New(path)
    {
        this.path := path
        this.file := FileOpen(path, "r", "UTF-8-RAW")
        this.file.Pos := 0
        this.mode := "rb"
        this.closed := false
