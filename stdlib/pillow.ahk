AhkStdlibPillowSgiOpen(source)
{
    bytes := AhkStdlibPillowSgiSourceBytes(source)
    if bytes.Length < 512 || !AhkStdlibPillowSgiAcceptPrefix(AhkStdlibPillowArraySlice(bytes, 1, Min(bytes.Length, 2)))
