AhkStdlibPillowPpmModesMap()
{
    static modes := unset
    if IsSet(modes)
        return modes
    modes := Map(
        "P1", "1",
        "P2", "L",
        "P3", "RGB",
        "P4", "1",
        "P5", "L",
        "P6", "RGB",
        "P0CMYK", "CMYK",
        "Pf", "F",
        "PyP", "P",
        "PyRGBA", "RGBA",
        "PyCMYK", "CMYK"
    )
