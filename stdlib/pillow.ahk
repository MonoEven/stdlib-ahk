{
    if AhkStdlibPillowIsOpenFileLike(source) {
        source.seek(0)
        return AhkStdlibPillowByteSequence(source.read())
    }
    return AhkStdlibPillowReadFileBytes(source)
}

AhkStdlibPillowSgiTile(mode, width, height, zsize, bpc, compression)
{
    bbox := [0, 0, width, height]
    if compression = 1
        return [["sgi_rle", bbox, 512, [mode, -1, bpc]]]
    if bpc = 2
        return [["SGI16", bbox, 512, [mode, 0, -1]]]

    tile := []
    channelNames := AhkStdlibPillowChannels(mode)
    planeSize := width * height * bpc
    loop zsize {
        channel := SubStr(channelNames, A_Index, 1)
        tile.Push(["raw", bbox.Clone(), 512 + (A_Index - 1) * planeSize, [channel, 0, -1]])
    }
    if tile.Length = 1
        tile[1][4][1] := mode
    return tile
}

AhkStdlibPillowSgiDecodeRawRows(bytes, width, height, zsize, bpc, mode)
{
    planes := AhkStdlibPillowSgiBlankPlanes(zsize, width, height)
    offset := 513
    loop zsize {
        channel := A_Index
        loop height {
            fileY := A_Index - 1
            destY := height - 1 - fileY
            loop width {
                x := A_Index - 1
                value := 0
                if offset <= bytes.Length
                    value := bytes[offset]
                offset += bpc
                planes[channel][destY * width + x + 1] := value
            }
        }
    }
    return AhkStdlibPillowSgiRowsFromPlanes(planes, width, height, mode)
}

AhkStdlibPillowSgiDecodeRleRows(bytes, width, height, zsize, bpc, mode)
{
    count := height * zsize
    planes := AhkStdlibPillowSgiBlankPlanes(zsize, width, height)
    loop zsize {
        channel := A_Index
        loop height {
            fileY := A_Index - 1
            tableIndex := (channel - 1) * height + fileY
            rowOffset := AhkStdlibPillowSgiReadU32Safe(bytes, 513 + tableIndex * 4) + 1
            rowLength := AhkStdlibPillowSgiReadU32Safe(bytes, 513 + count * 4 + tableIndex * 4)
            rowBytes := rowLength > 0 ? AhkStdlibPillowArraySlice(bytes, rowOffset, rowOffset + rowLength - 1) : []
            values := AhkStdlibPillowSgiDecodeRleRow(rowBytes, width)
            destY := height - 1 - fileY
            loop width
                planes[channel][destY * width + A_Index] := A_Index <= values.Length ? values[A_Index] : 0
        }
    }
    return AhkStdlibPillowSgiRowsFromPlanes(planes, width, height, mode)
}

AhkStdlibPillowSgiDecodeRleRow(bytes, width)
{
    values := []
    pos := 1
    while values.Length < width && pos <= bytes.Length {
        control := bytes[pos]
        pos += 1
        if control = 0
            break
        count := control & 0x7F
        if control & 0x80 {
            loop count {
                if pos > bytes.Length
                    break
                values.Push(bytes[pos])
                pos += 1
            }
        } else {
            value := pos <= bytes.Length ? bytes[pos] : 0
            pos += 1
            loop count
                values.Push(value)
        }
    }
    while values.Length < width
        values.Push(0)
    return values
}

AhkStdlibPillowSgiBlankPlanes(zsize, width, height)
{
    planes := []
    total := width * height
    loop zsize {
        plane := []
        loop total
            plane.Push(0)
        planes.Push(plane)
    }
    return planes
}

AhkStdlibPillowSgiRowsFromPlanes(planes, width, height, mode)
{
    rows := []
    channels := StrLen(AhkStdlibPillowChannels(mode))
    loop height {
        y := A_Index - 1
        row := []
        loop width {
            index := y * width + A_Index
            if channels = 1 {
                row.Push(planes[1][index])
            } else {
                pixel := []
                loop channels
                    pixel.Push(planes[A_Index][index])
                row.Push(pixel)
            }
        }
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowSgiSaveImage(image, fp, filename)
{
    mode := image.mode
    if mode = "L" {
        channels := 1
    } else if mode = "RGB" {
        channels := 3
    } else if mode = "RGBA" {
        channels := 4
    } else {
        throw ValueError("Unsupported SGI image mode", -1)
    }

    bpc := 1
    if image.HasOwnProp("encoderinfo") && image.encoderinfo.Has("bpc")
        bpc := Integer(image.encoderinfo["bpc"])
    if bpc != 1 && bpc != 2
        throw ValueError("Unsupported number of bytes per pixel", -1)

    dimension := channels = 1 ? (image.height = 1 ? 1 : 2) : 3
    bytes := AhkStdlibPillowSgiHeader(image.width, image.height, channels, bpc, dimension)
    loop channels {
        channelIndex := A_Index
        y := image.height - 1
        while y >= 0 {
            loop image.width {
                value := AhkStdlibPillowPixelChannel(image.getpixel([A_Index - 1, y]), mode, channelIndex)
                bytes.Push(AhkStdlibPillowRequireByte(value))
                if bpc = 2
                    bytes.Push(0)
            }
            y -= 1
        }
    }
    fp.write(bytes)
    return stdlib.None
}

AhkStdlibPillowSgiHeader(width, height, zsize, bpc, dimension)
{
    bytes := []
    AhkStdlibPillowSgiAppendU16(bytes, 474)
    bytes.Push(0, bpc)
    AhkStdlibPillowSgiAppendU16(bytes, dimension)
    AhkStdlibPillowSgiAppendU16(bytes, width)
    AhkStdlibPillowSgiAppendU16(bytes, height)
    AhkStdlibPillowSgiAppendU16(bytes, zsize)
    AhkStdlibPillowSgiAppendU32(bytes, 0)
    AhkStdlibPillowSgiAppendU32(bytes, 255)
    bytes.Push(0, 0, 0, 0)
    loop 80
        bytes.Push(0)
    AhkStdlibPillowSgiAppendU32(bytes, 0)
    while bytes.Length < 512
        bytes.Push(0)
    return bytes
}

AhkStdlibPillowSgiAppendU16(bytes, value)
{
    bytes.Push((Integer(value) >> 8) & 0xFF, Integer(value) & 0xFF)
    return stdlib.None
}

AhkStdlibPillowSgiAppendU32(bytes, value)
{
    value := Integer(value)
    bytes.Push((value >> 24) & 0xFF, (value >> 16) & 0xFF, (value >> 8) & 0xFF, value & 0xFF)
    return stdlib.None
}

AhkStdlibPillowSgiReadU16(bytes, offset)
{
    if bytes.Length < offset + 1
        return 0
    return (bytes[offset] << 8) | bytes[offset + 1]
}

AhkStdlibPillowSgiReadU32Safe(bytes, offset)
{
    if bytes.Length < offset + 3
        return 0
    return ((bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]) & 0xFFFFFFFF
}

