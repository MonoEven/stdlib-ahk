AhkStdlibPillowBlpUnpack565(value)
{
    value := Integer(value)
    return [
        ((value >> 11) & 0x1F) << 3,
        ((value >> 5) & 0x3F) << 2,
        (value & 0x1F) << 3,
    ]
}

AhkStdlibPillowBlpDecodeDxt1(data, alpha := false)
{
    bytes := AhkStdlibPillowByteSequence(data)
    blocks := bytes.Length // 8
    rows := [[], [], [], []]

    loop blocks {
        base := (A_Index - 1) * 8
        color0 := AhkStdlibPillowBlpU16(bytes, base)
        color1 := AhkStdlibPillowBlpU16(bytes, base + 2)
        bits := AhkStdlibPillowBlpU32(bytes, base + 4)
        color0Rgb := AhkStdlibPillowBlpUnpack565(color0)
        color1Rgb := AhkStdlibPillowBlpUnpack565(color1)

        loop 4 {
            row := rows[A_Index]
            loop 4 {
                control := bits & 3
                bits := bits >> 2
                rgba := AhkStdlibPillowBlpDxt1Color(color0, color1, color0Rgb, color1Rgb, control)
                row.Push(rgba[1])
                row.Push(rgba[2])
                row.Push(rgba[3])
                if alpha
                    row.Push(rgba[4])
            }
        }
    }
    return rows
}

AhkStdlibPillowBlpDecodeDxt3(data)
{
    bytes := AhkStdlibPillowByteSequence(data)
    blocks := bytes.Length // 16
    rows := [[], [], [], []]

    loop blocks {
        base := (A_Index - 1) * 16
        color0 := AhkStdlibPillowBlpU16(bytes, base + 8)
        color1 := AhkStdlibPillowBlpU16(bytes, base + 10)
        code := AhkStdlibPillowBlpU32(bytes, base + 12)
        color0Rgb := AhkStdlibPillowBlpUnpack565(color0)
        color1Rgb := AhkStdlibPillowBlpUnpack565(color1)

        loop 4 {
            y := A_Index - 1
            row := rows[A_Index]
            loop 4 {
                x := A_Index - 1
                alphaIndex := (4 * y + x) // 2
                alphaByte := bytes[base + alphaIndex + 1]
                a := Mod(x, 2) = 0 ? (alphaByte & 0xF) : (alphaByte >> 4)
                a *= 17
                colorCode := (code >> (2 * (4 * y + x))) & 0x03
                rgb := AhkStdlibPillowBlpDxtColor(color0Rgb, color1Rgb, colorCode)
                row.Push(rgb[1])
                row.Push(rgb[2])
                row.Push(rgb[3])
                row.Push(a)
            }
        }
    }
    return rows
}

AhkStdlibPillowBlpDecodeDxt5(data)
{
    bytes := AhkStdlibPillowByteSequence(data)
    blocks := bytes.Length // 16
    rows := [[], [], [], []]

    loop blocks {
        base := (A_Index - 1) * 16
        a0 := bytes[base + 1]
        a1 := bytes[base + 2]
        alphacode2 := bytes[base + 3] | (bytes[base + 4] << 8)
        alphacode1 := bytes[base + 5] | (bytes[base + 6] << 8) | (bytes[base + 7] << 16) | (bytes[base + 8] << 24)
        color0 := AhkStdlibPillowBlpU16(bytes, base + 8)
        color1 := AhkStdlibPillowBlpU16(bytes, base + 10)
        code := AhkStdlibPillowBlpU32(bytes, base + 12)
        color0Rgb := AhkStdlibPillowBlpUnpack565(color0)
        color1Rgb := AhkStdlibPillowBlpUnpack565(color1)

        loop 4 {
            y := A_Index - 1
            row := rows[A_Index]
            loop 4 {
                x := A_Index - 1
                alphacodeIndex := 3 * (4 * y + x)
                if alphacodeIndex <= 12
                    alphaCode := (alphacode2 >> alphacodeIndex) & 0x07
                else if alphacodeIndex = 15
                    alphaCode := (alphacode2 >> 15) | ((alphacode1 << 1) & 0x06)
                else
                    alphaCode := (alphacode1 >> (alphacodeIndex - 16)) & 0x07

                if alphaCode = 0
                    a := a0
                else if alphaCode = 1
                    a := a1
                else if a0 > a1
                    a := ((8 - alphaCode) * a0 + (alphaCode - 1) * a1) // 7
                else if alphaCode = 6
                    a := 0
                else if alphaCode = 7
                    a := 255
                else
                    a := ((6 - alphaCode) * a0 + (alphaCode - 1) * a1) // 5

                colorCode := (code >> (2 * (4 * y + x))) & 0x03
                rgb := AhkStdlibPillowBlpDxtColor(color0Rgb, color1Rgb, colorCode)
                row.Push(rgb[1])
                row.Push(rgb[2])
                row.Push(rgb[3])
                row.Push(a)
            }
        }
    }
    return rows
}

AhkStdlibPillowBlpDxt1Color(color0, color1, color0Rgb, color1Rgb, control)
{
    if control = 0
        return [color0Rgb[1], color0Rgb[2], color0Rgb[3], 255]
    if control = 1
        return [color1Rgb[1], color1Rgb[2], color1Rgb[3], 255]
    if control = 2 {
        if color0 > color1
            return [
                (2 * color0Rgb[1] + color1Rgb[1]) // 3,
                (2 * color0Rgb[2] + color1Rgb[2]) // 3,
                (2 * color0Rgb[3] + color1Rgb[3]) // 3,
                255,
            ]
        return [
            (color0Rgb[1] + color1Rgb[1]) // 2,
            (color0Rgb[2] + color1Rgb[2]) // 2,
            (color0Rgb[3] + color1Rgb[3]) // 2,
            255,
        ]
    }
    if color0 > color1
        return [
            (2 * color1Rgb[1] + color0Rgb[1]) // 3,
            (2 * color1Rgb[2] + color0Rgb[2]) // 3,
            (2 * color1Rgb[3] + color0Rgb[3]) // 3,
            255,
        ]
    return [0, 0, 0, 0]
}

AhkStdlibPillowBlpDxtColor(color0Rgb, color1Rgb, control)
{
    if control = 0
        return color0Rgb
    if control = 1
        return color1Rgb
    if control = 2
        return [
            (2 * color0Rgb[1] + color1Rgb[1]) // 3,
            (2 * color0Rgb[2] + color1Rgb[2]) // 3,
            (2 * color0Rgb[3] + color1Rgb[3]) // 3,
        ]
    return [
        (2 * color1Rgb[1] + color0Rgb[1]) // 3,
        (2 * color1Rgb[2] + color0Rgb[2]) // 3,
        (2 * color1Rgb[3] + color0Rgb[3]) // 3,
    ]
}

AhkStdlibPillowBlpOpen(source)
{
    bytes := AhkStdlibPillowBlpSourceBytes(source)
    if !AhkStdlibPillowBlpImagePluginModule._accept(bytes)
        throw AhkStdlibPillowBLPFormatError("Bad BLP magic " AhkStdlibPillowBlpMagicRepr(bytes), -1)

    magic := AhkStdlibPillowBlpMagic(bytes)
    AhkStdlibPillowBlpRequireLength(bytes, magic = "BLP1" ? 28 : 20)
    compression := AhkStdlibPillowBlpU32(bytes, 4)
    if magic = "BLP1" {
        alpha := AhkStdlibPillowBlpU32(bytes, 8) != 0
        width := AhkStdlibPillowBlpU32(bytes, 12)
        height := AhkStdlibPillowBlpU32(bytes, 16)
        encoding := AhkStdlibPillowBlpU32(bytes, 20)
        offsetsPos := 28
        lengthsPos := 92
        palettePos := 156
        alphaEncoding := 0
    } else {
        encoding := bytes[9]
        alpha := bytes[10] != 0
        alphaEncoding := bytes[11]
        width := AhkStdlibPillowBlpU32(bytes, 12)
        height := AhkStdlibPillowBlpU32(bytes, 16)
        offsetsPos := 20
        lengthsPos := 84
        palettePos := 148
    }

    AhkStdlibPillowBlpRequireLength(bytes, palettePos + 1024)
    offsets := AhkStdlibPillowBlpReadU32Array(bytes, offsetsPos, 16)
    lengths := AhkStdlibPillowBlpReadU32Array(bytes, lengthsPos, 16)
    palette := AhkStdlibPillowBlpReadPalette(bytes, palettePos)
    mode := alpha ? "RGBA" : "RGB"

    if compression != 1
        throw AhkStdlibPillowBLPFormatError("Unknown BLP compression " compression, -1)

    if magic = "BLP1" {
        if !(encoding = 4 || encoding = 5)
            throw AhkStdlibPillowBLPFormatError("Unsupported BLP encoding " encoding, -1)
        image := AhkStdlibPillowBlpDecodePaletteImage(bytes, palettePos + 1024, lengths[1], width, height, palette, alpha)
    } else if encoding = AhkStdlibPillowBlpEncodingEnum().UNCOMPRESSED.value {
        image := AhkStdlibPillowBlpDecodePaletteImage(bytes, offsets[1], lengths[1], width, height, palette, alpha)
    } else if encoding = AhkStdlibPillowBlpEncodingEnum().DXT.value {
        image := AhkStdlibPillowBlpDecodeDxtImage(bytes, offsets[1], lengths[1], width, height, alpha, alphaEncoding)
    } else {
        throw AhkStdlibPillowBLPFormatError("Unknown BLP encoding " encoding, -1)
    }

    image.AhkStdlibFormat := "BLP"
    image.AhkStdlibReadonly := 1
    return image
}

AhkStdlibPillowBlpDecodePaletteImage(bytes, dataPos, length, width, height, palette, alpha)
{
    AhkStdlibPillowBlpRequireLength(bytes, dataPos + length)
    image := AhkStdlibPillowImageNew(alpha ? "RGBA" : "RGB", [width, height], alpha ? [0, 0, 0, 0] : [0, 0, 0])
    try {
        index := dataPos + 1
        loop height {
            y := A_Index - 1
            loop width {
                x := A_Index - 1
                if index > bytes.Length
                    throw OSError("Truncated BLP file", -1)
                paletteIndex := bytes[index] + 1
                color := paletteIndex <= palette.Length ? palette[paletteIndex] : [0, 0, 0, 0]
                image.putpixel([x, y], alpha ? color.Clone() : [color[1], color[2], color[3]])
                index += 1
            }
        }
    } catch Error as err {
        image.close()
        throw err
    }
    return image
}

AhkStdlibPillowBlpDecodeDxtImage(bytes, dataPos, length, width, height, alpha, alphaEncoding)
{
    AhkStdlibPillowBlpRequireLength(bytes, dataPos + length)
    mode := alpha ? "RGBA" : "RGB"
    image := AhkStdlibPillowImageNew(mode, [width, height], alpha ? [0, 0, 0, 0] : [0, 0, 0])
    try {
        blockRows := (height + 3) // 4
        current := dataPos
        loop blockRows {
            blockRow := A_Index - 1
            if alphaEncoding = AhkStdlibPillowBlpAlphaEncodingEnum().DXT1.value {
                lineSize := ((width + 3) // 4) * 8
                decodedRows := AhkStdlibPillowBlpDecodeDxt1(AhkStdlibPillowBlpByteSlice(bytes, current, current + lineSize), alpha)
            } else if alphaEncoding = AhkStdlibPillowBlpAlphaEncodingEnum().DXT3.value {
                lineSize := ((width + 3) // 4) * 16
                decodedRows := AhkStdlibPillowBlpDecodeDxt3(AhkStdlibPillowBlpByteSlice(bytes, current, current + lineSize))
            } else if alphaEncoding = AhkStdlibPillowBlpAlphaEncodingEnum().DXT5.value {
                lineSize := ((width + 3) // 4) * 16
                decodedRows := AhkStdlibPillowBlpDecodeDxt5(AhkStdlibPillowBlpByteSlice(bytes, current, current + lineSize))
            } else {
                throw AhkStdlibPillowBLPFormatError("Unsupported alpha encoding " alphaEncoding, -1)
            }
            current += lineSize
            for rowOffset, rowBytes in decodedRows {
                y := blockRow * 4 + rowOffset - 1
                if y >= height
                    continue
                stride := alpha ? 4 : 3
                loop width {
                    x := A_Index - 1
                    byteIndex := x * stride + 1
                    if byteIndex + stride - 1 > rowBytes.Length
                        break
                    if alpha
                        pixel := [rowBytes[byteIndex], rowBytes[byteIndex + 1], rowBytes[byteIndex + 2], rowBytes[byteIndex + 3]]
                    else
                        pixel := [rowBytes[byteIndex], rowBytes[byteIndex + 1], rowBytes[byteIndex + 2]]
                    image.putpixel([x, y], pixel)
                }
            }
        }
    } catch Error as err {
        image.close()
        throw err
    }
    return image
}

AhkStdlibPillowBlpSaveImage(image, fp)
{
    if image.mode != "P"
        throw ValueError("Unsupported BLP image mode", -1)

    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    magic := info.Has("blp_version") && info["blp_version"] = "BLP1" ? "BLP1" : "BLP2"
    alphaDepth := image.AhkStdlibPaletteMode = "RGBA" ? 1 : 0
    width := image.width
    height := image.height
    dataLength := width * height
    offsetValue := 20 + 16 * 4 * 2 + 256 * 4

    bytes := AhkStdlibPillowAsciiBytes(magic)
    AhkStdlibPillowBlpPushU32(bytes, 1)
    if magic = "BLP1" {
        AhkStdlibPillowBlpPushU32(bytes, alphaDepth)
    } else {
        bytes.Push(AhkStdlibPillowBlpEncodingEnum().UNCOMPRESSED.value)
        bytes.Push(alphaDepth)
        bytes.Push(0)
        bytes.Push(0)
    }
    AhkStdlibPillowBlpPushU32(bytes, width)
    AhkStdlibPillowBlpPushU32(bytes, height)
    if magic = "BLP1" {
        AhkStdlibPillowBlpPushU32(bytes, 5)
        AhkStdlibPillowBlpPushU32(bytes, 0)
    }

    loop 16
        AhkStdlibPillowBlpPushU32(bytes, A_Index = 1 ? offsetValue : 0)
    loop 16
        AhkStdlibPillowBlpPushU32(bytes, A_Index = 1 ? dataLength : 0)
    for byte in AhkStdlibPillowBlpPaletteBytes(image)
        bytes.Push(byte)
    loop height {
        y := A_Index - 1
        loop width {
            x := A_Index - 1
            bytes.Push(AhkStdlibPillowRequireByte(image.getpixel([x, y])))
        }
    }
    fp.write(bytes)
    return stdlib.None
}

AhkStdlibPillowBlpPaletteBytes(image)
{
    palette := image.getpalette("RGBA")
    bytes := []
    entry := 0
    index := 1
    while index <= palette.Length && entry < 256 {
        r := palette[index]
        g := index + 1 <= palette.Length ? palette[index + 1] : 0
        b := index + 2 <= palette.Length ? palette[index + 2] : 0
        a := index + 3 <= palette.Length ? palette[index + 3] : 255
        bytes.Push(b)
        bytes.Push(g)
        bytes.Push(r)
        bytes.Push(a)
        entry += 1
        index += 4
    }
    while entry < 256 {
        bytes.Push(0)
        bytes.Push(0)
        bytes.Push(0)
        bytes.Push(0)
        entry += 1
    }
    return bytes
}

AhkStdlibPillowBlpSourceBytes(source)
{
    if AhkStdlibPillowIsOpenFileLike(source)
        return AhkStdlibPillowReadAllFileLikeBytes(source)
    fp := AhkStdlibPillowOpenFile(source)
    try {
        return AhkStdlibPillowByteSequence(fp.read())
    } finally {
        fp.close()
    }
}

AhkStdlibPillowBlpMagic(bytes)
{
    if bytes.Length < 4
        return ""
    return Chr(bytes[1]) Chr(bytes[2]) Chr(bytes[3]) Chr(bytes[4])
}

AhkStdlibPillowBlpMagicRepr(bytes)
{
    if bytes.Length < 4
        return "b''"
    return "b'" Chr(bytes[1]) Chr(bytes[2]) Chr(bytes[3]) Chr(bytes[4]) "'"
}

AhkStdlibPillowBlpReadPalette(bytes, offset)
{
    palette := []
    loop 256 {
        pos := offset + (A_Index - 1) * 4
        b := bytes[pos + 1]
        g := bytes[pos + 2]
        r := bytes[pos + 3]
        a := bytes[pos + 4]
        palette.Push([r, g, b, a])
    }
    return palette
}

AhkStdlibPillowBlpReadU32Array(bytes, offset, count)
{
    values := []
    loop count
        values.Push(AhkStdlibPillowBlpU32(bytes, offset + (A_Index - 1) * 4))
    return values
}

AhkStdlibPillowBlpRequireLength(bytes, length)
{
    if bytes.Length < length
        throw OSError("Truncated BLP file", -1)
}

AhkStdlibPillowBlpU16(bytes, offset)
{
    AhkStdlibPillowBlpRequireLength(bytes, offset + 2)
    return bytes[offset + 1] | (bytes[offset + 2] << 8)
}

AhkStdlibPillowBlpU32(bytes, offset)
{
    AhkStdlibPillowBlpRequireLength(bytes, offset + 4)
    return bytes[offset + 1] | (bytes[offset + 2] << 8) | (bytes[offset + 3] << 16) | (bytes[offset + 4] << 24)
}

AhkStdlibPillowBlpPushU32(bytes, value)
{
    bytes.Push(value & 0xFF)
    bytes.Push((value >> 8) & 0xFF)
    bytes.Push((value >> 16) & 0xFF)
    bytes.Push((value >> 24) & 0xFF)
    return stdlib.None
}

AhkStdlibPillowBlpByteSlice(bytes, start, stop)
{
    result := []
    index := start + 1
    while index <= stop && index <= bytes.Length {
        result.Push(bytes[index])
        index += 1
    }
    return result
}

