AhkStdlibPillowWebPAnimation(bytes)
{
    pos := 13
    frames := []
    loopCount := 1
    background := [255, 255, 255, 255]
    hasAlpha := false
    timestamp := 0

    while pos + 7 <= bytes.Length {
        chunkId := AhkStdlibPillowAsciiFromBytes(AhkStdlibPillowArraySlice(bytes, pos, pos + 3))
        chunkSize := AhkStdlibPillowWebPReadU32(bytes, pos + 4)
        payloadStart := pos + 8
        payloadEnd := payloadStart + chunkSize - 1
        if payloadEnd > bytes.Length
            break

        if chunkId = "VP8X" && chunkSize >= 10 {
            hasAlpha := (bytes[payloadStart] & 0x10) != 0
        } else if chunkId = "ANIM" && chunkSize >= 6 {
            b := bytes[payloadStart]
            g := bytes[payloadStart + 1]
            r := bytes[payloadStart + 2]
            a := bytes[payloadStart + 3]
            background := [r, g, b, a]
            loopCount := bytes[payloadStart + 4] | (bytes[payloadStart + 5] << 8)
        } else if chunkId = "ANMF" && chunkSize >= 16 {
            duration := AhkStdlibPillowWebPReadU24(bytes, payloadStart + 12)
            frameBytes := AhkStdlibPillowWebPFrameBytes(bytes, payloadStart + 16, payloadEnd)
            if frameBytes.Length {
                frames.Push({ Bytes: frameBytes, Timestamp: timestamp, Duration: duration })
                timestamp += duration
            }
        }

        pos := payloadStart + chunkSize + Mod(chunkSize, 2)
    }

    if frames.Length = 0
        return stdlib.None
    return { Frames: frames, Loop: loopCount, Background: background, HasAlpha: hasAlpha }
}

AhkStdlibPillowWebPFrameBytes(bytes, start, end)
{
    chunks := []
    pos := start
    while pos + 7 <= end {
        chunkId := AhkStdlibPillowAsciiFromBytes(AhkStdlibPillowArraySlice(bytes, pos, pos + 3))
        chunkSize := AhkStdlibPillowWebPReadU32(bytes, pos + 4)
        chunkEnd := pos + 8 + chunkSize - 1
        paddedEnd := chunkEnd + Mod(chunkSize, 2)
        if chunkEnd > end
            break
        if chunkId = "VP8 " || chunkId = "VP8L" || chunkId = "ALPH"
            chunks.Push(AhkStdlibPillowArraySlice(bytes, pos, Min(paddedEnd, end)))
        pos := paddedEnd + 1
    }
    if chunks.Length = 0
        return []
    return AhkStdlibPillowWebPStandaloneBytes(chunks)
}

AhkStdlibPillowWebPStandaloneBytes(chunks)
{
    payload := AhkStdlibPillowAsciiBytes("WEBP")
    for chunk in chunks
        AhkStdlibPillowWebPAppendBytes(payload, chunk)

    result := AhkStdlibPillowAsciiBytes("RIFF")
    AhkStdlibPillowWebPPushU32(result, payload.Length)
    AhkStdlibPillowWebPAppendBytes(result, payload)
    return result
}

AhkStdlibPillowWebPImageSeek(self, args*)
{
    if args.Length < 1
        throw TypeError("Image.seek() missing 1 required positional argument: 'frame'", -1)
    if args.Length > 1
        throw TypeError("Image.seek() takes 2 positional arguments but " args.Length + 1 " were given", -1)
    frame := Integer(args[1])
    if frame < 0 || frame >= self.n_frames
        throw EOFError("attempt to seek outside sequence", -1)
    if self.HasOwnProp("AhkStdlibWebPFrames") && frame != self.AhkStdlibWebPFrame
        AhkStdlibPillowWebPSetFrame(self, frame)
