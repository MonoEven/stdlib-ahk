    try {
        if bytes.Length < 10
            return stdlib.None

        if bytes[1] = 73 && bytes[2] = 73 && bytes[3] = 42 && bytes[4] = 0
            littleEndian := true
        else if bytes[1] = 77 && bytes[2] = 77 && bytes[3] = 0 && bytes[4] = 42
            littleEndian := false
        else
            return stdlib.None

        ifdStart := AhkStdlibPillowTiffReadU32(bytes, 5, littleEndian) + 1
        if ifdStart < 1 || ifdStart + 1 > bytes.Length
            return stdlib.None

        entryCount := AhkStdlibPillowTiffReadU16(bytes, ifdStart, littleEndian)
        entriesStart := ifdStart + 2
        maxEntries := Floor((bytes.Length - entriesStart + 1) / 12)
        if maxEntries < 0
            return stdlib.None
        if entryCount > maxEntries
            entryCount := maxEntries

        bitsPerSample := stdlib.None
        photometric := stdlib.None
        samplesPerPixel := stdlib.None

        loop entryCount {
            entryOffset := entriesStart + (A_Index - 1) * 12
            tag := AhkStdlibPillowTiffReadU16(bytes, entryOffset, littleEndian)
            typeValue := AhkStdlibPillowTiffReadU16(bytes, entryOffset + 2, littleEndian)
            count := AhkStdlibPillowTiffReadU32(bytes, entryOffset + 4, littleEndian)
            valueOffset := entryOffset + 8

            switch tag {
                case 258:
                    bitsPerSample := AhkStdlibPillowTiffReadFirstValue(bytes, valueOffset, typeValue, count, littleEndian)
                case 262:
                    photometric := AhkStdlibPillowTiffReadFirstValue(bytes, valueOffset, typeValue, count, littleEndian)
                case 277:
                    samplesPerPixel := AhkStdlibPillowTiffReadFirstValue(bytes, valueOffset, typeValue, count, littleEndian)
            }
        }

        if !AhkStdlibIsNone(photometric)
            && (photometric = 0 || photometric = 1)
            && (AhkStdlibIsNone(samplesPerPixel) || samplesPerPixel = 1)
            && (AhkStdlibIsNone(bitsPerSample) || bitsPerSample = 8)
            return "L"
    } catch {
        return stdlib.None
    }
    return stdlib.None
}

AhkStdlibPillowTiffReadFirstValue(bytes, valueOffset, typeValue, count, littleEndian)
{
    if count < 1
        return stdlib.None

    typeSize := AhkStdlibPillowTiffTypeSize(typeValue)
    if AhkStdlibIsNone(typeSize)
        return stdlib.None

    if count * typeSize <= 4
        dataOffset := valueOffset
    else
        dataOffset := AhkStdlibPillowTiffReadU32(bytes, valueOffset, littleEndian) + 1

    switch typeValue {
        case 1, 6, 7:
            return AhkStdlibPillowTiffReadByte(bytes, dataOffset)
        case 3, 8:
            return AhkStdlibPillowTiffReadU16(bytes, dataOffset, littleEndian)
        case 4, 9, 13:
            return AhkStdlibPillowTiffReadU32(bytes, dataOffset, littleEndian)
    }
    return stdlib.None
}

