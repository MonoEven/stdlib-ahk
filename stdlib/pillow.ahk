        throw ValueError("palette contains raw palette data", -1)
    if !(color is Array)
        throw ValueError("unknown color specifier: '" color "'", -1)

    values := color.Clone()
    paletteBytes := values.Clone()
    if palette.mode = "RGB" {
        if values.Length = 4 {
            if values[4] != 255
                throw ValueError("cannot add non-opaque RGBA color to RGB palette", -1)
            values := [values[1], values[2], values[3]]
            paletteBytes := values.Clone()
        }
    } else if palette.mode = "RGBA" {
        if values.Length = 3 {
            values.Push(255)
            paletteBytes := [values[1], values[2], values[3]]
        }
    }

    keyBytes := []
    for value in values
        keyBytes.Push(AhkStdlibPillowRequireByte(value))
    bytes := []
    for value in paletteBytes
        bytes.Push(AhkStdlibPillowRequireByte(value))

    key := AhkStdlibPillowImagePaletteColorKey(keyBytes)
    colors := palette.colors
    if colors.Has(key)
        return colors[key]

    index := AhkStdlibPillowImagePaletteNewColorIndex(palette, image?)
    palette.AhkStdlibAssignedColors[key] := index
    offset := index * 3 + 1
    if offset < palette.palette.Length {
        before := AhkStdlibPillowImagePaletteSlice(palette.palette, 1, offset - 1)
        after := AhkStdlibPillowImagePaletteSlice(palette.palette, offset + 3, palette.palette.Length)
        newPalette := before
        for byte in bytes
            newPalette.Push(byte)
        for byte in after
            newPalette.Push(byte)
        palette.palette := newPalette
    } else {
        for byte in bytes
            palette.palette.Push(byte)
    }
