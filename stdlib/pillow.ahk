    if saveAll && AhkStdlibPillowGifInfoHas(info, "append_images") {
        for appendImage in info["append_images"] {
            if appendImage.mode != "P"
                appendImage := appendImage.convert("P")
            frames.Push({ Image: appendImage, Info: info })
        }
    }
    return frames
}

AhkStdlibPillowGifPushGraphicControl(bytes, info, frameIndex)
{
    bytes.Push(0x21)
    bytes.Push(0xF9)
    bytes.Push(4)
    transparency := AhkStdlibPillowGifInfoHas(info, "transparency") ? AhkStdlibPillowGifInfoInt(info, "transparency", 0) : 0
    bytes.Push(AhkStdlibPillowGifInfoHas(info, "transparency") ? 1 : 0)
    AhkStdlibPillowGifPushU16(bytes, Floor(AhkStdlibPillowGifFrameInfoInt(info, "duration", 0, frameIndex) / 10))
    bytes.Push(transparency)
    bytes.Push(0)
    return stdlib.None
}

AhkStdlibPillowGifPushFrame(bytes, image, colorBits)
{
    pixels := image.getdata()
    bytes.Push(0x2C)
    AhkStdlibPillowGifPushU16(bytes, 0)
    AhkStdlibPillowGifPushU16(bytes, 0)
    AhkStdlibPillowGifPushU16(bytes, image.width)
    AhkStdlibPillowGifPushU16(bytes, image.height)
    bytes.Push(0)
    minCodeSize := Max(2, colorBits)
    bytes.Push(minCodeSize)
    compressed := AhkStdlibPillowGifEncodeLzw(pixels, minCodeSize)
    AhkStdlibPillowGifPushSubBlocks(bytes, compressed)
    return stdlib.None
}

AhkStdlibPillowGifInfoHas(info, key)
{
