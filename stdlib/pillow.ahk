AhkStdlibPillowGimpGradientBytesRepr(bytes)
{
    text := ""
    for byte in bytes {
        if byte = 10
            text .= "\n"
        else if byte = 13
            text .= "\r"
        else if byte = 9
            text .= "\t"
        else if byte = 92
            text .= "\\"
        else if byte = 39
            text .= "\'"
        else
