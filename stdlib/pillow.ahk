            return AhkStdlibPillowChopsClampByte((value1 + value2) / scale + offset)
        case "subtract":
            return AhkStdlibPillowChopsClampByte((value1 - value2) / scale + offset)
        case "add_modulo":
            return Mod(value1 + value2, 256)
        case "subtract_modulo":
            return AhkStdlibPillowModulo(value1 - value2, 256)
        case "multiply":
            return AhkStdlibPillowChopsClampByte(value1 * value2 / 255)
        case "screen":
            return 255 - Floor((255 - value1) * (255 - value2) / 255)
        case "soft_light":
            return AhkStdlibPillowChopsClampByte(
                Floor((255 - value1) * (value1 * value2) / 65536)
                + Floor(value1 * (255 - Floor((255 - value1) * (255 - value2) / 255)) / 255)
            )
        case "hard_light":
            if value2 < 128
                return AhkStdlibPillowChopsClampByte(Floor(value1 * value2 / 127))
            return AhkStdlibPillowChopsClampByte(255 - Floor((255 - value2) * (255 - value1) / 127))
        case "overlay":
            if value1 < 128
                return AhkStdlibPillowChopsClampByte(Floor(value1 * value2 / 127))
            return AhkStdlibPillowChopsClampByte(255 - Floor((255 - value1) * (255 - value2) / 127))
        case "difference":
            return Abs(value1 - value2)
        case "lighter":
            return Max(value1, value2)
        case "darker":
