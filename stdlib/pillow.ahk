    {
        if this.HasOwnProp("AhkStdlibDcxFrames") {
            for frame in this.AhkStdlibDcxFrames
                if IsObject(frame) && frame.HasOwnProp("AhkStdlibHandle") && frame.AhkStdlibHandle
