    width := AhkStdlibPillowSgiReadU16(bytes, 7)
    height := AhkStdlibPillowSgiReadU16(bytes, 9)
    zsize := AhkStdlibPillowSgiReadU16(bytes, 11)
    key := bpc "," dimension "," zsize
    modes := AhkStdlibPillowSgiModesMap()
    if !modes.Has(key)
        throw ValueError("Unsupported SGI image mode", -1)

    storedMode := modes[key]
    mode := StrReplace(storedMode, ";16B", "")
    tile := AhkStdlibPillowSgiTile(mode, width, height, zsize, bpc, compression)
    rows := compression = 1
        ? AhkStdlibPillowSgiDecodeRleRows(bytes, width, height, zsize, bpc, mode)
        : AhkStdlibPillowSgiDecodeRawRows(bytes, width, height, zsize, bpc, mode)

    image := AhkStdlibPillowImage(0, mode, width, height, "SGI", 1)
    image.AhkStdlibMemoryPixels := rows
    image.tile := tile
    if mode = "RGB"
