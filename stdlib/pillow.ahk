    for point in points {
        minY := Min(minY, point[2])
        maxY := Max(maxY, point[2])
    }

    y := minY
    while y <= maxY {
        nodes := []
        j := points.Length
        loop points.Length {
            i := A_Index
            xi := points[i][1]
            yi := points[i][2]
            xj := points[j][1]
            yj := points[j][2]
            if yi != yj && y >= Min(yi, yj) && y < Max(yi, yj)
                nodes.Push(xi + (y - yi) / (yj - yi) * (xj - xi))
            j := i
        }
        AhkStdlibPillowSortNumbers(nodes)
        index := 1
        while index < nodes.Length {
            x := Floor(nodes[index])
            stop := Floor(nodes[index + 1])
            while x <= stop {
                mask[x "," y] := true
                x += 1
            }
            index += 2
        }
        y += 1
    }

    j := points.Length
    loop points.Length {
        i := A_Index
        if points[i][2] = points[j][2] {
            y := points[i][2]
            x := Min(points[i][1], points[j][1])
            stop := Max(points[i][1], points[j][1])
            while x <= stop {
                mask[x "," y] := true
                x += 1
            }
