AhkStdlibPillowColorToArgb(value, mode)
{
    if mode = "1" {
        gray := AhkStdlibPillowBoolColorValue(value)
        return (0xFF << 24) | (gray << 16) | (gray << 8) | gray
    }
    if mode = "L" || mode = "P" {
        gray := AhkStdlibPillowRequireByte(value)
        return (0xFF << 24) | (gray << 16) | (gray << 8) | gray
    }
    if mode = "LA" {
        values := AhkStdlibPillowSequenceToArray(value)
        if values.Length != 2
            throw TypeError("color must be a sequence of length 2", -1)
        gray := AhkStdlibPillowRequireByte(values[1])
        a := AhkStdlibPillowRequireByte(values[2])
        return (a << 24) | (gray << 16) | (gray << 8) | gray
    }

    values := AhkStdlibPillowSequenceToArray(value)
    expected := mode = "RGBA" ? 4 : 3
    if values.Length != expected
        throw TypeError("color must be a sequence of length " expected, -1)
    r := AhkStdlibPillowRequireByte(values[1])
    g := AhkStdlibPillowRequireByte(values[2])
    b := AhkStdlibPillowRequireByte(values[3])
    a := expected = 4 ? AhkStdlibPillowRequireByte(values[4]) : 0xFF
    return (a << 24) | (r << 16) | (g << 8) | b
}

AhkStdlibPillowArgbToColor(argb, mode)
{
    a := (argb >> 24) & 0xFF
    r := (argb >> 16) & 0xFF
    g := (argb >> 8) & 0xFF
    b := argb & 0xFF
    switch mode {
        case "1":
            return r
        case "RGBA":
            return [r, g, b, a]
        case "LA":
            return [r, a]
        case "L", "P":
            return r
        default:
            return [r, g, b]
    }
}

AhkStdlibPillowRequireByte(value)
{
    if !(value is Integer)
        throw TypeError("color must be int or tuple", -1)
    if value < 0 || value > 255
        throw ValueError("color must be int, or tuple of one, three or four elements", -1)
    return value
}

AhkStdlibPillowBoolColorValue(value)
{
    if value is Integer
        return AhkStdlibPillowRequireByte(value)
    values := AhkStdlibPillowSequenceToArray(value)
    if values.Length = 1
        return AhkStdlibPillowRequireByte(values[1])
    throw TypeError("color must be int or single-element tuple", -1)
}

AhkStdlibPillowRegisterOpen(args*)
{
    if args.Length < 2
        throw TypeError("register_open() missing " (2 - args.Length) " required positional argument" (2 - args.Length = 1 ? "" : "s") ": " (args.Length = 0 ? "'id' and 'factory'" : "'factory'"), -1)
    if args.Length > 3
        throw TypeError("register_open() takes from 2 to 3 positional arguments but " args.Length " were given", -1)
    id := StrUpper(args[1])
    order := AhkStdlibPillowOpenRegistryOrder()
    if !AhkStdlibPillowArrayContains(order, id)
        order.Push(id)
    AhkStdlibPillowRegistryMap("OPEN")[id] := [args[2], args.Length >= 3 ? args[3] : stdlib.None]
    return stdlib.None
}

