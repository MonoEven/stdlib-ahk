        if !latin
            return this.add_itxt(key, value, "", "", zip)
        keyBytes := AhkStdlibPillowPngLatin1Bytes(key)
        payload := keyBytes.Clone()
        payload.Push(0)
        if zip {
            payload.Push(0)
            AhkStdlibPillowPngAppendBytes(payload, AhkStdlibPillowPngZlibStoreCompress(valueBytes))
            return this.add([122, 84, 88, 116], payload)
        }
        AhkStdlibPillowPngAppendBytes(payload, valueBytes)
        return this.add([116, 69, 88, 116], payload)
    }
}

class AhkStdlibPillowPngITXt
{
    __New(text, lang := stdlib.None, tkey := stdlib.None)
    {
        this.text := String(text)
        this.lang := lang
        this.tkey := tkey
    }

    __String()
    {
        return this.text
    }
}

class AhkStdlibPillowPngChunkStream
{
    __New(fp)
    {
        this.fp := fp
        this.queue := []
    }

    read()
    {
        if this.queue.Length {
            item := this.queue.Pop()
            this.fp.seek(item[2])
            return item
        }
        header := AhkStdlibPillowByteSequence(this.fp.read(8))
        if header.Length < 8
            throw OSError("truncated PNG file", -1)
        cid := AhkStdlibPillowArraySlice(header, 5, 8)
        pos := this.fp.tell()
        length := AhkStdlibPillowPngI32(header, 1)
        if !AhkStdlibPillowPngIsCid(cid)
            throw SyntaxError("broken PNG file (chunk " AhkStdlibPillowBytesRepr(cid) ")", -1)
        return [cid, pos, length]
    }

    push(cid, pos, length)
    {
        this.queue.Push([AhkStdlibPillowByteSequence(cid), pos, length])
        return stdlib.None
    }

    close()
    {
        this.queue := stdlib.None
        this.fp := stdlib.None
        return stdlib.None
    }

    crc(cid, data)
    {
        expected := AhkStdlibPillowPngCrc32(AhkStdlibPillowByteSequence(data), AhkStdlibPillowPngCrc32(AhkStdlibPillowByteSequence(cid)))
        actualBytes := AhkStdlibPillowByteSequence(this.fp.read(4))
        if actualBytes.Length < 4
            throw SyntaxError("broken PNG file (incomplete checksum in " AhkStdlibPillowBytesRepr(cid) ")", -1)
        actual := AhkStdlibPillowPngI32(actualBytes, 1)
        if expected != actual
            throw SyntaxError("broken PNG file (bad header checksum in " AhkStdlibPillowBytesRepr(cid) ")", -1)
        return stdlib.None
    }

    crc_skip(cid, data)
    {
        this.fp.read(4)
        return stdlib.None
    }

    verify(endchunk := unset)
    {
        target := IsSet(endchunk) ? AhkStdlibPillowByteSequence(endchunk) : [73, 69, 78, 68]
        cids := []
        loop {
            chunk := this.read()
            cid := chunk[1]
            pos := chunk[2]
            length := chunk[3]
            if AhkStdlibPillowBytesEqual(cid, target)
                break
            data := AhkStdlibPillowByteSequence(this.fp.read(length))
            this.crc(cid, data)
            cids.Push(cid)
        }
        return cids
    }
}

class AhkStdlibPillowPngImageFileFactory
{
    format := "PNG"
    format_description := "Portable network graphics"

    Call(args*)
    {
        actual := AhkStdlibPillowPngNormalizeFactoryArgs(this, args)
        if actual.Length < 1
            throw TypeError("ImageFile.__init__() missing 1 required positional argument: 'fp'", -1)
        if actual.Length > 2
            throw TypeError("ImageFile.__init__() takes from 2 to 3 positional arguments but " (actual.Length + 1) " were given", -1)
        return AhkStdlibPillowPngOpen(actual[1])
    }
}

class AhkStdlibPillowPngAccept
{
    static Call(prefix)
    {
        return AhkStdlibPillowPngImagePluginModule._accept(prefix)
    }
}

class AhkStdlibPillowPngSave
{
    static Call(image, fp, filename)
    {
        return AhkStdlibPillowPngSaveImage(image, fp, filename)
    }
}

class AhkStdlibPillowPngSaveAll
{
    static Call(image, fp, filename)
    {
        return AhkStdlibPillowPngSaveImage(image, fp, filename)
    }
}

AhkStdlibPillowPngEnsureRegistered()
{
    if !AhkStdlibPillowRegistryMap("OPEN").Has("PNG")
        AhkStdlibPillowRegisterOpen("PNG", AhkStdlibPillowPngImageFileFactory(), AhkStdlibPillowPngAccept)
    AhkStdlibPillowRegisterSave("PNG", AhkStdlibPillowPngSave)
    AhkStdlibPillowRegisterSaveAll("PNG", AhkStdlibPillowPngSaveAll)
    AhkStdlibPillowRegisterExtensions("PNG", [".png", ".apng"])
    AhkStdlibPillowRegisterMime("PNG", "image/png")
    return stdlib.None
}

AhkStdlibPillowPngNormalizeFactoryArgs(self, args)
{
    actual := args
    if actual.Length >= 1 && IsObject(actual[1]) && ObjPtr(actual[1]) = ObjPtr(self) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length >= 2 && !AhkStdlibPillowPngLooksLikeSource(actual[1]) && AhkStdlibPillowPngLooksLikeSource(actual[2]) {
        actual := actual.Clone()
        actual.RemoveAt(1)
    } else if actual.Length = 1 && !AhkStdlibPillowPngLooksLikeSource(actual[1]) {
        actual := []
    }
    return actual
}

AhkStdlibPillowPngLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowPngOpen(source)
{
    bytes := AhkStdlibPillowPngSourceBytes(source)
    if !AhkStdlibPillowPngImagePluginModule._accept(AhkStdlibPillowArraySlice(bytes, 1, 8))
        throw SyntaxError("not a PNG file", -1)
    decoded := AhkStdlibPillowWicDecodeToBgra(stdlib.io.BytesIO(bytes))
    image := AhkStdlibPillowImageFromWicDecoded(decoded)
    image.AhkStdlibFormat := "PNG"
    image.text := Map()
    AhkStdlibPillowPngApplyMetadata(image, bytes)
    return image
}

AhkStdlibPillowPngSourceBytes(source)
{
    if AhkStdlibPillowIsOpenFileLike(source)
        return AhkStdlibPillowReadAllFileLikeBytes(source)
    fp := AhkStdlibPillowOpenFile(source)
    try {
        return AhkStdlibPillowByteSequence(fp.read())
    } finally {
        fp.close()
    }
}

AhkStdlibPillowPngSaveImage(image, fp, filename)
{
    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    if AhkStdlibPillowPngCanEncodePure(image, info) {
        fp.write(AhkStdlibPillowPngEncodeImageBytes(image, info))
        return stdlib.None
    }
    encoder := AhkStdlibPillowEncoderClsid("PNG")
    raw := stdlib.io.BytesIO()
    AhkStdlibPillowImageSaveBuiltinFileLike(image, raw, encoder)
    bytes := AhkStdlibPillowPngInjectChunks(raw.getvalue(), info)
    fp.write(bytes)
    return stdlib.None
}

AhkStdlibPillowPngGetChunks(args*)
{
    image := args[1]
    params := args.Length >= 2 ? AhkStdlibPillowSaveParamsToMap(args[2]) : Map()
    previousEncoderInfoWasSet := image.HasOwnProp("encoderinfo")
    previousEncoderInfo := previousEncoderInfoWasSet ? image.encoderinfo : unset
    try {
        image.encoderinfo := AhkStdlibPillowCloneMap(params)
        out := stdlib.io.BytesIO()
        AhkStdlibPillowPngSaveImage(image, out, "")
        return AhkStdlibPillowPngParseChunks(out.getvalue())
    } finally {
        if previousEncoderInfoWasSet
            image.encoderinfo := previousEncoderInfo
        else if image.HasOwnProp("encoderinfo")
            image.DeleteProp("encoderinfo")
    }
}

AhkStdlibPillowPngCanEncodePure(image, info)
{
    if !(info is Map && (info.Has("pnginfo") || info.Has("dpi")))
        return false
    return image.mode = "RGB" || image.mode = "RGBA" || image.mode = "L"
}

AhkStdlibPillowPngEncodeImageBytes(image, info)
{
    mode := image.mode
    switch mode {
        case "RGB":
            colorType := 2
        case "RGBA":
            colorType := 6
        case "L":
            colorType := 0
        default:
            throw OSError("cannot write mode " mode " as PNG", -1)
    }

    bytes := AhkStdlibPillowPngImagePluginModule._MAGIC.Clone()
    ihdr := AhkStdlibPillowPngO32(image.width)
    AhkStdlibPillowPngAppendBytes(ihdr, AhkStdlibPillowPngO32(image.height))
    ihdr.Push(8, colorType, 0, 0, 0)
    AhkStdlibPillowPngAppendEncodedChunk(bytes, [73, 72, 68, 82], ihdr)

    pnginfo := info.Has("pnginfo") ? info["pnginfo"] : stdlib.None
    AhkStdlibPillowPngAppendEncodedChunks(bytes, AhkStdlibPillowPngInfoChunks(pnginfo, false))
    if info.Has("dpi")
        AhkStdlibPillowPngAppendEncodedChunk(bytes, [112, 72, 89, 115], AhkStdlibPillowPngDpiData(info["dpi"]))
    AhkStdlibPillowPngAppendEncodedChunk(bytes, [73, 68, 65, 84], AhkStdlibPillowPngZlibStoreCompress(AhkStdlibPillowPngScanlineBytes(image)))
    AhkStdlibPillowPngAppendEncodedChunks(bytes, AhkStdlibPillowPngInfoChunks(pnginfo, true))
    AhkStdlibPillowPngAppendEncodedChunk(bytes, [73, 69, 78, 68], [])
    return bytes
}

AhkStdlibPillowPngScanlineBytes(image)
{
    bytes := []
    mode := image.mode
    loop image.height {
        y := A_Index - 1
        bytes.Push(0)
        loop image.width {
            pixel := image.getpixel([A_Index - 1, y])
            if mode = "L" {
                bytes.Push(AhkStdlibPillowRequireByte(pixel))
            } else {
                values := AhkStdlibPillowSequenceToArray(pixel)
                count := mode = "RGBA" ? 4 : 3
                loop count
                    bytes.Push(AhkStdlibPillowRequireByte(values[A_Index]))
            }
        }
    }
    return bytes
}

AhkStdlibPillowPngInjectChunks(bytes, info)
{
    pnginfo := (info is Map && info.Has("pnginfo")) ? info["pnginfo"] : stdlib.None
    beforeChunks := AhkStdlibPillowPngInfoChunks(pnginfo, false)
    afterChunks := AhkStdlibPillowPngInfoChunks(pnginfo, true)
    hasDpi := info is Map && info.Has("dpi")

    result := AhkStdlibPillowArraySlice(bytes, 1, 8)
    insertedBefore := false
    offset := 9
    while offset + 11 <= bytes.Length {
        length := AhkStdlibPillowPngI32(bytes, offset)
        cid := AhkStdlibPillowArraySlice(bytes, offset + 4, offset + 7)
        name := AhkStdlibPillowAsciiFromBytes(cid)
        chunkEnd := offset + 11 + length
        if chunkEnd > bytes.Length
            break

        if name = "IDAT" && !insertedBefore {
            AhkStdlibPillowPngAppendEncodedChunks(result, beforeChunks)
            if hasDpi
                AhkStdlibPillowPngAppendEncodedChunk(result, [112, 72, 89, 115], AhkStdlibPillowPngDpiData(info["dpi"]))
            insertedBefore := true
        }

        if name = "IEND" {
            if !insertedBefore {
                AhkStdlibPillowPngAppendEncodedChunks(result, beforeChunks)
                if hasDpi
                    AhkStdlibPillowPngAppendEncodedChunk(result, [112, 72, 89, 115], AhkStdlibPillowPngDpiData(info["dpi"]))
                insertedBefore := true
            }
            AhkStdlibPillowPngAppendEncodedChunks(result, afterChunks)
            AhkStdlibPillowPngAppendBytes(result, AhkStdlibPillowArraySlice(bytes, offset, chunkEnd))
            return result
        }

        if !(hasDpi && name = "pHYs") && name != "sRGB" && name != "gAMA"
            AhkStdlibPillowPngAppendBytes(result, AhkStdlibPillowArraySlice(bytes, offset, chunkEnd))
        offset := chunkEnd + 1
    }
    return result
}

AhkStdlibPillowPngInfoChunks(pnginfo, afterIdat)
{
    chunks := []
    if AhkStdlibIsNone(pnginfo) || !(IsObject(pnginfo) && HasProp(pnginfo, "chunks"))
        return chunks
    for chunk in pnginfo.chunks {
        cid := AhkStdlibPillowByteSequence(chunk[1])
        data := AhkStdlibPillowByteSequence(chunk[2])
        after := chunk.Length >= 3 ? !!chunk[3] : false
        if after = afterIdat
            chunks.Push([cid, data])
    }
    return chunks
}

AhkStdlibPillowPngAppendEncodedChunks(target, chunks)
{
    for chunk in chunks
        AhkStdlibPillowPngAppendEncodedChunk(target, chunk[1], chunk[2])
    return stdlib.None
}

AhkStdlibPillowPngAppendEncodedChunk(target, cid, data)
{
    AhkStdlibPillowPngAppendBytes(target, AhkStdlibPillowPngEncodeChunk(cid, data))
    return stdlib.None
}

AhkStdlibPillowPngEncodeChunk(cid, data)
{
    cidBytes := AhkStdlibPillowByteSequence(cid)
    dataBytes := AhkStdlibPillowByteSequence(data)
    chunk := AhkStdlibPillowPngO32(dataBytes.Length)
    AhkStdlibPillowPngAppendBytes(chunk, cidBytes)
    AhkStdlibPillowPngAppendBytes(chunk, dataBytes)
    AhkStdlibPillowPngAppendBytes(chunk, AhkStdlibPillowPngO32(AhkStdlibPillowPngCrc32(dataBytes, AhkStdlibPillowPngCrc32(cidBytes))))
    return chunk
}

AhkStdlibPillowPngPutChunk(fp, cid, data*)
{
    byteData := []
    for part in data
        AhkStdlibPillowPngAppendBytes(byteData, AhkStdlibPillowByteSequence(part))
    fp.write(AhkStdlibPillowPngEncodeChunk(cid, byteData))
    return stdlib.None
}

AhkStdlibPillowPngParseChunks(bytes)
{
    chunks := []
    offset := 9
    while offset + 11 <= bytes.Length {
        length := AhkStdlibPillowPngI32(bytes, offset)
        cid := AhkStdlibPillowArraySlice(bytes, offset + 4, offset + 7)
        dataStart := offset + 8
        dataEnd := dataStart + length - 1
        crcStart := dataEnd + 1
        crcEnd := crcStart + 3
        if crcEnd > bytes.Length
            break
        data := length > 0 ? AhkStdlibPillowArraySlice(bytes, dataStart, dataEnd) : []
        crc := AhkStdlibPillowArraySlice(bytes, crcStart, crcEnd)
        chunks.Push([cid, data, crc])
        offset := crcEnd + 1
    }
    return chunks
}

AhkStdlibPillowPngApplyMetadata(image, bytes)
{
    offset := 9
    while offset + 11 <= bytes.Length {
        length := AhkStdlibPillowPngI32(bytes, offset)
        cid := AhkStdlibPillowArraySlice(bytes, offset + 4, offset + 7)
        name := AhkStdlibPillowAsciiFromBytes(cid)
        dataStart := offset + 8
        dataEnd := dataStart + length - 1
        crcEnd := dataEnd + 4
        if crcEnd > bytes.Length
            break
        data := length > 0 ? AhkStdlibPillowArraySlice(bytes, dataStart, dataEnd) : []
        switch name {
            case "tEXt":
                AhkStdlibPillowPngApplyTextChunk(image, data)
            case "iTXt":
                AhkStdlibPillowPngApplyInternationalTextChunk(image, data)
            case "zTXt":
                AhkStdlibPillowPngApplyCompressedTextChunk(image, data)
            case "pHYs":
                AhkStdlibPillowPngApplyDpiChunk(image, data)
        }
        offset := crcEnd + 1
    }
    return stdlib.None
}

AhkStdlibPillowPngApplyTextChunk(image, data)
{
    split := AhkStdlibPillowPngFindByte(data, 0)
    if !split
        return stdlib.None
    key := AhkStdlibPillowPngLatin1FromBytes(AhkStdlibPillowArraySlice(data, 1, split - 1))
    value := AhkStdlibPillowPngLatin1FromBytes(AhkStdlibPillowArraySlice(data, split + 1, data.Length))
    image.info[key] := value
    image.text[key] := value
    return stdlib.None
}

AhkStdlibPillowPngApplyInternationalTextChunk(image, data)
{
    keyEnd := AhkStdlibPillowPngFindByte(data, 0)
    if !keyEnd || data.Length < keyEnd + 4
        return stdlib.None
    key := AhkStdlibPillowPngLatin1FromBytes(AhkStdlibPillowArraySlice(data, 1, keyEnd - 1))
    compressionFlag := data[keyEnd + 1]
    pos := keyEnd + 3
    langEnd := AhkStdlibPillowPngFindByte(data, 0, pos)
    if !langEnd
        return stdlib.None
    lang := AhkStdlibPillowPngUtf8FromBytes(AhkStdlibPillowArraySlice(data, pos, langEnd - 1))
    pos := langEnd + 1
    tkeyEnd := AhkStdlibPillowPngFindByte(data, 0, pos)
    if !tkeyEnd
        return stdlib.None
    tkey := AhkStdlibPillowPngUtf8FromBytes(AhkStdlibPillowArraySlice(data, pos, tkeyEnd - 1))
    valueBytes := AhkStdlibPillowArraySlice(data, tkeyEnd + 1, data.Length)
    if compressionFlag
        valueBytes := AhkStdlibPillowPngZlibStoreDecompress(valueBytes)
    value := AhkStdlibPillowPngUtf8FromBytes(valueBytes)
    text := AhkStdlibPillowPngITXt(value, lang, tkey)
    image.info[key] := text
    image.text[key] := text
    return stdlib.None
}

AhkStdlibPillowPngApplyCompressedTextChunk(image, data)
{
    split := AhkStdlibPillowPngFindByte(data, 0)
    if !split || data.Length < split + 2
        return stdlib.None
    key := AhkStdlibPillowPngLatin1FromBytes(AhkStdlibPillowArraySlice(data, 1, split - 1))
    try {
        valueBytes := AhkStdlibPillowPngZlibStoreDecompress(AhkStdlibPillowArraySlice(data, split + 2, data.Length))
        value := AhkStdlibPillowPngLatin1FromBytes(valueBytes)
        image.info[key] := value
        image.text[key] := value
    }
    return stdlib.None
}

AhkStdlibPillowPngApplyDpiChunk(image, data)
{
    if data.Length < 9 || data[9] != 1
        return stdlib.None
    image.info["dpi"] := [Round(AhkStdlibPillowPngI32(data, 1) * 0.0254, 3), Round(AhkStdlibPillowPngI32(data, 5) * 0.0254, 3)]
    return stdlib.None
}

AhkStdlibPillowPngDpiData(dpi)
{
    values := AhkStdlibPillowSequenceToArray(dpi)
    x := Floor(Float(values[1]) / 0.0254 + 0.5)
    y := Floor(Float(values[2]) / 0.0254 + 0.5)
    data := AhkStdlibPillowPngO32(x)
    AhkStdlibPillowPngAppendBytes(data, AhkStdlibPillowPngO32(y))
    data.Push(1)
    return data
}

AhkStdlibPillowPngI16(bytes, offset)
{
    if bytes.Length < offset + 1
        return 0
    return (bytes[offset] << 8) | bytes[offset + 1]
}

AhkStdlibPillowPngI32(bytes, offset)
{
    if bytes.Length < offset + 3
        return 0
    return ((bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]) & 0xFFFFFFFF
}

AhkStdlibPillowPngO16(value)
{
    value := Integer(value)
    return [(value >> 8) & 0xFF, value & 0xFF]
}

AhkStdlibPillowPngO32(value)
{
    value := Integer(value) & 0xFFFFFFFF
    return [(value >> 24) & 0xFF, (value >> 16) & 0xFF, (value >> 8) & 0xFF, value & 0xFF]
}

AhkStdlibPillowPngCrc32(bytes, seed := 0)
{
    buffer := AhkStdlibPillowPngBytesToBuffer(bytes)
    crc := DllCall("ntdll\RtlComputeCrc32"
        , "UInt", Integer(seed) & 0xFFFFFFFF
        , "Ptr", buffer.Ptr
        , "UInt", buffer.Size
        , "UInt")
    return crc & 0xFFFFFFFF
}

AhkStdlibPillowPngBytesToBuffer(bytes)
{
    bytesBuffer := Buffer(bytes.Length, 0)
    for index, byte in bytes
        NumPut("UChar", AhkStdlibPillowRequireByte(byte), bytesBuffer, index - 1)
    return bytesBuffer
}

AhkStdlibPillowPngIsCid(bytes)
{
    if bytes.Length < 4
        return false
    loop 4 {
        value := bytes[A_Index]
        if !((value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value = 95)
            return false
    }
    return true
}

AhkStdlibPillowPngAppendBytes(target, more)
{
    for byte in more
        target.Push(AhkStdlibPillowRequireByte(byte))
    return target
}

AhkStdlibPillowPngFindByte(bytes, needle, start := 1)
{
    index := start
    while index <= bytes.Length {
        if bytes[index] = needle
            return index
        index += 1
    }
    return 0
}

AhkStdlibPillowPngLatin1Bytes(value)
{
    if !(value is String)
        return AhkStdlibPillowByteSequence(value)
    bytes := []
    loop parse value {
        code := Ord(A_LoopField)
        if code > 255
            throw ValueError("'latin-1' codec can't encode character", -1)
        bytes.Push(code)
    }
    return bytes
}

AhkStdlibPillowPngTryLatin1Bytes(value, &latin)
{
    if !(value is String) {
        latin := true
        return AhkStdlibPillowByteSequence(value)
    }
    bytes := []
    loop parse value {
        code := Ord(A_LoopField)
        if code > 255 {
            latin := false
            return AhkStdlibPillowPngUtf8Bytes(value)
        }
        bytes.Push(code)
    }
    latin := true
    return bytes
}

AhkStdlibPillowPngUtf8OrBytes(value)
{
    if value is String
        return AhkStdlibPillowPngUtf8Bytes(value)
    return AhkStdlibPillowByteSequence(value)
}

AhkStdlibPillowPngUtf8Bytes(text)
{
    size := StrPut(String(text), "UTF-8") - 1
    if size <= 0
        return []
    bytesBuffer := Buffer(size + 1, 0)
    StrPut(String(text), bytesBuffer, size + 1, "UTF-8")
    return AhkStdlibPillowBufferToBytes(bytesBuffer, size)
}

AhkStdlibPillowPngLatin1FromBytes(bytes)
{
    text := ""
    for byte in bytes
        text .= Chr(byte)
    return text
}

AhkStdlibPillowPngUtf8FromBytes(bytes)
{
    if bytes.Length = 0
        return ""
    bytesBuffer := AhkStdlibPillowPngBytesToBuffer(bytes)
    return StrGet(bytesBuffer, bytesBuffer.Size, "UTF-8")
}

AhkStdlibPillowPngZlibStoreCompress(bytes)
{
    output := [0x78, 0x01]
    index := 1
    while index <= bytes.Length {
        remaining := bytes.Length - index + 1
        blockLength := Min(65535, remaining)
        final := (index + blockLength - 1) >= bytes.Length ? 1 : 0
        output.Push(final)
        output.Push(blockLength & 0xFF)
        output.Push((blockLength >> 8) & 0xFF)
        nlen := (~blockLength) & 0xFFFF
        output.Push(nlen & 0xFF)
        output.Push((nlen >> 8) & 0xFF)
        AhkStdlibPillowPngAppendBytes(output, AhkStdlibPillowArraySlice(bytes, index, index + blockLength - 1))
        index += blockLength
    }
    if bytes.Length = 0
        output.Push(1, 0, 0, 255, 255)
    AhkStdlibPillowPngAppendBytes(output, AhkStdlibPillowPngO32(AhkStdlibPillowPngAdler32(bytes)))
    return output
}

AhkStdlibPillowPngZlibStoreDecompress(bytes)
{
    if bytes.Length < 6
        throw ValueError("Error -5 while decompressing data: incomplete or truncated stream", -1)
    pos := 3
    output := []
    loop {
        if pos + 4 > bytes.Length
            throw ValueError("Error -5 while decompressing data: incomplete or truncated stream", -1)
        header := bytes[pos]
        final := header & 1
        blockType := (header >> 1) & 3
        if blockType != 0
            throw ValueError("PngImagePlugin._safe_zlib_decompress only supports stored zlib blocks in stdlib.pillow", -1)
        len := bytes[pos + 1] | (bytes[pos + 2] << 8)
        nlen := bytes[pos + 3] | (bytes[pos + 4] << 8)
        if ((len ^ nlen) & 0xFFFF) != 0xFFFF
            throw ValueError("Error -3 while decompressing data: invalid stored block lengths", -1)
        pos += 5
        if pos + len - 1 > bytes.Length
            throw ValueError("Error -5 while decompressing data: incomplete or truncated stream", -1)
        AhkStdlibPillowPngAppendBytes(output, AhkStdlibPillowArraySlice(bytes, pos, pos + len - 1))
        pos += len
        if final
            break
    }
    return output
}

AhkStdlibPillowPngAdler32(bytes)
{
    a := 1
    b := 0
    for byte in bytes {
        a := Mod(a + byte, 65521)
        b := Mod(b + a, 65521)
    }
    return ((b << 16) | a) & 0xFFFFFFFF
}

AhkStdlibPillowBytesEqual(left, right)
{
    if left.Length != right.Length
        return false
    loop left.Length {
        if left[A_Index] != right[A_Index]
