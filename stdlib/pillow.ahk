    return 1.0 - Sqrt(1.0 - scale ** 2)
}

AhkStdlibPillowGimpGradientSegmentScale(segment, middle, pos)
{
    switch segment {
        case "linear":
            return AhkStdlibPillowGimpGradientLinear(middle, pos)
        case "curved":
            return AhkStdlibPillowGimpGradientCurved(middle, pos)
        case "sine":
            return AhkStdlibPillowGimpGradientSine(middle, pos)
        case "sphere_increasing":
            return AhkStdlibPillowGimpGradientSphereIncreasing(middle, pos)
        case "sphere_decreasing":
