AhkStdlibPillowMcIdasAcceptPrefix(prefix)
{
    bytes := AhkStdlibPillowByteSequence(prefix)
    return bytes.Length >= 8
        && bytes[1] = 0
        && bytes[2] = 0
        && bytes[3] = 0
        && bytes[4] = 0
        && bytes[5] = 0
        && bytes[6] = 0
        && bytes[7] = 0
        && bytes[8] = 4
}

AhkStdlibPillowMcIdasOpen(source)
{
    bytes := AhkStdlibPillowMcIdasSourceBytes(source)
    if bytes.Length < 256 || !AhkStdlibPillowMcIdasAcceptPrefix(AhkStdlibPillowArraySlice(bytes, 1, Min(256, bytes.Length)))
        throw SyntaxError("not an McIdas area file", -1)

    raw := AhkStdlibPillowArraySlice(bytes, 1, 256)
    descriptor := [0]
    pos := 1
    loop 64 {
        descriptor.Push(AhkStdlibPillowMcIdasI32be(raw, pos))
        pos += 4
    }

    bytesPerPixel := descriptor[12]
    if bytesPerPixel = 1 {
        mode := "L"
        rawmode := "L"
    } else if bytesPerPixel = 2 {
        mode := "I;16B"
        rawmode := "I;16B"
    } else if bytesPerPixel = 4 {
        mode := "I"
        rawmode := "I;32B"
    } else {
        throw SyntaxError("unsupported McIdas format", -1)
    }

    width := descriptor[11]
    height := descriptor[10]
    bands := descriptor[15]
    prefix := descriptor[16]
    offset := descriptor[35] + prefix
    stride := prefix + width * bytesPerPixel * bands

    if mode = "L" {
        image := AhkStdlibPillowMcIdasImage(AhkStdlibPillowCreateBitmap(width, height, "L"), mode, width, height, "MCIDAS", 1)
        pixelBytes := []
        rowStart := offset + 1
        loop height {
            dataStart := rowStart + prefix
            dataEnd := dataStart + width - 1
            if dataEnd > bytes.Length
                throw OSError("image file is truncated", -1)
            for byte in AhkStdlibPillowArraySlice(bytes, dataStart, dataEnd)
                pixelBytes.Push(byte)
            rowStart += stride
        }
        image.frombytes(pixelBytes)
    } else {
        image := AhkStdlibPillowMcIdasImage(0, mode, width, height, "MCIDAS", 1)
    }

    image.area_descriptor_raw := raw
    image.area_descriptor := descriptor
    image.tile := [["raw", [0, 0, width, height], offset, [rawmode, stride, 1]]]
    return image
}

AhkStdlibPillowMcIdasI32be(bytes, offset)
{
    if bytes.Length < offset + 3
        throw SyntaxError("not an McIdas area file", -1)
    value := (bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]
    return value >= 0x80000000 ? value - 0x100000000 : value
}

