class AhkStdlibPillowImageWinDib
{
    __New(image, size := unset)
    {
        if image is String {
            mode := image
            if !IsSet(size) || AhkStdlibIsNone(size)
                throw ValueError("If first argument is mode, size is required", -1)
            sizeValues := AhkStdlibPillowRequireSize(size)
            sourceImage := stdlib.None
        } else {
            if !(IsObject(image) && image.HasOwnProp("AhkStdlibHandle"))
                throw TypeError("argument must be an image or mode string", -1)
            mode := image.mode
            sizeValues := image.size
            sourceImage := image
        }

        mode := AhkStdlibPillowImageWinDisplayMode(mode)
        if mode = "P"
            throw ValueError("image has wrong mode", -1)

        this.mode := mode
        this.size := sizeValues
        this.AhkStdlibPixels := AhkStdlibPillowImageWinBlankPixels(mode, sizeValues)
        if !AhkStdlibIsNone(sourceImage)
            this.paste(sourceImage)
    }

    expose(handle)
    {
        AhkStdlibPillowImageWinHandleToInteger(handle)
        return stdlib.None
    }

    draw(handle, dst, src := unset)
    {
        AhkStdlibPillowImageWinHandleToInteger(handle)
        AhkStdlibPillowRequireBox(dst)
        if IsSet(src) && !AhkStdlibIsNone(src)
            AhkStdlibPillowRequireBox(src)
        return stdlib.None
    }

    query_palette(handle)
    {
        AhkStdlibPillowImageWinHandleToInteger(handle)
        return 0
    }

    paste(im, box := unset)
    {
        if !(IsObject(im) && im.HasOwnProp("AhkStdlibHandle"))
            throw TypeError("argument must be an image", -1)
        converted := im.mode = this.mode ? im : im.convert(this.mode)
        closeConverted := converted != im
        try {
            if IsSet(box) && !AhkStdlibIsNone(box) {
                rect := AhkStdlibPillowRequireBox(box)
                left := rect[1], top := rect[2], right := rect[3], bottom := rect[4]
                copyWidth := Min(converted.width, Max(0, right - left))
                copyHeight := Min(converted.height, Max(0, bottom - top))
            } else {
                left := 0, top := 0
                copyWidth := Min(converted.width, this.size[1])
                copyHeight := Min(converted.height, this.size[2])
            }
            loop copyHeight {
                y := A_Index - 1
                targetY := top + y
                if targetY < 0 || targetY >= this.size[2]
                    continue
                loop copyWidth {
                    x := A_Index - 1
                    targetX := left + x
                    if targetX < 0 || targetX >= this.size[1]
                        continue
                    this.AhkStdlibPixels[targetY + 1][targetX + 1] := AhkStdlibPillowImageWinPixelForMode(converted.getpixel([x, y]), this.mode)
                }
            }
        } finally {
            if closeConverted
                converted.close()
        }
        return stdlib.None
    }

    frombytes(buffer)
    {
        bytes := AhkStdlibPillowByteSequence(buffer)
        expected := AhkStdlibPillowImageWinStride(this.mode, this.size[1]) * this.size[2]
        if bytes.Length != expected
            throw ValueError("wrong size", -1)
        this.AhkStdlibPixels := AhkStdlibPillowImageWinPixelsFromBytes(this.mode, this.size, bytes)
        return stdlib.None
    }

    tobytes()
    {
        return AhkStdlibPillowImageWinPixelsToBytes(this.mode, this.size, this.AhkStdlibPixels)
    }
}

