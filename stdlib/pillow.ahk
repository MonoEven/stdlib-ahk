        throw AhkStdlibPillowPyCMSError("direction must be an integer between 0 and 2", -1)
    return numeric
}

AhkStdlibPillowImageCmsFlagsValue(value)
{
    numeric := AhkStdlibPillowImageCmsNumericValue(value)
    if numeric < 0 || numeric > 100663295
        throw AhkStdlibPillowPyCMSError("flags must be an integer between 0 and 100663295", -1)
    return numeric
}

AhkStdlibPillowImageCmsNumericValue(value)
{
    if value is Integer
        return value
    if value is Number
        return Integer(value)
    if IsObject(value) && HasProp(value, "value")
        return Integer(value.value)
    throw TypeError("'" AhkStdlibPythonTypeName(value) "' object cannot be interpreted as an integer", -1)
}

AhkStdlibPillowImageCmsRequireImage(value)
{
    if !IsObject(value) || !value.HasOwnProp("AhkStdlibHandle")
        throw TypeError("argument must be an image", -1)
}

AhkStdlibPillowImageCmsJoin(values, sep)
{
    result := ""
    for index, value in values {
        if index > 1
            result .= sep
        result .= value
    }
    return result
}

class AhkStdlibPillowImageGrabModule
{
    static grab(args*)
    {
        if args.Length > 5
            throw TypeError("grab() takes from 0 to 5 positional arguments but " args.Length " were given", -1)

        parsed := AhkStdlibPillowImageGrabParseGrabArgs(args)
        if !AhkStdlibIsNone(parsed.Xdisplay)
            throw OSError("Pillow was built without XCB support", -1)
        return AhkStdlibPillowImageGrabScreen(parsed.Bbox, parsed.IncludeLayeredWindows, parsed.AllScreens, parsed.Window)
    }

    static grabclipboard(args*)
    {
        if args.Length > 0
            throw TypeError("grabclipboard() takes 0 positional arguments but " args.Length " was given", -1)
        return AhkStdlibPillowImageGrabClipboard()
    }
}

AhkStdlibPillowImageGrabParseGrabArgs(args)
{
    bbox := stdlib.None
    includeLayeredWindows := false
    allScreens := false
    xdisplay := stdlib.None
    window := stdlib.None

    if args.Length = 1 && IsObject(args[1]) && !(args[1] is Array) {
        options := args[1]
        if HasProp(options, "bbox")
            bbox := options.bbox
        if HasProp(options, "include_layered_windows")
            includeLayeredWindows := !!options.include_layered_windows
        if HasProp(options, "all_screens")
            allScreens := !!options.all_screens
        if HasProp(options, "xdisplay")
            xdisplay := options.xdisplay
        if HasProp(options, "window")
            window := options.window
    } else {
        if args.Length >= 1
            bbox := args[1]
        if args.Length >= 2
            includeLayeredWindows := !!args[2]
        if args.Length >= 3
            allScreens := !!args[3]
        if args.Length >= 4
            xdisplay := args[4]
        if args.Length >= 5
            window := args[5]
    }

    if AhkStdlibIsNone(bbox)
        normalizedBbox := stdlib.None
    else {
        values := AhkStdlibPillowSequenceToArray(bbox)
        if values.Length != 4
            throw ValueError("not enough values to unpack (expected 4, got " values.Length ")", -1)
        normalizedBbox := [
            AhkStdlibPillowRequireInteger(values[1], "left"),
            AhkStdlibPillowRequireInteger(values[2], "top"),
            AhkStdlibPillowRequireInteger(values[3], "right"),
            AhkStdlibPillowRequireInteger(values[4], "bottom"),
        ]
    }

    return {
        Bbox: normalizedBbox,
        IncludeLayeredWindows: includeLayeredWindows,
        AllScreens: allScreens,
        Xdisplay: xdisplay,
        Window: window,
    }
}

AhkStdlibPillowImageGrabScreen(bbox := unset, includeLayeredWindows := false, allScreens := false, window := unset)
{
    if IsSet(window) && !AhkStdlibIsNone(window)
        return AhkStdlibPillowImageGrabWindow(window, bbox?, includeLayeredWindows)

    if IsSet(bbox) && !AhkStdlibIsNone(bbox)
        return AhkStdlibPillowImageGrabCaptureRect(bbox[1], bbox[2], bbox[3] - bbox[1], bbox[4] - bbox[2], includeLayeredWindows)

    if IsSet(allScreens) && allScreens {
        x := DllCall("user32\GetSystemMetrics", "Int", 76, "Int")
        y := DllCall("user32\GetSystemMetrics", "Int", 77, "Int")
        width := DllCall("user32\GetSystemMetrics", "Int", 78, "Int")
        height := DllCall("user32\GetSystemMetrics", "Int", 79, "Int")
    } else {
        x := 0
        y := 0
        width := DllCall("user32\GetSystemMetrics", "Int", 0, "Int")
        height := DllCall("user32\GetSystemMetrics", "Int", 1, "Int")
    }

    image := AhkStdlibPillowImageGrabCaptureRect(x, y, width, height, includeLayeredWindows)
    return image
}

AhkStdlibPillowImageGrabWindow(window, bbox := unset, includeLayeredWindows := false)
{
    hwnd := Integer(window)
    rect := Buffer(16, 0)
    if !DllCall("user32\GetWindowRect", "Ptr", hwnd, "Ptr", rect, "Int")
        throw OSError("GetWindowRect failed", -1)
    left := NumGet(rect, 0, "Int")
    top := NumGet(rect, 4, "Int")
    right := NumGet(rect, 8, "Int")
    bottom := NumGet(rect, 12, "Int")
    if IsSet(bbox) && !AhkStdlibIsNone(bbox)
        return AhkStdlibPillowImageGrabCaptureRect(bbox[1], bbox[2], bbox[3] - bbox[1], bbox[4] - bbox[2], includeLayeredWindows)
    image := AhkStdlibPillowImageGrabCaptureRect(left, top, right - left, bottom - top, includeLayeredWindows, hwnd)
    return image
}

AhkStdlibPillowImageGrabCropOffset(image, bbox, offsetX, offsetY)
{
    try {
        cropped := image.crop([bbox[1] - offsetX, bbox[2] - offsetY, bbox[3] - offsetX, bbox[4] - offsetY])
    } finally {
        image.close()
    }
    return cropped
}

AhkStdlibPillowImageGrabCaptureRect(x, y, width, height, includeLayeredWindows := false, hwnd := 0)
{
    if width < 0 || height < 0
        throw ValueError("Coordinate 'right' is less than 'left'", -1)
    if width = 0 || height = 0
        return AhkStdlibPillowImageNew("RGB", [width, height])

    screenDc := 0
    memoryDc := 0
    bitmap := 0
    oldBitmap := 0
    bits := 0
    try {
        screenDc := DllCall("user32\GetDC", "Ptr", hwnd, "Ptr")
        if !screenDc
            throw OSError("GetDC failed", -1)
        memoryDc := DllCall("gdi32\CreateCompatibleDC", "Ptr", screenDc, "Ptr")
        if !memoryDc
            throw OSError("CreateCompatibleDC failed", -1)

        bmi := Buffer(40, 0)
        NumPut("UInt", 40, bmi, 0)
        NumPut("Int", width, bmi, 4)
        NumPut("Int", -height, bmi, 8)
        NumPut("UShort", 1, bmi, 12)
        NumPut("UShort", 32, bmi, 14)
        bitmap := DllCall("gdi32\CreateDIBSection", "Ptr", screenDc, "Ptr", bmi, "UInt", 0, "Ptr*", &bits, "Ptr", 0, "UInt", 0, "Ptr")
        if !bitmap || !bits
            throw OSError("CreateDIBSection failed", -1)
        oldBitmap := DllCall("gdi32\SelectObject", "Ptr", memoryDc, "Ptr", bitmap, "Ptr")

        raster := 0x00CC0020 | (includeLayeredWindows ? 0x40000000 : 0)
        if hwnd {
            if !DllCall("user32\PrintWindow", "Ptr", hwnd, "Ptr", memoryDc, "UInt", 0, "Int")
                if !DllCall("gdi32\BitBlt", "Ptr", memoryDc, "Int", 0, "Int", 0, "Int", width, "Int", height, "Ptr", screenDc, "Int", 0, "Int", 0, "UInt", raster, "Int")
                    throw OSError("BitBlt failed", -1)
        } else if !DllCall("gdi32\BitBlt", "Ptr", memoryDc, "Int", 0, "Int", 0, "Int", width, "Int", height, "Ptr", screenDc, "Int", x, "Int", y, "UInt", raster, "Int") {
            throw OSError("BitBlt failed", -1)
        }

        image := AhkStdlibPillowImageNew("RGB", [width, height])
        try {
            offset := 0
            loop height {
                yy := A_Index - 1
                loop width {
                    xx := A_Index - 1
                    b := NumGet(bits, offset, "UChar")
                    g := NumGet(bits, offset + 1, "UChar")
                    r := NumGet(bits, offset + 2, "UChar")
                    image.putpixel([xx, yy], [r, g, b])
                    offset += 4
                }
            }
        } catch Error as err {
            image.close()
            throw err
        }
        return image
    } finally {
        if oldBitmap
            DllCall("gdi32\SelectObject", "Ptr", memoryDc, "Ptr", oldBitmap, "Ptr")
        if bitmap
            DllCall("gdi32\DeleteObject", "Ptr", bitmap, "Int")
        if memoryDc
            DllCall("gdi32\DeleteDC", "Ptr", memoryDc, "Int")
        if screenDc
            DllCall("user32\ReleaseDC", "Ptr", hwnd, "Ptr", screenDc, "Int")
    }
}

AhkStdlibPillowImageGrabClipboard()
{
    if !DllCall("user32\OpenClipboard", "Ptr", 0, "Int")
        return stdlib.None
    try {
        if DllCall("user32\IsClipboardFormatAvailable", "UInt", 15, "Int")
            return AhkStdlibPillowImageGrabClipboardFiles()

        pngFormat := DllCall("user32\RegisterClipboardFormat", "Str", "PNG", "UInt")
        if pngFormat && DllCall("user32\IsClipboardFormatAvailable", "UInt", pngFormat, "Int") {
            pngBytes := AhkStdlibPillowImageGrabClipboardBytes(pngFormat)
            if pngBytes.Length
                return stdlib.pillow.Image.open(stdlib.io.BytesIO(pngBytes), "r", ["PNG"])
        }

        if DllCall("user32\IsClipboardFormatAvailable", "UInt", 8, "Int") {
            dibSize := AhkStdlibPillowImageGrabClipboardDataSize(8)
            if dibSize > AhkStdlibPillowImageGrabClipboardDibByteLimit()
                return stdlib.None
            dibBytes := AhkStdlibPillowImageGrabClipboardBytes(8)
            if dibBytes.Length
                return stdlib.pillow.BmpImagePlugin.DibImageFile(stdlib.io.BytesIO(dibBytes))
        }
    } finally {
        DllCall("user32\CloseClipboard", "Int")
    }
    return stdlib.None
}

AhkStdlibPillowImageGrabClipboardDibByteLimit()
{
    return 8 * 1024 * 1024
}

AhkStdlibPillowImageGrabClipboardDataSize(format)
{
    hglobal := DllCall("user32\GetClipboardData", "UInt", format, "Ptr")
    if !hglobal
        return 0
    return DllCall("kernel32\GlobalSize", "Ptr", hglobal, "UPtr")
}

AhkStdlibPillowImageGrabClipboardBytes(format)
{
    hglobal := DllCall("user32\GetClipboardData", "UInt", format, "Ptr")
    if !hglobal
        return []
    size := DllCall("kernel32\GlobalSize", "Ptr", hglobal, "UPtr")
    if size <= 0
        return []
    locked := DllCall("kernel32\GlobalLock", "Ptr", hglobal, "Ptr")
    if !locked
        return []
    try {
        clipboardBuffer := Buffer(size, 0)
        DllCall("kernel32\RtlMoveMemory", "Ptr", clipboardBuffer, "Ptr", locked, "UPtr", size)
        return AhkStdlibPillowBufferToBytes(clipboardBuffer, size)
    } finally {
        DllCall("kernel32\GlobalUnlock", "Ptr", hglobal, "Int")
    }
}

AhkStdlibPillowImageGrabClipboardFiles()
{
    hdrop := DllCall("user32\GetClipboardData", "UInt", 15, "Ptr")
    if !hdrop
        return []
    count := DllCall("shell32\DragQueryFileW", "Ptr", hdrop, "UInt", 0xFFFFFFFF, "Ptr", 0, "UInt", 0, "UInt")
    files := []
    loop count {
        index := A_Index - 1
        length := DllCall("shell32\DragQueryFileW", "Ptr", hdrop, "UInt", index, "Ptr", 0, "UInt", 0, "UInt")
        pathBuffer := Buffer((length + 1) * 2, 0)
        DllCall("shell32\DragQueryFileW", "Ptr", hdrop, "UInt", index, "Ptr", pathBuffer, "UInt", length + 1, "UInt")
        files.Push(StrGet(pathBuffer, "UTF-16"))
    }
    return files
}

class AhkStdlibPillowImageShowModule
{
    static Viewer := AhkStdlibPillowImageShowViewerFactory()
    static WindowsViewer := AhkStdlibPillowImageShowWindowsViewerFactory()
    static MacViewer := AhkStdlibPillowImageShowMacViewerFactory()
    static UnixViewer := AhkStdlibPillowImageShowUnixViewerFactory()
    static XDGViewer := AhkStdlibPillowImageShowXDGViewerFactory()
    static DisplayViewer := AhkStdlibPillowImageShowDisplayViewerFactory()
    static GmDisplayViewer := AhkStdlibPillowImageShowGmDisplayViewerFactory()
    static EogViewer := AhkStdlibPillowImageShowEogViewerFactory()
    static XVViewer := AhkStdlibPillowImageShowXVViewerFactory()
    static IPythonViewer := AhkStdlibPillowImageShowIPythonViewerFactory()
    static RecordingViewer := AhkStdlibPillowImageShowRecordingViewerFactory()

    static _viewers
    {
        get => AhkStdlibPillowImageShowViewers()
    }

    static register(args*)
    {
        if args.Length < 1
            throw TypeError("register() missing 1 required positional argument: 'viewer'", -1)
        if args.Length > 2
            throw TypeError("register() takes from 1 to 2 positional arguments but " args.Length " were given", -1)
        viewer := AhkStdlibPillowImageShowInstantiateViewer(args[1])
        order := args.Length >= 2 ? args[2] : 1
        if order > 0
            AhkStdlibPillowImageShowViewers().Push(viewer)
        else
            AhkStdlibPillowImageShowViewers().InsertAt(1, viewer)
        return stdlib.None
    }

    static show(args*)
    {
        if args.Length < 1
            throw TypeError("show() missing 1 required positional argument: 'image'", -1)
        image := args[1]
        title := args.Length >= 2 ? args[2] : stdlib.None
        options := args.Length >= 3 && IsObject(args[3]) ? AhkStdlibPillowCloneMap(AhkStdlibPillowImageShowOptionsToMap(args[3])) : Map()
        if !AhkStdlibIsNone(title)
            options["title"] := title
        for viewer in AhkStdlibPillowImageShowViewers() {
            if viewer.show(image, options)
                return true
        }
        return false
    }

    static clear_viewers()
    {
        viewers := AhkStdlibPillowImageShowViewers()
        while viewers.Length
            viewers.Pop()
        return stdlib.None
    }

    static restore_viewers(viewers)
    {
        current := AhkStdlibPillowImageShowViewers()
        while current.Length
            current.Pop()
        for viewer in viewers
            current.Push(viewer)
        return stdlib.None
    }

    static viewer_names()
    {
        names := []
        for viewer in AhkStdlibPillowImageShowViewers()
            names.Push(AhkStdlibPillowImageShowVisibleTypeName(viewer))
        return names
    }
}

