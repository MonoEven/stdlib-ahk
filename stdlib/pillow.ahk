    length := Sqrt(12.0 * sigma2 + 1.0)
    integerPart := Floor((length - 1.0) / 2.0)
    fractional := (2 * integerPart + 1) * (integerPart * (integerPart + 1) - 3 * sigma2)
    fractional /= 6 * (sigma2 - (integerPart + 1) * (integerPart + 1))
    return integerPart + fractional
