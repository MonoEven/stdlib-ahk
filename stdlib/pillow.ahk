AhkStdlibPillowImageDrawFloodfill(image, xy, value, border := unset, thresh := 0)
{
    if !IsObject(image) || !image.HasOwnProp("AhkStdlibHandle")
        throw AttributeError("'" AhkStdlibPythonTypeName(image) "' object has no attribute 'load'", -1)
    coords := AhkStdlibPillowFloodfillUnpackPoint(xy)
    x := coords[1], y := coords[2]
    if x < 0 || y < 0 || x >= image.width || y >= image.height
        return stdlib.None

    background := image.getpixel([x, y])
    if AhkStdlibPillowFloodfillColorDiff(value, background) <= thresh
        return stdlib.None

    try {
        image.putpixel([x, y], value)
    } catch ValueError {
        return stdlib.None
    } catch IndexError {
        return stdlib.None
    }

    hasBorder := IsSet(border) && !AhkStdlibIsNone(border)
    edge := Map(x "," y, [x, y])
    fullEdge := Map()
    while edge.Count {
        newEdge := Map()
        for _, point in edge {
            for neighbor in [
                [point[1] + 1, point[2]],
                [point[1] - 1, point[2]],
                [point[1], point[2] + 1],
                [point[1], point[2] - 1],
            ] {
                sx := neighbor[1], sy := neighbor[2]
                key := sx "," sy
                if fullEdge.Has(key) || sx < 0 || sy < 0
                    continue
                if sx >= image.width || sy >= image.height
                    continue
                fullEdge[key] := neighbor
                pixel := image.getpixel([sx, sy])
                if hasBorder {
                    fill := !AhkStdlibPillowColorsEqual(pixel, value) && !AhkStdlibPillowColorsEqual(pixel, border)
                } else {
                    fill := AhkStdlibPillowFloodfillColorDiff(pixel, background) <= thresh
                }
                if fill {
                    image.putpixel([sx, sy], value)
                    newEdge[key] := neighbor
                }
            }
        }
        fullEdge := edge
        edge := newEdge
    }
    return stdlib.None
}

