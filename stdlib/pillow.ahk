        index := dataOffset
        loop height {
            y := A_Index - 1
            loop width {
                x := A_Index - 1
                AhkStdlibPillowDdsRequireLength(bytes, index)
                if mode = "L" {
                    image.putpixel([x, y], bytes[index])
                    index += 1
                } else {
                    AhkStdlibPillowDdsRequireLength(bytes, index + 1)
                    image.putpixel([x, y], [bytes[index], bytes[index + 1]])
                    index += 2
                }
            }
        }
    } catch Error as err {
        image.close()
        throw err
    }
    return image
}

AhkStdlibPillowDdsDecodeRgb(bytes, dataOffset, width, height, bitcount, mode, masks)
{
