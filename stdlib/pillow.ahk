AhkStdlibPillowDdsAppendPixels(bytes, image)
{
    loop image.height {
        y := A_Index - 1
        loop image.width {
            x := A_Index - 1
            pixel := image.getpixel([x, y])
            switch image.mode {
                case "RGB":
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[3]))
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[2]))
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[1]))
                case "RGBA":
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[3]))
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[2]))
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[1]))
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[4]))
                case "L":
                    bytes.Push(AhkStdlibPillowRequireByte(pixel))
                case "LA":
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[1]))
                    bytes.Push(AhkStdlibPillowRequireByte(pixel[2]))
            }
        }
    }
    return stdlib.None
}

AhkStdlibPillowDdsU32(bytes, offset)
{
    AhkStdlibPillowDdsRequireLength(bytes, offset + 3)
    return bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)
