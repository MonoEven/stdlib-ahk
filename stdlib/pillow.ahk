    dx := Abs(x2 - x1)
    dy := Abs(y2 - y1)
    sx := x1 < x2 ? 1 : -1
    sy := y1 < y2 ? 1 : -1
    err := dx - dy
    loop {
        if mask.Has(x1 "," y1)
            AhkStdlibPillowDrawPutPixel(image, x1, y1, color)
        else if dx < dy {
            lx := x1 - 1
            AhkStdlibPillowDrawPutPixel(image, lx, y1, color)
        }
        if x1 = x2 && y1 = y2
            break
        e2 := 2 * err
        if e2 > -dy {
            err -= dy
            x1 += sx
        }
        if e2 < dx {
            err += dx
            y1 += sy
        }
    }
}

