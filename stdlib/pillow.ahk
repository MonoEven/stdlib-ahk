class AhkStdlibPillowFeaturesModule
{
    static modules
    {
        get => AhkStdlibPillowFeaturesModulesMap()
    }

    static codecs
    {
        get => AhkStdlibPillowFeaturesCodecsMap()
    }

    static features
    {
        get => AhkStdlibPillowFeaturesFeaturesMap()
    }

    static check(args*)
    {
        return AhkStdlibPillowFeaturesCheck(args*)
    }

    static check_module(args*)
    {
        return AhkStdlibPillowFeaturesCheckKind("module", args*)
    }

    static check_codec(args*)
    {
        return AhkStdlibPillowFeaturesCheckKind("codec", args*)
    }

    static check_feature(args*)
    {
        return AhkStdlibPillowFeaturesCheckKind("feature", args*)
    }

    static version(args*)
    {
        return AhkStdlibPillowFeaturesVersion(args*)
    }

    static version_module(args*)
    {
        return AhkStdlibPillowFeaturesVersionKind("module", args*)
    }

    static version_codec(args*)
    {
        return AhkStdlibPillowFeaturesVersionKind("codec", args*)
    }

    static version_feature(args*)
    {
        return AhkStdlibPillowFeaturesVersionKind("feature", args*)
    }

    static get_supported_modules(args*)
    {
        return AhkStdlibPillowFeaturesGetSupported("module", args*)
    }

    static get_supported_codecs(args*)
    {
        return AhkStdlibPillowFeaturesGetSupported("codec", args*)
    }

    static get_supported_features(args*)
    {
        return AhkStdlibPillowFeaturesGetSupported("feature", args*)
    }

    static get_supported(args*)
    {
        return AhkStdlibPillowFeaturesGetSupported("all", args*)
    }

    static pilinfo(args*)
    {
        return AhkStdlibPillowFeaturesPilinfo(args*)
    }
}

