        throw TypeError("too many data entries", -1)
    return stdlib.None
}

AhkStdlibPillowImageGetPalette(image, rawmode := "RGB")
{
    AhkStdlibPillowValidatePaletteMode(rawmode)
    palette := image.AhkStdlibPalette
    if rawmode = image.AhkStdlibPaletteMode
        return palette.Clone()

    result := []
    if rawmode = "RGB" && image.AhkStdlibPaletteMode = "RGBA" {
        index := 1
        while index <= palette.Length {
            result.Push(palette[index])
            if index + 1 <= palette.Length
                result.Push(palette[index + 1])
            if index + 2 <= palette.Length
                result.Push(palette[index + 2])
            index += 4
        }
        return result
    }

    if rawmode = "RGBA" && image.AhkStdlibPaletteMode = "RGB" {
        index := 1
        while index <= palette.Length {
            result.Push(palette[index])
            if index + 1 <= palette.Length
                result.Push(palette[index + 1])
            if index + 2 <= palette.Length
                result.Push(palette[index + 2])
            result.Push(255)
            index += 3
        }
        return result
    }

    return []
}

AhkStdlibPillowImagePutPalette(image, data, rawmode := "RGB")
{
    if AhkStdlibIsNone(data)
        throw TypeError("cannot convert 'NoneType' object to bytes", -1)
    AhkStdlibPillowValidatePaletteMode(rawmode)
    image.AhkStdlibPaletteMode := rawmode
    image.AhkStdlibPalette := AhkStdlibPillowPaletteByteSequence(data)
    return stdlib.None
}

AhkStdlibPillowImageHasTransparencyData(image)
{
    if image.mode = "LA" || image.mode = "La" || image.mode = "PA" || image.mode = "RGBA" || image.mode = "RGBa"
        return true
    if image.HasOwnProp("info") && image.info.Has("transparency")
        return true
    return image.mode = "P" && image.AhkStdlibPaletteMode = "RGBA"
}

AhkStdlibPillowImageApplyTransparency(image)
{
    if image.mode != "P" || !image.info.Has("transparency")
        return stdlib.None

    palette := image.getpalette("RGBA")
    transparency := image.info["transparency"]
    if transparency is String
        throw TypeError('can only concatenate str (not "int") to str', -1)

    if transparency is Buffer {
        index := 1
        while index <= transparency.Size {
            alphaIndex := (index - 1) * 4 + 4
            if alphaIndex > palette.Length
                break
            palette[alphaIndex] := NumGet(transparency, index - 1, "UChar")
            index += 1
        }
    } else if transparency is Array {
        for index, alpha in transparency {
            alphaIndex := (index - 1) * 4 + 4
            if alphaIndex > palette.Length
                break
            palette[alphaIndex] := AhkStdlibPillowClampByte(AhkStdlibPillowRequireInteger(alpha, "transparency"))
        }
    } else {
        entry := AhkStdlibPillowRequireInteger(transparency, "transparency")
        alphaIndex := entry * 4 + 4
        if alphaIndex < 1 || alphaIndex > palette.Length
            throw IndexError("list assignment index out of range", -1)
        palette[alphaIndex] := 0
    }

    image.AhkStdlibPaletteMode := "RGBA"
    image.AhkStdlibPalette := palette
    image.info.Delete("transparency")
    return stdlib.None
}

AhkStdlibPillowImageQuantizeImage(image, colors := 256, method := unset, kmeans := 0, palette := unset, dither := AhkStdlibPillowImageDither.FLOYDSTEINBERG)
{
    if colors < 1 || colors > 256
        throw ValueError("bad number of colors", -1)
    if !IsSet(method) || AhkStdlibIsNone(method)
        method := image.mode = "RGBA" ? AhkStdlibPillowImageQuantize.FASTOCTREE : AhkStdlibPillowImageQuantize.MEDIANCUT
    if image.mode = "RGBA" && method != AhkStdlibPillowImageQuantize.FASTOCTREE && method != AhkStdlibPillowImageQuantize.LIBIMAGEQUANT
        throw ValueError("Fast Octree (method == 2) and libimagequant (method == 3) are the only valid methods for quantizing RGBA images", -1)
    if kmeans < 0
        throw ValueError("kmeans must not be negative", -1)

    if IsSet(palette) && !AhkStdlibIsNone(palette)
        return AhkStdlibPillowImageQuantizeToPalette(image, palette, dither)

    if image.mode = "RGBA"
        return AhkStdlibPillowImageQuantizeUniqueColors(image, colors, true)
    if image.mode = "RGB" || image.mode = "L" || image.mode = "P"
        return AhkStdlibPillowImageQuantizeUniqueColors(image, colors, false)
    throw ValueError("image has wrong mode", -1)
}

AhkStdlibPillowImageQuantizeToPalette(image, palette, dither := AhkStdlibPillowImageDither.FLOYDSTEINBERG)
{
    if palette.mode != "P"
        throw ValueError("bad mode for palette image", -1)
    if image.mode != "RGB" && image.mode != "L"
        throw ValueError("only RGB or L mode images can be quantized to a palette", -1)

    paletteColors := AhkStdlibPillowPaletteColors(palette)
    result := AhkStdlibPillowImageNew("P", image.size, 0)
    try {
        result.AhkStdlibPaletteMode := palette.AhkStdlibPaletteMode
        result.AhkStdlibPalette := palette.AhkStdlibPalette.Clone()
        loop image.height {
            y := A_Index - 1
            loop image.width {
                x := A_Index - 1
                color := AhkStdlibPillowPixelToRgb(image.getpixel([x, y]), image.mode, image)
                result.putpixel([x, y], AhkStdlibPillowNearestPaletteIndex(color, paletteColors))
            }
        }
        AhkStdlibPillowCopyExif(image, result)
        result.AhkStdlibPaletteMode := palette.AhkStdlibPaletteMode
        result.AhkStdlibPalette := palette.AhkStdlibPalette.Clone()
    } catch Error as err {
        result.close()
        throw err
    }
    return result
}

AhkStdlibPillowImageQuantizeUniqueColors(image, colors, rgbaMode := false)
{
    colorEntries := AhkStdlibPillowQuantizeCollectColors(image, rgbaMode)
    if colorEntries.Length > colors
        colorEntries := AhkStdlibPillowQuantizeReduceColors(colorEntries, colors)
    paletteBytes := []
    for entry in colorEntries {
        paletteBytes.Push(entry.Color[1])
        paletteBytes.Push(entry.Color[2])
        paletteBytes.Push(entry.Color[3])
    }

    lookup := Map()
    for index, entry in colorEntries
        lookup[AhkStdlibPillowColorKey(entry.Color)] := index - 1

    result := AhkStdlibPillowImageNew("P", image.size, 0)
    try {
        result.AhkStdlibPaletteMode := "RGB"
        result.AhkStdlibPalette := paletteBytes
        loop image.height {
            y := A_Index - 1
            loop image.width {
                x := A_Index - 1
                color := AhkStdlibPillowPixelToRgb(image.getpixel([x, y]), image.mode, image)
                key := AhkStdlibPillowColorKey(color)
                index := lookup.Has(key) ? lookup[key] : AhkStdlibPillowNearestPaletteIndex(color, colorEntries)
                result.putpixel([x, y], index)
            }
        }
        AhkStdlibPillowCopyExif(image, result)
        result.AhkStdlibPaletteMode := "RGB"
        result.AhkStdlibPalette := paletteBytes
    } catch Error as err {
        result.close()
        throw err
    }
    return result
}

AhkStdlibPillowQuantizeCollectColors(image, rgbaMode := false)
{
    entries := []
    byKey := Map()
    loop image.height {
        y := A_Index - 1
        loop image.width {
            x := A_Index - 1
            pixel := image.getpixel([x, y])
            color := AhkStdlibPillowPixelToRgb(pixel, image.mode, image)
            alpha := rgbaMode && image.mode = "RGBA" ? AhkStdlibPillowSequenceToArray(pixel)[4] : 255
            key := AhkStdlibPillowColorKey(color) "," alpha
            if byKey.Has(key) {
                entries[byKey[key]].Count += 1
            } else {
                entries.Push({ Color: color, Count: 1, Alpha: alpha })
                byKey[key] := entries.Length
            }
        }
    }
    AhkStdlibPillowQuantizeSortEntries(entries, rgbaMode)
    return entries
}

AhkStdlibPillowQuantizeReduceColors(entries, colors)
{
    while entries.Length > colors {
        merged := AhkStdlibPillowQuantizeAverage(entries, 1, 2)
        reduced := [merged]
        index := 3
        while index <= entries.Length {
            reduced.Push(entries[index])
            index += 1
        }
        entries := reduced
        AhkStdlibPillowQuantizeSortEntries(entries, false)
    }
    return entries
}

AhkStdlibPillowQuantizeAverage(entries, startIndex, endIndex)
{
    r := 0, g := 0, b := 0, count := 0
    index := startIndex
    while index <= endIndex {
        entry := entries[index]
        r += entry.Color[1] * entry.Count
        g += entry.Color[2] * entry.Count
        b += entry.Color[3] * entry.Count
        count += entry.Count
        index += 1
    }
    return { Color: [Round(r / count), Round(g / count), Round(b / count)], Count: count, Alpha: 255 }
}

AhkStdlibPillowQuantizeSortEntries(entries, rgbaMode := false)
{
    n := entries.Length
    loop n {
        i := A_Index
        j := i + 1
        while j <= n {
            if AhkStdlibPillowQuantizeEntryLess(entries[j], entries[i], rgbaMode) {
                tmp := entries[i]
                entries[i] := entries[j]
                entries[j] := tmp
            }
            j += 1
        }
    }
}

AhkStdlibPillowQuantizeEntryLess(a, b, rgbaMode := false)
{
    if rgbaMode {
        if a.Alpha != b.Alpha
            return a.Alpha < b.Alpha
        return AhkStdlibPillowColorLuma(a.Color) > AhkStdlibPillowColorLuma(b.Color)
    }
    return AhkStdlibPillowColorLuma(a.Color) > AhkStdlibPillowColorLuma(b.Color)
}

AhkStdlibPillowArraySlice(values, startIndex, endIndex)
{
    result := []
    index := startIndex
    while index <= endIndex && index <= values.Length {
        result.Push(values[index])
        index += 1
    }
    return result
}

AhkStdlibPillowArrayEquals(left, right)
{
    if !(left is Array) || !(right is Array)
        return false
    if left.Length != right.Length
        return false
    loop left.Length {
        if left[A_Index] != right[A_Index]
            return false
    }
    return true
}

AhkStdlibPillowPaletteColors(image)
{
    palette := image.getpalette("RGB")
    colors := []
    index := 1
    while index <= palette.Length {
        colors.Push({ Color: [palette[index], palette[index + 1], palette[index + 2]], Count: 1 })
        index += 3
    }
    return colors
}

AhkStdlibPillowNearestPaletteIndex(color, paletteColors)
{
    bestIndex := 0
    bestDistance := unset
    for index, entry in paletteColors {
        distance := AhkStdlibPillowColorDistance(color, entry.Color)
        if !IsSet(bestDistance) || distance < bestDistance {
            bestDistance := distance
            bestIndex := index - 1
        }
    }
    return bestIndex
}

AhkStdlibPillowPixelToRgb(pixel, mode, image := unset)
{
    if mode = "P" {
        if !IsSet(image)
            return [pixel, pixel, pixel]
        return AhkStdlibPillowPaletteLookup(image, pixel, "RGB")
    }
    if mode = "L" || mode = "1"
        return [pixel, pixel, pixel]
    values := AhkStdlibPillowSequenceToArray(pixel)
    return [values[1], values[2], values[3]]
}

AhkStdlibPillowPaletteLookup(image, index, rawmode := "RGB")
{
    palette := image.getpalette(rawmode)
    stride := rawmode = "RGBA" ? 4 : 3
    offset := index * stride + 1
    if offset + stride - 1 > palette.Length {
        if rawmode = "RGBA"
            return [index, index, index, 255]
        return [index, index, index]
    }
    if rawmode = "RGBA"
        return [palette[offset], palette[offset + 1], palette[offset + 2], palette[offset + 3]]
    return [palette[offset], palette[offset + 1], palette[offset + 2]]
}

AhkStdlibPillowColorKey(color)
{
    return color[1] "," color[2] "," color[3]
}

AhkStdlibPillowColorLuma(color)
{
    return color[1] * 299 + color[2] * 587 + color[3] * 114
}

AhkStdlibPillowColorDistance(a, b)
{
    dr := a[1] - b[1]
    dg := a[2] - b[2]
    db := a[3] - b[3]
    return dr * dr + dg * dg + db * db
}

AhkStdlibPillowImageRemapPalette(image, destMap, sourcePalette := unset)
{
    if image.mode != "L" && image.mode != "P"
        throw ValueError("illegal image mode", -1)

    destValues := AhkStdlibPillowRemapDestMapToArray(destMap)
    source := AhkStdlibPillowRemapSourcePalette(image, sourcePalette?)
    bands := source.Bands
    sourceBytes := source.Bytes

    newPositions := []
    loop 256
        newPositions.Push(0)

    paletteBytes := []
    for index, oldPosition in destValues {
        AhkStdlibPillowRemapValidateOldPosition(oldPosition)
        for byteValue in AhkStdlibPillowRemapPaletteSlice(sourceBytes, oldPosition * bands, oldPosition * bands + bands)
            paletteBytes.Push(byteValue)
        newPositions[AhkStdlibPillowPythonListIndex(oldPosition, 256) + 1] := index - 1
    }

    result := AhkStdlibPillowImageNew("P", image.size, 0)
    try {
        result.AhkStdlibPaletteMode := source.Mode
        result.AhkStdlibPalette := paletteBytes

        loop image.height {
            y := A_Index - 1
            loop image.width {
                x := A_Index - 1
                oldValue := image.getpixel([x, y])
                if !(oldValue is Integer)
                    throw TypeError("'" AhkStdlibPythonTypeName(oldValue) "' object cannot be interpreted as an integer", -1)
                if oldValue < 0 || oldValue > 255
                    throw IndexError("list assignment index out of range", -1)
                result.putpixel([x, y], newPositions[oldValue + 1])
            }
        }

        AhkStdlibPillowCopyExif(image, result)
        result.AhkStdlibPaletteMode := source.Mode
        result.AhkStdlibPalette := paletteBytes
        if image.info.Has("transparency") {
            transparency := image.info["transparency"]
            foundTransparency := false
            for index, oldPosition in destValues {
                if oldPosition = transparency {
                    result.info["transparency"] := index - 1
                    foundTransparency := true
                    break
                }
            }
            if !foundTransparency && result.info.Has("transparency")
                result.info.Delete("transparency")
        }
    } catch Error as err {
        result.close()
        throw err
    }
    return result
}

AhkStdlibPillowRemapDestMapToArray(destMap)
{
    if destMap is String
        throw TypeError('can only concatenate str (not "int") to str', -1)
    return AhkStdlibPillowSequenceToArray(destMap)
}

AhkStdlibPillowRemapSourcePalette(image, sourcePalette := unset)
{
    if !IsSet(sourcePalette) || AhkStdlibIsNone(sourcePalette) {
        if image.mode = "P" {
            paletteMode := image.AhkStdlibPaletteMode
            bands := paletteMode = "RGBA" ? 4 : 3
            return { Bytes: image.getpalette(paletteMode), Bands: bands, Mode: paletteMode }
        }

        sourceBytes := []
        loop 768
            sourceBytes.Push(Floor((A_Index - 1) / 3))
        return { Bytes: sourceBytes, Bands: 3, Mode: "RGB" }
    }

    if sourcePalette is String
        throw TypeError("can't concat str to bytes", -1)

    sourceBytes := AhkStdlibPillowByteSequence(sourcePalette)
    if sourceBytes.Length > 768
        return { Bytes: sourceBytes, Bands: 4, Mode: "RGBA" }
    return { Bytes: sourceBytes, Bands: 3, Mode: "RGB" }
}

AhkStdlibPillowRemapValidateOldPosition(oldPosition)
{
    if !(oldPosition is Integer)
        throw TypeError("slice indices must be integers or None or have an __index__ method", -1)
    if oldPosition < -256 || oldPosition > 255
        throw IndexError("list assignment index out of range", -1)
}

AhkStdlibPillowRemapPaletteSlice(sourceBytes, start, stop)
{
    length := sourceBytes.Length
    start := AhkStdlibPillowNormalizePythonSliceIndex(start, length)
    stop := AhkStdlibPillowNormalizePythonSliceIndex(stop, length)
    result := []
    index := start
    while index < stop {
        result.Push(sourceBytes[index + 1])
        index += 1
    }
    return result
}

AhkStdlibPillowNormalizePythonSliceIndex(index, length)
{
    if index < 0
        index += length
    if index < 0
        return 0
    if index > length
        return length
    return index
}

AhkStdlibPillowPythonListIndex(index, length)
{
    if index < 0
        index += length
    if index < 0 || index >= length
        throw IndexError("list assignment index out of range", -1)
    return index
}

AhkStdlibPillowValidatePaletteMode(rawmode)
{
    if rawmode != "RGB" && rawmode != "RGBA"
        throw ValueError("unrecognized raw mode", -1)
}

AhkStdlibPillowPaletteByteSequence(data)
{
    if data is Buffer {
        bytes := []
        loop data.Size
            bytes.Push(NumGet(data, A_Index - 1, "UChar"))
