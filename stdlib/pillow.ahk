    AhkStdlibPillowRegisterSaveAll("PDF", AhkStdlibPillowPdfSaveAll)
    AhkStdlibPillowRegisterExtension("PDF", ".pdf")
    AhkStdlibPillowRegisterMime("PDF", "application/pdf")
    return stdlib.None
}

AhkStdlibPillowPdfSaveImage(args*)
{
    AhkStdlibPillowPdfRequireArity("_save", args, 3, ["im", "fp", "filename"])
    return AhkStdlibPillowPdfSavePages(args[1], args[2], args[3], false)
}

AhkStdlibPillowPdfSaveAllImage(args*)
{
    AhkStdlibPillowPdfRequireArity("_save_all", args, 3, ["im", "fp", "filename"])
    return AhkStdlibPillowPdfSavePages(args[1], args[2], args[3], true)
}

AhkStdlibPillowPdfWriteImage(args*)
{
    AhkStdlibPillowPdfRequireArity("_write_image", args, 4, ["im", "filename", "existing_pdf", "image_refs"])
    image := args[1]
    imageRefs := args[4]
    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    frame := AhkStdlibPillowPdfFrameDescriptor(image, info)
    if IsObject(imageRefs) && imageRefs is Array
        imageRefs.Push(frame)
    return stdlib.None
}

AhkStdlibPillowPdfRequireArity(name, args, required, labels)
{
    if args.Length < required
        throw TypeError(name "() missing " (required - args.Length) " required positional argument" (required - args.Length = 1 ? "" : "s") ": " AhkStdlibPillowPdfQuotedNames(AhkStdlibPillowArraySlice(labels, args.Length + 1, labels.Length)), -1)
    if args.Length > required
        throw TypeError(name "() takes " required " positional arguments but " args.Length " were given", -1)
    return stdlib.None
}

AhkStdlibPillowPdfQuotedNames(names)
{
    quoted := []
    for name in names
        quoted.Push("'" name "'")
    if quoted.Length = 1
        return quoted[1]
    if quoted.Length = 2
        return quoted[1] " and " quoted[2]
    prefix := AhkStdlibPillowJoin(AhkStdlibPillowArraySlice(quoted, 1, quoted.Length - 1), ", ")
    return prefix ", and " quoted[quoted.Length]
}

AhkStdlibPillowPdfSavePages(image, fp, filename, saveAll)
{
    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    images := [image]
    if saveAll && AhkStdlibPillowPdfInfoHas(info, "append_images") {
        for appended in AhkStdlibPillowSequenceToArray(AhkStdlibPillowPdfInfoGet(info, "append_images", []))
            images.Push(appended)
    }

    bytes := AhkStdlibPillowPdfBuildDocument(images, info)
    fp.write(bytes)
    if HasMethod(fp, "flush")
        fp.flush()
    return stdlib.None
}

AhkStdlibPillowPdfBuildDocument(images, info)
{
    frames := []
    for image in images
        frames.Push(AhkStdlibPillowPdfFrameDescriptor(image, info))

    catalogObj := frames.Length * 3 + 1
    pagesObj := catalogObj + 1
    infoObj := AhkStdlibPillowPdfHasInfoObject(info) ? pagesObj + 1 : 0
    maxObj := infoObj ? infoObj : pagesObj
    objects := Map()
    kids := []

    for index, frame in frames {
        imageObj := (index - 1) * 3 + 1
        pageObj := imageObj + 1
        contentObj := imageObj + 2
        frame.ImageName := "image" index
        kids.Push(pageObj " 0 R")
        objects[imageObj] := AhkStdlibPillowPdfImageObjectBytes(imageObj, frame)
        objects[pageObj] := AhkStdlibPillowPdfPageObjectBytes(pageObj, pagesObj, contentObj, imageObj, frame)
        objects[contentObj] := AhkStdlibPillowPdfContentObjectBytes(contentObj, frame)
    }

    objects[catalogObj] := AhkStdlibPillowPdfObjectBytes(catalogObj, AhkStdlibPillowAsciiBytes("<<`n/Type /Catalog`n/Pages " pagesObj " 0 R`n>>"))
    objects[pagesObj] := AhkStdlibPillowPdfObjectBytes(pagesObj, AhkStdlibPillowAsciiBytes("<<`n/Type /Pages`n/Count " frames.Length "`n/Kids [ " AhkStdlibPillowJoin(kids, " ") " ]`n>>"))
    if infoObj
        objects[infoObj] := AhkStdlibPillowPdfObjectBytes(infoObj, AhkStdlibPillowAsciiBytes(AhkStdlibPillowPdfInfoDict(info)))

    bytes := AhkStdlibPillowAsciiBytes("%PDF-1.4`n% created by Pillow 11.3.0 PDF driver`n")
    offsets := Map()
    loop maxObj {
        offsets[A_Index] := bytes.Length
        AhkStdlibPillowPdfAppendBytes(bytes, objects[A_Index])
    }

    xrefOffset := bytes.Length
    AhkStdlibPillowPdfAppendAscii(bytes, "xref`n0 " (maxObj + 1) "`n0000000000 65535 f `n")
    loop maxObj
        AhkStdlibPillowPdfAppendAscii(bytes, Format("{:010d}", offsets[A_Index]) " 00000 n `n")

    trailer := "trailer`n<<`n/Size " (maxObj + 1) "`n/Root " catalogObj " 0 R`n"
    if infoObj
        trailer .= "/Info " infoObj " 0 R`n"
    trailer .= ">>`nstartxref`n" xrefOffset "`n%%EOF`n"
    AhkStdlibPillowPdfAppendAscii(bytes, trailer)
    return bytes
}

AhkStdlibPillowPdfFrameDescriptor(image, info)
{
    if !AhkStdlibPillowArrayContains(["1", "L", "P", "RGB"], image.mode)
        throw ValueError("cannot save mode " image.mode, -1)

    descriptor := {
        Image: image,
        Mode: image.mode,
        Width: image.size[1],
        Height: image.size[2],
        MediaBox: AhkStdlibPillowPdfMediaBox(image, info),
        BitsPerComponent: image.mode = "1" ? 1 : 8,
        ProcSet: image.mode = "RGB" ? "ImageC" : image.mode = "P" ? "ImageI" : "ImageB",
        Filter: "",
        ColorSpace: "",
        DecodeParms: "",
        Stream: []
    }

    if image.mode = "RGB" {
        descriptor.Filter := "/Filter /DCTDecode`n"
        descriptor.ColorSpace := "/ColorSpace /DeviceRGB`n"
        descriptor.Stream := AhkStdlibPillowPdfJpegStream(image)
    } else if image.mode = "L" {
        descriptor.Filter := "/Filter /DCTDecode`n"
        descriptor.ColorSpace := "/ColorSpace /DeviceGray`n"
        descriptor.Stream := AhkStdlibPillowPdfJpegStream(image)
    } else if image.mode = "P" {
        descriptor.Filter := "/Filter /ASCIIHexDecode`n"
        descriptor.ColorSpace := "/ColorSpace " AhkStdlibPillowPdfPaletteColorSpace(image) "`n"
        descriptor.Stream := AhkStdlibPillowAsciiBytes(AhkStdlibPillowPdfPalettePixelHex(image))
    } else {
        descriptor.Filter := "/Filter [ /CCITTFaxDecode ]`n"
        descriptor.ColorSpace := "/ColorSpace /DeviceGray`n"
        descriptor.DecodeParms := "/DecodeParms [ <<`n/K -1`n/BlackIs1 true`n/Columns " descriptor.Width "`n/Rows " descriptor.Height "`n>> ]`n"
        descriptor.Stream := AhkStdlibPillowImageToBytes(image)
    }
    return descriptor
}

AhkStdlibPillowPdfJpegStream(image)
{
    try {
        AhkStdlibPillowJpegEnsureRegistered()
        buffer := stdlib.io.BytesIO()
        image.save(buffer, "JPEG")
        bytes := buffer.getvalue()
        if bytes.Length
            return bytes
    }
    return AhkStdlibPillowImageToBytes(image)
}

AhkStdlibPillowPdfMediaBox(image, info)
{
    dpi := AhkStdlibPillowPdfResolution(info)
    width := AhkStdlibPillowPdfPointSize(image.size[1], dpi[1])
    height := AhkStdlibPillowPdfPointSize(image.size[2], dpi[2])
    return "0 0 " width " " height
}

AhkStdlibPillowPdfResolution(info)
{
    xres := 72.0
    yres := 72.0
    if AhkStdlibPillowPdfInfoHas(info, "dpi") {
        values := AhkStdlibPillowSequenceToArray(AhkStdlibPillowPdfInfoGet(info, "dpi", [72.0, 72.0]))
        if values.Length >= 1
            xres := Float(values[1])
        if values.Length >= 2
            yres := Float(values[2])
    } else if AhkStdlibPillowPdfInfoHas(info, "resolution") {
        xres := Float(AhkStdlibPillowPdfInfoGet(info, "resolution", 72.0))
        yres := xres
    }
    if xres <= 0
        xres := 72.0
    if yres <= 0
        yres := 72.0
    return [xres, yres]
}

AhkStdlibPillowPdfPointSize(pixels, resolution)
{
    return Format("{:.1f}", Float(pixels) * 72.0 / Float(resolution))
}

AhkStdlibPillowPdfImageObjectBytes(number, frame)
{
    dict := "<<`n/Type /XObject`n/Subtype /Image`n/Width " frame.Width "`n/Height " frame.Height "`n"
        . frame.Filter
        . frame.DecodeParms
        . "/BitsPerComponent " frame.BitsPerComponent "`n"
        . frame.ColorSpace
        . "/Length " frame.Stream.Length "`n>>"
    return AhkStdlibPillowPdfStreamObjectBytes(number, dict, frame.Stream)
}

AhkStdlibPillowPdfPageObjectBytes(number, pagesObj, contentObj, imageObj, frame)
{
    body := "<<`n/Type /Page`n/Parent " pagesObj " 0 R`n/Resources <<`n/ProcSet [ /PDF /" frame.ProcSet " ]`n/XObject << /" frame.ImageName " " imageObj " 0 R >>`n>>`n/MediaBox [ " frame.MediaBox " ]`n/Contents " contentObj " 0 R`n>>"
    return AhkStdlibPillowPdfObjectBytes(number, AhkStdlibPillowAsciiBytes(body))
}

AhkStdlibPillowPdfContentObjectBytes(number, frame)
{
    stream := AhkStdlibPillowAsciiBytes("q`n" AhkStdlibPillowPdfContentSize(frame.MediaBox, 3) " 0 0 " AhkStdlibPillowPdfContentSize(frame.MediaBox, 4) " 0 0 cm`n/" frame.ImageName " Do`nQ`n")
    return AhkStdlibPillowPdfStreamObjectBytes(number, "<<`n/Length " stream.Length "`n>>", stream)
}

AhkStdlibPillowPdfContentSize(mediaBox, field)
{
    parts := StrSplit(mediaBox, " ")
    return parts[field]
}

AhkStdlibPillowPdfObjectBytes(number, bodyBytes)
{
    bytes := AhkStdlibPillowAsciiBytes(number " 0 obj")
    AhkStdlibPillowPdfAppendBytes(bytes, bodyBytes)
    AhkStdlibPillowPdfAppendAscii(bytes, "`nendobj`n")
    return bytes
}

AhkStdlibPillowPdfStreamObjectBytes(number, dictText, streamBytes)
{
    bytes := AhkStdlibPillowAsciiBytes(number " 0 obj" dictText "`nstream`n")
    AhkStdlibPillowPdfAppendBytes(bytes, streamBytes)
    AhkStdlibPillowPdfAppendAscii(bytes, "`nendstream`nendobj`n")
    return bytes
}

AhkStdlibPillowPdfPaletteColorSpace(image)
{
    palette := image.getpalette("RGB")
    maxIndex := Max((palette.Length // 3) - 1, AhkStdlibPillowPdfMaxPaletteIndex(image), 0)
    hex := ""
    loop (maxIndex + 1) * 3 {
        value := A_Index <= palette.Length ? palette[A_Index] : 0
        hex .= Format("{:02X}", AhkStdlibPillowRequireByte(value))
    }
    return "[ /Indexed /DeviceRGB " maxIndex " <" hex "> ]"
}

AhkStdlibPillowPdfPalettePixelHex(image)
{
    hex := ""
    loop image.height {
        y := A_Index - 1
        loop image.width
            hex .= Format("{:02X}", AhkStdlibPillowRequireByte(image.getpixel([A_Index - 1, y])))
    }
    return hex
}

AhkStdlibPillowPdfMaxPaletteIndex(image)
{
    maxIndex := 0
    loop image.height {
        y := A_Index - 1
        loop image.width
            maxIndex := Max(maxIndex, AhkStdlibPillowRequireByte(image.getpixel([A_Index - 1, y])))
    }
    return maxIndex
}

AhkStdlibPillowPdfHasInfoObject(info)
{
    return AhkStdlibPillowPdfInfoHasNonNone(info, "title")
        || AhkStdlibPillowPdfInfoHasNonNone(info, "author")
}

AhkStdlibPillowPdfInfoDict(info)
{
    parts := ["<<"]
    if AhkStdlibPillowPdfInfoHasNonNone(info, "title")
        parts.Push("/Title (" AhkStdlibPillowPdfEscapeText(AhkStdlibPillowPdfInfoGet(info, "title", "")) ")")
    if AhkStdlibPillowPdfInfoHasNonNone(info, "author")
        parts.Push("/Author (" AhkStdlibPillowPdfEscapeText(AhkStdlibPillowPdfInfoGet(info, "author", "")) ")")
    parts.Push(">>")
    return AhkStdlibPillowJoin(parts, "`n")
}

AhkStdlibPillowPdfInfoHasNonNone(info, name)
{
    return AhkStdlibPillowPdfInfoHas(info, name) && !AhkStdlibIsNone(AhkStdlibPillowPdfInfoGet(info, name, stdlib.None))
}

AhkStdlibPillowPdfInfoHas(info, name)
{
    if !IsObject(info)
        return false
    if info is Map
        return info.Has(name)
    return HasProp(info, name)
}

AhkStdlibPillowPdfInfoGet(info, name, defaultValue)
{
    if !IsObject(info)
        return defaultValue
    if info is Map
        return info.Has(name) ? info[name] : defaultValue
    return HasProp(info, name) ? info.%name% : defaultValue
}

AhkStdlibPillowPdfEscapeText(value)
{
    text := String(value)
    text := StrReplace(text, "\", "\\")
    text := StrReplace(text, "(", "\(")
    text := StrReplace(text, ")", "\)")
    text := StrReplace(text, "`r", "\r")
    text := StrReplace(text, "`n", "\n")
    return text
}

AhkStdlibPillowPdfAppendAscii(bytes, text)
{
    return AhkStdlibPillowPdfAppendBytes(bytes, AhkStdlibPillowAsciiBytes(text))
}

AhkStdlibPillowPdfAppendBytes(bytes, more)
{
    for byte in more
        bytes.Push(byte)
    return stdlib.None
}

class AhkStdlibPillowPixarImagePluginModule
{
