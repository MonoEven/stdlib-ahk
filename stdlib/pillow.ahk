class AhkStdlibPillowTiffImageFileFactory
{
    format := "TIFF"
    format_description := "Adobe TIFF"

    Call(args*)
    {
        actual := AhkStdlibPillowTiffNormalizeFactoryArgs(this, args)
        if actual.Length < 1
            throw TypeError("TiffImageFile.__init__() missing 1 required positional argument: 'fp'", -1)
        if actual.Length > 2
            throw TypeError("TiffImageFile.__init__() takes from 2 to 3 positional arguments but " (actual.Length + 1) " were given", -1)
        return AhkStdlibPillowTiffOpen(actual[1])
    }
}

