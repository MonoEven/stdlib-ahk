    fp.write(bytes)
    return stdlib.None
}

AhkStdlibPillowGifEncodeImage(image, saveAll := false)
{
    if image.mode != "P"
        image := image.convert("P")
    palette := image.getpalette("RGB")
    while palette.Length < 12
        palette.Push(0)
    colorCount := Max(2, Ceil(palette.Length / 3))
    colorTableSize := 2
    colorBits := 1
    while colorTableSize < colorCount {
        colorTableSize *= 2
        colorBits += 1
    }
    while palette.Length < colorTableSize * 3
        palette.Push(0)
    packedSizeBits := Max(0, colorBits - 1)

    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : image.info
    bytes := AhkStdlibPillowAsciiBytes("GIF89a")
    AhkStdlibPillowGifPushU16(bytes, image.width)
    AhkStdlibPillowGifPushU16(bytes, image.height)
    bytes.Push(0x80 | (7 << 4) | packedSizeBits)
    bytes.Push(AhkStdlibPillowGifInfoInt(info, "background", 0))
    bytes.Push(0)
    loop colorTableSize * 3
        bytes.Push(A_Index <= palette.Length ? palette[A_Index] : 0)

    if AhkStdlibPillowGifInfoHas(info, "comment") {
        bytes.Push(0x21)
        bytes.Push(0xFE)
        AhkStdlibPillowGifPushSubBlocks(bytes, AhkStdlibPillowByteSequence(info["comment"]))
    }
    if AhkStdlibPillowGifInfoHas(info, "loop") {
        bytes.Push(0x21)
        bytes.Push(0xFF)
        bytes.Push(11)
        for byte in AhkStdlibPillowAsciiBytes("NETSCAPE2.0")
            bytes.Push(byte)
        bytes.Push(3)
        bytes.Push(1)
        AhkStdlibPillowGifPushU16(bytes, AhkStdlibPillowGifInfoInt(info, "loop", 0))
        bytes.Push(0)
    }
    if AhkStdlibPillowGifInfoHas(info, "transparency") || AhkStdlibPillowGifInfoHas(info, "duration") {
        AhkStdlibPillowGifPushGraphicControl(bytes, info, 1)
    }

    frames := AhkStdlibPillowGifSaveFrames(image, info, saveAll)
    for index, frame in frames {
        if index > 1 && (AhkStdlibPillowGifInfoHas(frame.Info, "transparency") || AhkStdlibPillowGifInfoHas(frame.Info, "duration"))
            AhkStdlibPillowGifPushGraphicControl(bytes, frame.Info, index)
        AhkStdlibPillowGifPushFrame(bytes, frame.Image, colorBits)
    }
    bytes.Push(0x3B)
    return bytes
}

AhkStdlibPillowGifSaveFrames(image, info, saveAll)
{
