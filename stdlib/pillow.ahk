AhkStdlibPillowPalm8BitColormapValues()
{
    levels := [255, 204, 153, 102, 51, 0]
    values := []
    for blueBlock in [[255, 204, 153], [102, 51, 0]] {
        for red in levels {
            for blue in blueBlock {
                for green in levels
                    values.Push([red, green, blue])
            }
        }
    }
    values[216] := [17, 17, 17]
    for color in [
        [34, 34, 34],
        [68, 68, 68],
        [85, 85, 85],
        [119, 119, 119],
        [136, 136, 136],
        [170, 170, 170],
        [187, 187, 187],
        [221, 221, 221],
        [238, 238, 238],
        [192, 192, 192],
        [128, 0, 0],
        [128, 0, 128],
        [0, 128, 0],
        [0, 128, 128],
    ]
        values.Push(color)
    while values.Length < 256
        values.Push([0, 0, 0])
    return values
}

AhkStdlibPillowPalmSaveImage(args*)
{
    if args.Length < 3
        throw TypeError("_save() missing " (3 - args.Length) " required positional argument" (3 - args.Length = 1 ? "" : "s") ": " (args.Length = 0 ? "'im', 'fp', and 'filename'" : args.Length = 1 ? "'fp' and 'filename'" : "'filename'"), -1)
    if args.Length > 3
        throw TypeError("_save() takes 3 positional arguments but " args.Length " were given", -1)

    image := args[1]
    fp := args[2]
    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    if image.mode = "P" {
        bpp := 8
        version := 1
        flags := 0x4000
        palette := image.getpalette("RGB")
        colors := palette.Length // 3
        colormapSize := 4 * colors + 2
    } else if image.mode = "L" {
        bpp := stdlib.None
        if info.Has("bpp") && AhkStdlibPillowArrayContains([1, 2, 4], info["bpp"])
            bpp := info["bpp"]
        else if image.info.Has("bpp") && AhkStdlibPillowArrayContains([1, 2, 4], image.info["bpp"])
            bpp := image.info["bpp"]
        if AhkStdlibIsNone(bpp)
            throw OSError("cannot write mode L as Palm", -1)
        throw ValueError("image has no palette", -1)
    } else if image.mode = "1" {
        bpp := 1
        version := 0
        flags := 0
        colors := 0
        palette := []
        colormapSize := 0
    } else {
        throw OSError("cannot write mode " image.mode " as Palm", -1)
    }

    cols := image.width
    rows := image.height
    rowbytes := Ceil(cols / (16 // bpp)) * 2
    offset := image.info.Has("offset") ? (rowbytes * rows + 16 + 3 + colormapSize) // 4 : 0
    bytes := []
    for byte in AhkStdlibPillowPalmBe16(cols)
        bytes.Push(byte)
    for byte in AhkStdlibPillowPalmBe16(rows)
        bytes.Push(byte)
    for byte in AhkStdlibPillowPalmBe16(rowbytes)
        bytes.Push(byte)
    for byte in AhkStdlibPillowPalmBe16(flags)
        bytes.Push(byte)
    bytes.Push(bpp)
    bytes.Push(version)
    for byte in AhkStdlibPillowPalmBe16(offset)
        bytes.Push(byte)
    bytes.Push(0)
    bytes.Push(0xFF)
    for byte in AhkStdlibPillowPalmBe16(0)
        bytes.Push(byte)

    if image.mode = "P" {
        for byte in AhkStdlibPillowPalmBe16(colors)
            bytes.Push(byte)
        loop colors {
            colorIndex := A_Index - 1
            pos := colorIndex * 3 + 1
            bytes.Push(colorIndex)
            bytes.Push(palette[pos])
            bytes.Push(palette[pos + 1])
            bytes.Push(palette[pos + 2])
        }
        body := AhkStdlibPillowPalmPBody(image, rowbytes)
    } else {
        body := AhkStdlibPillowPalmOneBody(image, rowbytes)
    }
    for byte in body
        bytes.Push(byte)
    fp.write(bytes)
    if HasMethod(fp, "flush")
        fp.flush()
    return stdlib.None
}

AhkStdlibPillowPalmPBody(image, rowbytes)
{
    bytes := []
    loop image.height {
        y := A_Index - 1
        row := []
        loop image.width
            row.Push(AhkStdlibPillowRequireByte(image.getpixel([A_Index - 1, y])))
        while row.Length < rowbytes
            row.Push(0)
        for byte in row
            bytes.Push(byte)
    }
    return bytes
}

AhkStdlibPillowPalmOneBody(image, rowbytes)
{
    bytes := []
    loop image.height {
        y := A_Index - 1
        row := []
        current := 0
        bit := 7
        loop image.width {
            x := A_Index - 1
            value := image.getpixel([x, y]) ? 0 : 1
            current |= value << bit
            bit -= 1
            if bit < 0 {
                row.Push(current)
                current := 0
                bit := 7
            }
        }
        if bit != 7
            row.Push(current)
        while row.Length < rowbytes
            row.Push(0)
        for byte in row
            bytes.Push(byte)
    }
    return bytes
}

AhkStdlibPillowPalmBe16(value)
{
    value := Integer(value)
    return [(value >> 8) & 0xFF, value & 0xFF]
}

