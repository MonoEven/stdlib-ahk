    return raw
}

AhkStdlibPillowQoiDecodeRows(bytes, mode, width, height)
{
    bands := StrLen(AhkStdlibPillowChannels(mode))
    destLength := width * height * bands
    data := []
    previous := [0, 0, 0, 255]
    seen := Map()
    pos := 1
    while data.Length < destLength && pos <= bytes.Length {
        byte := bytes[pos]
        pos += 1
        value := unset
        if byte = 0xFE {
            if pos + 2 > bytes.Length
                break
            value := [bytes[pos], bytes[pos + 1], bytes[pos + 2], previous[4]]
            pos += 3
        } else if byte = 0xFF {
            if pos + 3 > bytes.Length
                break
            value := [bytes[pos], bytes[pos + 1], bytes[pos + 2], bytes[pos + 3]]
            pos += 4
        } else {
            op := byte >> 6
            if op = 0 {
                opIndex := byte & 0x3F
                value := seen.Has(opIndex) ? seen[opIndex].Clone() : [0, 0, 0, 0]
            } else if op = 1 {
                value := [
                    Mod(previous[1] + ((byte & 0x30) >> 4) - 2, 256),
                    Mod(previous[2] + ((byte & 0x0C) >> 2) - 2, 256),
                    Mod(previous[3] + (byte & 0x03) - 2, 256),
                    previous[4],
                ]
            } else if op = 2 {
                if pos > bytes.Length
                    break
                second := bytes[pos]
                pos += 1
                diffGreen := (byte & 0x3F) - 32
                diffRed := ((second & 0xF0) >> 4) - 8
                diffBlue := (second & 0x0F) - 8
                value := [
                    Mod(previous[1] + diffGreen + diffRed, 256),
                    Mod(previous[2] + diffGreen, 256),
                    Mod(previous[3] + diffGreen + diffBlue, 256),
                    previous[4],
                ]
            } else {
                runLength := (byte & 0x3F) + 1
                loop runLength {
                    AhkStdlibPillowQoiAppendPixelData(data, previous, bands)
                    if data.Length >= destLength
                        break
                }
                continue
            }
        }
        AhkStdlibPillowQoiRememberPixel(seen, value)
        previous := value.Clone()
        AhkStdlibPillowQoiAppendPixelData(data, value, bands)
    }
    return AhkStdlibPillowQoiRowsFromRaw(data, width, height, mode)
}

AhkStdlibPillowQoiAppendPixelData(data, pixel, bands)
{
    loop bands
        data.Push(pixel[A_Index])
    return stdlib.None
}

AhkStdlibPillowQoiRowsFromRaw(data, width, height, mode)
{
    rows := []
    bands := StrLen(AhkStdlibPillowChannels(mode))
    pos := 1
    loop height {
        row := []
        loop width {
            if bands = 1 {
                row.Push(pos <= data.Length ? data[pos] : 0)
                pos += 1
            } else {
                pixel := []
                loop bands {
                    pixel.Push(pos <= data.Length ? data[pos] : 0)
                    pos += 1
                }
                row.Push(pixel)
            }
        }
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowQoiSaveImage(image, fp, filename)
{
    if image.mode = "RGB" {
        channels := 3
    } else if image.mode = "RGBA" {
        channels := 4
    } else {
        throw ValueError("Unsupported QOI image mode", -1)
    }
    colorspace := 1
    if image.HasOwnProp("encoderinfo") && image.encoderinfo.Has("colorspace") && image.encoderinfo["colorspace"] = "sRGB"
        colorspace := 0

    bytes := AhkStdlibPillowAsciiBytes("qoif")
    AhkStdlibPillowQoiAppendBytes(bytes, AhkStdlibPillowQoiO32(image.width))
    AhkStdlibPillowQoiAppendBytes(bytes, AhkStdlibPillowQoiO32(image.height))
    bytes.Push(channels, colorspace)
    AhkStdlibPillowQoiAppendBytes(bytes, image.tobytes("qoi"))
