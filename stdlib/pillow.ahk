        return AhkStdlibPillowFloatBoxBlurLineChannel(line, floatRadius)

    channels := StrLen(AhkStdlibPillowChannels(mode))
    channelOutputs := []
    loop channels {
        channelIndex := A_Index
        channelLine := []
        for pixel in line
            channelLine.Push(AhkStdlibPillowPixelChannel(pixel, mode, channelIndex))
        channelOutputs.Push(AhkStdlibPillowFloatBoxBlurLineChannel(channelLine, floatRadius))
    }

    output := []
    loop line.Length {
        pixelIndex := A_Index
        pixel := []
        loop channels
            pixel.Push(channelOutputs[A_Index][pixelIndex])
        output.Push(pixel)
