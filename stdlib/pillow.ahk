AhkStdlibPillowMpoParseMpfTiff(bytes)
{
    if bytes.Length < 10 || bytes[1] != Ord("I") || bytes[2] != Ord("I")
        throw SyntaxError("malformed MP Index", -1)
    if AhkStdlibPillowMpoReadLe16(bytes, 3) != 42
        throw SyntaxError("malformed MP Index", -1)
    ifdStart := AhkStdlibPillowMpoReadLe32(bytes, 5) + 1
    if ifdStart < 1 || ifdStart + 1 > bytes.Length
        throw SyntaxError("malformed MP Index", -1)
    entryCount := AhkStdlibPillowMpoReadLe16(bytes, ifdStart)
    pos := ifdStart + 2
    result := Map()
    loop entryCount {
        if pos + 11 > bytes.Length
            throw SyntaxError("malformed MP Index", -1)
        tag := AhkStdlibPillowMpoReadLe16(bytes, pos)
        count := AhkStdlibPillowMpoReadLe32(bytes, pos + 4)
        valueOffset := pos + 8
        if tag = 0xB000 {
            result[tag] := AhkStdlibPillowArraySlice(bytes, valueOffset, valueOffset + count - 1)
        } else if tag = 0xB001 {
            result[tag] := AhkStdlibPillowMpoReadLe32(bytes, valueOffset)
        } else if tag = 0xB002 {
            dataOffset := AhkStdlibPillowMpoReadLe32(bytes, valueOffset)
            dataStart := dataOffset + 1
            entryBytes := AhkStdlibPillowArraySlice(bytes, dataStart, dataStart + count - 1)
            result[tag] := AhkStdlibPillowMpoParseEntries(entryBytes)
        }
        pos += 12
    }
    return result
}

AhkStdlibPillowMpoParseMpf(payload)
{
    if payload.Length < 14 || !AhkStdlibPillowBytesStartsWithAscii(payload, "MPF") || payload[4] != 0
        throw SyntaxError("malformed MP Index", -1)
    tiffStart := 5
    if payload[tiffStart] != Ord("I") || payload[tiffStart + 1] != Ord("I")
        throw SyntaxError("malformed MP Index", -1)
    if AhkStdlibPillowMpoReadLe16(payload, tiffStart + 2) != 42
        throw SyntaxError("malformed MP Index", -1)
    ifdOffset := AhkStdlibPillowMpoReadLe32(payload, tiffStart + 4)
    ifdStart := tiffStart + ifdOffset
    entryCount := AhkStdlibPillowMpoReadLe16(payload, ifdStart)
    pos := ifdStart + 2
    result := Map()
    loop entryCount {
        tag := AhkStdlibPillowMpoReadLe16(payload, pos)
        typeValue := AhkStdlibPillowMpoReadLe16(payload, pos + 2)
        count := AhkStdlibPillowMpoReadLe32(payload, pos + 4)
        valueOffset := pos + 8
        if tag = 0xB000 {
            result[tag] := AhkStdlibPillowArraySlice(payload, valueOffset, valueOffset + count - 1)
        } else if tag = 0xB001 {
            result[tag] := AhkStdlibPillowMpoReadLe32(payload, valueOffset)
        } else if tag = 0xB002 {
            dataOffset := AhkStdlibPillowMpoReadLe32(payload, valueOffset)
            dataStart := tiffStart + dataOffset
            entryBytes := AhkStdlibPillowArraySlice(payload, dataStart, dataStart + count - 1)
            result[tag] := AhkStdlibPillowMpoParseEntries(entryBytes)
        }
        pos += 12
    }
    return result
}

AhkStdlibPillowMpoParseEntries(bytes)
{
    entries := []
    pos := 1
    while pos + 15 <= bytes.Length {
        attribute := AhkStdlibPillowMpoReadLe32(bytes, pos)
        entries.Push(Map(
            "Attribute", AhkStdlibPillowMpoAttribute(attribute),
            "Size", AhkStdlibPillowMpoReadLe32(bytes, pos + 4),
            "DataOffset", AhkStdlibPillowMpoReadLe32(bytes, pos + 8),
            "EntryNo1", AhkStdlibPillowMpoReadLe16(bytes, pos + 12),
            "EntryNo2", AhkStdlibPillowMpoReadLe16(bytes, pos + 14)
        ))
        pos += 16
    }
    return entries
}

AhkStdlibPillowMpoAttribute(attribute)
{
    imageDataFormat := (attribute & 0x07000000) >> 24
    mpType := attribute & 0x00FFFFFF
    return Map(
        "MPType", AhkStdlibPillowMpoTypeName(mpType),
        "ImageDataFormat", imageDataFormat = 0 ? "JPEG" : imageDataFormat,
        "Reserved", (attribute & 0x18000000) >> 27,
        "DependentParentImageFlag", !!(attribute & 0x80000000),
        "DependentChildImageFlag", !!(attribute & 0x40000000),
        "RepresentativeImageFlag", !!(attribute & 0x20000000)
    )
}

AhkStdlibPillowMpoTypeName(mpType)
{
    static types := Map(
        0x000000, "Undefined",
        0x010001, "Large Thumbnail (VGA Equivalent)",
        0x010002, "Large Thumbnail (Full HD Equivalent)",
        0x020001, "Multi-Frame Image (Panorama)",
        0x020002, "Multi-Frame Image: (Disparity)",
        0x020003, "Multi-Frame Image: (Multi-Angle)",
        0x030000, "Baseline MP Primary Image"
    )
    return types.Has(mpType) ? types[mpType] : "Unknown"
}

AhkStdlibPillowMpoReadLe16(bytes, offset)
{
    if offset < 1 || offset + 1 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return bytes[offset] | (bytes[offset + 1] << 8)
}

AhkStdlibPillowMpoReadLe32(bytes, offset)
{
    if offset < 1 || offset + 3 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)
}

AhkStdlibPillowMpoSaveImage(args*)
{
    if args.Length < 3
        throw TypeError("_save() missing " (3 - args.Length) " required positional argument" (3 - args.Length = 1 ? "" : "s") ": " (args.Length = 0 ? "'im', 'fp', and 'filename'" : args.Length = 1 ? "'fp' and 'filename'" : "'filename'"), -1)
    if args.Length > 3
        throw TypeError("_save() takes 3 positional arguments but " args.Length " were given", -1)
    return AhkStdlibPillowJpegSaveImage(args[1], args[2], args[3])
}

AhkStdlibPillowMpoSaveAll(args*)
{
    if args.Length < 3
        throw TypeError("_save_all() missing " (3 - args.Length) " required positional argument" (3 - args.Length = 1 ? "" : "s") ": " (args.Length = 0 ? "'im', 'fp', and 'filename'" : args.Length = 1 ? "'fp' and 'filename'" : "'filename'"), -1)
    if args.Length > 3
        throw TypeError("_save_all() takes 3 positional arguments but " args.Length " were given", -1)
    image := args[1]
    fp := args[2]
    filename := args[3]
    appendImages := []
    if image.HasOwnProp("encoderinfo") && image.encoderinfo.Has("append_images")
        appendImages := AhkStdlibPillowSequenceToArray(image.encoderinfo["append_images"])
    if appendImages.Length = 0 && (!image.HasOwnProp("is_animated") || !image.is_animated)
        return AhkStdlibPillowMpoSaveImage(image, fp, filename)
    jpegFrames := []
    AhkStdlibPillowMpoAppendSaveAllJpegFrames(jpegFrames, image, filename)
    for appendImage in appendImages
        AhkStdlibPillowMpoAppendSaveAllJpegFrames(jpegFrames, appendImage, filename)
    mpoBytes := AhkStdlibPillowMpoBuildBytes(jpegFrames)
    fp.write(mpoBytes)
    return stdlib.None
}

AhkStdlibPillowMpoAppendSaveAllJpegFrames(jpegFrames, image, filename)
{
    iterator := AhkStdlibPillowImageSequenceIterator(image)
    loop {
        try {
            frame := iterator.next()
        } catch StopIteration {
            break
        }
        buffer := stdlib.io.BytesIO()
        AhkStdlibPillowJpegSaveImage(frame, buffer, filename)
        jpegFrames.Push(buffer.getvalue())
    }
    return stdlib.None
}

AhkStdlibPillowMpoBuildBytes(jpegFrames)
{
    if jpegFrames.Length < 2
        return jpegFrames[1]
    first := jpegFrames[1]
    mpOffset := 28
    app2PayloadLength := 54 + 16 * jpegFrames.Length
    app2TotalLength := app2PayloadLength + 4
    firstSize := first.Length + app2TotalLength
    offsets := []
    offsets.Push(firstSize)
    loop jpegFrames.Length - 1
        offsets.Push(jpegFrames[A_Index + 1].Length)

    mpEntries := []
    dataOffset := 0
    loop offsets.Length {
        index := A_Index
        size := offsets[index]
        mptype := index = 1 ? 0x030000 : 0
        for byte in AhkStdlibPillowMpoLe32(mptype)
            mpEntries.Push(byte)
        for byte in AhkStdlibPillowMpoLe32(size)
            mpEntries.Push(byte)
        for byte in AhkStdlibPillowMpoLe32(dataOffset)
            mpEntries.Push(byte)
        for byte in [0, 0, 0, 0]
            mpEntries.Push(byte)
        if index = 1
            dataOffset -= mpOffset
        dataOffset += size
    }

    ifd := []
    for byte in AhkStdlibPillowMpoLe16(3)
        ifd.Push(byte)
    for byte in AhkStdlibPillowMpoIfdEntry(0xB000, 7, 4, AhkStdlibPillowAsciiBytes("0100"))
        ifd.Push(byte)
    for byte in AhkStdlibPillowMpoIfdEntry(0xB001, 4, 1, AhkStdlibPillowMpoLe32(offsets.Length))
        ifd.Push(byte)
    for byte in AhkStdlibPillowMpoIfdEntry(0xB002, 7, mpEntries.Length, AhkStdlibPillowMpoLe32(50))
        ifd.Push(byte)
    for byte in AhkStdlibPillowMpoLe32(0)
        ifd.Push(byte)
    for byte in mpEntries
        ifd.Push(byte)

    payload := AhkStdlibPillowAsciiBytes("MPF")
    payload.Push(0)
    for byte in AhkStdlibPillowAsciiBytes("II")
        payload.Push(byte)
    for byte in AhkStdlibPillowMpoLe16(42)
        payload.Push(byte)
    for byte in AhkStdlibPillowMpoLe32(8)
        payload.Push(byte)
    for byte in ifd
        payload.Push(byte)

    app2 := [0xFF, 0xE2]
    for byte in AhkStdlibPillowMpoBe16(payload.Length + 2)
        app2.Push(byte)
    for byte in payload
        app2.Push(byte)

    bytes := AhkStdlibPillowArraySlice(first, 1, 20)
    for byte in app2
        bytes.Push(byte)
    for byte in AhkStdlibPillowArraySlice(first, 21, first.Length)
        bytes.Push(byte)
    loop jpegFrames.Length - 1 {
        for byte in jpegFrames[A_Index + 1]
            bytes.Push(byte)
    }
    return bytes
}

AhkStdlibPillowMpoIfdEntry(tag, typeValue, count, valueBytes)
{
    bytes := []
    for byte in AhkStdlibPillowMpoLe16(tag)
        bytes.Push(byte)
    for byte in AhkStdlibPillowMpoLe16(typeValue)
        bytes.Push(byte)
    for byte in AhkStdlibPillowMpoLe32(count)
        bytes.Push(byte)
    padded := valueBytes.Clone()
    while padded.Length < 4
        padded.Push(0)
    for byte in AhkStdlibPillowArraySlice(padded, 1, 4)
        bytes.Push(byte)
    return bytes
}

AhkStdlibPillowMpoLe16(value)
{
    value := Integer(value)
    return [value & 0xFF, (value >> 8) & 0xFF]
}

AhkStdlibPillowMpoLe32(value)
{
    value := Integer(value)
    return [value & 0xFF, (value >> 8) & 0xFF, (value >> 16) & 0xFF, (value >> 24) & 0xFF]
}

AhkStdlibPillowMpoBe16(value)
{
    value := Integer(value)
    return [(value >> 8) & 0xFF, value & 0xFF]
}

