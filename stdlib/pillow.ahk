    return AhkStdlibPillowSunDecodeRaw(decoded, 1, width, height, mode, rawmode, depth, rowStride)
}

AhkStdlibPillowSunDecodeRawIntoImage(image, bytes, dataIndex, rawmode, depth, stride)
{
    width := image.width
    height := image.height
    loop height {
        y := A_Index - 1
        rowStart := dataIndex + y * stride
        loop width {
            x := A_Index - 1
            if depth = 1 {
                byte := AhkStdlibPillowSunByteAt(bytes, rowStart + (x // 8))
                bit := 7 - Mod(x, 8)
                image.putpixel([x, y], ((byte >> bit) & 1) ? 0 : 255)
            } else if depth = 4 {
                byte := AhkStdlibPillowSunByteAt(bytes, rowStart + (x // 2))
                nibble := Mod(x, 2) = 0 ? ((byte >> 4) & 0xF) : (byte & 0xF)
                image.putpixel([x, y], image.mode = "P" ? nibble : nibble * 17)
            } else if depth = 8 {
                image.putpixel([x, y], AhkStdlibPillowSunByteAt(bytes, rowStart + x))
            } else if depth = 24 {
                base := rowStart + x * 3
                b1 := AhkStdlibPillowSunByteAt(bytes, base)
                b2 := AhkStdlibPillowSunByteAt(bytes, base + 1)
                b3 := AhkStdlibPillowSunByteAt(bytes, base + 2)
                image.putpixel([x, y], rawmode = "RGB" ? [b1, b2, b3] : [b3, b2, b1])
            } else if depth = 32 {
                base := rowStart + x * 4
                b1 := AhkStdlibPillowSunByteAt(bytes, base)
                b2 := AhkStdlibPillowSunByteAt(bytes, base + 1)
                b3 := AhkStdlibPillowSunByteAt(bytes, base + 2)
                image.putpixel([x, y], rawmode = "RGBX" ? [b1, b2, b3] : [b3, b2, b1])
            }
        }
    }
    return stdlib.None
}

AhkStdlibPillowSunRleBytes(bytes, dataIndex, expected)
{
    decoded := []
    index := dataIndex
    while decoded.Length < expected && index <= bytes.Length {
        value := bytes[index]
        index += 1
        if value != 0x80 {
            decoded.Push(value)
            continue
        }
        if index > bytes.Length {
            decoded.Push(0x80)
            break
        }
        count := bytes[index]
        index += 1
        if count = 0 {
            decoded.Push(0x80)
            continue
        }
        repeatValue := index <= bytes.Length ? bytes[index] : 0
        index += 1
        loop count + 1 {
            if decoded.Length >= expected
                break
            decoded.Push(repeatValue)
        }
    }
    while decoded.Length < expected
        decoded.Push(0)
    return decoded
}

AhkStdlibPillowSunRgbLPalette(bytes)
