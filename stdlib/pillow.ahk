AhkStdlibPillowGifDecodeLzw(data, minCodeSize, expectedCount)
{
    clearCode := 1 << minCodeSize
    endCode := clearCode + 1
    codeSize := minCodeSize + 1
    nextCode := endCode + 1
    dictionary := AhkStdlibPillowGifInitialDictionary(clearCode)
    bitPos := 0
    previous := unset
    output := []

    loop {
        code := AhkStdlibPillowGifReadBits(data, &bitPos, codeSize)
        if AhkStdlibIsNone(code)
            break
        if code = clearCode {
            dictionary := AhkStdlibPillowGifInitialDictionary(clearCode)
            codeSize := minCodeSize + 1
            nextCode := endCode + 1
            previous := unset
            continue
        }
        if code = endCode
            break

        if dictionary.Has(code) {
            entry := dictionary[code].Clone()
        } else if IsSet(previous) && code = nextCode {
            entry := previous.Clone()
            entry.Push(previous[1])
        } else {
            throw OSError("broken data stream when reading image file", -1)
        }

        for value in entry {
            if output.Length < expectedCount
                output.Push(value)
        }

        if IsSet(previous) {
            newEntry := previous.Clone()
            newEntry.Push(entry[1])
            dictionary[nextCode] := newEntry
            nextCode += 1
            if nextCode = (1 << codeSize) && codeSize < 12
                codeSize += 1
        }
        previous := entry
        if output.Length >= expectedCount
            break
    }
    while output.Length < expectedCount
        output.Push(0)
    return output
}

AhkStdlibPillowGifInitialDictionary(clearCode)
{
    dictionary := Map()
    loop clearCode
        dictionary[A_Index - 1] := [A_Index - 1]
