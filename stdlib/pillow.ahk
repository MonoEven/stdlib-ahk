}

AhkStdlibPillowEpsLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowEpsSourceBytes(source)
{
    if AhkStdlibPillowIsOpenFileLike(source)
        return AhkStdlibPillowReadAllFileLikeBytes(source)
    fp := AhkStdlibPillowOpenFile(source)
    try {
        return AhkStdlibPillowByteSequence(fp.read())
    } finally {
        fp.close()
    }
}

AhkStdlibPillowEpsOpen(source)
{
    bytes := AhkStdlibPillowEpsSourceBytes(source)
    if bytes.Length < 4
        throw SyntaxError("not an EPS file", -1)
    if bytes[1] = 37 && bytes[2] = 33 && bytes[3] = 80 && bytes[4] = 83 {
        offset := 0
        length := bytes.Length
        parseStart := 1
        parseEnd := bytes.Length
    } else if AhkStdlibPillowEpsU32(bytes, 1) = 0xC6D3D0C5 {
        offset := AhkStdlibPillowEpsU32(bytes, 5)
        length := AhkStdlibPillowEpsU32(bytes, 9)
        parseStart := offset + 1
        parseEnd := Min(bytes.Length, offset + length)
    } else {
        throw SyntaxError("not an EPS file", -1)
    }

    lines := AhkStdlibPillowEpsLines(bytes, parseStart, parseEnd)
    info := Map()
    boundingBox := stdlib.None
    readingHeader := true
    readingTrailer := false
    trailerReached := false
    imagedataSize := stdlib.None
    mode := "RGB"

    for line in lines {
        if readingHeader {
            if line = "" {
                continue
            }
            if SubStr(line, 1, 1) != "%" || SubStr(line, 1, 13) = "%%EndComments" {
                AhkStdlibPillowEpsCheckRequired(info)
                readingHeader := false
                continue
            }
            AhkStdlibPillowEpsReadComment(line, info, &boundingBox, &readingTrailer, false, false)
            continue
        }

        if SubStr(line, 1, 11) = "%ImageData:" {
            if AhkStdlibIsNone(imagedataSize) {
                parts := StrSplit(Trim(SubStr(line, 12)), A_Space "`t")
                filtered := []
                for part in parts
                    if part != ""
                        filtered.Push(part)
                if filtered.Length >= 4 {
                    columns := Integer(filtered[1])
                    rows := Integer(filtered[2])
                    bitDepth := Integer(filtered[3])
                    modeId := Integer(filtered[4])
                    if bitDepth = 1
                        mode := "1"
                    else if bitDepth = 8 && AhkStdlibPillowEpsImageFileFactory().mode_map.Has(modeId)
                        mode := AhkStdlibPillowEpsImageFileFactory().mode_map[modeId]
                    imagedataSize := [columns, rows]
                }
            }
        } else if SubStr(line, 1, 5) = "%%EOF" {
            break
        } else if trailerReached && readingTrailer {
            AhkStdlibPillowEpsReadComment(line, info, &boundingBox, &readingTrailer, true, true)
        } else if SubStr(line, 1, 9) = "%%Trailer" {
            trailerReached := true
        }
    }

    if readingHeader
        AhkStdlibPillowEpsCheckRequired(info)
    if AhkStdlibIsNone(boundingBox)
        throw OSError("cannot determine EPS bounding box", -1)
    size := !AhkStdlibIsNone(imagedataSize) ? imagedataSize : [boundingBox[3] - boundingBox[1], boundingBox[4] - boundingBox[2]]
    return AhkStdlibPillowEpsImage(mode, size, info, ["eps", [0, 0, size[1], size[2]], offset, [length, boundingBox]])
}

