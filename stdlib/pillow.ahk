AhkStdlibPillowPsdAcceptPrefix(prefix)
{
    bytes := AhkStdlibPillowByteSequence(prefix)
    return bytes.Length >= 4 && bytes[1] = 56 && bytes[2] = 66 && bytes[3] = 80 && bytes[4] = 83
