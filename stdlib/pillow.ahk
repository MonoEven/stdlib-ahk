AhkStdlibPillowKernelChannel(sourceRows, mode, x, y, filter, channelIndex)
{
    size := filter.AhkStdlibSize
    kernelWidth := size[1]
    kernelHeight := size[2]
    radiusX := Floor(kernelWidth / 2)
    radiusY := Floor(kernelHeight / 2)
    total := 0
    loop kernelHeight {
        ky := A_Index - 1
        sourceY := y + ky - radiusY
        flippedKy := kernelHeight - 1 - ky
        loop kernelWidth {
            kx := A_Index - 1
            sourceX := x + kx - radiusX
            weight := filter.AhkStdlibKernel[flippedKy * kernelWidth + kx + 1]
            channelValue := AhkStdlibPillowPixelChannel(sourceRows[sourceY + 1][sourceX + 1], mode, channelIndex)
            total += channelValue * weight
        }
    }
    if filter.AhkStdlibScale = 0
        value := 0
    else
        value := total / filter.AhkStdlibScale + filter.AhkStdlibOffset
    return AhkStdlibPillowClampByte(value)
}

AhkStdlibPillowPixelChannel(pixel, mode, channelIndex)
