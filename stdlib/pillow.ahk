    opName := unset
    if args.Length > 1 && AhkStdlibPillowImageMorphLooksLikeImplicitTarget(args[1], ["patterns", "op_name"]) && AhkStdlibPillowImageMorphIsKeywordObject(args[2])
        args.RemoveAt(1)
    if args.Length > 2
        throw TypeError("LutBuilder.__init__() takes from 1 to 3 positional arguments but " (args.Length + 1) " were given", -1)
    if args.Length = 1 && AhkStdlibPillowImageMorphIsKeywordObject(args[1]) {
        if args[1].HasProp("patterns")
            patterns := args[1].patterns
        if args[1].HasProp("op_name")
            opName := args[1].op_name
    } else {
        if args.Length >= 1
            patterns := args[1]
        if args.Length >= 2
