    width := AhkStdlibPillowRequireInteger(sizeValues[1], "width")
    height := AhkStdlibPillowRequireInteger(sizeValues[2], "height")
    if width < 0 || height < 0
        throw ValueError("Width and height must be >= 0", -1)

    extentValues := AhkStdlibPillowSequenceToArray(extent)
    if extentValues.Length != 4
        throw TypeError("argument 2 must be sequence of length 4, not " extentValues.Length, -1)
    if !(quality is Integer)
        throw TypeError("'" AhkStdlibPythonTypeName(quality) "' object cannot be interpreted as an integer", -1)
    if quality < 4
        throw ValueError("unrecognized argument value", -1)

