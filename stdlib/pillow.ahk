AhkStdlibPillowSpiderParse(bytes, headerOffset := 0, stackOffset := unset, nFramesOverride := unset)
{
    if bytes.Length < headerOffset + 27 * 4
        throw SyntaxError("not a valid Spider file", -1)

    bigValues := AhkStdlibPillowSpiderReadHeaderFloats(bytes, headerOffset + 1, false, 27)
    hdrLen := AhkStdlibPillowSpiderIsHeader(bigValues)
    bigEndian := 1
    values := bigValues
    if hdrLen = 0 {
        values := AhkStdlibPillowSpiderReadHeaderFloats(bytes, headerOffset + 1, true, 27)
        hdrLen := AhkStdlibPillowSpiderIsHeader(values)
        bigEndian := 0
    }
    if hdrLen = 0
        throw SyntaxError("not a valid Spider file", -1)

    iform := Integer(values[5])
    if iform != 1
        throw SyntaxError("not a Spider 2D image", -1)

    width := Integer(values[12])
    height := Integer(values[2])
    istack := Integer(values[24])
    imgnumber := Integer(values[27])
    nFrames := IsSet(nFramesOverride) ? nFramesOverride : 1

    if istack = 0 && imgnumber = 0 {
        dataOffset := headerOffset + hdrLen
        nFrames := 1
    } else if istack > 0 && imgnumber = 0 {
        nFrames := Integer(values[26])
        dataOffset := headerOffset + hdrLen * 2
        imgnumber := 1
    } else if istack = 0 && imgnumber > 0 && IsSet(stackOffset) {
        dataOffset := hdrLen + stackOffset
        istack := 2
    } else {
        throw SyntaxError("inconsistent stack header values", -1)
    }

    return {
        Width: width,
        Height: height,
        HdrLen: hdrLen,
        DataOffset: dataOffset,
        RawMode: bigEndian ? "F;32BF" : "F;32F",
        BigEndian: bigEndian,
        IStack: istack,
        ImgNumber: imgnumber,
        NFrames: nFrames
    }
}

AhkStdlibPillowSpiderReadHeaderFloats(bytes, offset, little, count)
{
    values := []
    pos := offset
    loop count {
        values.Push(AhkStdlibPillowSpiderReadFloat32(bytes, pos, little))
        pos += 4
    }
    return values
}

AhkStdlibPillowSpiderReadRows(bytes, dataOffset, width, height, little)
{
