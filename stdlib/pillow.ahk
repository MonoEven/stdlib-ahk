AhkStdlibPillowMspLooksLikeSource(value)
{
    return value is String || AhkStdlibPillowIsOpenFileLike(value)
}

AhkStdlibPillowMspAcceptPrefix(prefix)
{
    bytes := AhkStdlibPillowByteSequence(prefix)
    return bytes.Length >= 4 && (
        (bytes[1] = Ord("D") && bytes[2] = Ord("a") && bytes[3] = Ord("n") && bytes[4] = Ord("M"))
        || (bytes[1] = Ord("L") && bytes[2] = Ord("i") && bytes[3] = Ord("n") && bytes[4] = Ord("S"))
    )
}

AhkStdlibPillowMspSourceBytes(source)
{
    if AhkStdlibPillowIsOpenFileLike(source)
        return AhkStdlibPillowReadAllFileLikeBytes(source)
    fp := AhkStdlibPillowOpenFile(source)
    try {
        return AhkStdlibPillowByteSequence(fp.read())
    } finally {
        fp.close()
    }
}

AhkStdlibPillowMspOpen(source)
{
    bytes := AhkStdlibPillowMspSourceBytes(source)
    if !AhkStdlibPillowMspAcceptPrefix(bytes)
        throw SyntaxError("not an MSP file", -1)
    if AhkStdlibPillowMspChecksum(bytes) != 0
        throw SyntaxError("bad MSP checksum", -1)

    width := AhkStdlibPillowMspReadLe16(bytes, 5)
    height := AhkStdlibPillowMspReadLe16(bytes, 7)
    image := AhkStdlibPillowImageNew("1", [width, height], 0)
    try {
        if bytes[1] = Ord("D") {
            packed := AhkStdlibPillowArraySlice(bytes, 33, bytes.Length)
            image.tile := [["raw", [0, 0, width, height], 32, "1"]]
        } else {
            packed := AhkStdlibPillowMspDecodeRleBytes(bytes, width, height)
            image.tile := [["MSP", [0, 0, width, height], 32, stdlib.None]]
        }
        AhkStdlibPillowImageFromPackedBits(image, packed)
        image.AhkStdlibFormat := "MSP"
        image.AhkStdlibReadonly := 1
        return image
    } catch Error as err {
        image.close()
        throw err
    }
}

AhkStdlibPillowMspDecodeRleBytes(bytes, width, height)
{
    rowBytes := Ceil(width / 8)
    rowMapOffset := 33
    rowMapBytes := height * 2
    if bytes.Length < 32 + rowMapBytes
        throw OSError("Truncated MSP file in row map", -1)
    dataOffset := rowMapOffset + rowMapBytes
    decoded := []
    loop height {
        rowIndex := A_Index - 1
        rowLength := AhkStdlibPillowMspReadLe16(bytes, rowMapOffset + rowIndex * 2)
        if rowLength = 0 {
            loop rowBytes
                decoded.Push(0xFF)
            continue
        }
        if dataOffset + rowLength - 1 > bytes.Length
            throw OSError("Truncated MSP file, expected " rowLength " bytes on row " rowIndex, -1)
        row := AhkStdlibPillowArraySlice(bytes, dataOffset, dataOffset + rowLength - 1)
        dataOffset += rowLength
        index := 1
        while index <= rowLength {
            runType := row[index]
            index += 1
            if runType = 0 {
                if index + 1 > rowLength
                    throw OSError("Corrupted MSP file in row " rowIndex, -1)
                runCount := row[index]
                runValue := row[index + 1]
                index += 2
                loop runCount
                    decoded.Push(runValue)
            } else {
                runCount := runType
                loop runCount {
                    if index > rowLength
                        break
                    decoded.Push(row[index])
                    index += 1
                }
            }
        }
    }
    required := rowBytes * height
    if decoded.Length < required
        throw ValueError("not enough image data", -1)
    return AhkStdlibPillowArraySlice(decoded, 1, required)
}

