    image := args[1]
    if !IsObject(image) || !HasProp(image, "AhkStdlibJpegImage") || !image.AhkStdlibJpegImage
        return -1
    if !HasProp(image, "layers") || image.layers = 1 || image.layers = 4
        return -1
    if !HasProp(image, "layer") || image.layer.Length < 3
        return -1
    key := image.layer[1][2] "," image.layer[1][3] "," image.layer[2][2] "," image.layer[2][3] "," image.layer[3][2] "," image.layer[3][3]
    samplings := AhkStdlibPillowJpegSamplingsMap()
    return samplings.Has(key) ? samplings[key] : -1
}

