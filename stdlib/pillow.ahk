AhkStdlibPillowImageQtAlign8To32(data, width, mode)
{
    bytes := AhkStdlibPillowByteSequence(data)
    if !(mode = "1" || mode = "L" || mode = "P" || mode = "I;16")
        throw KeyError("'" mode "'", -1)
    bitsPerPixel := mode = "1" ? 1 : mode = "I;16" ? 16 : 8
    bitsPerLine := bitsPerPixel * width
    bytesPerLine := bitsPerLine // 8 + (Mod(bitsPerLine, 8) ? 1 : 0)
    extraPadding := Mod(4 - Mod(bytesPerLine, 4), 4)
    if extraPadding = 0
        return bytes
    aligned := []
    rowCount := bytesPerLine = 0 ? 0 : bytes.Length // bytesPerLine
    loop rowCount {
        start := (A_Index - 1) * bytesPerLine + 1
        loop bytesPerLine
            aligned.Push(bytes[start + A_Index - 1])
        loop extraPadding
            aligned.Push(0)
    }
    return aligned
}

AhkStdlibPillowImageQtToClassHelper(value)
{
    exclusiveFp := false
    if IsObject(value) && HasMethod(value, "toUtf8")
        value := String(value.toUtf8())
    if AhkStdlibPillowIsPath(value) {
        value := stdlib.pillow.Image.open(AhkStdlibPillowImageFontPathText(value), "r", ["PNG", "BMP", "JPEG", "JPG", "TIFF", "TIF"])
        exclusiveFp := true
    }
    if !(IsObject(value) && value.HasOwnProp("AhkStdlibHandle"))
        throw AssertionError("", -1)

    try {
        mode := value.mode
        data := stdlib.None
        colortable := stdlib.None
        format := unset
        if mode = "1" {
            format := AhkStdlibPillowImageQtQImageFormat.Format_Mono
        } else if mode = "L" {
            format := AhkStdlibPillowImageQtQImageFormat.Format_Indexed8
            colortable := []
            loop 256 {
                gray := A_Index - 1
                colortable.Push(AhkStdlibPillowImageQtRgb(gray, gray, gray))
            }
        } else if mode = "P" {
            format := AhkStdlibPillowImageQtQImageFormat.Format_Indexed8
            palette := value.getpalette()
            if AhkStdlibIsNone(palette)
                throw AssertionError("", -1)
            colortable := []
            index := 1
            while index <= palette.Length {
                colortable.Push(AhkStdlibPillowImageQtRgb(palette[index], palette[index + 1], palette[index + 2]))
                index += 3
            }
        } else if mode = "RGB" {
            format := AhkStdlibPillowImageQtQImageFormat.Format_RGB32
            data := AhkStdlibPillowImageQtBgraBytes(value, true)
        } else if mode = "RGBA" {
            format := AhkStdlibPillowImageQtQImageFormat.Format_ARGB32
            data := AhkStdlibPillowImageQtBgraBytes(value, false)
        } else if mode = "I;16" {
            format := AhkStdlibPillowImageQtQImageFormat.Format_Grayscale16
        } else {
            throw ValueError("unsupported image mode '" mode "'", -1)
        }

        if AhkStdlibIsNone(data)
            data := AhkStdlibPillowImageQtAlign8To32(AhkStdlibPillowImageQtRawBytes(value), value.size[1], mode)
        return Map("data", data, "size", value.size, "format", format, "colortable", colortable)
    } finally {
        if exclusiveFp
            value.close()
    }
}

