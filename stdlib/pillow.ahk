        if value.Length >= 2
            return AhkStdlibPillowMemoryPixel(value[1], mode)
        if value.Length = 1
            return AhkStdlibPillowMemoryPixel(value[1], mode)
        return 0
    }
    if mode = "F"
        return value + 0.0
    if mode = "I"
        return Integer(value)
    return value
}

AhkStdlibPillowClonePixelRows(rows)
{
    cloned := []
    for row in rows
        cloned.Push(row.Clone())
    return cloned
