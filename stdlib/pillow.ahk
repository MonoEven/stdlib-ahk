    locked := 0
    stream := 0
    try {
        locked := DllCall("kernel32\GlobalLock", "Ptr", hglobal, "Ptr")
        if !locked && size > 0
            throw OSError("GlobalLock failed", -1)
        for index, byte in bytes
            NumPut("UChar", AhkStdlibPillowRequireByte(byte), locked, index - 1)
        if locked {
            DllCall("kernel32\GlobalUnlock", "Ptr", hglobal, "Int")
            locked := 0
        }
        AhkStdlibPillowCheckHresult(DllCall("ole32\CreateStreamOnHGlobal", "Ptr", hglobal, "Int", true, "Ptr*", &stream, "Int"), "CreateStreamOnHGlobal")
        hglobal := 0
        return stream
    } catch Error as err {
        if locked
            DllCall("kernel32\GlobalUnlock", "Ptr", hglobal, "Int")
        if hglobal
            DllCall("kernel32\GlobalFree", "Ptr", hglobal, "Ptr")
        if stream
            ObjRelease(stream)
        throw err
    }
}

