            bytesBuffer := Buffer(size, 0)
            readCount := this.file.RawRead(bytesBuffer, size)
            return AhkStdlibPillowBufferToBytes(bytesBuffer, readCount)
        }

        remaining := this.file.Length - this.file.Pos
        bytesBuffer := Buffer(remaining, 0)
        readCount := this.file.RawRead(bytesBuffer, remaining)
        return AhkStdlibPillowBufferToBytes(bytesBuffer, readCount)
    }

    seek(offset)
    {
        this.file.Pos := offset
        return stdlib.None
    }

    tell()
    {
        return this.file.Pos
    }

    readable()
    {
        return true
    }

    writable()
    {
        return false
    }

    seekable()
    {
        return true
    }

    isatty()
    {
        return false
    }

    flush()
    {
        return stdlib.None
    }

    fileno()
    {
        throw AhkStdlibIoUnsupportedOperation("fileno", -1)
    }

    close()
    {
        if !this.closed {
            this.file.Close()
            this.closed := true
            this.file := stdlib.None
        }
        return stdlib.None
    }

    name
    {
        get => this.path
    }
}

AhkStdlibPillowBufferToBytes(buffer, length)
