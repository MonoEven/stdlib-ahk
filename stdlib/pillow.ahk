AhkStdlibPillowImNumber(value)
{
    text := String(value)
    if RegExMatch(text, "^[+-]?\d+$")
        return Integer(text)
    try {
        return Float(text)
    } catch Error {
        throw ValueError("could not convert string to float: '" text "'", -1)
    }
}

AhkStdlibPillowImOpen(source)
{
    if !(AhkStdlibPillowIsOpenFileLike(source))
        source := AhkStdlibPillowOpenFile(source)
    first := AhkStdlibPillowByteSequence(source.read(100))
    if !AhkStdlibPillowArrayContains(first, 10)
        throw SyntaxError("not an IM file", -1)
    source.seek(0)

    comment := AhkStdlibPillowImImagePluginModule.COMMENT
    framesTag := AhkStdlibPillowImImagePluginModule.FRAMES
    lutTag := AhkStdlibPillowImImagePluginModule.LUT
    sizeTag := AhkStdlibPillowImImagePluginModule.SIZE
    modeTag := AhkStdlibPillowImImagePluginModule.MODE
    info := Map(modeTag, "L", sizeTag, [512, 512], framesTag, 1)
    tagCount := 0
    line := []

    loop {
        byteSeq := AhkStdlibPillowByteSequence(source.read(1))
        if byteSeq.Length = 0 {
            line := []
            break
        }
        byte := byteSeq[1]
        if byte = 13
            continue
        if byte = 0 || byte = 0x1A {
            line := [byte]
            break
        }
        rest := AhkStdlibPillowByteSequence(source.readline())
        line := [byte]
        for item in rest
            line.Push(item)
        if line.Length > 100
            throw SyntaxError("not an IM file", -1)
        while line.Length && (line[line.Length] = 10 || line[line.Length] = 13)
            line.Pop()
        text := AhkStdlibPillowAsciiFromBytes(line)
        if !RegExMatch(text, "^([A-Za-z][^:]*):[ \t]*(.*)[ \t]*$", &match)
            throw SyntaxError("Syntax error in IM header: " text, -1)
        key := match[1]
        value := RegExReplace(match[2], "[ \t]+$")
        if key = framesTag || key = sizeTag || key = AhkStdlibPillowImImagePluginModule.SCALE {
            parts := StrSplit(StrReplace(value, "*", ","), ",")
            parsed := []
            for part in parts
                parsed.Push(AhkStdlibPillowImNumber(part))
            value := parsed.Length = 1 ? parsed[1] : parsed
        } else if key = modeTag && AhkStdlibPillowImOpenMap().Has(value) {
            pair := AhkStdlibPillowImOpenMap()[value]
            value := pair[1]
            rawmode := pair[2]
        }
        if key = comment {
            if info.Has(key)
                info[key].Push(value)
            else
                info[key] := [value]
        } else {
            info[key] := value
        }
        if AhkStdlibPillowImTagsMap().Has(key)
            tagCount += 1
    }

    if tagCount = 0
        throw SyntaxError("Not an IM file", -1)
    if !IsSet(rawmode)
        rawmode := "L"

    size := AhkStdlibPillowSequenceToArray(info[sizeTag])
    if size.Length != 2
        throw SyntaxError("not an IM file", -1)
    mode := info[modeTag]

    while line.Length && line[1] != 0x1A {
        next := AhkStdlibPillowByteSequence(source.read(1))
        if next.Length = 0
            throw SyntaxError("File truncated", -1)
        line := next
    }
    if line.Length = 0
        throw SyntaxError("File truncated", -1)

    paletteBytes := unset
    if info.Has(lutTag) {
        palette := AhkStdlibPillowByteSequence(source.read(768))
        if palette.Length < 768
            throw SyntaxError("File truncated", -1)
        greyscale := true
        linear := true
        loop 256 {
            i := A_Index
            if !(palette[i] = palette[i + 256] && palette[i] = palette[i + 512]) {
                greyscale := false
            } else if palette[i] != i - 1 {
                linear := false
            }
        }
        if mode = "L" || mode = "LA" || mode = "P" || mode = "PA" {
            if !greyscale {
                if mode = "L" || mode = "P" {
                    mode := "P"
                    rawmode := "P"
                } else if mode = "LA" || mode = "PA" {
                    mode := "PA"
                    rawmode := "PA;L"
                }
                paletteBytes := AhkStdlibPillowImInterleavedPalette(palette)
            } else if !linear {
                lut := AhkStdlibPillowArraySlice(palette, 1, 256)
            }
        } else if mode = "RGB" && (!greyscale || !linear) {
            lut := palette.Clone()
        }
    }

    dataOffset := source.tell()
    frameSize := AhkStdlibPillowImFrameSize(mode, rawmode, size)
    frames := Integer(info[framesTag])
    image := AhkStdlibPillowImImage(mode, size, rawmode, source, dataOffset, frameSize, frames, info, paletteBytes?)
    if IsSet(lut)
        image.lut := lut
    return image
}

AhkStdlibPillowImBlankRows(mode, width, height)
{
    rows := []
    pixel := AhkStdlibPillowMemoryPixel(AhkStdlibPillowDefaultColor(mode), mode)
    loop height {
        row := []
        loop width
            row.Push(pixel is Array ? pixel.Clone() : pixel)
        rows.Push(row)
    }
    return rows
}

AhkStdlibPillowImDecodeInto(image, bytes)
{
    mode := image.mode
    rawmode := image.rawmode
    width := image.width
    height := image.height
    rows := AhkStdlibPillowImBlankRows(mode, width, height)
    if rawmode = "L" || rawmode = "P" {
        AhkStdlibPillowImDecodeSingle(rows, bytes, width, height)
    } else if rawmode = "1" {
        AhkStdlibPillowImDecodeBits(rows, bytes, width, height, 1)
    } else if rawmode = "P;2" {
        AhkStdlibPillowImDecodeBits(rows, bytes, width, height, 2)
    } else if rawmode = "P;4" {
        AhkStdlibPillowImDecodeBits(rows, bytes, width, height, 4)
    } else if rawmode = "RGB;L" {
        AhkStdlibPillowImDecodeRgbL(rows, bytes, width, height)
    } else if rawmode = "RGB" {
        AhkStdlibPillowImDecodeInterleaved(rows, bytes, width, height, 3)
    } else if rawmode = "RGBA;L" {
        AhkStdlibPillowImDecodePlanar(rows, bytes, width, height, 4)
    } else if rawmode = "LA;L" || rawmode = "PA;L" {
        AhkStdlibPillowImDecodePlanar(rows, bytes, width, height, 2)
    } else {
        AhkStdlibPillowImDecodeSingle(rows, bytes, width, height)
    }
    image.AhkStdlibMemoryPixels := rows
    return stdlib.None
}

AhkStdlibPillowImDecodeSingle(rows, bytes, width, height)
{
    offset := 1
    loop height {
        y := height - A_Index + 1
        loop width {
            rows[y][A_Index] := offset <= bytes.Length ? bytes[offset] : 0
            offset += 1
        }
    }
}

AhkStdlibPillowImDecodeInterleaved(rows, bytes, width, height, channels)
{
    offset := 1
    loop height {
        y := A_Index
        loop width {
            x := A_Index
            pixel := []
            loop channels {
                pixel.Push(offset <= bytes.Length ? bytes[offset] : 0)
                offset += 1
            }
            rows[y][x] := pixel
        }
    }
}

AhkStdlibPillowImDecodePlanar(rows, bytes, width, height, channels)
{
    planeSize := width * height
    loop height {
        y := A_Index - 1
        loop width {
            x := A_Index - 1
            pixelIndex := y * width + x
            pixel := []
            loop channels {
                offset := (A_Index - 1) * planeSize + pixelIndex + 1
                pixel.Push(offset <= bytes.Length ? bytes[offset] : 0)
            }
            rows[y + 1][x + 1] := pixel
        }
    }
}

AhkStdlibPillowImDecodeRgbL(rows, bytes, width, height)
{
    loop height {
        y := A_Index - 1
        sourceY := height - 1 - y
        rowOffset := sourceY * width * 3
        loop width {
            x := A_Index - 1
            rows[y + 1][x + 1] := [
                bytes[rowOffset + x + 1],
                bytes[rowOffset + width + x + 1],
                bytes[rowOffset + width * 2 + x + 1],
            ]
        }
    }
}

AhkStdlibPillowImDecodeBits(rows, bytes, width, height, bits)
{
    bitmask := (1 << bits) - 1
    bitOffset := 0
    loop height {
        y := height - A_Index + 1
        loop width {
            byteIndex := Floor(bitOffset / 8) + 1
            shift := 8 - bits - Mod(bitOffset, 8)
            value := byteIndex <= bytes.Length ? ((bytes[byteIndex] >> shift) & bitmask) : 0
            rows[y][A_Index] := bits = 1 ? (value ? 255 : 0) : value
            bitOffset += bits
        }
        if Mod(bitOffset, 8)
            bitOffset += 8 - Mod(bitOffset, 8)
    }
}

AhkStdlibPillowImFrameSize(mode, rawmode, size)
{
    width := size[1]
    height := size[2]
    if rawmode = "1"
        return Ceil(width / 8) * height
    if rawmode = "P;2"
        return Ceil(width * 2 / 8) * height
    if rawmode = "P;4"
        return Ceil(width * 4 / 8) * height
    if rawmode = "RGB;L" || rawmode = "RGB" || rawmode = "RYB;T" || rawmode = "RGB;T"
        return width * height * 3
    if rawmode = "RGBA;L" || rawmode = "RGBX;L" || rawmode = "CMYK;L" || rawmode = "YCbCr;L"
        return width * height * 4
    if rawmode = "LA;L" || rawmode = "PA;L"
        return width * height * 2
    return width * height
}

AhkStdlibPillowImInterleavedPalette(palette)
{
    bytes := []
    loop 256 {
        i := A_Index
        bytes.Push(palette[i])
        bytes.Push(palette[i + 256])
        bytes.Push(palette[i + 512])
    }
    return bytes
}

AhkStdlibPillowImSaveImage(image, fp, filename)
{
    saveMap := AhkStdlibPillowImSaveMap()
    if !saveMap.Has(image.mode)
        throw ValueError("Cannot save " image.mode " images as IM", -1)
    pair := saveMap[image.mode]
    imageType := pair[1]
    rawmode := pair[2]
    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    frames := info.Has("frames") ? info["frames"] : 1
    bytes := AhkStdlibPillowAsciiBytes("Image type: " imageType " image`r`n")
    if filename != "" {
        name := AhkStdlibPillowImBasename(filename)
        if StrLen(name) > 92
            name := SubStr(name, 1, 92)
        for byte in AhkStdlibPillowAsciiBytes("Name: " name "`r`n")
            bytes.Push(byte)
    }
    for byte in AhkStdlibPillowAsciiBytes("Image size (x*y): " image.width "*" image.height "`r`n")
        bytes.Push(byte)
    for byte in AhkStdlibPillowAsciiBytes("File size (no of images): " frames "`r`n")
        bytes.Push(byte)
    if image.mode = "P" || image.mode = "PA" {
        for byte in AhkStdlibPillowAsciiBytes("Lut: 1`r`n")
            bytes.Push(byte)
    }
    padding := 511 - bytes.Length
    loop padding
        bytes.Push(0)
    bytes.Push(0x1A)
    if image.mode = "P" || image.mode = "PA" {
        palette := image.getpalette("RGB")
        colors := palette.Length // 3
        loop 3 {
            channel := A_Index
            loop colors
                bytes.Push(palette[(A_Index - 1) * 3 + channel])
            loop 256 - colors
                bytes.Push(0)
        }
    }
    for byte in AhkStdlibPillowImEncodeImage(image, rawmode)
        bytes.Push(byte)
    fp.write(bytes)
    if HasMethod(fp, "flush")
        fp.flush()
    return stdlib.None
}

AhkStdlibPillowImEncodeImage(image, rawmode)
{
    if rawmode = "L" || rawmode = "P"
        return AhkStdlibPillowImEncodeSingle(image)
    if rawmode = "1"
        return AhkStdlibPillowImEncodePackedBits(image)
    if rawmode = "RGB;L"
        return AhkStdlibPillowImEncodeRgbL(image)
    if rawmode = "RGBA;L" || rawmode = "LA;L" || rawmode = "PA;L"
        return AhkStdlibPillowImEncodePlanar(image)
    return image.tobytes()
}

AhkStdlibPillowImEncodeSingle(image)
{
    bytes := []
    y := image.height - 1
    while y >= 0 {
        loop image.width
            bytes.Push(AhkStdlibPillowRequireByte(image.getpixel([A_Index - 1, y])))
        y -= 1
    }
    return bytes
}

AhkStdlibPillowImEncodePackedBits(image)
{
    bytes := []
    y := image.height - 1
    while y >= 0 {
        current := 0
        bit := 7
        loop image.width {
            value := image.getpixel([A_Index - 1, y]) ? 1 : 0
            current |= value << bit
            bit -= 1
            if bit < 0 {
                bytes.Push(current)
                current := 0
                bit := 7
            }
        }
        if bit != 7
            bytes.Push(current)
        y -= 1
    }
    return bytes
}

AhkStdlibPillowImEncodeRgbL(image)
{
    bytes := []
    loop image.height {
        y := image.height - A_Index
        rowPlanes := [[], [], []]
        loop image.width {
            pixel := image.getpixel([A_Index - 1, y])
            rowPlanes[1].Push(AhkStdlibPillowPixelChannel(pixel, image.mode, 1))
            rowPlanes[2].Push(AhkStdlibPillowPixelChannel(pixel, image.mode, 2))
            rowPlanes[3].Push(AhkStdlibPillowPixelChannel(pixel, image.mode, 3))
        }
        for plane in rowPlanes {
            for byte in plane
                bytes.Push(byte)
        }
    }
    return bytes
}

AhkStdlibPillowImEncodePlanar(image)
{
    channels := StrLen(AhkStdlibPillowChannels(image.mode))
    planes := []
    loop channels
        planes.Push([])
    loop image.height {
        y := A_Index - 1
        loop image.width {
            pixel := image.getpixel([A_Index - 1, y])
            loop channels
                planes[A_Index].Push(AhkStdlibPillowPixelChannel(pixel, image.mode, A_Index))
        }
    }
    bytes := []
    for plane in planes {
        for byte in plane
            bytes.Push(byte)
    }
    return bytes
}

AhkStdlibPillowImBasename(path)
{
    text := String(path)
    return RegExReplace(text, "^.*[\\/]", "")
}

