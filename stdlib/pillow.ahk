AhkStdlibPillowPpmReadFloat32(bytes, pos, little)
{
    buf := Buffer(4, 0)
    if little {
        NumPut("UChar", bytes[pos], buf, 0)
        NumPut("UChar", bytes[pos + 1], buf, 1)
        NumPut("UChar", bytes[pos + 2], buf, 2)
        NumPut("UChar", bytes[pos + 3], buf, 3)
    } else {
        NumPut("UChar", bytes[pos + 3], buf, 0)
        NumPut("UChar", bytes[pos + 2], buf, 1)
        NumPut("UChar", bytes[pos + 1], buf, 2)
        NumPut("UChar", bytes[pos], buf, 3)
    }
    return NumGet(buf, 0, "Float")
}

