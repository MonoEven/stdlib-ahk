}

AhkStdlibPillowGifPushSubBlocks(bytes, payload)
{
    pos := 1
    while pos <= payload.Length {
        count := Min(255, payload.Length - pos + 1)
        bytes.Push(count)
        loop count {
            bytes.Push(payload[pos])
            pos += 1
        }
    }
    bytes.Push(0)
    return stdlib.None
}

AhkStdlibPillowGifEncodeLzw(pixels, minCodeSize)
{
    clearCode := 1 << minCodeSize
    endCode := clearCode + 1
    codeSize := minCodeSize + 1
    codes := [clearCode]
    nextCode := endCode + 1
    dictionary := Map()
    loop clearCode
        dictionary[String(A_Index - 1)] := A_Index - 1

    if pixels.Length {
        current := String(AhkStdlibPillowRequireByte(pixels[1]))
        index := 2
        while index <= pixels.Length {
            byte := AhkStdlibPillowRequireByte(pixels[index])
            combined := current "," byte
            if dictionary.Has(combined) {
                current := combined
            } else {
                codes.Push(dictionary[current])
                if nextCode < 4096 {
                    dictionary[combined] := nextCode
                    nextCode += 1
                    if nextCode = (1 << codeSize) && codeSize < 12
                        codeSize += 1
                }
                current := String(byte)
            }
            index += 1
        }
        codes.Push(dictionary[current])
    }
    codes.Push(endCode)
    return AhkStdlibPillowGifPackCodes(codes, minCodeSize)
}

AhkStdlibPillowGifPackCodes(codes, minCodeSize)
{
    clearCode := 1 << minCodeSize
    endCode := clearCode + 1
    codeSize := minCodeSize + 1
    nextCode := endCode + 1
    bytes := []
    current := 0
    bitCount := 0
    firstDataCodeSeen := false
    for code in codes {
        current |= code << bitCount
        bitCount += codeSize
        while bitCount >= 8 {
            bytes.Push(current & 0xFF)
            current >>= 8
            bitCount -= 8
        }
        if code = clearCode {
            codeSize := minCodeSize + 1
            nextCode := endCode + 1
            firstDataCodeSeen := false
        } else if code != endCode {
            if firstDataCodeSeen {
                nextCode += 1
                if nextCode = (1 << codeSize) && codeSize < 12
                    codeSize += 1
            } else {
                firstDataCodeSeen := true
            }
        }
    }
    if bitCount > 0
        bytes.Push(current & 0xFF)
    return bytes
}

class AhkStdlibPillowFliImage extends AhkStdlibPillowImage
{
    __New(width, height, nFrames, duration, paletteBytes, sourceBytes)
    {
        handle := AhkStdlibPillowCreateBitmap(width, height, "P")
        super.__New(handle, "P", width, height, "FLI", 1)
        this.n_frames := nFrames
        this.is_animated := nFrames > 1
        this.info["duration"] := duration
        this.palette := AhkStdlibPillowImagePaletteModule.raw("RGB", paletteBytes)
        this.decodermaxblock := 0
        this.tile := []
        this.AhkStdlibFliFrame := -1
        this.AhkStdlibFliOffset := 128
        this.AhkStdlibFliSourceBytes := sourceBytes
    }

    seek(frame)
    {
        if frame < 0 || frame >= this.n_frames
            throw EOFError("attempt to seek outside sequence", -1)
        if frame = this.AhkStdlibFliFrame
            return stdlib.None
        if frame < this.AhkStdlibFliFrame
            this.AhkStdlibFliSeekInternal(0)
        loop frame - this.AhkStdlibFliFrame
            this.AhkStdlibFliSeekInternal(this.AhkStdlibFliFrame + 1)
        return stdlib.None
    }

    tell()
    {
        return this.AhkStdlibFliFrame
    }

    AhkStdlibFliSeekInternal(frame)
    {
        if frame = 0 {
            this.AhkStdlibFliFrame := -1
            this.AhkStdlibFliOffset := 128
        } else {
            this.load()
        }
        if frame != this.AhkStdlibFliFrame + 1
            throw ValueError("cannot seek to frame " frame, -1)
        this.AhkStdlibFliFrame := frame
        pos := this.AhkStdlibFliOffset + 1
        if pos + 3 > this.AhkStdlibFliSourceBytes.Length
            throw EOFError("missing frame size", -1)
        frameSize := AhkStdlibPillowFliU32(this.AhkStdlibFliSourceBytes, pos)
        this.decodermaxblock := frameSize
        this.tile := [["fli", [0, 0, this.width, this.height], this.AhkStdlibFliOffset, stdlib.None]]
        this.AhkStdlibFliOffset += frameSize
        return stdlib.None
    }

    load()
    {
        this.tile := []
        return stdlib.None
    }
}

class AhkStdlibPillowDcxImage extends AhkStdlibPillowImage
{
    __New(frames)
    {
        this.AhkStdlibDcxFrames := frames
        this.AhkStdlibDcxFrame := 0
        first := frames[1]
        super.__New(first.AhkStdlibHandle, first.mode, first.width, first.height, "DCX", 1)
        first.AhkStdlibHandle := 0
        this.info := first.info
        this.AhkStdlibPaletteMode := first.AhkStdlibPaletteMode
        this.AhkStdlibPalette := first.AhkStdlibPalette
        this.n_frames := frames.Length
        this.is_animated := frames.Length > 1
    }

    seek(args*)
    {
        if args.Length = 0
            throw TypeError("Image.seek() missing 1 required positional argument: 'frame'", -1)
        if args.Length > 1
            throw TypeError("Image.seek() takes 2 positional arguments but " args.Length + 1 " were given", -1)
