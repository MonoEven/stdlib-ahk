    image := args[1]
    fp := args[2]
    if image.mode != "1"
        throw OSError("cannot write mode " image.mode " as MSP", -1)
    bytes := AhkStdlibPillowMspHeader("DanM", image.width, image.height)
    for byte in image.tobytes()
        bytes.Push(byte)
    fp.write(bytes)
    return stdlib.None
}

AhkStdlibPillowMspHeader(magic, width, height)
{
    bytes := AhkStdlibPillowAsciiBytes(magic)
    for value in [width, height, 1, 1, 1, 1, width, height, 0, 0, 0, 0, 0, 0] {
        for byte in AhkStdlibPillowMspLe16(value)
            bytes.Push(byte)
    }
    checksum := AhkStdlibPillowMspChecksum(bytes)
    bytes[25] := checksum & 0xFF
    bytes[26] := (checksum >> 8) & 0xFF
    return bytes
}

AhkStdlibPillowMspChecksum(bytes)
{
    if bytes.Length < 32
        throw SyntaxError("unpack_from requires a buffer of at least 6 bytes for unpacking 2 bytes at offset 4 (actual buffer size is " bytes.Length ")", -1)
    checksum := 0
    index := 1
    while index <= 32 {
        checksum := checksum ^ AhkStdlibPillowMspReadLe16(bytes, index)
        index += 2
    }
    return checksum
}

AhkStdlibPillowMspReadLe16(bytes, offset)
{
    if offset < 1 || offset + 1 > bytes.Length
        throw OSError("Truncated File Read", -1)
    return bytes[offset] | (bytes[offset + 1] << 8)
}

AhkStdlibPillowMspLe16(value)
{
    value := Integer(value)
    return [value & 0xFF, (value >> 8) & 0xFF]
}

