    loop image.height {
        y := A_Index - 1
        loop image.width {
            x := A_Index - 1
            pixel := image.getpixel([x, y])
            nonZero := false
            if useAlpha {
                nonZero := AhkStdlibPillowPixelChannel(pixel, image.mode, StrLen(AhkStdlibPillowChannels(image.mode))) != 0
            } else {
                channels := StrLen(AhkStdlibPillowChannels(image.mode))
                loop channels {
                    if AhkStdlibPillowPixelChannel(pixel, image.mode, A_Index) != 0 {
                        nonZero := true
                        break
                    }
                }
            }
            if nonZero {
                if x < left
                    left := x
                if y < top
                    top := y
                if x + 1 > right
                    right := x + 1
                if y + 1 > bottom
                    bottom := y + 1
            }
        }
    }

    if right < 0
        return stdlib.None
    return [left, top, right, bottom]
}

