    input := Buffer(A_PtrSize = 8 ? 24 : 16, 0)
    NumPut("UInt", 1, input, 0)
    AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdiplusStartup", "Ptr*", &token, "Ptr", input, "Ptr", 0), "GdiplusStartup")
    return token
}

