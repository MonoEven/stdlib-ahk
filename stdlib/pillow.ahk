AhkStdlibPillowAvifValidateEncoderInfo(image)
{
    info := image.HasOwnProp("encoderinfo") ? image.encoderinfo : Map()
    quality := info.Has("quality") ? info["quality"] : 75
    if !(quality is Integer) || quality < 0 || quality > 100
        throw ValueError("Invalid quality setting", -1)

    if info.Has("advanced") && !AhkStdlibIsNone(info["advanced"]) {
        advanced := info["advanced"]
        invalid := false
        if advanced is Map {
            invalid := false
        } else if IsObject(advanced) && HasMethod(advanced, "__Enum") {
