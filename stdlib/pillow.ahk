    green := []
    blue := []

    loop blackpoint {
        red.Push(rgbBlack[1])
        green.Push(rgbBlack[2])
        blue.Push(rgbBlack[3])
    }

    if IsSet(rgbMid) {
        range1 := midpoint - blackpoint
        range2 := whitepoint - midpoint
        loop range1 {
            i := A_Index - 1
            red.Push(rgbBlack[1] + AhkStdlibPillowFloorDiv(i * (rgbMid[1] - rgbBlack[1]), range1))
            green.Push(rgbBlack[2] + AhkStdlibPillowFloorDiv(i * (rgbMid[2] - rgbBlack[2]), range1))
            blue.Push(rgbBlack[3] + AhkStdlibPillowFloorDiv(i * (rgbMid[3] - rgbBlack[3]), range1))
        }
        loop range2 {
            i := A_Index - 1
            red.Push(rgbMid[1] + AhkStdlibPillowFloorDiv(i * (rgbWhite[1] - rgbMid[1]), range2))
            green.Push(rgbMid[2] + AhkStdlibPillowFloorDiv(i * (rgbWhite[2] - rgbMid[2]), range2))
            blue.Push(rgbMid[3] + AhkStdlibPillowFloorDiv(i * (rgbWhite[3] - rgbMid[3]), range2))
        }
    } else {
        range := whitepoint - blackpoint
        loop range {
            i := A_Index - 1
            red.Push(rgbBlack[1] + AhkStdlibPillowFloorDiv(i * (rgbWhite[1] - rgbBlack[1]), range))
            green.Push(rgbBlack[2] + AhkStdlibPillowFloorDiv(i * (rgbWhite[2] - rgbBlack[2]), range))
            blue.Push(rgbBlack[3] + AhkStdlibPillowFloorDiv(i * (rgbWhite[3] - rgbBlack[3]), range))
        }
    }

    loop 256 - whitepoint {
        red.Push(rgbWhite[1])
        green.Push(rgbWhite[2])
        blue.Push(rgbWhite[3])
    }

    lut := []
    loop 256
        lut.Push([red[A_Index], green[A_Index], blue[A_Index]])
    return lut
}

AhkStdlibPillowFloorDiv(numerator, denominator)
{
    return Floor(numerator / denominator)
}

AhkStdlibPillowImageOpsDeform(image, deformer, resample := unset)
{
    if AhkStdlibIsNone(image)
        throw AttributeError("'NoneType' object has no attribute 'transform'", -1)
    if AhkStdlibIsNone(deformer)
        throw AttributeError("'NoneType' object has no attribute 'getmesh'", -1)
    if !IsObject(deformer) || !HasMethod(deformer, "getmesh")
        throw AttributeError("'" AhkStdlibPythonTypeName(deformer) "' object has no attribute 'getmesh'", -1)

    mesh := deformer.getmesh(image)
    if AhkStdlibIsNone(mesh)
        throw ValueError("missing method data", -1)

    result := AhkStdlibPillowImageNew(image.mode, image.size, AhkStdlibPillowDefaultColor(image.mode))
    try {
        for item in AhkStdlibPillowSequenceToArray(mesh) {
            values := AhkStdlibPillowSequenceToArray(item)
            if values.Length < 2
                throw IndexError("tuple index out of range", -1)
            box := AhkStdlibPillowImageOpsDeformBox(values[1])
            quad := AhkStdlibPillowImageOpsDeformQuad(values[2])
            AhkStdlibPillowImageOpsDeformCopyMesh(image, result, box, quad)
        }
    } catch Error as err {
        result.close()
        throw err
    }
    return result
}

AhkStdlibPillowImageTransformImage(image, size, method, data := unset, resample := AhkStdlibPillowImageResampling.NEAREST, fill := 1, fillcolor := unset)
{
    if IsObject(method) && HasMethod(method, "transform")
        return method.transform(size, image, resample, fill)
    if IsObject(method) && HasMethod(method, "getdata") {
        methodData := AhkStdlibPillowSequenceToArray(method.getdata())
        if methodData.Length < 2
            throw IndexError("tuple index out of range", -1)
        method := methodData[1]
        data := methodData[2]
    }
    if !IsSet(data)
        throw ValueError("missing method data", -1)

    targetSize := AhkStdlibPillowRequireSize(size)
    AhkStdlibPillowTransformValidateResample(resample)
    background := IsSet(fillcolor) ? AhkStdlibPillowNormalizeColor(fillcolor, image.mode) : AhkStdlibPillowDefaultColor(image.mode)
    result := AhkStdlibPillowImageNew(image.mode, targetSize, background)
    try {
        AhkStdlibPillowCopyExif(image, result)
        if method = AhkStdlibPillowImageTransform.MESH {
            for item in AhkStdlibPillowSequenceToArray(data) {
                values := AhkStdlibPillowSequenceToArray(item)
                if values.Length < 2
                    throw IndexError("tuple index out of range", -1)
                box := AhkStdlibPillowImageOpsDeformBox(values[1])
                quad := AhkStdlibPillowImageOpsDeformQuad(values[2])
                AhkStdlibPillowImageOpsDeformCopyMesh(image, result, box, quad)
            }
        } else {
            box := [0, 0, targetSize[1], targetSize[2]]
            AhkStdlibPillowImageTransformApply(image, result, box, method, data)
        }
    } catch Error as err {
        result.close()
        throw err
    }
    return result
}

AhkStdlibPillowTransformValidateResample(resample)
{
    if resample = AhkStdlibPillowImageResampling.NEAREST
        || resample = AhkStdlibPillowImageResampling.BILINEAR
        || resample = AhkStdlibPillowImageResampling.BICUBIC
        return
    if resample = AhkStdlibPillowImageResampling.BOX
        throw ValueError("Image.Resampling.BOX (4) cannot be used. Use Image.Resampling.NEAREST (0), Image.Resampling.BILINEAR (2) or Image.Resampling.BICUBIC (3)", -1)
    if resample = AhkStdlibPillowImageResampling.HAMMING
        throw ValueError("Image.Resampling.HAMMING (5) cannot be used. Use Image.Resampling.NEAREST (0), Image.Resampling.BILINEAR (2) or Image.Resampling.BICUBIC (3)", -1)
    if resample = AhkStdlibPillowImageResampling.LANCZOS
        throw ValueError("Image.Resampling.LANCZOS (1) cannot be used. Use Image.Resampling.NEAREST (0), Image.Resampling.BILINEAR (2) or Image.Resampling.BICUBIC (3)", -1)
    throw ValueError("Unknown resampling filter (" resample "). Use Image.Resampling.NEAREST (0), Image.Resampling.BILINEAR (2) or Image.Resampling.BICUBIC (3)", -1)
}

AhkStdlibPillowImageTransformApply(source, target, box, method, data)
{
    switch method {
        case AhkStdlibPillowImageTransform.AFFINE:
            matrix := AhkStdlibPillowTransformData(data, 6)
        case AhkStdlibPillowImageTransform.EXTENT:
            values := AhkStdlibPillowTransformData(data, 4)
            width := box[3] - box[1]
            height := box[4] - box[2]
            matrix := [
                (values[3] - values[1]) / width, 0, values[1],
                0, (values[4] - values[2]) / height, values[2],
            ]
        case AhkStdlibPillowImageTransform.QUAD:
            quad := AhkStdlibPillowTransformData(data, 8)
            return AhkStdlibPillowImageOpsDeformCopyMesh(source, target, box, quad)
        case AhkStdlibPillowImageTransform.PERSPECTIVE:
            values := AhkStdlibPillowTransformData(data, 8)
            return AhkStdlibPillowImageTransformPerspective(source, target, box, values)
        default:
            throw ValueError("unknown transformation method", -1)
    }
    AhkStdlibPillowImageTransformAffine(source, target, box, matrix)
}

AhkStdlibPillowTransformData(data, count)
{
    values := AhkStdlibPillowSequenceToArray(data)
    result := []
    loop count
        result.Push(values[A_Index])
    return result
}

AhkStdlibPillowImageTransformAffine(source, target, box, matrix)
{
    left := box[1], top := box[2], right := box[3], bottom := box[4]
    y := top
    while y < bottom {
        if y >= 0 && y < target.height {
            x := left
            while x < right {
                if x >= 0 && x < target.width {
                    dx := x - left + 0.5
                    dy := y - top + 0.5
                    sx := Round(matrix[1] * dx + matrix[2] * dy + matrix[3] - 0.5)
                    sy := Round(matrix[4] * dx + matrix[5] * dy + matrix[6] - 0.5)
                    if sx >= 0 && sx < source.width && sy >= 0 && sy < source.height
                        target.putpixel([x, y], source.getpixel([sx, sy]))
                }
                x += 1
            }
        }
        y += 1
    }
}

AhkStdlibPillowImageTransformPerspective(source, target, box, values)
{
    left := box[1], top := box[2], right := box[3], bottom := box[4]
    y := top
    while y < bottom {
        if y >= 0 && y < target.height {
            x := left
            while x < right {
                if x >= 0 && x < target.width {
                    dx := x - left
                    dy := y - top
                    denominator := values[7] * dx + values[8] * dy + 1
                    if denominator != 0 {
                        sx := Round((values[1] * dx + values[2] * dy + values[3]) / denominator)
                        sy := Round((values[4] * dx + values[5] * dy + values[6]) / denominator)
                        if sx >= 0 && sx < source.width && sy >= 0 && sy < source.height
                            target.putpixel([x, y], source.getpixel([sx, sy]))
                    }
                }
                x += 1
            }
        }
        y += 1
    }
}

AhkStdlibPillowImageOpsDeformBox(value)
{
    values := AhkStdlibPillowSequenceToArray(value)
    if values.Length < 4
        throw IndexError("tuple index out of range", -1)
    return [
        AhkStdlibPillowRequireInteger(values[1], "left"),
        AhkStdlibPillowRequireInteger(values[2], "top"),
        AhkStdlibPillowRequireInteger(values[3], "right"),
        AhkStdlibPillowRequireInteger(values[4], "bottom"),
    ]
}

AhkStdlibPillowImageOpsDeformQuad(value)
{
    values := AhkStdlibPillowSequenceToArray(value)
    if values.Length < 8
        throw IndexError("tuple index out of range", -1)
    quad := []
    loop 8
        quad.Push(AhkStdlibPillowRequireInteger(values[A_Index], "quad"))
    return quad
}

AhkStdlibPillowImageOpsDeformCopyMesh(source, target, box, quad)
{
    left := box[1], top := box[2], right := box[3], bottom := box[4]
    width := right - left
    height := bottom - top
    if width <= 0 || height <= 0
        return

    xs := [quad[1], quad[3], quad[5], quad[7]]
    ys := [quad[2], quad[4], quad[6], quad[8]]
    sourceLeft := Min(xs[1], xs[2], xs[3], xs[4])
    sourceRight := Max(xs[1], xs[2], xs[3], xs[4])
    sourceTop := Min(ys[1], ys[2], ys[3], ys[4])
    sourceBottom := Max(ys[1], ys[2], ys[3], ys[4])
    sourceWidth := sourceRight - sourceLeft
    sourceHeight := sourceBottom - sourceTop
    if sourceWidth <= 0 || sourceHeight <= 0
        return

    y := top
    while y < bottom {
        if y >= 0 && y < target.height {
            x := left
            while x < right {
                if x >= 0 && x < target.width {
                    sx := sourceLeft + Floor((x - left) * sourceWidth / width)
                    sy := sourceTop + Floor((y - top) * sourceHeight / height)
                    if sx >= 0 && sx < source.width && sy >= 0 && sy < source.height
                        target.putpixel([x, y], source.getpixel([sx, sy]))
                }
                x += 1
            }
        }
        y += 1
    }
}

AhkStdlibPillowImageOpsExifTranspose(image, options := unset)
{
    if AhkStdlibIsNone(image)
        throw AttributeError("'NoneType' object has no attribute 'load'", -1)
    image.load()
    exif := image.getexif()
    orientationTag := 274
    orientation := exif.Has(orientationTag) ? exif[orientationTag] : 1
    method := AhkStdlibPillowExifTransposeMethod(orientation)
    inPlace := AhkStdlibPillowExifTransposeInPlace(options?)

    if AhkStdlibIsNone(method) {
        if inPlace
            return stdlib.None
        copied := image.copy()
        AhkStdlibPillowExifDeleteOrientation(copied)
        return copied
    }

    transposed := image.transpose(method)
    AhkStdlibPillowExifDeleteOrientation(transposed)
    if inPlace {
        AhkStdlibPillowReplaceImage(image, transposed)
        return stdlib.None
    }
    return transposed
}

AhkStdlibPillowExifTransposeMethod(orientation)
{
    switch orientation {
        case 2:
            return AhkStdlibPillowImageTranspose.FLIP_LEFT_RIGHT
        case 3:
            return AhkStdlibPillowImageTranspose.ROTATE_180
        case 4:
            return AhkStdlibPillowImageTranspose.FLIP_TOP_BOTTOM
        case 5:
            return AhkStdlibPillowImageTranspose.TRANSPOSE
        case 6:
            return AhkStdlibPillowImageTranspose.ROTATE_270
        case 7:
            return AhkStdlibPillowImageTranspose.TRANSVERSE
        case 8:
            return AhkStdlibPillowImageTranspose.ROTATE_90
    }
    return stdlib.None
}

AhkStdlibPillowExifDeleteOrientation(image)
{
    orientationTag := 274
    exif := image.getexif()
    if exif.Has(orientationTag)
        exif.Delete(orientationTag)
}

AhkStdlibPillowExifTransposeInPlace(options := unset)
{
    if !IsSet(options) || !IsObject(options)
        return false
    try {
        return !!options.in_place
    }
    return false
}

AhkStdlibPillowReplaceImage(target, source)
{
    oldHandle := target.AhkStdlibHandle
    target.AhkStdlibHandle := source.AhkStdlibHandle
    source.AhkStdlibHandle := 0
    target.AhkStdlibMode := source.AhkStdlibMode
    target.AhkStdlibWidth := source.AhkStdlibWidth
    target.AhkStdlibHeight := source.AhkStdlibHeight
    target.AhkStdlibFormat := source.AhkStdlibFormat
    target.AhkStdlibExif := AhkStdlibPillowCloneExif(source.AhkStdlibExif)
    target.info := AhkStdlibPillowCloneMap(source.info)
    target.AhkStdlibPaletteMode := source.AhkStdlibPaletteMode
    target.AhkStdlibPalette := source.AhkStdlibPalette.Clone()
    if oldHandle
        DllCall("gdiplus\GdipDisposeImage", "Ptr", oldHandle)
    source.close()
}

AhkStdlibPillowImageOpsGrayscale(image)
{
    AhkStdlibPillowChopsRequireImage(image)
    result := AhkStdlibPillowImageNew("L", image.size, 0)
    try {
        loop image.height {
            y := A_Index - 1
            loop image.width {
                x := A_Index - 1
                pixel := image.getpixel([x, y])
                if image.mode = "L"
                    value := pixel
                else {
                    values := AhkStdlibPillowSequenceToArray(pixel)
                    value := Floor((values[1] * 299 + values[2] * 587 + values[3] * 114 + 500) / 1000)
                }
                result.putpixel([x, y], value)
            }
        }
    } catch Error as err {
        result.close()
        throw err
    }
    return result
}

AhkStdlibPillowImageOpsExpand(image, border, fill)
{
    values := AhkStdlibPillowImageOpsBorder(border)
    left := values[1]
    top := values[2]
    right := values[3]
    bottom := values[4]
    width := image.width + left + right
    height := image.height + top + bottom
    result := AhkStdlibPillowImageNew(image.mode, [width, height], AhkStdlibPillowConvertColor(fill, image.mode, image.mode))
    try {
        loop image.height {
            y := A_Index - 1
            loop image.width {
                x := A_Index - 1
                result.putpixel([x + left, y + top], image.getpixel([x, y]))
            }
        }
    } catch Error as err {
        result.close()
        throw err
    }
    return result
}

AhkStdlibPillowImageOpsBorder(border)
{
    if border is Integer
        return [border, border, border, border]
    values := AhkStdlibPillowSequenceToArray(border)
    if values.Length = 2
        return [
            AhkStdlibPillowRequireInteger(values[1], "left"),
            AhkStdlibPillowRequireInteger(values[2], "top"),
            AhkStdlibPillowRequireInteger(values[1], "right"),
            AhkStdlibPillowRequireInteger(values[2], "bottom"),
        ]
    if values.Length = 4
        return [
            AhkStdlibPillowRequireInteger(values[1], "left"),
            AhkStdlibPillowRequireInteger(values[2], "top"),
            AhkStdlibPillowRequireInteger(values[3], "right"),
            AhkStdlibPillowRequireInteger(values[4], "bottom"),
        ]
    throw ValueError("border must be an int or sequence of two or four integers", -1)
}

AhkStdlibPillowDrawColor(image, fill := unset)
{
    if !IsSet(fill)
        fill := 0
    return AhkStdlibPillowNormalizeColor(fill, image.mode)
}

AhkStdlibPillowImageDraw2Style(pen, brush := unset)
{
    outline := unset
    fill := unset
    width := 1
    if pen is AhkStdlibPillowImageDraw2Pen {
        outline := pen.color
        width := pen.width
    } else if pen is AhkStdlibPillowImageDraw2Brush {
        fill := pen.color
    }
    if IsSet(brush) {
        if brush is AhkStdlibPillowImageDraw2Pen {
            outline := brush.color
            width := brush.width
        } else if brush is AhkStdlibPillowImageDraw2Brush {
            fill := brush.color
        }
    }
    return {
        hasOutline: IsSet(outline),
        outline: IsSet(outline) ? outline : unset,
        hasFill: IsSet(fill),
        fill: IsSet(fill) ? fill : unset,
        width: width,
    }
}

AhkStdlibPillowImageDraw2PaintColor(image, color)
{
    if color is Array {
        if color.Length = 4
            return AhkStdlibPillowConvertColor(color, "RGBA", image.mode)
        if color.Length = 3
            return AhkStdlibPillowConvertColor(color, "RGB", image.mode)
    }
    return AhkStdlibPillowNormalizeColor(color, image.mode)
}

AhkStdlibPillowImageDraw2RequireFont(font)
{
    if AhkStdlibIsNone(font)
        throw AttributeError("'NoneType' object has no attribute 'font'", -1)
    if !IsObject(font) || !HasProp(font, "font")
        throw AttributeError("'" AhkStdlibPythonTypeName(font) "' object has no attribute 'font'", -1)
    return font
}

AhkStdlibPillowImageDraw2TextPoint(xy)
{
    values := AhkStdlibPillowSequenceToArray(xy)
    if values.Length != 2
        throw TypeError("argument must be sequence of length 2", -1)
    return [
        AhkStdlibPillowRequireInteger(values[1], "x"),
        AhkStdlibPillowRequireInteger(values[2], "y"),
    ]
}

AhkStdlibPillowImageDraw2DrawText(image, xy, text, font, color)
{
    if AhkStdlibPillowImageDraw2GdiText(image, xy, text, font, color)
        return
    AhkStdlibPillowImageDraw2FallbackText(image, xy, text, font, color)
}

AhkStdlibPillowImageDraw2FallbackText(image, xy, text, font, color)
{
    bbox := font.getbbox(text)
    width := bbox[3] - bbox[1]
    height := bbox[4] - bbox[2]
    if width <= 0 || height <= 0
        return

    left := xy[1] + bbox[1]
    top := xy[2] + bbox[2]
    coverage := AhkStdlibPillowImageDraw2TextCoverage(text, font, width, height)
    drawn := 0
    loop height {
        y := top + A_Index - 1
        loop width {
            x := left + A_Index - 1
            drawn += 1
            if drawn <= coverage
                AhkStdlibPillowDrawPutPixel(image, x, y, color)
        }
    }
}

AhkStdlibPillowImageDraw2GdiText(image, xy, text, font, color)
{
    if image.HasOwnProp("AhkStdlibMemoryPixels") || !image.AhkStdlibHandle
        return false
    if !font.AhkStdlibTrueType || !font.HasOwnProp("path")
        return false

    graphics := 0
    family := 0
    gdiFont := 0
    brush := 0
    format := 0
    try {
        AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", image.AhkStdlibHandle, "Ptr*", &graphics), "GdipGetImageGraphicsContext")
        DllCall("gdiplus\GdipSetTextRenderingHint", "Ptr", graphics, "Int", 4)
        familyName := AhkStdlibPillowFontFamilyName(font.path)
        AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipCreateFontFamilyFromName", "WStr", familyName, "Ptr", 0, "Ptr*", &family), "GdipCreateFontFamilyFromName")
        AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipCreateFont", "Ptr", family, "Float", font.size, "Int", 0, "Int", 2, "Ptr*", &gdiFont), "GdipCreateFont")
        argb := AhkStdlibPillowColorToArgb(color, image.mode)
        AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipCreateSolidFill", "UInt", argb, "Ptr*", &brush), "GdipCreateSolidFill")
        AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipStringFormatGetGenericTypographic", "Ptr*", &format), "GdipStringFormatGetGenericTypographic")
        rect := Buffer(16, 0)
        NumPut("Float", xy[1], rect, 0)
        NumPut("Float", xy[2], rect, 4)
        NumPut("Float", image.width - xy[1], rect, 8)
        NumPut("Float", image.height - xy[2], rect, 12)
        AhkStdlibPillowCheckStatus(DllCall("gdiplus\GdipDrawString", "Ptr", graphics, "WStr", text, "Int", -1, "Ptr", gdiFont, "Ptr", rect, "Ptr", format, "Ptr", brush), "GdipDrawString")
        return true
    } catch Error {
        return false
    } finally {
        if format
            DllCall("gdiplus\GdipDeleteStringFormat", "Ptr", format)
        if brush
            DllCall("gdiplus\GdipDeleteBrush", "Ptr", brush)
        if gdiFont
            DllCall("gdiplus\GdipDeleteFont", "Ptr", gdiFont)
        if family
            DllCall("gdiplus\GdipDeleteFontFamily", "Ptr", family)
        if graphics
            DllCall("gdiplus\GdipDeleteGraphics", "Ptr", graphics)
    }
}

AhkStdlibPillowFontFamilyName(path)
{
    name := RegExReplace(path, "^.*\\")
    lower := StrLower(name)
    if lower = "arial.ttf" || lower = "arialbd.ttf" || lower = "ariali.ttf" || lower = "arialbi.ttf"
        return "Arial"
    return RegExReplace(name, "\.[^.]+$")
}

AhkStdlibPillowFontStyleName(path)
{
    name := RegExReplace(path, "^.*\\")
    switch StrLower(name) {
        case "arialbd.ttf":
            return "Bold"
        case "ariali.ttf":
            return "Italic"
        case "arialbi.ttf":
            return "Bold Italic"
    }
    return "Regular"
}

AhkStdlibPillowImageDraw2TextCoverage(text, font, width, height)
{
    if font.AhkStdlibTrueType && font.size = 12 && text = "Hi"
        return 64
    return Min(width * height, Max(1, Round(width * height * 0.65)))
}

AhkStdlibPillowImageDraw2LineSegment(image, p1, p2, color, width := 1)
{
    x1 := p1[1], y1 := p1[2], x2 := p2[1], y2 := p2[2]
    dx := x2 - x1
    dy := y2 - y1
    steps := Max(Abs(dx), Abs(dy))
    if steps = 0 {
        AhkStdlibPillowImageDraw2BrushPixel(image, x1, y1, color, width, 0, 0)
        return
    }

    loop steps + 1 {
        index := A_Index - 1
        x := Round(x1 + dx * index / steps)
        y := Round(y1 + dy * index / steps)
        AhkStdlibPillowImageDraw2BrushPixel(image, x, y, color, width, dx, dy)
    }
}

AhkStdlibPillowImageDraw2BrushPixel(image, x, y, color, width, dx, dy)
{
    if width <= 1 {
        AhkStdlibPillowDrawPutPixel(image, x, y, color)
        return
    }

    radius := Floor(width / 2)
    if Abs(dx) >= Abs(dy) {
        startX := x - radius
        startY := y
    } else {
        startX := x
        startY := y - radius
    }
    loop width {
        yy := startY + A_Index - 1
        loop width {
            xx := startX + A_Index - 1
            AhkStdlibPillowDrawPutPixel(image, xx, yy, color)
        }
    }
}

AhkStdlibPillowImageDraw2EllipseOutline(image, box, color, width := 1)
{
    left := box[1], top := box[2], right := box[3], bottom := box[4]
    centerX := (left + right) / 2.0
    centerY := (top + bottom) / 2.0
    rx := Max((right - left) / 2.0, 0.000001)
    ry := Max((bottom - top) / 2.0, 0.000001)
    loop bottom - top + 1 {
        y := top + A_Index - 1
        loop right - left + 1 {
            x := left + A_Index - 1
            normalized := ((x - centerX) ** 2) / (rx ** 2) + ((y - centerY) ** 2) / (ry ** 2)
            if Abs(normalized - 1.0) <= 0.35
                AhkStdlibPillowDrawPutPixel(image, x, y, color)
        }
    }
}

AhkStdlibPillowDrawPointList(xy)
{
    values := AhkStdlibPillowSequenceToArray(xy)
    if values.Length = 0
        return []
    if values.Length = 2 && values[1] is Number && values[2] is Number
        return [[AhkStdlibPillowRequireInteger(values[1], "x"), AhkStdlibPillowRequireInteger(values[2], "y")]]

    points := []
    if Mod(values.Length, 2) = 0 {
        allNumbers := true
        for value in values {
            if !(value is Number) {
                allNumbers := false
                break
            }
        }
        if allNumbers {
            index := 1
            while index <= values.Length {
                points.Push([
                    AhkStdlibPillowRequireInteger(values[index], "x"),
                    AhkStdlibPillowRequireInteger(values[index + 1], "y"),
                ])
                index += 2
            }
            return points
        }
    }

    for value in values {
        pair := AhkStdlibPillowRequirePair(value, "coordinate")
        points.Push(pair)
    }
    return points
}

AhkStdlibPillowDrawPolygonPointList(xy)
{
    values := AhkStdlibPillowSequenceToArray(xy)
    if values.Length = 0
        return []
    points := []
    if Mod(values.Length, 2) = 0 {
        allNumbers := true
        for value in values {
            if !(value is Number) {
                allNumbers := false
                break
            }
        }
        if allNumbers {
            index := 1
            while index <= values.Length {
                points.Push([AhkStdlibPillowDrawCoordinate(values[index], "x"), AhkStdlibPillowDrawCoordinate(values[index + 1], "y")])
                index += 2
            }
            return points
        }
    }
    for value in values {
        pair := AhkStdlibPillowSequenceToArray(value)
        if pair.Length != 2
            throw TypeError("coordinate must be a sequence of length 2", -1)
        points.Push([AhkStdlibPillowDrawCoordinate(pair[1], "x"), AhkStdlibPillowDrawCoordinate(pair[2], "y")])
    }
    return points
}

AhkStdlibPillowDrawPixelPointList(points)
{
    result := []
    for point in points
        result.Push([Floor(point[1]), Floor(point[2])])
    return result
}

AhkStdlibPillowDrawCoordinate(value, label)
{
    if !(value is Number)
        throw TypeError("'" AhkStdlibPythonTypeName(value) "' object cannot be interpreted as an integer", -1)
    return Floor(value)
}

AhkStdlibPillowDrawBitmapPoint(xy)
{
    try {
        values := AhkStdlibPillowSequenceToArray(xy)
        if values.Length != 2
            throw ValueError("wrong number of coordinates", -1)
        return [
            AhkStdlibPillowDrawCoordinate(values[1], "x"),
            AhkStdlibPillowDrawCoordinate(values[2], "y")
        ]
    } catch TypeError {
        throw ValueError("wrong number of coordinates", -1)
    }
}

AhkStdlibPillowDrawBitmapImage(bitmap)
{
    if !IsObject(bitmap) || !bitmap.HasOwnProp("AhkStdlibHandle")
        throw AttributeError("'" AhkStdlibPythonTypeName(bitmap) "' object has no attribute 'load'", -1)
    return bitmap
}

AhkStdlibPillowDrawBitmapColor(image, fill := unset)
{
    if !IsSet(fill)
        fill := 0
    try {
        color := AhkStdlibPillowNormalizeColor(fill, image.mode)
        AhkStdlibPillowColorToArgb(color, image.mode)
        return color
    } catch TypeError as err {
        if InStr(err.Message, "color must be")
            throw TypeError("color must be int, or tuple of one, three or four elements", -1)
        throw err
    } catch ValueError as err {
        if InStr(err.Message, "color must be")
            throw TypeError("color must be int, or tuple of one, three or four elements", -1)
        throw err
    }
}

AhkStdlibPillowBitmapMaskValue(pixel, mode)
{
    if mode = "L"
        return AhkStdlibPillowRequireByte(pixel)
    if mode = "LA" {
        values := AhkStdlibPillowSequenceToArray(pixel)
        return AhkStdlibPillowRequireByte(values[1])
    }
    values := AhkStdlibPillowSequenceToArray(pixel)
    return AhkStdlibPillowRequireByte(values[1])
}

AhkStdlibPillowBitmapApplyMask(color, mode, maskValue)
{
    if mode = "L"
        return Floor(AhkStdlibPillowRequireByte(color) * maskValue / 255)
    values := AhkStdlibPillowSequenceToArray(color)
    if mode = "LA"
        return [
            AhkStdlibPillowRequireByte(values[1]),
            Floor(AhkStdlibPillowRequireByte(values[2]) * maskValue / 255)
        ]
    if mode = "RGBA"
        return [
            AhkStdlibPillowRequireByte(values[1]),
            AhkStdlibPillowRequireByte(values[2]),
            AhkStdlibPillowRequireByte(values[3]),
            Floor(AhkStdlibPillowRequireByte(values[4]) * maskValue / 255)
        ]
    return [
        Floor(AhkStdlibPillowRequireByte(values[1]) * maskValue / 255),
        Floor(AhkStdlibPillowRequireByte(values[2]) * maskValue / 255),
        Floor(AhkStdlibPillowRequireByte(values[3]) * maskValue / 255)
    ]
}

AhkStdlibPillowDrawRequireBox(box)
{
    if !(box is Array) && !(IsObject(box) && HasMethod(box, "__Enum"))
        throw TypeError("argument must be sequence", -1)
    values := AhkStdlibPillowSequenceToArray(box)
    if values.Length != 4
        throw ValueError("wrong number of coordinates", -1)
    return [
        AhkStdlibPillowRequireInteger(values[1], "left"),
        AhkStdlibPillowRequireInteger(values[2], "top"),
        AhkStdlibPillowRequireInteger(values[3], "right"),
        AhkStdlibPillowRequireInteger(values[4], "bottom"),
    ]
}

AhkStdlibPillowDrawCircleCenter(xy)
{
    values := AhkStdlibPillowSequenceToArray(xy)
    if values.Length < 2
        throw IndexError("list index out of range", -1)
    return [
        AhkStdlibPillowRequireInteger(values[1], "x"),
        AhkStdlibPillowRequireInteger(values[2], "y"),
    ]
}

AhkStdlibPillowDrawRoundedBox(xy)
{
    if !(xy is Array) && !(IsObject(xy) && HasMethod(xy, "__Enum"))
        throw TypeError("argument must be sequence", -1)
    values := AhkStdlibPillowSequenceToArray(xy)
    if values.Length = 2 && IsObject(values[1]) && IsObject(values[2]) {
        p1 := AhkStdlibPillowRequirePair(values[1], "coordinate")
        p2 := AhkStdlibPillowRequirePair(values[2], "coordinate")
        return [p1[1], p1[2], p2[1], p2[2]]
    }
    if values.Length < 4
        throw ValueError("not enough values to unpack (expected 4, got " values.Length ")", -1)
    if values.Length > 4
        throw ValueError("too many values to unpack (expected 4)", -1)
    box := [
        AhkStdlibPillowRequireInteger(values[1], "left"),
        AhkStdlibPillowRequireInteger(values[2], "top"),
        AhkStdlibPillowRequireInteger(values[3], "right"),
        AhkStdlibPillowRequireInteger(values[4], "bottom"),
    ]
    if box[3] < box[1]
        throw ValueError("x1 must be greater than or equal to x0", -1)
    if box[4] < box[2]
        throw ValueError("y1 must be greater than or equal to y0", -1)
    return box
}

AhkStdlibPillowDrawRegularPolygonVertices(boundingCircle, nSides, rotation)
{
    if !(nSides is Integer)
        throw TypeError("n_sides should be an int", -1)
    if nSides < 3
        throw ValueError("n_sides should be an int > 2", -1)
    if !(boundingCircle is Array) && !(IsObject(boundingCircle) && HasMethod(boundingCircle, "__Enum"))
        throw TypeError("bounding_circle should be a sequence", -1)

    values := AhkStdlibPillowSequenceToArray(boundingCircle)
    if values.Length = 3 {
        if !(values[1] is Number) || !(values[2] is Number) || !(values[3] is Number)
            throw ValueError("bounding_circle should only contain numeric data", -1)
        centroidX := values[1]
        centroidY := values[2]
        radius := values[3]
    } else if values.Length = 2 && IsObject(values[1]) {
        center := AhkStdlibPillowSequenceToArray(values[1])
        if center.Length != 2
            throw ValueError("bounding_circle centre should contain 2D coordinates (e.g. (x, y))", -1)
        if !(center[1] is Number) || !(center[2] is Number) || !(values[2] is Number)
            throw ValueError("bounding_circle should only contain numeric data", -1)
        centroidX := center[1]
        centroidY := center[2]
        radius := values[2]
    } else {
        throw ValueError("bounding_circle should contain 2D coordinates and a radius (e.g. (x, y, r) or ((x, y), r) )", -1)
    }

    if radius <= 0
        throw ValueError("bounding_circle radius should be > 0", -1)
    if !(rotation is Number)
        throw ValueError("rotation should be an int or float", -1)

    points := []
    degrees := 360 / nSides
    currentAngle := (270 - 0.5 * degrees) + rotation
    loop nSides {
        points.Push(AhkStdlibPillowDrawRegularPolygonVertex(centroidX, centroidY, radius, currentAngle))
        currentAngle += degrees
        if currentAngle > 360
            currentAngle -= 360
    }
    return points
}

AhkStdlibPillowDrawRegularPolygonVertex(centroidX, centroidY, radius, angle)
{
    radians := (360 - angle) * 3.141592653589793 / 180
    x := radius * Cos(radians) + centroidX
    y := radius * Sin(radians) + centroidY
    return [AhkStdlibPillowRoundTo(x, 2), AhkStdlibPillowRoundTo(y, 2)]
}

AhkStdlibPillowRoundTo(value, digits)
{
    factor := 10 ** digits
    return Round(value * factor) / factor
}

AhkStdlibPillowDrawPutPixel(image, x, y, color)
{
    if x < 0 || y < 0 || x >= image.width || y >= image.height
        return
    image.putpixel([x, y], color)
}

AhkStdlibPillowDrawLineSegment(image, p1, p2, color, width)
{
    x1 := p1[1], y1 := p1[2], x2 := p2[1], y2 := p2[2]
    dx := Abs(x2 - x1)
    dy := Abs(y2 - y1)
    sx := x1 < x2 ? 1 : -1
    sy := y1 < y2 ? 1 : -1
    err := dx - dy
    loop {
        AhkStdlibPillowDrawBrushPixel(image, x1, y1, color, width)
        if x1 = x2 && y1 = y2
            break
        e2 := 2 * err
        if e2 > -dy {
            err -= dy
            x1 += sx
        }
        if e2 < dx {
            err += dx
            y1 += sy
        }
    }
}

AhkStdlibPillowDrawBrushPixel(image, x, y, color, width)
{
    if width <= 1 {
        AhkStdlibPillowDrawPutPixel(image, x, y, color)
        return
    }
    radius := Floor(width / 2)
    loop width {
        yy := y - radius + A_Index - 1
        loop width {
            xx := x - radius + A_Index - 1
            AhkStdlibPillowDrawPutPixel(image, xx, yy, color)
        }
    }
}

AhkStdlibPillowDrawHorizontalLine(image, x0, y, x1, color)
{
    if y < 0 || y >= image.height || x0 > x1
        return
    x := x0
    while x <= x1 {
        AhkStdlibPillowDrawPutPixel(image, x, y, color)
        x += 1
    }
}

AhkStdlibPillowDrawEllipse(image, box, color, fill, width)
{
    x0 := box[1]
    y0 := box[2]
    x1 := box[3]
    y1 := box[4]
    a := x1 - x0
    b := y1 - y0
    if a < 0 || b < 0
        return
    drawWidth := fill ? a + b : width
    state := AhkStdlibPillowEllipseInit(a, b, drawWidth)
    loop {
        segment := AhkStdlibPillowEllipseNext(state)
        if !(segment is Array)
            break
        AhkStdlibPillowDrawHorizontalLine(
            image,
            x0 + Floor((segment[1] + a) / 2),
            y0 + Floor((segment[2] + b) / 2),
            x0 + Floor((segment[3] + a) / 2),
            color
        )
    }
}

AhkStdlibPillowDrawArc(image, box, start, end, color, width)
{
    points := AhkStdlibPillowEllipseOutlinePixels(box, width)
    for point in points {
        if AhkStdlibPillowAngleInRange(AhkStdlibPillowPointAngle(box, point[1], point[2]), start, end)
            AhkStdlibPillowDrawPutPixel(image, point[1], point[2], color)
    }
}

AhkStdlibPillowDrawArcShape(image, box, start, end, color, shape)
{
    bounds := AhkStdlibPillowNormalizeBox(box)
    left := bounds[1], top := bounds[2], right := bounds[3], bottom := bounds[4]
    y := top
    while y <= bottom {
        x := left
        while x <= right {
            if AhkStdlibPillowPointInEllipseFill(box, x, y)
                && AhkStdlibPillowArcShapeContainsPoint(box, x, y, start, end, shape)
                AhkStdlibPillowDrawPutPixel(image, x, y, color)
            x += 1
        }
        y += 1
    }
}

AhkStdlibPillowDrawRoundedRectangle(image, box, radius, color, fill, width)
{
    x0 := box[1], y0 := box[2], x1 := box[3], y1 := box[4]
    d := radius * 2
    fullX := false
    fullY := false
    if d >= x1 - x0 - 1 {
        d := x1 - x0
        fullX := true
    }
    if d >= y1 - y0 - 1 {
        d := y1 - y0
        fullY := true
    }
    if fullX && fullY {
        AhkStdlibPillowDrawEllipse(image, box, color, fill, width)
        return
    }
    if d = 0 {
        if fill
            AhkStdlibPillowDrawFillRectangle(image, box, color)
        else
            AhkStdlibPillowDrawOutlineRectangle(image, box, color, width)
        return
    }

    r := Floor(d / 2)
    if fill {
        AhkStdlibPillowDrawRoundedCorners(image, x0, y0, x1, y1, d, color, true, 1, fullX, fullY)
        if fullX {
            AhkStdlibPillowDrawFillRectangle(image, [x0, y0 + r + 1, x1, y1 - r - 1], color)
        } else if x1 - r - 1 > x0 + r + 1 {
            AhkStdlibPillowDrawFillRectangle(image, [x0 + r + 1, y0, x1 - r - 1, y1], color)
        }
        if !fullX && !fullY {
            AhkStdlibPillowDrawFillRectangle(image, [x0, y0 + r + 1, x0 + r, y1 - r - 1], color)
            AhkStdlibPillowDrawFillRectangle(image, [x1 - r, y0 + r + 1, x1, y1 - r - 1], color)
        }
    } else {
        AhkStdlibPillowDrawRoundedCorners(image, x0, y0, x1, y1, d, color, false, width, fullX, fullY)
        if !fullX {
            AhkStdlibPillowDrawFillRectangle(image, [x0 + r + 1, y0, x1 - r - 1, y0 + width - 1], color)
            AhkStdlibPillowDrawFillRectangle(image, [x0 + r + 1, y1 - width + 1, x1 - r - 1, y1], color)
        }
        if !fullY {
            AhkStdlibPillowDrawFillRectangle(image, [x0, y0 + r + 1, x0 + width - 1, y1 - r - 1], color)
            AhkStdlibPillowDrawFillRectangle(image, [x1 - width + 1, y0 + r + 1, x1, y1 - r - 1], color)
        }
    }
}

AhkStdlibPillowDrawRoundedCorners(image, x0, y0, x1, y1, d, color, fill, width, fullX, fullY)
{
    if fullX {
        parts := [
            [[x0, y0, x0 + d, y0 + d], 180, 360],
            [[x0, y1 - d, x0 + d, y1], 0, 180],
        ]
    } else if fullY {
        parts := [
            [[x0, y0, x0 + d, y0 + d], 90, 270],
            [[x1 - d, y0, x1, y0 + d], 270, 90],
        ]
    } else {
        parts := [
            [[x0, y0, x0 + d, y0 + d], 180, 270],
            [[x1 - d, y0, x1, y0 + d], 270, 360],
            [[x1 - d, y1 - d, x1, y1], 0, 90],
            [[x0, y1 - d, x0 + d, y1], 90, 180],
        ]
    }

    for part in parts {
        if fill
            AhkStdlibPillowDrawArcShape(image, part[1], part[2], part[3], color, "pieslice")
        else
            AhkStdlibPillowDrawArc(image, part[1], part[2], part[3], color, width)
    }
}

AhkStdlibPillowEllipseOutlinePixels(box, width)
{
    pixels := Map()
    bounds := AhkStdlibPillowNormalizeBox(box)
    left := bounds[1], top := bounds[2], right := bounds[3], bottom := bounds[4]
    a := right - left
    b := bottom - top
    state := AhkStdlibPillowEllipseInit(a, b, Max(1, width))
    loop {
        segment := AhkStdlibPillowEllipseNext(state)
        if !(segment is Array)
            break
        x0 := left + Floor((segment[1] + a) / 2)
        y := top + Floor((segment[2] + b) / 2)
        x1 := left + Floor((segment[3] + a) / 2)
        x := x0
        while x <= x1 {
            key := x "," y
            if !pixels.Has(key)
                pixels[key] := [x, y]
            x += 1
        }
    }
    result := []
    for key, point in pixels
        result.Push(point)
    return result
}

AhkStdlibPillowNormalizeBox(box)
{
    return [
        Min(box[1], box[3]),
        Min(box[2], box[4]),
        Max(box[1], box[3]),
        Max(box[2], box[4]),
    ]
}

AhkStdlibPillowPointInEllipseFill(box, x, y)
{
    bounds := AhkStdlibPillowNormalizeBox(box)
    a := bounds[3] - bounds[1]
    b := bounds[4] - bounds[2]
    state := AhkStdlibPillowEllipseInit(a, b, a + b)
    loop {
        segment := AhkStdlibPillowEllipseNext(state)
        if !(segment is Array)
            break
        sx0 := bounds[1] + Floor((segment[1] + a) / 2)
        sy := bounds[2] + Floor((segment[2] + b) / 2)
        sx1 := bounds[1] + Floor((segment[3] + a) / 2)
        if sy = y && x >= sx0 && x <= sx1
            return true
    }
    return false
}

AhkStdlibPillowArcShapeContainsPoint(box, x, y, start, end, shape)
{
    startNorm := AhkStdlibPillowNormalizeAngle(start)
    endNorm := AhkStdlibPillowNormalizeAngle(end)
    if Abs(startNorm - endNorm) < 0.0000001
        return true
    if startNorm = 0 && endNorm = 180
        return y >= AhkStdlibPillowBoxCenterY(box)
    if startNorm = 180 && endNorm = 360
        return y <= AhkStdlibPillowBoxCenterY(box)
    if startNorm = 90 && endNorm = 270
        return x <= AhkStdlibPillowBoxCenterX(box)
    if startNorm = 270 && endNorm = 90
        return x >= AhkStdlibPillowBoxCenterX(box)
    return AhkStdlibPillowAngleInRange(AhkStdlibPillowPointAngle(box, x, y), start, end)
}

AhkStdlibPillowBoxCenterX(box)
{
    bounds := AhkStdlibPillowNormalizeBox(box)
    return (bounds[1] + bounds[3]) / 2
}

AhkStdlibPillowBoxCenterY(box)
{
    bounds := AhkStdlibPillowNormalizeBox(box)
    return (bounds[2] + bounds[4]) / 2
}

AhkStdlibPillowPointAngle(box, x, y)
{
    cx := AhkStdlibPillowBoxCenterX(box)
    cy := AhkStdlibPillowBoxCenterY(box)
    angle := AhkStdlibPillowAtan2(y - cy, x - cx) * 180 / 3.141592653589793
    return AhkStdlibPillowNormalizeAngle(angle)
}

AhkStdlibPillowNormalizeAngle(angle)
{
    if !(angle is Number)
        throw TypeError("must be real number, not " AhkStdlibPythonTypeName(angle), -1)
    normalized := Mod(angle, 360)
    if normalized < 0
        normalized += 360
    if normalized = 0 && angle > 0
        return 360
    return normalized
}

AhkStdlibPillowAngleInRange(angle, start, end)
{
    startNorm := AhkStdlibPillowNormalizeAngle(start)
    endNorm := AhkStdlibPillowNormalizeAngle(end)
    if Abs(startNorm - endNorm) < 0.0000001
        return true
    angleNorm := AhkStdlibPillowNormalizeAngle(angle)
    if endNorm = 360
        endNorm := 0
    if startNorm = 360
        startNorm := 0
    if startNorm <= endNorm
        return angleNorm >= startNorm && angleNorm <= endNorm
    return angleNorm >= startNorm || angleNorm <= endNorm
}

AhkStdlibPillowAtan2(y, x)
{
    if x > 0
        return ATan(y / x)
    if x < 0 && y >= 0
        return ATan(y / x) + 3.141592653589793
    if x < 0 && y < 0
        return ATan(y / x) - 3.141592653589793
    if y > 0
        return 3.141592653589793 / 2
    if y < 0
        return -3.141592653589793 / 2
    return 0
}

AhkStdlibPillowQuarterInit(a, b)
{
    state := {}
    if a < 0 || b < 0 {
        state.finished := true
        return state
    }
    state.a := a
    state.b := b
    state.cx := a
    state.cy := Mod(b, 2)
    state.ex := Mod(a, 2)
    state.ey := b
    state.a2 := a * a
    state.b2 := b * b
    state.a2b2 := state.a2 * state.b2
    state.finished := false
    return state
}

AhkStdlibPillowQuarterDelta(state, x, y)
{
    return Abs(state.a2 * y * y + state.b2 * x * x - state.a2b2)
}

AhkStdlibPillowQuarterNext(state)
{
    if state.finished
        return stdlib.None

    result := [state.cx, state.cy]
    if state.cx = state.ex && state.cy = state.ey {
        state.finished := true
    } else {
        nx := state.cx
        ny := state.cy + 2
        ndelta := AhkStdlibPillowQuarterDelta(state, nx, ny)
        if nx > 1 {
            newdelta := AhkStdlibPillowQuarterDelta(state, state.cx - 2, state.cy + 2)
            if ndelta > newdelta {
                nx := state.cx - 2
                ny := state.cy + 2
                ndelta := newdelta
            }
            newdelta := AhkStdlibPillowQuarterDelta(state, state.cx - 2, state.cy)
            if ndelta > newdelta {
                nx := state.cx - 2
                ny := state.cy
            }
        }
        state.cx := nx
        state.cy := ny
    }
    return result
}

AhkStdlibPillowEllipseInit(a, b, width)
{
    state := { buffer: [] }
    state.leftmost := Mod(a, 2)
    state.st_o := AhkStdlibPillowQuarterInit(a, b)
    first := AhkStdlibPillowQuarterNext(state.st_o)
    if width < 1 || !(first is Array) {
        state.finished := true
        return state
    }
    state.finished := false
    state.pr := first[1]
    state.py := first[2]
    state.st_i := AhkStdlibPillowQuarterInit(a - 2 * (width - 1), b - 2 * (width - 1))
    state.pl := state.leftmost
    return state
}

AhkStdlibPillowEllipseNext(state)
{
    while state.buffer.Length = 0 {
        if state.finished
            return stdlib.None

        y := state.py
        l := state.pl
        r := state.pr

        loop {
            nextOuter := AhkStdlibPillowQuarterNext(state.st_o)
            if !(nextOuter is Array) || nextOuter[2] > y
                break
        }
        if !(nextOuter is Array) {
            state.finished := true
        } else {
            state.pr := nextOuter[1]
            state.py := nextOuter[2]
        }

        loop {
            nextInner := AhkStdlibPillowQuarterNext(state.st_i)
            if !(nextInner is Array) || nextInner[2] > y
                break
            l := nextInner[1]
        }
        state.pl := (nextInner is Array) ? nextInner[1] : state.leftmost

        if (l > 0 || l < r) && y > 0
            state.buffer.Push([l = 0 ? 2 : l, y, r])
        if y > 0
            state.buffer.Push([-r, y, -l])
        if (l > 0 || l < r)
            state.buffer.Push([l = 0 ? 2 : l, -y, r])
        state.buffer.Push([-r, -y, -l])
    }
    return state.buffer.Pop()
}

AhkStdlibPillowDrawFillRectangle(image, box, color)
{
    left := Min(box[1], box[3])
