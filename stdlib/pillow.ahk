AhkStdlibPillowFormatFromPath(path, strict := false)
{
    SplitPath path,,, &ext
    if ext = "" {
        if strict
            throw ValueError("unknown file extension: ", -1)
        return "PNG"
    }
    normalized := "." StrLower(ext)
    extensions := AhkStdlibPillowExtensionRegistry()
    if extensions.Has(normalized)
        return extensions[normalized]
    if strict
        throw ValueError("unknown file extension: " normalized, -1)
    return StrUpper(ext)
}

