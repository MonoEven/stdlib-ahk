AhkStdlibPillowMpoImageSeek(self, args*)
{
    if args.Length < 1
        throw TypeError("Image.seek() missing 1 required positional argument: 'frame'", -1)
    if args.Length > 1
        throw TypeError("Image.seek() takes 2 positional arguments but " args.Length + 1 " were given", -1)
    frameArg := args[1]
    if frameArg is String
        throw TypeError("'<' not supported between instances of 'str' and 'int'", -1)
    if AhkStdlibIsNone(frameArg)
        throw TypeError("'<' not supported between instances of 'NoneType' and 'int'", -1)
    if frameArg is Array
        throw TypeError("'<' not supported between instances of 'list' and 'int'", -1)
    if frameArg is Float {
        if frameArg < 0 || frameArg >= self.n_frames
            throw EOFError("attempt to seek outside sequence", -1)
        if frameArg = self.AhkStdlibMpoFrame
            return stdlib.None
        throw TypeError("list indices must be integers or slices, not float", -1)
    }
    frame := Integer(frameArg)
    if frame < 0 || frame >= self.n_frames
        throw EOFError("attempt to seek outside sequence", -1)
    if frame = self.AhkStdlibMpoFrame
        return stdlib.None

    if !self.HasOwnProp("AhkStdlibJpegBytes")
        throw ValueError("No data found for frame", -1)
    offset := self.AhkStdlibMpoOffsets[frame + 1]
    if offset < 0 || offset + 2 > self.AhkStdlibJpegBytes.Length
        throw ValueError("No data found for frame", -1)
    frameBytes := AhkStdlibPillowArraySlice(self.AhkStdlibJpegBytes, offset + 1, self.AhkStdlibJpegBytes.Length)
    if frameBytes.Length < 2 || frameBytes[1] != 0xFF || frameBytes[2] != 0xD8
        throw ValueError("No data found for frame", -1)
    metadata := AhkStdlibPillowJpegParse(frameBytes)
    self.AhkStdlibMode := metadata.Mode
    self.AhkStdlibWidth := metadata.Size[1]
    self.AhkStdlibHeight := metadata.Size[2]
    self.bits := metadata.Bits
    self.layers := metadata.Layers
    self.layer := metadata.Layer
    self.quantization := metadata.Quantization
    self.app := metadata.App
    self.applist := metadata.AppList
    self.info := metadata.Info
    if self.info.Has("mp")
        self.info.Delete("mp")
    if self.info.Has("mpoffset")
        self.info.Delete("mpoffset")
    self.tile := [["jpeg", [0, 0, metadata.Size[1], metadata.Size[2]], offset, [metadata.Mode, ""]]]
    self.offset := offset
    self.AhkStdlibMpoFrame := frame
    if self.HasOwnProp("fp") && IsObject(self.fp) && HasMethod(self.fp, "seek")
        self.fp.seek(offset)
    return stdlib.None
}

