AhkStdlibPillowImageMorphIsKeywordObject(value)
{
    return IsObject(value) && !(value is Array)
}

AhkStdlibPillowImageMorphLooksLikeImplicitTarget(value, keywordNames)
{
    if !IsObject(value) || value is Array
        return false
    for keywordName in keywordNames {
        if value.HasProp(keywordName)
            return false
    }
    return true
}

AhkStdlibPillowImageMorphKnownPatterns(opName)
{
    switch opName {
        case "corner":
            return ["1:(... ... ...)->0", "4:(00. 01. ...)->1"]
        case "dilation4":
            return ["4:(... .0. .1.)->1"]
        case "dilation8":
            return ["4:(... .0. .1.)->1", "4:(... .0. ..1)->1"]
        case "erosion4":
            return ["4:(... .1. .0.)->0"]
        case "erosion8":
            return ["4:(... .1. .0.)->0", "4:(... .1. ..0)->0"]
        case "edge":
            return ["1:(... ... ...)->0", "4:(.0. .1. ...)->1", "4:(01. .1. ...)->1"]
    }
    throw Error("Unknown pattern " opName "!", -1)
}

AhkStdlibPillowImageMorphParsePattern(pattern)
{
    original := pattern
    compact := StrReplace(pattern, "`n", "")
    if !RegExMatch(compact, "S)^(\w*):?\s*\((.+?)\)\s*->\s*(\d)", &match)
        throw Error('Syntax error in pattern "' original '"', -1)
    parsedPattern := StrReplace(StrReplace(match[2], " ", ""), "`n", "")
    return { Options: match[1], Pattern: parsedPattern, Result: Integer(match[3]) }
}

AhkStdlibPillowImageMorphNegatePattern(pattern)
{
    result := ""
    loop StrLen(pattern) {
        char := SubStr(pattern, A_Index, 1)
        switch char {
            case "0":
                result .= "1"
            case "1":
                result .= "0"
            default:
                result .= char
        }
    }
    return result
}

AhkStdlibPillowImageMorphBitPattern(value)
{
    pattern := ""
    loop 9
        pattern .= (value >> (A_Index - 1)) & 1
    return pattern
}

AhkStdlibPillowImageMorphPatternMatches(pattern, bitpattern)
{
    loop 9 {
        expected := SubStr(pattern, A_Index, 1)
        if expected = "." || expected = "X"
            continue
        if expected != SubStr(bitpattern, A_Index, 1)
            return false
    }
    return true
}

AhkStdlibPillowImageMorphRequireLut(op)
{
    if AhkStdlibIsNone(op.lut)
        throw Error("No operator loaded", -1)
    return stdlib.None
}

AhkStdlibPillowImageMorphRequireLImage(image)
{
    if image.mode != "L"
        throw ValueError("Image mode must be L", -1)
    return stdlib.None
}

AhkStdlibPillowImageMorphNeighborhoodIndex(image, x, y)
{
    index := 0
    bit := 0
    loop 3 {
        yy := y + A_Index - 2
        loop 3 {
            xx := x + A_Index - 2
            if xx >= 0 && xx < image.width && yy >= 0 && yy < image.height && image.getpixel([xx, yy])
                index |= 1 << bit
            bit += 1
        }
    }
    return index
}

