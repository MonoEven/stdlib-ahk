class AhkStdlibPillowIptcImage extends AhkStdlibPillowImage
{
    __New(mode, size, source, tile, info)
    {
        handle := AhkStdlibPillowCreateBitmap(size[1], size[2], mode)
        super.__New(handle, mode, size[1], size[2], "IPTC", 1)
        this.fp := source
        this.tile := tile
        this.info := AhkStdlibPillowCloneMap(info)
    }

    getint(key)
    {
        return AhkStdlibPillowIptcI(this.info[AhkStdlibPillowIptcKey(key)])
    }

    field()
    {
        return AhkStdlibPillowIptcReadField(this.fp)
    }

    load()
    {
        if this.tile.Length != 1 || this.tile[1][1] != "iptc"
            return stdlib.None

        offset := this.tile[1][3]
        compression := this.tile[1][4]
        this.fp.seek(offset)

        data := []
        loop {
            field := AhkStdlibPillowIptcReadField(this.fp)
            tag := field[1]
            size := field[2]
            if AhkStdlibIsNone(tag) || AhkStdlibPillowIptcKey(tag) != "8,10"
                break
            chunk := AhkStdlibPillowByteSequence(this.fp.read(size))
            for byte in chunk
                data.Push(byte)
        }

        if compression = "raw"
            this.frombytes(data)
        else
            throw OSError("unsupported IPTC image compression", -1)
        this.tile := []
        return stdlib.None
    }

    getpixel(xy)
    {
        this.load()
        return super.getpixel(xy)
    }

    getdata(band := unset)
    {
        this.load()
        return super.getdata(band?)
    }

    copy()
    {
        this.load()
        return super.copy()
    }
}

